# ──────────────────────────────────────────────
# 水博館 V2（獨立測試專案）— 環境變數範例
# 複製為 .env 後填入真實值。絕對不要提交 .env。
# ──────────────────────────────────────────────

# Public（可暴露給 browser）
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=jt3vrzpz
PUBLIC_SANITY_DATASET=production

# Sanity Studio（npm run studio；連 V2 專用專案）
SANITY_STUDIO_PROJECT_ID=jt3vrzpz
SANITY_STUDIO_DATASET=production

# 選填：再從 V1 同步時需要（npm run sanity:migrate-from-v1）
# SANITY_V1_PROJECT_ID=iz7fvprm
# SANITY_V1_DATASET=production
# SANITY_V1_TOKEN=

# PostgreSQL（V2 專用資料庫；禁止連 V1）
# 範例：postgresql://USER:PASSWORD@HOST:5432/boaquarium_v2
DATABASE_URL=

# Better Auth（server-only secrets）
# 產生方式：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# OAuth providers (server-only). Use separate V2 credentials/callbacks per environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Sanity（server-only；可選讀取 token）
# 禁止使用 PUBLIC_ 前綴放置任何 token / secret
SANITY_API_READ_TOKEN=
# Resend credentials for verification and password reset emails (required to enable email registration)
RESEND_API_KEY=
# Optional Gmail API sender. Keep the refresh token server-only and grant only gmail.send.
GMAIL_API_REFRESH_TOKEN=
# Gmail sender example: 水博館水族 <boaquarium01@gmail.com>
# Resend sender must use a verified domain, e.g. 水博館水族 <auth@your-verified-domain.example>
AUTH_EMAIL_FROM=
# Legacy fallback sender value; prefer AUTH_EMAIL_FROM
PASSWORD_RESET_FROM_EMAIL=
# 官網內容後台寫入（Editor）；與 SANITY_API_READ_TOKEN 可為同一 token 若權限足夠
SANITY_API_TOKEN=

# 銀行轉帳收款資訊（對顧客公開；可留空則顯示測試提示文案）
PUBLIC_BANK_NAME=
PUBLIC_BANK_ACCOUNT_NAME=
PUBLIC_BANK_ACCOUNT_NUMBER=

# 後台管理員（逗號分隔 email；必須先註冊／登入該帳號）
ADMIN_EMAILS=

# 後台密鑰路徑：/admin/{ADMIN_PATH_SLUG}/dashboard（20–48 字元 [a-zA-Z0-9_-]）
ADMIN_PATH_SLUG=

# 禁止項目（絕對不要加）：
# PUBLIC_DATABASE_URL
# PUBLIC_BETTER_AUTH_SECRET
# PUBLIC_SANITY_WRITE_TOKEN
# PUBLIC_SANITY_API_TOKEN
