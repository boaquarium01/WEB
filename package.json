{
  "name": "boaquarium-v2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "水博館 V2 測試版電商（獨立於 V1）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "gmail:authorize": "node scripts/authorize-gmail-mailer.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:ping": "node scripts/db-ping.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-locations.mjs",
    "db:seed:inventory": "node scripts/seed-inventory.mjs",
    "db:studio": "drizzle-kit studio",
    "typecheck": "astro check",
    "test": "node --test src/lib/auth/policies.test.mjs",
    "sync:products": "tsx scripts/sync-products.ts",
    "studio": "sanity dev --host --port 3334",
    "sanity:migrate-from-v1": "node scripts/migrate-sanity-from-v1.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^1.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^3.99.0",
    "styled-components": "^6.3.12",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
