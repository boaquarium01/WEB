---
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { isValidAdminSecretParam } from '../../../../../lib/admin/path';
import { listAdminSkus, updateSkuCommerceSettings } from '../../../../../lib/services/admin-catalog';
import { getAdminBasePath } from '../../../../../lib/admin/path';
import { listInventoryMovements } from '../../../../../lib/services/inventory';
import { listCatalogCategories } from '../../../../../lib/services/catalog';

export const prerender = false;

if (!isValidAdminSecretParam(Astro.params.adminSecret)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const base = getAdminBasePath();
const currentSearch = Astro.url.searchParams.toString();
const user = Astro.locals.user!;
let error: string | null = null;
let message: string | null = null;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const rawStock = String(form.get('onHand') ?? '').trim();
	const quantity = Number(rawStock);
	const saleMode = String(form.get('saleMode') ?? 'open');
	try {
		await updateSkuCommerceSettings({
			productSkuId: String(form.get('productSkuId') ?? ''),
			sellingPrice: Number(form.get('sellingPrice')),
			onHand: rawStock === '' ? -1 : quantity,
			saleEnabled: saleMode === 'open',
			createdBy: user.id,
		});
		message = '價格與庫存已儲存至資料庫';
	} catch (e) {
		error = e instanceof Error ? e.message : '儲存失敗';
	}
}
const [rows, cmsCategories] = await Promise.all([listAdminSkus(), listCatalogCategories()]);
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const category = Astro.url.searchParams.get('category')?.trim() ?? '';
const statusParam = Astro.url.searchParams.get('status') ?? 'all';
const allowedStatuses = ['all', 'enabled', 'disabled', 'sellable', 'unsellable'];
const status = allowedStatuses.includes(statusParam) ? statusParam : 'all';
const sortChoices = ['default', 'name-asc', 'price-asc', 'price-desc', 'stock-asc', 'stock-desc'] as const;
const requestedSort = Astro.url.searchParams.get('sort') ?? '';
const legacySort = Astro.url.searchParams.get('sort') ?? 'name';
const legacyDirection = Astro.url.searchParams.get('direction') === 'desc' ? 'desc' : 'asc';
const legacySortChoice = legacySort === 'price' || legacySort === 'stock' ? `${legacySort}-${legacyDirection}` : 'default';
const sortChoice = sortChoices.includes(requestedSort as (typeof sortChoices)[number])
	? requestedSort as (typeof sortChoices)[number]
	: legacySortChoice;
const [sortKey, direction] = sortChoice === 'default'
	? ['name', 'asc'] as const
	: sortChoice.split('-') as ['name' | 'price' | 'stock', 'asc' | 'desc'];
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const needle = query.toLocaleLowerCase('zh-Hant');
const productCategorySlugs = new Set(rows.map((row) => row.productType).filter(Boolean));
const knownCategorySlugs = new Set(cmsCategories.map((item) => item.slug));
const categories = [
	...cmsCategories.filter((item) => productCategorySlugs.has(item.slug)),
	...[...productCategorySlugs].filter((slug) => !knownCategorySlugs.has(slug)).map((slug) => ({ slug, label: '其他分類' })),
];
const categoryLabels = new Map(cmsCategories.map((item) => [item.slug, item.label]));
const filteredRows = rows.filter((row) => {
	const matchesQuery = !needle || [row.productName, row.skuName, row.productType].some((value) => String(value ?? '').toLocaleLowerCase('zh-Hant').includes(needle));
	const productEnabled = row.productActive && row.productOnline;
	const matchesStatus = status === 'all'
		|| (status === 'enabled' && productEnabled)
		|| (status === 'disabled' && !productEnabled)
		|| (status === 'sellable' && row.saleEnabled)
		|| (status === 'unsellable' && !row.saleEnabled);
	return matchesQuery && (!category || row.productType === category) && matchesStatus;
});
const sortedRows = [...filteredRows].sort((a, b) => {
	let comparison = 0;
	if (sortKey === 'price') comparison = a.sellingPrice - b.sellingPrice;
	else if (sortKey === 'stock') comparison = (a.onHand < 0 ? Number.POSITIVE_INFINITY : a.onHand) - (b.onHand < 0 ? Number.POSITIVE_INFINITY : b.onHand);
	else comparison = a.productName.localeCompare(b.productName, 'zh-Hant');
	return (direction === 'desc' ? -comparison : comparison) || a.productName.localeCompare(b.productName, 'zh-Hant');
});
const pageSize = 25;
const totalPages = Math.max(1, Math.ceil(sortedRows.length / pageSize));
const currentPage = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), totalPages) : 1;
const pageRows = sortedRows.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const movements = await listInventoryMovements({ limit: 100 });
const productCount = new Set(rows.map((row) => row.productId)).size;
const sellingProductCount = new Set(rows.filter((row) => row.saleEnabled && row.productActive && row.productOnline).map((row) => row.productId)).size;
const pageHref = (page: number) => {
	const params = new URLSearchParams();
	if (query) params.set('q', query);
	if (category) params.set('category', category);
	if (status !== 'all') params.set('status', status);
	if (sortChoice !== 'default') params.set('sort', sortChoice);
	params.set('page', String(page));
	return `${base}/shop/products?${params.toString()}#products-list`;
};
---

<AdminLayout title="價格／庫存｜水博館水族官方網站後台">
	<header class="head page-heading">
		<div class="heading-row"><h1>價格與庫存明細</h1><div class="heading-actions"><a class="commerce-back-link" href={`${base}/dashboard?model=product`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>商品</a><span class="summary-pill">{productCount} 商品 <i>·</i> {sellingProductCount} 販售</span><button class="movement-link" type="button" aria-label="異動紀錄" title="異動紀錄" aria-controls="inventory-movements" aria-expanded="false"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></button></div></div>
		<form class="product-filters" method="get" action={`${base}/shop/products`}>
			<label class="filter-category"><span class="sr-only">分類</span><select name="category" aria-label="分類" onchange="this.form.requestSubmit()"><option value="">分類</option>{categories.map((item) => <option value={item.slug} selected={category === item.slug}>{item.label || categoryLabels.get(item.slug) || '其他分類'}</option>)}</select></label>
			<label class="filter-sort"><span class="sr-only">排序</span><select name="sort" aria-label="排序" onchange="this.form.requestSubmit()"><option value="default" selected={sortChoice === 'default'}>排序</option><option value="name-asc" selected={sortChoice === 'name-asc'}>名稱↑</option><option value="price-asc" selected={sortChoice === 'price-asc'}>價格↑</option><option value="price-desc" selected={sortChoice === 'price-desc'}>價格↓</option><option value="stock-asc" selected={sortChoice === 'stock-asc'}>庫存↑</option><option value="stock-desc" selected={sortChoice === 'stock-desc'}>庫存↓</option></select></label>
			<label class="filter-status"><span class="sr-only">狀態</span><select name="status" aria-label="狀態" onchange="this.form.requestSubmit()"><option value="all" selected={status === 'all'}>狀態</option><option value="enabled" selected={status === 'enabled'}>上架</option><option value="disabled" selected={status === 'disabled'}>未上架</option><option value="sellable" selected={status === 'sellable'}>販售</option><option value="unsellable" selected={status === 'unsellable'}>禁售</option></select></label>
			<label class="search-field" for="product-search"><span class="sr-only">搜尋商品或規格</span><input id="product-search" type="search" name="q" value={query} placeholder="搜尋商品／規格" onchange="this.form.requestSubmit()" onkeydown="if(event.key==='Enter'){event.preventDefault();this.form.requestSubmit();}" /></label>
		</form>
	</header>
	{message && <p class="notice ok">{message}</p>}
	{error && <p class="notice error">{error}</p>}

	{
		filteredRows.length === 0 ? (
			<div class="empty"><i class="fa-solid fa-box-open" aria-hidden="true"></i><strong>{rows.length === 0 ? '商品資料尚未同步' : '找不到符合的商品'}</strong><span>{rows.length === 0 ? '請先執行商品同步流程，再回來管理商品規格與售價。' : '請更換關鍵字後再搜尋。'}</span></div>
		) : (
			<div id="products-list" class="table-wrap">
			<div class="table-toolbar"><span>{(currentPage - 1) * pageSize + 1}–{Math.min(currentPage * pageSize, sortedRows.length)} / {filteredRows.length} 項</span><span>庫存留白＝不限量 · 0＝售完</span></div>
				<table class="product-table">
					<colgroup><col style="width:34%"/><col style="width:17%"/><col style="width:18%"/><col style="width:19%"/><col style="width:12%"/></colgroup>
					<thead><tr><th>商品／規格</th><th>售價</th><th>庫存</th><th>販售</th><th>儲存</th></tr></thead>
					<tbody>{pageRows.map((row) => <tr>
						<td class="identity-cell" data-label="商品">
							<div class="product-title-row"><a class="product-name" href={`/product/${row.slug}`} title={row.productName}>{row.productName}</a><a class="edit-content-link" aria-label={`編輯 ${row.productName}`} title="編輯商品" href={`${base}/dashboard?model=product&product=${encodeURIComponent(row.slug)}`}><i class="fa-solid fa-pen" aria-hidden="true"></i></a></div>
							<div class="product-subtitle">{row.skuName !== row.productName && <span>{row.skuName}</span>}{!row.productOnline || !row.productActive ? <span class="offline-badge">未上架</span> : null}</div>
						</td>
						<td class="price-cell" data-label="售價"><label class="price-field"><span>$</span><input form={`sku-edit-${row.productSkuId}`} type="number" inputmode="numeric" name="sellingPrice" min="0" step="1" required value={row.sellingPrice} aria-label={`${row.productName} ${row.skuName} 售價`}/></label></td>
						<td class="stock-cell" data-label="庫存"><label class="stock-field"><input form={`sku-edit-${row.productSkuId}`} type="number" inputmode="numeric" name="onHand" min="0" step="1" placeholder="不限量" value={row.onHand < 0 ? '' : row.onHand} aria-label={`${row.productName} ${row.skuName} 庫存`}/></label>{row.reserved > 0 && <small class="reserved-hint">預留 {row.reserved}</small>}</td>
						<td class="sale-cell" data-label="販售"><fieldset class="sale-mode-editor" aria-label={`${row.productName} ${row.skuName} 販售狀態`}><label><input form={`sku-edit-${row.productSkuId}`} type="radio" name="saleMode" value="open" checked={row.saleEnabled}/><span>販售</span></label><label><input form={`sku-edit-${row.productSkuId}`} type="radio" name="saleMode" value="stop" checked={!row.saleEnabled}/><span>停售</span></label></fieldset></td>
						<td class="save-cell" data-label="儲存"><form id={`sku-edit-${row.productSkuId}`} class="sku-edit-form" data-product-id={row.sanityProductId} method="post" action={`${base}/shop/products${currentSearch ? `?${currentSearch}` : ''}`}><input type="hidden" name="productSkuId" value={row.productSkuId}/><button class="save-row" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>儲存</button><span class="row-feedback" role="status" aria-live="polite"></span></form></td>
					</tr>)}</tbody>
				</table>
			</div>
			<nav class="pagination" aria-label="商品清單頁數">
				<a class:list={[{ disabled: currentPage <= 1 }]} href={pageHref(Math.max(1, currentPage - 1))} aria-disabled={currentPage <= 1}>上一頁</a>
				<span class="page-position" aria-live="polite" aria-label={`第 ${currentPage} 頁，共 ${totalPages} 頁`}><strong>{currentPage}</strong><span>/ {totalPages} 頁</span></span>
				<a class:list={[{ disabled: currentPage >= totalPages }]} href={pageHref(Math.min(totalPages, currentPage + 1))} aria-disabled={currentPage >= totalPages}>下一頁</a>
			</nav>
		)
	}

	<details id="inventory-movements" class="movement-section">
		<summary><span><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>庫存異動紀錄</span><small>最近 {movements.length} 筆</small><i class="fa-solid fa-chevron-down movement-chevron" aria-hidden="true"></i></summary>
		{movements.length === 0 ? <div class="empty"><strong>尚無異動</strong></div> : <div class="table-wrap movement-table"><table>
			<thead><tr><th>時間</th><th>商品</th><th>地點</th><th>數量</th><th>庫存</th><th>說明</th></tr></thead>
			<tbody>{movements.map((row) => <tr>
				<td class="movement-time"><time datetime={row.createdAt.toISOString()} title={row.createdAt.toLocaleString('zh-TW', { timeZone:'Asia/Taipei' })}>{row.createdAt.toLocaleString('zh-TW', { timeZone:'Asia/Taipei', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', hour12:false })}</time></td>
				<td class="movement-product"><strong>{row.productName}</strong></td>
				<td class="movement-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>{row.locationName}</span></td>
				<td class="movement-quantity"><span class="movement-mobile-label">數量</span><span>{row.quantity}</span></td>
				<td class="movement-stock"><span class="movement-mobile-label">庫存</span><span class="movement-stock-before">{row.beforeQuantity < 0 ? '不限量' : row.beforeQuantity}</span><span class="movement-arrow" aria-label="變更為">→</span><strong>{row.afterQuantity < 0 ? '不限量' : row.afterQuantity}</strong>{(row.beforeQuantity < 0) !== (row.afterQuantity < 0) && <span class="movement-mode">模式切換</span>}</td>
				<td class:list={['movement-note', { 'is-empty': !row.note }]}>{row.note || '—'}</td>
			</tr>)}</tbody>
		</table></div>}

	</details>
</AdminLayout>

<style>
	.head {
		margin-bottom: 1rem;
	}
	.eyebrow { margin: 0 0 7px; color: #8c9b9c; font-size: 9px; font-weight: 800; letter-spacing: .15em; }
	.eyebrow span { color: var(--commerce-primary); }
	.heading-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
	.heading-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 9px; }
	.summary-pill { display: inline-flex; align-items: center; gap: 9px; padding: 10px 14px; border: 1px solid #d8ebe4; border-radius: 999px; background: #f2faf6; color: #28745f; font-size: 14px; font-weight: 750; white-space: nowrap; }
	.summary-pill i { color: #95b6aa; font-style: normal; font-weight: 500; }
	.online-count { display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border: 1px solid #d8ebe4; border-radius: 999px; background: #f2faf6; color: #39866c; font-size: 10px; font-weight: 700; white-space: nowrap; }
	.online-count i { font-size: 7px; }
	.product-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: 10px; margin-top: 20px; padding: 15px; border: 1px solid var(--commerce-line); border-radius: 14px; background: #fff; }
	.product-filters .search-field { grid-column: 1 / 3; }
	.product-filters .movement-link { grid-column: 3; width: 100%; }
	.product-filters label { display: grid; gap: 6px; color: #607579; font-size: 12px; font-weight: 700; }
	.product-filters input,.product-filters select { width: 100%; min-width: 0; height: 40px; padding: 0 11px; font-size: 13px; }
	.product-filters button,.movement-link { display: inline-flex; justify-content: center; align-items: center; gap: 7px; min-height: 40px; padding: 0 13px; border: 1px solid var(--commerce-primary); border-radius: 9px; background: var(--commerce-primary); color: #fff; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; cursor: pointer; }
	.product-filters .movement-link { border-color: #dce8e5; background: #fff; color: var(--commerce-primary-dark); }
	.notice { padding: 11px 14px; border: 1px solid; border-radius: 10px; font-size: 11px; }
	.notice.ok { border-color: #cce8d9; background: #f1faf5; color: #287451; }
	.notice.error { border-color: #f1c9c4; background: #fff5f3; color: #a23e34; }

	h1 {
		margin: 0;
	}

	.lead {
		color: var(--aq-muted);
		font-size: 0.92rem;
	}

	.lead code {
		font-size: 0.85rem;
	}

	.empty {
		color: var(--aq-muted);
	}

	.table-wrap {
		overflow-x: auto;
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
	}
	.product-table { table-layout: fixed; min-width: 1080px; }
	.product-table th { padding: 14px 12px; font-size: 12px; }
	.product-table td { padding: 14px 12px; font-size: 14px; vertical-align: middle; overflow-wrap: anywhere; }
	.product-table td[data-label="販售狀態"] { min-width: 0; vertical-align: middle; }
	.product-table td[data-label="商品規格"] strong { display: block; line-height: 1.45; }
	.product-table td:first-child a { display: inline-block; line-height: 1.45; }
	.product-table td:first-child .edit-content-link { display: flex; align-items: center; gap: 5px; width: max-content; margin-top: 6px; color: #5c7c7d; font-size: 10px; font-weight: 700; }

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	th,
	td {
		padding: 0.65rem 0.75rem;
		border-bottom: 1px solid var(--aq-line);
		text-align: left;
		vertical-align: top;
	}

	th {
		background: var(--aq-sand-2, #f3efe6);
		font-weight: 650;
		white-space: nowrap;
	}

	a {
		color: var(--aq-primary);
		text-decoration: none;
		font-weight: 650;
	}

	.mono {
		font-variant-numeric: tabular-nums;
	}

	small {
		display: block;
		color: var(--aq-muted);
		font-size: 0.8rem;
	}
	.price-field, .stock-field { display: flex; align-items: center; gap: 7px; width: 100%; min-width: 0; min-height: 42px; padding: 5px 9px; box-sizing: border-box; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; color: #73868a; font-size: 12px; }
	.price-field input, .stock-field input { display: block; width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; border: 0; outline: 0; background: transparent; color: #243e44; font: inherit; font-size: 14px; font-weight: 650; }
	.stock-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
	.stock-field small { min-width: 0; font-size: 10px; white-space: nowrap; }
	.sale-mode-editor { display: grid; grid-template-columns: 1fr; gap: 3px; min-width: 0; margin: 0 0 6px; padding: 3px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #f5f9f8; }
	.sale-mode-editor label { position: relative; display: inline-flex; align-items: center; min-width: 0; cursor: pointer; }
	.sale-mode-editor input { position: absolute; width: 1px; height: 1px; opacity: 0; }
	.sale-mode-editor label span { display: block; width: 100%; box-sizing: border-box; padding: 5px 7px; border-radius: 6px; color: #627679; font-size: 11px; font-weight: 700; line-height: 1.25; text-align: center; white-space: nowrap; }
	.sale-mode-editor label:has(input:checked) span { background: #e6f5ef; color: #08745c; box-shadow: 0 1px 4px rgba(15, 118, 110, .12); }
	.sale-mode-editor label:has(input[value='stop']:checked) span { background: #fff0ee; color: #b5473c; }
	.sale-mode-editor label:focus-within span { outline: 2px solid rgba(15, 118, 110, .3); outline-offset: 1px; }
	.sku-edit-form { display: flex; justify-content: center; width: 100%; min-width: 0; margin: 0; }
	.save-row { display: inline-flex; flex: 0 0 auto; justify-content: center; align-items: center; gap: 6px; width: 100%; min-width: 82px; min-height: 42px; box-sizing: border-box; padding: 8px 10px; border: 0; border-radius: 8px; background: var(--commerce-primary); color: #fff; font-size: 13px; font-weight: 700; line-height: 1; white-space: nowrap; word-break: keep-all; cursor: pointer; }
	.save-row.is-dirty { background: #e76f2e; box-shadow: 0 0 0 3px rgba(231, 111, 46, .16), 0 6px 16px rgba(187, 75, 24, .2); }
	.save-row.is-dirty:hover { background: #c9541d; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
	.table-toolbar { display: flex; justify-content: space-between; padding: 12px 15px; border-bottom: 1px solid var(--commerce-line); color: #839294; font-size: 10px; }
	.table-toolbar strong { color: var(--commerce-primary-dark); }
	.pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 15px 0 34px; }
	.pagination a { min-width: 38px; height: 38px; display: inline-grid; place-items: center; padding: 0 10px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; color: var(--commerce-primary-dark); font-size: 13px; text-decoration: none; }
	.pagination a.active { border-color: var(--commerce-primary); background: var(--commerce-primary); color: #fff; }
	.pagination a.disabled { opacity: .45; pointer-events: none; }
	.movement-section { margin-top: 38px; scroll-margin-top: 18px; }
	.movement-heading { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 12px; }
	.movement-heading h2 { margin: 0; font-size: 25px; }
	.movement-heading p { margin: 5px 0 0; color: var(--commerce-muted); font-size: 13px; }
	.movement-heading > span { padding: 7px 11px; border-radius: 999px; background: var(--commerce-primary-soft); color: var(--commerce-primary-dark); font-size: 12px; font-weight: 700; }
	.movement-table td { font-size: 13px; }
	.updated-at { min-width: 0; white-space: nowrap; font-size: 12px; font-variant-numeric: tabular-nums; }
	.movement-section { margin-top: 4px; scroll-margin-top: 18px; border: 1px solid var(--commerce-line); border-radius: 14px; background: #fff; box-shadow: var(--commerce-shadow); }
	.movement-section summary { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 15px 18px; color: var(--commerce-primary-dark); font-size: 16px; font-weight: 750; cursor: pointer; list-style: none; }
	.movement-section summary::-webkit-details-marker { display: none; }
	.movement-section summary > span { display: inline-flex; align-items: center; gap: 9px; }
	.movement-section summary small { color: var(--commerce-muted); font-size: 12px; font-weight: 550; }
	.movement-section[open] summary { border-bottom: 1px solid var(--commerce-line); }
	.movement-section .table-wrap { border: 0; border-radius: 0 0 14px 14px; box-shadow: none; }
