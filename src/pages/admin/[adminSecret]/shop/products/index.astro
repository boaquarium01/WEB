	@media(prefers-reduced-motion:reduce) { .movement-chevron { transition:none; } }
</style>

<script>
	const movementDetails = document.querySelector<HTMLDetailsElement>('#inventory-movements');
	const movementToggle = document.querySelector<HTMLButtonElement>('.movement-link');
	if (movementDetails && movementToggle) {
		const syncMovementToggle = () => movementToggle.setAttribute('aria-expanded', String(movementDetails.open));
		movementToggle.addEventListener('click', () => {
			movementDetails.open = !movementDetails.open;
			syncMovementToggle();
			if (movementDetails.open) movementDetails.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
		if (window.location.hash === '#inventory-movements') {
			movementDetails.open = true;
			syncMovementToggle();
		}
		movementDetails.addEventListener('toggle', syncMovementToggle);
	}
	const dirtyForms = new Set<HTMLFormElement>();
	let savingRows = 0, navigationApproved = false;
	window.addEventListener('beforeunload', (event) => { if (!navigationApproved && (dirtyForms.size || savingRows)) { event.preventDefault(); event.returnValue = ''; } });
	const allowNavigation = () => {
		if (savingRows) { window.alert('儲存中，請稍候'); return false; }
		if (!dirtyForms.size) return true;
		if (!window.confirm('尚有未儲存變更，確定離開？')) return false;
		navigationApproved = true; setTimeout(() => { navigationApproved = false; }, 1500); return true;
	};
	document.querySelector('.product-filters')?.addEventListener('submit', (event) => { if (!allowNavigation()) event.preventDefault(); });
	document.addEventListener('click', (event) => {
		const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('.pagination a,.commerce-back-link,.product-name,.edit-content-link') : null;
		if (link && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey && !allowNavigation()) event.preventDefault();
	});
	document.querySelectorAll<HTMLFormElement>('.sku-edit-form').forEach((form) => {
		const price = form.elements.namedItem('sellingPrice') as HTMLInputElement;
		const stock = form.elements.namedItem('onHand') as HTMLInputElement;
		// The numeric fields and radios live in neighboring table cells and share the form attribute.
		const controls = Array.from(form.elements).filter((element): element is HTMLInputElement => element instanceof HTMLInputElement && element.type !== 'hidden');
		const button = form.querySelector<HTMLButtonElement>('.save-row')!;
		const feedback = form.querySelector<HTMLElement>('.row-feedback')!;
		const row = form.closest('tr')!;
		const read = () => ({ sellingPrice: price.value, onHand: stock.value, saleMode: (form.elements.namedItem('saleMode') as RadioNodeList).value });
		let baseline = read(), saving = false;
		const paint = () => {
			const value = read(); const dirty = (Object.keys(value) as Array<keyof typeof value>).some((key) => value[key] !== baseline[key]);
			if (dirty) dirtyForms.add(form); else dirtyForms.delete(form);
			row.classList.toggle('is-dirty', dirty); button.classList.toggle('is-dirty', dirty); button.disabled = saving || !dirty;
			if (!saving) button.innerHTML = dirty ? '<i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>儲存' : '<i class="fa-solid fa-check" aria-hidden="true"></i>儲存';
		};
		controls.forEach((control) => control.addEventListener('input', () => { feedback.textContent = ''; paint(); }));
		form.addEventListener('submit', async (event) => {
			event.preventDefault(); if (saving || !form.reportValidity()) return;
			const value = read(); const patch: Record<string, unknown> = {};
			if (value.sellingPrice !== baseline.sellingPrice) patch.sellingPrice = Number(value.sellingPrice);
			if (value.onHand !== baseline.onHand) patch.onHand = value.onHand === '' ? -1 : Number(value.onHand);
			if (value.saleMode !== baseline.saleMode) patch.saleEnabled = value.saleMode === 'open';
			if (!Object.keys(patch).length) return;
			saving = true; savingRows++; controls.forEach((control) => { control.disabled = true; }); button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = '儲存中'; feedback.textContent = '';
			try {
				const response = await fetch('/api/admin/product-commerce', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ action:'save-changes', sanityProductId:form.dataset.productId, changes:[{productSkuId:(form.elements.namedItem('productSkuId') as HTMLInputElement).value,...patch}] }) });
				const result = await response.json(); if (!response.ok) throw new Error(result.error?.message || '儲存失敗');
				baseline = value; feedback.dataset.error = 'false'; feedback.textContent = '已儲存';
			} catch (error) { feedback.dataset.error = 'true'; feedback.textContent = error instanceof Error ? error.message : '儲存失敗，請重試'; }
			finally { saving = false; savingRows--; controls.forEach((control) => { control.disabled = false; }); button.removeAttribute('aria-busy'); paint(); }
		});
		paint();
	});
</script>
