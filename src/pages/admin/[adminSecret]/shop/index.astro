---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {
	getAdminBasePath,
	isValidAdminSecretParam,
} from '../../../../lib/admin/path';
import { getAdminDashboardStats } from '../../../../lib/services/admin-orders';
import { formatTwd } from '../../../../lib/services/catalog';
import { listAdminOrders } from '../../../../lib/services/admin-orders';
import { orderStatusLabel } from '../../../../lib/services/order';

export const prerender = false;

if (!isValidAdminSecretParam(Astro.params.adminSecret)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const base = getAdminBasePath();
const stats = await getAdminDashboardStats();
const recent = await listAdminOrders({ limit: 8 });
---

<AdminLayout title="電商營運總覽｜水博館水族">
	<header class="head page-heading">
		<div class="heading-row">
			<div><h1>電商總覽</h1></div>
			<a class="btn-primary" href={`${base}/shop/orders`}><i class="fa-solid fa-list-check" aria-hidden="true"></i>前往訂單管理</a>
		</div>
	</header>

	<section class="stats">
		<a class="stat stat--teal" href={`${base}/shop/orders`}>
			<span class="stat-icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
			<span class="label">今日訂單</span>
			<strong class="num">{stats.todayOrders}<small>筆</small></strong>
		</a>
		<a class="stat stat--amber" href={`${base}/shop/orders?status=PAYMENT_REVIEW`}>
			<span class="stat-icon"><i class="fa-solid fa-clock" aria-hidden="true"></i></span>
			<span class="label">待付款核對</span>
			<strong class="num">{stats.pendingPayment}<small>筆</small></strong>
		</a>
		<a class="stat stat--blue" href={`${base}/shop/orders?status=AWAITING_SHIPMENT`}>
			<span class="stat-icon"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i></span>
			<span class="label">待出貨</span>
			<strong class="num">{stats.awaitingShipment}<small>筆</small></strong>
		</a>
		<a class="stat stat--rose" href={`${base}/shop/products?sort=stock&direction=asc`}>
			<span class="stat-icon"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
			<span class="label">低庫存品項</span>
			<strong class="num">{stats.lowStock}<small>項</small></strong>
		</a>
	</section>

	<section class="quick-links" aria-label="常用功能">
		<a href={`${base}/shop/orders`}><span class="quick-icon"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span><span><strong>處理訂單</strong></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
		<a href={`${base}/shop/products`}><span class="quick-icon"><i class="fa-solid fa-box-open" aria-hidden="true"></i></span><span><strong>商品目錄</strong></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
		<a href={`${base}/shop/products`}><span class="quick-icon"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span><span><strong>商品管理</strong></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
	</section>

	<section class="panel recent-panel">
		<div class="panel-head">
			<div><h2>最近訂單</h2></div>
			<a href={`${base}/shop/orders`}>查看全部訂單 <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
		</div>
		{
			recent.length === 0 ? (
				<div class="empty"><i class="fa-regular fa-clipboard" aria-hidden="true"></i><strong>目前還沒有訂單</strong></div>
			) : (
				<div class="recent table-wrap"><table><thead><tr><th>訂單編號</th><th>顧客</th><th>狀態</th><th>訂購金額</th><th></th></tr></thead><tbody>
					{recent.map((row) => (
						<tr>
			<td><a class="mono order-link" href={`${base}/shop/orders/${encodeURIComponent(row.orderNumber)}`}>{row.orderNumber}</a></td>
			<td>{row.customerName ?? '—'}</td>
							<td><span class="status-pill">{orderStatusLabel(row.status)}</span></td>
							<td class="amount">{formatTwd(row.total)}</td>
							<td><a class="row-arrow" href={`${base}/shop/orders/${encodeURIComponent(row.orderNumber)}`} aria-label={`查看訂單 ${row.orderNumber}`}><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></td>
						</tr>
					))}
				</tbody></table></div>
			)
		}
	</section>
</AdminLayout>

<style>
	.eyebrow { margin: 0 0 7px; color: #8c9b9c; font-size: 14px; font-weight: 800; letter-spacing: .08em; }
	.eyebrow span { color: var(--commerce-primary); }
	.head h1 { font-size: 40px; }
	.heading-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
	.heading-row .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 10px; background: var(--commerce-primary); color: #fff; font-size: 15px; font-weight: 700; text-decoration: none; }
	.stats { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; margin: 24px 0 17px; }
	.stat { position: relative; display: grid; grid-template-columns: 42px 1fr; grid-template-rows: auto auto auto; align-items: center; column-gap: 12px; min-height: 130px; padding: 17px; overflow: hidden; border: 1px solid var(--commerce-line); border-radius: 15px; background: #fff; color: inherit; text-decoration: none; box-shadow: var(--commerce-shadow); transition: transform .16s ease,box-shadow .16s ease; }
	.stat:hover { transform: translateY(-2px); box-shadow: 0 16px 32px #21454512; }
	.stat-icon { grid-row: 1 / 4; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; background: #e8f5f2; color: #078177; }
	.stat--amber .stat-icon { background: #fff3df; color: #b87922; }
	.stat--blue .stat-icon { background: #e9f1ff; color: #4d75bd; }
	.stat--rose .stat-icon { background: #fff0ed; color: #be665c; }
	.label { color: #52676b; font-size: 15px; font-weight: 700; }
	.num { display: flex; align-items: baseline; gap: 5px; margin: 7px 0 1px; color: #1c3941; font-size: 38px; line-height: 1; font-weight: 750; font-variant-numeric: tabular-nums; }
	.num small { color: #52676b; font-size: 15px; font-weight: 650; }
	.quick-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-bottom: 22px; }
	.quick-links > a { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 13px 15px; border: 1px solid var(--commerce-line); border-radius: 13px; background: #fff; color: inherit; text-decoration: none; transition: border-color .16s,transform .16s; }
	.quick-links > a:hover { transform: translateY(-1px); border-color: #acd6ce; }
	.quick-icon { width: 36px; height: 36px; display: grid; place-items: center; flex: none; border-radius: 11px; background: #eff7f5; color: var(--commerce-primary); }
	.quick-links > a > span:nth-child(2) { flex: 1; display: grid; gap: 3px; }
	.quick-links strong { font-size: 15px; }
	.quick-links > a > i { color: #9aabaa; font-size: 11px; }
	.panel { padding: 0 !important; }
	.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 17px 20px; border-bottom: 1px solid #edf1ef; }
	.panel-head h2 { margin: 0; font-size: 26px; }
	.panel-head .eyebrow { margin-bottom: 3px; }
	.panel-head a { display: inline-flex; align-items: center; gap: 8px; color: var(--commerce-primary); font-size: 14px; font-weight: 700; text-decoration: none; }
	.recent { border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
	.recent th { font-size: 14px; }
	.recent td { font-size: 15px; }
	.recent small { display: block; margin-top: 3px; color: #65797c; font-size: 13px; }
	.recent .order-link { color: var(--commerce-primary-dark); text-decoration: none; font-weight: 750; }
	.recent .status-pill { display: inline-block; padding: 5px 10px; border-radius: 999px; background: #eef5f2; color: #56766f; font-size: 13px; }
	.recent .amount { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.recent .row-arrow { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 8px; background: #f3f7f6; color: #718a89; text-decoration: none; }
	.empty { display: grid; justify-items: center; gap: 6px; margin: 0; padding: 38px 20px; border: 0 !important; background: #fff !important; }
	.empty i { margin-bottom: 3px; color: #9eb8b3; font-size: 24px; }
	.empty strong { color: #41575e; font-size: 16px; }
	.mono { font-variant-numeric: tabular-nums; }
	:global(body:has(.stats) .commerce-brand__text small), :global(body:has(.stats) .commerce-footer) { display: none; }
	@media (max-width: 1000px) { .stats { grid-template-columns: repeat(2,minmax(0,1fr)); } }
	@media (max-width: 700px) { .head h1 { font-size: 34px; }.heading-row { align-items: start; flex-direction: column; }.quick-links { grid-template-columns: 1fr; gap: 8px; }.stats { gap: 9px; margin: 18px 0 12px; }.stat { min-height: 112px; grid-template-columns: 34px 1fr; gap: 3px 9px; padding: 12px; }.stat-icon { width: 34px; height: 34px; }.num { font-size: 24px; }.panel-head { padding: 14px; }.panel-head a { font-size: 13px; } }
</style>
