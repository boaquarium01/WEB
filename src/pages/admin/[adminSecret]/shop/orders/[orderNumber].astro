---
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import {
	getAdminBasePath,
	isValidAdminSecretParam,
} from '../../../../../lib/admin/path';
import {
	adminCancelOrder,
	adminCompleteOrder,
	adminConfirmPayment,
	adminMarkShipped,
	getAdminOrder,
} from '../../../../../lib/services/admin-orders';
import { formatTwd } from '../../../../../lib/services/catalog';
import { orderThumbUrl } from '../../../../../lib/services/order-item-images';
import { sendOrderPush } from '../../../../../lib/services/push';

/** 商品明細的單價／小計／運費不顯示「NT」，只有總計用 formatTwd 顯示 NT$（與前台訂單一致） */
const dollars = (amount: number) => `$${new Intl.NumberFormat('zh-TW').format(amount)}`;
import {
	orderStatusLabel,
	paymentStatusLabel,
} from '../../../../../lib/services/order';
import { sendAuthEmail } from '../../../../../lib/email/adapter';
import { orderShippedEmail } from '../../../../../lib/email/templates';
import { isSyntheticProviderEmail } from '../../../../../lib/auth/policies.js';

export const prerender = false;

if (!isValidAdminSecretParam(Astro.params.adminSecret)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const base = getAdminBasePath();
const user = Astro.locals.user!;
const orderNumber = String(Astro.params.orderNumber ?? '').trim();

let error: string | null = null;
let message: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'confirm_payment') {
			await adminConfirmPayment(
				orderNumber,
				user.id,
				String(form.get('submissionId') ?? '') || undefined,
			);
			message = '已確認付款，訂單進入處理中。';
			const paidOrder = await getAdminOrder(orderNumber);
			if (paidOrder?.userId) {
				const pushed = await sendOrderPush(paidOrder.userId, {
					title: '已確認收到您的款項',
					body: `訂單 ${paidOrder.orderNumber} 正在備貨中，出貨時會再通知您。`,
					url: `/account/orders/${encodeURIComponent(paidOrder.orderNumber)}`,
					tag: `order-${paidOrder.orderNumber}`,
				});
				if (pushed) message += `已推播通知顧客（${pushed} 台裝置）。`;
			}
		} else if (action === 'mark_shipped') {
			await adminMarkShipped(orderNumber, user.id);
			const shippedOrder = await getAdminOrder(orderNumber);
			if (!shippedOrder) throw new Error('找不到出貨訂單');
			const shippedPushCount = shippedOrder.userId
				? await sendOrderPush(shippedOrder.userId, {
					title: '您的訂單已出貨 🚚',
					body: `訂單 ${shippedOrder.orderNumber} 已出貨，請留意收件。`,
					url: `/account/orders/${encodeURIComponent(shippedOrder.orderNumber)}`,
					tag: `order-${shippedOrder.orderNumber}`,
				})
				: 0;
			const pushNote = shippedPushCount ? `已推播通知顧客（${shippedPushCount} 台裝置）。` : '';
			if (!shippedOrder.customerEmail || !shippedOrder.customerEmailVerified || isSyntheticProviderEmail(shippedOrder.customerEmail)) {
				message = '已標記出貨並扣減庫存；顧客沒有可寄送的已驗證電子郵件，因此未寄出通知。';
			} else {
				const orderUrl = new URL(`/account/orders/${encodeURIComponent(shippedOrder.orderNumber)}`, Astro.url.origin).toString();
				try {
					const sent = await sendAuthEmail({ to: shippedOrder.customerEmail, ...orderShippedEmail(shippedOrder, orderUrl) });
					message = sent
						? '已標記出貨、扣減庫存，並寄出顧客出貨通知。'
						: '已標記出貨並扣減庫存；郵件服務尚未設定，未寄出顧客通知。';
				} catch (emailError) {
					console.error(`Failed to send shipment email for order ${shippedOrder.orderNumber}:`, emailError);
					message = '已標記出貨並扣減庫存，但出貨通知寄送失敗。';
				}
			}
			if (pushNote) message = `${message ?? ''}${pushNote}`;
		} else if (action === 'complete') {
			await adminCompleteOrder(orderNumber);
			// 不另顯示提示列：下方「訂單進度」會以高亮的完成狀態呈現
		} else if (action === 'cancel') {
			await adminCancelOrder(orderNumber, user.id);
			message = '訂單已取消，預留庫存已釋放。';
		}
	} catch (e) {
		error = e instanceof Error ? e.message : '操作失敗';
	}
}

const order = orderNumber ? await getAdminOrder(orderNumber) : null;
if (!order) {
	return Astro.redirect(`${base}/shop/orders`);
}

const addr = order.shippingAddress;
const payment = order.payments[0];
const submissions = [...(payment?.submissions ?? [])].sort((a, b) => b.submittedAt.getTime() - a.submittedAt.getTime());
const primarySubmission = (payment?.status === 'PAID' ? submissions.find((submission) => submission.verifiedAt) : null) ?? submissions[0];
const previousSubmissions = submissions.filter((submission) => submission.id !== primarySubmission?.id);
const paymentHeadingStatus = payment ? (payment.status === 'PAID' ? '已核對' : paymentStatusLabel(payment.status)) : null;
const compactPaymentTime = (date: Date) => date.toLocaleString('zh-TW', { timeZone: 'Asia/Taipei', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });
/** 會員管理頁（累積消費、備註） */
const memberHref = order.userId ? `${base}/shop/members?userId=${encodeURIComponent(order.userId)}` : null;
const memberOrdersHref = order.customerEmail
	? `${base}/shop/orders?userId=${encodeURIComponent(order.userId)}`
	: null;
const copyAddress = [
	`收件人：${addr.recipientName}`,
	`電話：${addr.phone}`,
	...(addr.shippingMethodName ? [`配送方式：${addr.shippingMethodName}`] : []),
	`地址：${addr.postalCode} ${addr.city}${addr.district}${addr.addressLine}`,
	...(order.note ? [`備註：${order.note}`] : []),
].join('\n');
const formatDateTime = (date: Date) => date.toLocaleString('zh-TW', {
	timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit',
	hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
});
const currentStateSummary: Record<string, string> = {
	PENDING_PAYMENT: '等待顧客付款',
	PAYMENT_SUBMITTED: '顧客已回報付款，等待核對',
	PAID: '付款已確認，等待備貨',
	PROCESSING: '付款已確認，商品備貨中',
	SHIPPED: '商品已出貨，等待送達',
	COMPLETED: '訂單已完成',
	CANCELLED: '訂單已取消',
};
const progressSteps = [
	{ label: '成立', reached: true, event: order.statusHistory[0] ?? { createdAt: order.createdAt } },
	{
		label: '付款',
		reached: order.statusHistory.some((event) => event.paymentStatus === 'PAID'),
		event: order.statusHistory.find((event) => event.paymentStatus === 'PAID')
			?? order.statusHistory.find((event) => event.status === 'PAYMENT_SUBMITTED'),
	},
	{
		label: '出貨',
		reached: order.statusHistory.some((event) => event.shippingStatus === 'SHIPPED'),
		event: order.statusHistory.find((event) => event.shippingStatus === 'SHIPPED'),
	},
	{
		label: '完成',
		reached: order.statusHistory.some((event) => event.status === 'COMPLETED'),
		event: order.statusHistory.find((event) => event.status === 'COMPLETED'),
	},
];
const currentProgressIndex = order.status === 'CANCELLED'
	? -1
	: order.status === 'COMPLETED'
		? 3
		: order.shippingStatus === 'SHIPPED'
			? 3
			: order.paymentStatus === 'PAID'
				? 2
				: order.status === 'PAYMENT_SUBMITTED'
					? 1
					: 0;
/** 右側「下一步」卡：告訴夥伴這筆訂單現在要做什麼 */
const nextStepTitles: Record<string, string> = {
	PENDING_PAYMENT: '等待顧客轉帳',
	PAYMENT_SUBMITTED: '核對轉帳款項',
	PAID: '備貨並出貨',
	PROCESSING: '備貨並出貨',
	SHIPPED: '送達後完成訂單',
	COMPLETED: '訂單已完成',
	CANCELLED: '訂單已取消',
};
const nextStepTitle = nextStepTitles[order.status] ?? orderStatusLabel(order.status);
const nextTone = order.status === 'PAYMENT_SUBMITTED' ? 'action' : ['PAID', 'PROCESSING'].includes(order.status) ? 'ship' : order.status === 'CANCELLED' ? 'muted' : order.status === 'COMPLETED' ? 'done' : 'wait';
const cancellationEvent = order.statusHistory.find((event) => event.status === 'CANCELLED');

const canConfirm =
	order.status === 'PENDING_PAYMENT' || order.status === 'PAYMENT_SUBMITTED';
const canShip = order.status === 'PROCESSING' || order.status === 'PAID';
const canComplete = order.status === 'SHIPPED';
const canCancel = [
	'PENDING_PAYMENT',
	'PAYMENT_SUBMITTED',
	'PAID',
	'PROCESSING',
].includes(order.status);
---

<AdminLayout title={`訂單 ${order.orderNumber}｜水博館水族`}>
	<header class="head page-heading order-heading">
		<a class="commerce-back-link" href={`${base}/shop/orders`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>返回訂單管理</a>
		<div class="order-identity">
			<div class="order-title-row"><h1>{order.orderNumber}</h1><span class={`order-status status--${order.status.toLowerCase()}`}>{orderStatusLabel(order.status)}</span></div>
			{/* 會員名稱（點進會員資料：累積消費、備註）＋下單時間 */}
			<div class="customer-row">
				{memberHref ? <a class="member-link" href={memberHref}><i class="fa-regular fa-user" aria-hidden="true"></i><strong>{order.customerName ?? '—'}</strong><i class="fa-solid fa-chevron-right member-link__go" aria-hidden="true"></i></a> : <span class="member-link"><i class="fa-regular fa-user" aria-hidden="true"></i><strong>{order.customerName ?? '—'}</strong></span>}
				<time class="order-created" datetime={order.createdAt.toISOString()}><i class="fa-regular fa-calendar" aria-hidden="true"></i>{formatDateTime(order.createdAt)}</time>
			</div>
		</div>
	</header>

	{message && <p class="banner ok">{message}</p>}
	{error && <p class="banner error">{error}</p>}

	<div class="od-layout">
		<div class="od-main">
		<section class:list={['panel status-panel', { 'is-completed': order.status === 'COMPLETED' }]}>
			<div class="section-heading section-heading--stack"><h2>訂單進度</h2>{order.status === 'COMPLETED'
				? <strong class="completed-summary"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>訂單已完成</strong>
				: <strong>目前：{currentStateSummary[order.status] ?? orderStatusLabel(order.status)}</strong>}</div>
			{order.status === 'CANCELLED' ? (
				<div class="cancelled-progress"><span class="timeline-dot"></span><strong>訂單已取消</strong>{cancellationEvent && <time>{formatDateTime(cancellationEvent.createdAt)}</time>}</div>
			) : (
				<ol class="order-progress">{progressSteps.map((step, index) => <li class:list={{ reached: step.reached, current: index === currentProgressIndex, passed: index < currentProgressIndex, pending: !step.reached && index !== currentProgressIndex }} aria-current={index === currentProgressIndex && !step.reached ? 'step' : undefined}><span class="progress-marker" aria-hidden="true">{step.reached ? <i class="fa-solid fa-check"></i> : index === currentProgressIndex ? <span class="progress-dot"></span> : null}</span><strong>{step.label}</strong><time>{step.event ? formatDateTime(step.event.createdAt) : index === currentProgressIndex ? '進行中' : '等待中'}</time></li>)}</ol>
			)}
		</section>


		<section class="panel item-panel">
			<h2>商品明細 <span>{order.items.length} 項</span></h2>
			<div class="order-items-header" aria-hidden="true"><span>商品</span><span>單價</span><span>數量</span><span>總計</span></div>
			<ul class="lines order-lines">
				{order.items.map((item) => <li>
					<span class="order-product">
						<span class="order-thumb" aria-hidden="true">{item.imageUrl ? <img src={orderThumbUrl(item.imageUrl)} alt="" loading="lazy" decoding="async" /> : <i class="fa-solid fa-fish"></i>}</span>
						<span class="order-product__text"><span class="order-product__name">{item.productName}</span>
							{item.skuName?.trim() && item.skuName.trim() !== item.productName.trim() && <small>規格：{item.skuName}</small>}
							{!item.skuName?.trim() && <small>規格：未記錄</small>}
						</span>
					</span>
					<span class="order-unit-price" aria-label="單價">{dollars(item.unitPrice)}</span>
					<span class="order-quantity" aria-label="數量">{item.quantity}</span>
					<span class="order-calc">{dollars(item.unitPrice)} × <b>{item.quantity}</b></span>
					<strong class="order-line-total" aria-label="總計">{dollars(item.subtotal)}</strong>
				</li>)}
			</ul>
			<dl class="totals">
				<div>
					<dt>小計</dt>
					<dd>{dollars(order.subtotal)}</dd>
				</div>
				<div>
					<dt>運費</dt>
					<dd>{dollars(order.shippingFee)}</dd>
				</div>
				<div class="grand">
					<dt>總計</dt>
					<dd>{formatTwd(order.total)}</dd>
				</div>
			</dl>
		</section>
		</div>
		<aside class="od-side">
		<section class={`panel next-panel next--${nextTone}`}>
			<div class="next-panel__head">
				<span class="next-panel__eyebrow">下一步</span>
				<strong>{nextStepTitle}</strong>
			</div>
			<dl class="next-facts">
				<div><dt>應付金額</dt><dd class="next-facts__amount">{formatTwd(order.total)}</dd></div>
				{submissions[0] && <div><dt>轉帳末五碼</dt><dd class="mono next-facts__code">{submissions[0].bankLastFive}</dd></div>}
			</dl>
			<div class:list={['actions-bar', { 'has-actions': canConfirm || canShip || canComplete || canCancel }]}>
				{canConfirm && submissions[0] && <p class="actions-bar__info">末五碼 <strong class="mono">{submissions[0].bankLastFive}</strong>・應付 <strong>{formatTwd(order.total)}</strong></p>}
				{canConfirm && <form method="post" data-confirm={`確認已收到 ${formatTwd(order.total)} 的款項？${submissions[0] ? `\n末五碼：${submissions[0].bankLastFive}` : ''}\n確認後訂單會進入備貨中。`}><input type="hidden" name="_action" value="confirm_payment" />{submissions[0] && <input type="hidden" name="submissionId" value={submissions[0].id} />}<button type="submit" class="btn-payment">確認付款</button></form>}
				{canShip && <form method="post" data-confirm={`確認訂單 ${order.orderNumber} 已出貨？\n確認後會扣除庫存，並寄出貨通知信給顧客。`}><input type="hidden" name="_action" value="mark_shipped" /><button type="submit" class="btn-shipping">標記出貨</button></form>}
				{canComplete && <form method="post" data-confirm={`確認訂單 ${order.orderNumber} 已送達並完成？`}><input type="hidden" name="_action" value="complete" /><button type="submit" class="btn-complete">完成訂單</button></form>}
				{canCancel && <form method="post" data-confirm={`確定取消訂單 ${order.orderNumber}？
	取消後會釋放預留庫存。`} data-confirm-danger><input type="hidden" name="_action" value="cancel" /><button type="submit" class="btn-danger">取消訂單</button></form>}
			</div>
		</section>

		<section class="panel delivery-panel">
			<div class="section-heading"><h2>收件資訊</h2><button class="copy-address" type="button" data-copy={copyAddress}><i class="fa-regular fa-copy" aria-hidden="true"></i>複製資訊</button></div>
			<div class="address-details"><strong>{addr.recipientName}</strong><a class="tel-link" href={`tel:${addr.phone.replace(/[^\d+]/g, '')}`}><i class="fa-solid fa-phone" aria-hidden="true"></i>{addr.phone}</a>{addr.shippingMethodName && <span>配送方式：{addr.shippingMethodName}</span>}<span>{addr.postalCode} {addr.city}{addr.district}{addr.addressLine}</span>{order.note && <span class="order-note"><b>備註</b><span>{order.note}</span></span>}</div>
		</section>

		<section class="panel payment-panel">
			<div class="section-heading payment-heading"><h2>付款／末五碼</h2>{paymentHeadingStatus && <span class:list={['badge', { ok: payment?.status === 'PAID' }]}>{paymentHeadingStatus}</span>}</div>
			{
				payment ? (
					<div class="payment-summary">
						<p>{payment.method === 'BANK_TRANSFER' ? '銀行轉帳' : payment.method}<strong>{formatTwd(payment.amount)}</strong></p>
						{payment.paidAt && <small class="muted" title={formatDateTime(payment.paidAt)}>核對 {compactPaymentTime(payment.paidAt)}</small>}
					</div>
				) : (
					<p class="muted">無付款紀錄</p>
				)
			}
			{primarySubmission ? (
				<div class="payment-reference">
					<span>末五碼 <strong class="mono">{primarySubmission.bankLastFive}</strong></span>
					{primarySubmission.amount !== payment?.amount && <span>回報金額 {formatTwd(primarySubmission.amount)}</span>}
					{!payment?.paidAt && <time class="muted" datetime={primarySubmission.submittedAt.toISOString()} title={formatDateTime(primarySubmission.submittedAt)}>回報 {compactPaymentTime(primarySubmission.submittedAt)}</time>}
				</div>
			) : <p class="muted">顧客尚未回報末五碼</p>}
			{previousSubmissions.length > 0 && <details class="payment-history">
				<summary>其他回報紀錄（{previousSubmissions.length}）</summary>
				<ul class="subs">{previousSubmissions.map((submission) => <li>
					<span class="mono">{submission.bankLastFive}</span><span>{formatTwd(submission.amount)}</span>
					<time class="muted" datetime={submission.submittedAt.toISOString()} title={formatDateTime(submission.submittedAt)}>{compactPaymentTime(submission.submittedAt)}</time>
					<span class:list={['badge', { ok: Boolean(submission.verifiedAt) }]}>{submission.verifiedAt ? '已核對' : '待核對'}</span>
				</li>)}</ul>
			</details>}
		</section>

		</aside>
	</div>
</AdminLayout>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>('.copy-address');
	copyButton?.addEventListener('click', async () => {
		const originalText = '複製資訊';
		try {
			await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
			copyButton.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>已複製';
			window.setTimeout(() => { copyButton.innerHTML = '<i class="fa-regular fa-copy" aria-hidden="true"></i>' + originalText; }, 1800);
		} catch {
			copyButton.textContent = '複製失敗，請手動複製';
		}
	});
</script>

<style>
	.heading-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
	.order-date { display: inline-flex; align-items: center; gap: 8px; color: var(--commerce-muted); font-size: 11px; white-space: nowrap; }
	.crumb { margin-bottom: 18px; }
	.crumb a { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid var(--commerce-line); border-radius: 8px; background: #fff; color: #526b70; font-size: 10px; font-weight: 650; text-decoration: none; }
	.meta { display: flex; align-items: center; gap: 5px; margin: 14px 0 0; color: #60757a; font-size: 11px; }
	.meta span { color: #829295; }
	.head {
		margin-bottom: 1rem;
	}

	.crumb {
		margin: 0 0 0.35rem;
		font-size: 0.9rem;
		color: var(--aq-muted);
	}

	.crumb a {
		color: var(--aq-primary);
		text-decoration: none;
	}

	h1 {
		margin: 0;
		font-size: 1.45rem;
	}

	.lead,
	.meta,
	.muted {
		color: var(--aq-muted);
		font-size: 0.92rem;
	}

	.banner {
		padding: 0.7rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 0.85rem;
	}

	.banner.ok {
		background: var(--aq-primary-soft);
		color: var(--aq-primary-dark);
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.actions-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 18px 0 16px;
	}
	.order-progress { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0 0 19px; padding: 15px 18px; border: 1px solid var(--commerce-line); border-radius: 14px; background: #fff; list-style: none; }
	.order-progress { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0; padding: 8px 0 0; list-style: none; }
	.order-progress li { position: relative; display: grid; grid-template-columns: minmax(0,1fr); grid-template-rows: 30px auto auto; justify-items: center; align-items: start; row-gap: 4px; color: #9ba8a8; font-size: 13px; text-align: center; }
	.order-progress li:not(:last-child)::after { position: absolute; z-index: 0; top: 13px; left: calc(50% + 15px); right: calc(-50% + 15px); height: 2px; background: #e6ecea; content: ''; }
	.progress-marker { z-index: 1; width: 26px; height: 26px; display: grid; place-items: center; grid-row: 1; border: 1px solid #e2e9e7; border-radius: 50%; background: #fff; color: #96a4a5; font-size: 11px; }
	.order-progress li strong { grid-column: 1; grid-row: 2; font-weight: 650; }
	.order-progress li time { grid-column: 1; grid-row: 3; min-height: 18px; color: #829294; font-size: 12px; white-space: nowrap; }
	.order-progress li.reached .progress-marker,.order-progress li.current .progress-marker { border-color: var(--commerce-primary); background: var(--commerce-primary); color: #fff; }
	.order-progress li.reached strong,.order-progress li.current strong { color: var(--commerce-primary-dark); }
	.order-progress li.passed:not(:last-child)::after { background: #9fd0c5; }
	/* 統一三種狀態：已完成＝實心打勾、進行中＝空心圈＋圓點、未開始＝淺灰空心圈 */
