---
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import OrderList from '../../../../../components/admin/OrderList.astro';
import { cancelExpiredUnpaidOrders } from '../../../../../lib/services/admin-orders';
import {
	getAdminBasePath,
	isValidAdminSecretParam,
} from '../../../../../lib/admin/path';
import {
	getAdminOrderStatusCounts,
	listAdminOrders,
} from '../../../../../lib/services/admin-orders';
import { formatTwd } from '../../../../../lib/services/catalog';
import {
	orderStatusLabel,
	paymentStatusLabel,
} from '../../../../../lib/services/order';
import { shippingStatusLabel } from '../../../../../lib/services/order-management';

export const prerender = false;

if (!isValidAdminSecretParam(Astro.params.adminSecret)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

// 逾期（建立超過 3 天）仍未付款的訂單自動取消並釋放預留庫存；夥伴打開後台時順便檢查
await cancelExpiredUnpaidOrders().catch((error) => console.error('[expire-orders]', error));

const base = getAdminBasePath();
const params = Astro.url.searchParams;
const statusOptions = new Set(['PAYMENT_REVIEW', 'AWAITING_SHIPMENT', 'PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'PROCESSING', 'SHIPPED', 'COMPLETED', 'CANCELLED']);
const sortOptions = new Set(['newest', 'oldest', 'amount_desc', 'amount_asc', 'customer']);
const rawStatus = params.get('status')?.trim() ?? '';
const status = statusOptions.has(rawStatus) ? rawStatus : undefined;
const memberUserId = Astro.url.searchParams.get('userId')?.trim() || undefined;
const query = params.get('q')?.trim() ?? '';
const rawSort = params.get('sort')?.trim() ?? '';
const sort = sortOptions.has(rawSort) ? rawSort : 'newest';
const datePattern = /^\d{4}-\d{2}-\d{2}$/;
const parseDateStart = (value: string | null) => {
	if (!value || !datePattern.test(value)) return undefined;
	const [year, month, day] = value.split('-').map(Number);
	const calendarDate = new Date(Date.UTC(year, month - 1, day));
	if (calendarDate.getUTCFullYear() !== year || calendarDate.getUTCMonth() !== month - 1 || calendarDate.getUTCDate() !== day) return undefined;
	const parsed = new Date(`${value}T00:00:00+08:00`);
	return Number.isNaN(parsed.getTime()) ? undefined : parsed;
};
const dateFrom = params.get('dateFrom')?.trim() ?? '';
const dateTo = params.get('dateTo')?.trim() ?? '';
const createdAfter = parseDateStart(dateFrom || null);
const dateToStart = parseDateStart(dateTo || null);
const createdBefore = dateToStart ? new Date(dateToStart.getTime() + 86_400_000) : undefined;
const advancedFiltersOpen = sort !== 'newest' || Boolean(createdAfter || createdBefore);
const filterState = {
	...(memberUserId ? { userId: memberUserId } : {}),
	...(createdAfter ? { dateFrom } : {}),
	...(createdBefore ? { dateTo } : {}),
	...(query ? { q: query } : {}),
	...(sort !== 'newest' ? { sort } : {}),
};
function orderListUrl(nextStatus: string | null = status ?? null) {
	const search = new URLSearchParams({ ...filterState, ...(nextStatus ? { status: nextStatus } : {}) });
	return `${base}/shop/orders${search.size ? `?${search.toString()}` : ''}`;
}
const resetParams = new URLSearchParams(memberUserId ? { userId: memberUserId } : {});
const resetUrl = `${base}/shop/orders${resetParams.size ? `?${resetParams.toString()}` : ''}`;
const statusCounts = await getAdminOrderStatusCounts(memberUserId);
const orderRows = await listAdminOrders({
	status,
	userId: memberUserId,
	createdAfter,
	createdBefore,
	query,
	limit: memberUserId ? 300 : 150,
});
const rows = [...orderRows].sort((a, b) => {
	switch (sort) {
		case 'oldest': return a.createdAt.getTime() - b.createdAt.getTime();
		case 'amount_desc': return b.total - a.total;
		case 'amount_asc': return a.total - b.total;
		case 'customer': return String(a.customerName ?? '').localeCompare(String(b.customerName ?? ''), 'zh-Hant') || b.createdAt.getTime() - a.createdAt.getTime();
		default: return b.createdAt.getTime() - a.createdAt.getTime();
	}
});
/** 目前列表的金額合計（不含已取消） */
const visibleTotal = rows.filter((row) => row.status !== 'CANCELLED').reduce((sum, row) => sum + row.total, 0);
const formatOrderTime = (date: Date) => date.toLocaleString('zh-TW', {
	timeZone: 'Asia/Taipei', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false,
});

const filters = [
	{ value: '', label: '全部', count: statusCounts.all },
	{ value: 'PAYMENT_REVIEW', label: '付款待處理', count: statusCounts.PAYMENT_REVIEW, urgent: true },
	{ value: 'AWAITING_SHIPMENT', label: '待出貨', count: statusCounts.AWAITING_SHIPMENT, urgent: true },
	{ value: 'SHIPPED', label: '已出貨', count: statusCounts.SHIPPED },
	{ value: 'COMPLETED', label: '已完成', count: statusCounts.COMPLETED },
	{ value: 'CANCELLED', label: '已取消', count: statusCounts.CANCELLED },
];
---

<AdminLayout title="訂單管理">
	<header class="ol-head">
		{/* 標題列已移除；保留給螢幕閱讀器的頁面標題 */}
		<h1 class="visually-hidden">{memberUserId ? `${rows[0]?.customerName ?? '會員'}的訂單紀錄` : '訂單管理'}</h1>
		<nav class="ol-tabs" aria-label="依訂單狀態篩選">
			{filters.map((f) => (
				<a href={orderListUrl(f.value || null)} class:list={['ol-tab', { active: (status ?? '') === f.value, urgent: f.urgent && f.count > 0 }]} aria-current={(status ?? '') === f.value ? 'page' : undefined}>
					<span>{f.label}</span><span class="ol-tab__count">{f.count > 999 ? '999+' : f.count}</span>
				</a>
			))}
		</nav>
		<form class="ol-toolbar" method="get" action={`${base}/shop/orders`}>
			{status && <input type="hidden" name="status" value={status} />}
			{memberUserId && <input type="hidden" name="userId" value={memberUserId} />}
			<div class="ol-toolbar__main">
				<label class="ol-search">
					<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
					<span class="visually-hidden">搜尋訂單</span>
					<input type="search" name="q" value={query} placeholder="訂單編號、姓名或 Email" enterkeyhint="search" />
				</label>
				<button class="filter-toggle" type="button" aria-expanded={advancedFiltersOpen ? 'true' : 'false'} aria-controls="order-advanced-filters" title="排序與日期"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span>篩選</span>{advancedFiltersOpen && <span class="ol-dot" aria-label="已套用篩選"></span>}</button>
			</div>
			<div class="ol-advanced" id="order-advanced-filters" hidden={!advancedFiltersOpen}>
				<label class="filter-field"><span>排序</span><select name="sort" value={sort}><option value="newest">最新下單</option><option value="oldest">最早下單</option><option value="amount_desc">金額高到低</option><option value="amount_asc">金額低到高</option><option value="customer">顧客姓名</option></select></label>
				<label class="filter-field"><span>起始日期</span><input type="date" name="dateFrom" value={createdAfter ? dateFrom : ''} /></label>
				<label class="filter-field"><span>結束日期</span><input type="date" name="dateTo" value={createdBefore ? dateTo : ''} /></label>
				<a class="filter-reset" href={resetUrl}>清除</a>
			</div>
		</form>
	</header>

	{
		rows.length === 0 ? (
			<div class="empty"><i class="fa-regular fa-clipboard" aria-hidden="true"></i><strong>沒有符合條件的訂單</strong><span>{query ? '試試其他訂單編號或顧客資料。' : '符合此狀態的新訂單會顯示在這裡。'}</span></div>
		) : (
			<OrderList rows={rows} base={base} paginate />
		)
	}
</AdminLayout>

<style>
	.visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

	/* ── 標題與摘要 ── */
	.ol-head { display: grid; gap: 14px; margin-bottom: 16px; }
	.ol-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
	.ol-title h1 { margin: 0; font-size: 24px; }
	.ol-summary { margin: 0; color: var(--commerce-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
	.ol-summary strong { color: var(--commerce-ink); }

	/* ── 狀態分頁：一列可橫滑，需處理的狀態有數字時變醒目 ── */
	.ol-tabs { display: flex; gap: 6px; overflow-x: auto; padding: 2px 2px 4px; margin: 0 -2px; scrollbar-width: none; }
	.ol-tabs::-webkit-scrollbar { display: none; }
	.ol-tab { display: inline-flex; flex: none; align-items: center; gap: 7px; min-height: 38px; padding: 0 12px 0 14px; border: 1px solid var(--commerce-line); border-radius: 999px; background: #fff; color: #5d7074; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; transition: background-color .15s ease, border-color .15s ease, color .15s ease; }
	.ol-tab:hover { border-color: #b9d6cf; color: var(--commerce-primary-dark); }
	.ol-tab__count { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 999px; background: #eef3f1; color: #687b7e; font-size: 11px; font-weight: 800; font-variant-numeric: tabular-nums; }
	.ol-tab.urgent .ol-tab__count { background: #d64535; color: #fff; }
	.ol-tab.active { border-color: var(--commerce-primary); background: var(--commerce-primary); color: #fff; }
	.ol-tab.active .ol-tab__count { background: rgba(255, 255, 255, .22); color: #fff; }

	/* ── 搜尋與篩選 ── */
	.ol-toolbar { display: grid; gap: 10px; }
	.ol-toolbar__main { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
	.ol-search { position: relative; display: block; min-width: 0; }
	.ol-search > i { position: absolute; top: 50%; left: 14px; color: #93a5a6; font-size: 14px; transform: translateY(-50%); pointer-events: none; }
	.ol-search input { width: 100%; height: 44px; box-sizing: border-box; padding: 0 14px 0 40px; border: 1px solid var(--commerce-line); border-radius: 12px; background: #fff; color: var(--commerce-ink); font: inherit; font-size: 14px; }
	.ol-search input:focus, .filter-field input:focus, .filter-field select:focus { outline: none; border-color: var(--commerce-primary); box-shadow: 0 0 0 3px rgba(8, 126, 120, .12); }
	.filter-toggle { position: relative; display: inline-flex; align-items: center; gap: 7px; height: 44px; padding: 0 14px; border: 1px solid var(--commerce-line); border-radius: 12px; background: #fff; color: #4f6569; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
	.filter-toggle[aria-expanded="true"] { border-color: var(--commerce-primary); color: var(--commerce-primary-dark); background: var(--commerce-primary-soft); }
	.ol-dot { position: absolute; top: 8px; right: 8px; width: 7px; height: 7px; border-radius: 50%; background: #d64535; }
	.ol-advanced { display: grid; grid-template-columns: 1.3fr 1fr 1fr auto; gap: 10px; align-items: end; padding: 12px; border: 1px solid var(--commerce-line); border-radius: 12px; background: #fff; }
	.ol-advanced[hidden] { display: none; }
	.filter-field { display: grid; gap: 5px; min-width: 0; color: #687b7e; font-size: 12px; font-weight: 700; }
	.filter-field input, .filter-field select { width: 100%; height: 40px; box-sizing: border-box; padding: 0 10px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; color: var(--commerce-ink); font: inherit; font-size: 13px; }
	.filter-reset { display: inline-flex; align-items: center; justify-content: center; height: 40px; padding: 0 14px; border-radius: 9px; color: #607579; font-size: 13px; font-weight: 700; text-decoration: none; }
	.filter-reset:hover { background: #f2f5f4; }

	/* ── 空狀態 ── */
	.empty { display: grid; justify-items: center; gap: 7px; padding: 48px 16px; border: 1px dashed var(--commerce-line); border-radius: 14px; background: #fff; color: var(--commerce-muted); text-align: center; }
	.empty i { color: #9db8b3; font-size: 26px; }
	.empty strong { color: #41575e; font-size: 15px; }
	.empty span { font-size: 13px; }


	@media (max-width: 700px) {
		.ol-title h1 { font-size: 20px; }
		.ol-tab { min-height: 36px; padding: 0 10px 0 12px; font-size: 12px; }
		.ol-advanced { grid-template-columns: 1fr 1fr; }
		.ol-advanced .filter-field:first-child { grid-column: span 2; }
		.ol-advanced .filter-reset { grid-column: span 2; border: 1px solid var(--commerce-line); }
		.filter-toggle span:not(.ol-dot) { display: none; }
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
	const advancedFilters = document.querySelector<HTMLDivElement>('#order-advanced-filters');
	toggle?.addEventListener('click', () => {
		if (!advancedFilters) return;
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!isOpen));
		advancedFilters.hidden = isOpen;
	});
	advancedFilters?.querySelectorAll<HTMLSelectElement | HTMLInputElement>('[name="sort"], [name="dateFrom"], [name="dateTo"]').forEach((field) => {
		field.addEventListener('change', () => field.form?.requestSubmit());
	});
	// 選中的狀態分頁捲到可見位置（手機一列橫滑時）
	document.querySelector('.ol-tab.active')?.scrollIntoView({ block: 'nearest', inline: 'center' });

	// 手機一次顯示 10 筆，按「顯示更多」再載入
	const orderRows = Array.from(document.querySelectorAll<HTMLElement>('[data-order-row]'));
	const loadMoreButton = document.querySelector<HTMLButtonElement>('.load-more-orders');
	let visibleOrderCount = 10;
	const updateVisibleOrders = () => {
		const isMobile = window.matchMedia('(max-width: 700px)').matches;
		orderRows.forEach((row, index) => row.classList.toggle('is-order-hidden', isMobile && index >= visibleOrderCount));
		if (loadMoreButton) loadMoreButton.hidden = !isMobile || orderRows.length <= visibleOrderCount;
	};
	loadMoreButton?.addEventListener('click', () => {
		visibleOrderCount = Math.min(visibleOrderCount + 10, orderRows.length);
		updateVisibleOrders();
	});
	window.addEventListener('resize', updateVisibleOrders);
	updateVisibleOrders();
</script>
