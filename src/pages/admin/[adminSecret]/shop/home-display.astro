---
/**
 * 首頁陳列：管理首頁「主打」（最多 3 筆，最近開啟者優先）與「熱銷推薦」（依排序顯示前 8 筆）。
 * 讀取 Sanity（不走 CDN，存檔後立即看到最新）；寫入透過 /api/admin/sanity-dashboard（需管理員登入）。
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { isValidAdminSecretParam } from '../../../../lib/admin/path';
import { getSanityClient } from '../../../../lib/sanity/client';
import { PROMO_TABS } from '../../../../lib/promoTabs';
import { getAnnouncementBar, MAX_ANNOUNCEMENTS } from '../../../../lib/services/announcement';
import { getHeroSlides, heroImageUrl, MAX_HERO_SLIDES } from '../../../../lib/services/hero-slides';

export const prerender = false;

if (!isValidAdminSecretParam(Astro.params.adminSecret)) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

Astro.response.headers.set('Cache-Control', 'private, no-store');

type DisplayProduct = {
	_id: string;
	name: string;
	slug: string | null;
	imageUrl: string | null;
	categoryLabel: string | null;
	enabled: boolean | null;
	featured: boolean | null;
	featuredSortOrder: number | null;
	heroSpotlight: boolean | null;
	heroSpotlightActivatedAt: string | null;
};

const HOME_FEATURED_LIMIT = 8;
const HOME_SPOTLIGHT_LIMIT = 3;

let products: DisplayProduct[] = [];
let loadError = '';
try {
	products = await getSanityClient()
		.withConfig({ useCdn: false })
		.fetch<DisplayProduct[]>(`*[_type == "product" && defined(slug.current)] | order(name asc) {
			_id,
			name,
			"slug": slug.current,
			"imageUrl": coalesce(image.asset->url, gallery[0].asset->url),
			"categoryLabel": category->name,
			enabled,
			featured,
			featuredSortOrder,
			heroSpotlight,
			heroSpotlightActivatedAt
		}`);
} catch (error) {
	console.error('[home-display] Sanity load failed', error);
	loadError = '暫時無法讀取商品資料，請稍後重新整理。';
}

const featured = products
	.filter((p) => p.featured)
	.sort((a, b) => {
		const aHas = a.featuredSortOrder != null;
		const bHas = b.featuredSortOrder != null;
		if (aHas !== bHas) return aHas ? -1 : 1;
		return (a.featuredSortOrder ?? 0) - (b.featuredSortOrder ?? 0) || a.name.localeCompare(b.name, 'zh-Hant');
	});
const spotlight = products
	.filter((p) => p.heroSpotlight)
	.sort((a, b) => (b.heroSpotlightActivatedAt ?? '').localeCompare(a.heroSpotlightActivatedAt ?? ''));
const toCandidate = (p: DisplayProduct) => ({ id: p._id, name: p.name, categoryLabel: p.categoryLabel });
const candidates = {
	featured: products.filter((p) => !p.featured && p.enabled !== false).map(toCandidate),
	spotlight: products.filter((p) => !p.heroSpotlight && p.enabled !== false).map(toCandidate),
};
// 促銷分頁開關：沒設定過 enabled 視為開啟
let promoDocs: { _id: string; enabled: boolean | null }[] = [];
try {
	promoDocs = await getSanityClient()
		.withConfig({ useCdn: false })
		.fetch(`*[_type == "promotion" && _id in $ids]{ _id, enabled }`, { ids: PROMO_TABS.map((tab) => tab.id) });
} catch (error) {
	console.error('[home-display] promotion load failed', error);
}
const promoRows = PROMO_TABS.map((tab) => {
	const doc = promoDocs.find((item) => item._id === tab.id);
	return { ...tab, exists: Boolean(doc), enabled: doc ? doc.enabled !== false : false };
});
const announcement = await getAnnouncementBar();
const heroSlides = await getHeroSlides();
const thumb = (url: string | null) => (url ? `${url}?w=96&h=96&fit=crop&auto=format` : null);
---

<AdminLayout title="首頁陳列｜水博館水族官方網站後台">
	<header class="display-head">
		<div>
			<h1>首頁陳列</h1>
		</div>
		<a class="preview-link" href="/" target="_blank" rel="noopener">查看首頁 <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
	</header>

	<nav class="display-nav" aria-label="首頁陳列區塊">
		<a href="#announce-section"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i>公告條</a>
		<a href="#hero-section"><i class="fa-regular fa-images" aria-hidden="true"></i>主圖輪播</a>
		<a href="#promo-section"><i class="fa-solid fa-tags" aria-hidden="true"></i>促銷分頁</a>
		<a href="#spotlight-section"><i class="fa-solid fa-star" aria-hidden="true"></i>主打商品</a>
		<a href="#featured-section"><i class="fa-solid fa-fire" aria-hidden="true"></i>熱銷推薦</a>
	</nav>

	{loadError && <p class="display-notice is-error" role="alert">{loadError}</p>}
	<p class="display-notice" data-status role="status" hidden></p>

	<section id="announce-section" class="display-card" aria-labelledby="announce-heading" data-announce-editor data-max={MAX_ANNOUNCEMENTS}>
		<header class="display-card__head">
			<div>
				<h2 id="announce-heading">頂部公告條</h2>
				<p>網站最上方輪播的短訊息，每 4 秒換一則。手機約可完整顯示 22 個字，太長會自動往左滑。儲存後約 15 秒內生效。</p>
			</div>
		</header>
		<ul class="toggle-list">
			<li class="toggle-row">
				<span class="row-text"><strong>顯示公告條</strong><small>關閉後全站都不顯示</small></span>
				<label class="switch"><input type="checkbox" role="switch" data-announce-enabled checked={announcement.enabled} aria-label="顯示公告條" /><span class="switch__track" aria-hidden="true"></span></label>
			</li>
			<li class="toggle-row">
				<span class="row-text"><strong>只在首頁顯示</strong><small>關閉時全站每一頁都顯示</small></span>
				<label class="switch"><input type="checkbox" role="switch" data-announce-home checked={announcement.homeOnly} aria-label="只在首頁顯示" /><span class="switch__track" aria-hidden="true"></span></label>
			</li>
		</ul>
		<ol class="announce-list" data-announce-list>
			{announcement.items.map((item) => (
				<li class="announce-row">
					<div class="announce-row__fields">
						<label class="announce-field announce-field--badge"><span>醒目標籤</span><input data-field="badge" maxlength="8" value={item.badge} placeholder="例如：限時優惠" /></label>
						<label class="announce-field announce-field--text"><span>訊息內容 <em data-count></em></span><input data-field="text" maxlength="60" value={item.text} placeholder="例如：🚚 全館滿 $1,200 免運" /></label>
						<label class="announce-field announce-field--href"><span>點擊前往（選填）</span><input data-field="href" maxlength="200" value={item.href} placeholder="/promo/weekly-new" /></label>
					</div>
					<div class="announce-row__tools">
						<button type="button" data-move="-1" aria-label="往上移"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
						<button type="button" data-move="1" aria-label="往下移"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
						<button type="button" data-remove aria-label="刪除這則" class="is-danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
					</div>
				</li>
			))}
		</ol>
		<div class="announce-actions">
			<button type="button" class="announce-add" data-announce-add><i class="fa-solid fa-plus" aria-hidden="true"></i>新增一則</button>
			<button type="button" class="announce-save" data-announce-save><i class="fa-solid fa-check" aria-hidden="true"></i>儲存公告條</button>
		</div>
	</section>

	<section id="hero-section" class="display-card" aria-labelledby="hero-heading" data-hero-editor data-max={MAX_HERO_SLIDES}>
		<header class="display-card__head">
			<div>
				<h2 id="hero-heading">主圖輪播</h2>
				<p>首頁最上方的大圖。建議橫式 1920×1080 以上，主體放中間（手機會裁切左右）。上傳時會自動壓縮。儲存後約 15 秒內生效。</p>
			</div>
			<span class="count-pill" data-hero-count></span>
		</header>
		<ol class="hero-list" data-hero-list>
			{heroSlides.map((slide) => (
				<li class="hero-row" data-slide-id={slide.id} data-image={slide.image}>
					<div class="hero-row__media">
						<img src={heroImageUrl(slide.image, 640)} alt="" loading="lazy" data-hero-preview />
						<span class="hero-row__badge" data-hero-order></span>
						<label class="hero-row__upload"><input type="file" accept="image/jpeg,image/png,image/webp" data-hero-file hidden /><i class="fa-solid fa-camera" aria-hidden="true"></i><span>更換圖片</span></label>
					</div>
					<div class="hero-row__fields">
						<label class="announce-field"><span>標題 <em data-count-of="40"></em></span><input data-field="title" maxlength="40" value={slide.title} placeholder="例如：水博館水族｜淡水魚水族販售" /></label>
						<label class="announce-field"><span>副標（選填） <em data-count-of="80"></em></span><input data-field="subtitle" maxlength="80" value={slide.subtitle} placeholder="一句話介紹" /></label>
						<label class="announce-field"><span>「了解更多」連結（選填）</span><input data-field="href" maxlength="200" value={slide.href} placeholder="/promo/weekly-new" /></label>
					</div>
					<div class="hero-row__side">
						<label class="switch" title="在首頁顯示"><input type="checkbox" role="switch" data-field="enabled" checked={slide.enabled} aria-label="在首頁顯示這張" /><span class="switch__track" aria-hidden="true"></span></label>
						<div class="announce-row__tools">
							<button type="button" data-move="-1" aria-label="往前移"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
							<button type="button" data-move="1" aria-label="往後移"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
							<button type="button" data-remove aria-label="刪除這張" class="is-danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
						</div>
					</div>
				</li>
			))}
		</ol>
		<div class="announce-actions">
			<label class="announce-add" data-hero-add><input type="file" accept="image/jpeg,image/png,image/webp" data-hero-new hidden /><i class="fa-solid fa-plus" aria-hidden="true"></i>新增輪播圖</label>
			<button type="button" class="announce-save" data-hero-save><i class="fa-solid fa-check" aria-hidden="true"></i>儲存輪播圖</button>
		</div>
	</section>

	<section id="promo-section" class="display-card" aria-labelledby="promo-tabs-heading">
		<header class="display-card__head">
			<div>
				<h2 id="promo-tabs-heading">促銷分頁</h2>
				<p>關閉後前台導覽與首頁入口都不顯示，網址會導回首頁。切換後約 15 秒內生效。</p>
			</div>
			<span class="count-pill" data-promo-count>{promoRows.filter((row) => row.enabled).length} 個開啟</span>
		</header>
		<ul class="toggle-list">
			{promoRows.map((row) => (
				<li class="toggle-row">
					<span class="row-text">
						<strong>{row.label}</strong>
						<small data-promo-state>{!row.exists ? '尚未建立內容，請先到商品管理的促銷分頁編輯' : row.enabled ? '前台顯示中' : '已隱藏'}</small>
					</span>
					<label class="switch">
						<input type="checkbox" role="switch" data-promo-toggle={row.id} data-label={row.label} checked={row.enabled} disabled={!row.exists} aria-label={`${row.label}在前台顯示`} />
						<span class="switch__track" aria-hidden="true"></span>
					</label>
				</li>
			))}
		</ul>
	</section>

	<section id="spotlight-section" class="display-card" aria-labelledby="spotlight-heading">
		<header class="display-card__head">
			<div>
				<h2 id="spotlight-heading">主打商品</h2>
				<p>顯示 {HOME_SPOTLIGHT_LIMIT} 筆。新加入的會排第一，超過 3 筆時最舊的不顯示。</p>
			</div>
			<span class="count-pill">{spotlight.length} 筆</span>
		</header>
		{spotlight.length === 0 ? (
			<p class="empty-line">目前沒有主打商品。</p>
		) : (
			<ol class="sort-list">
				{spotlight.map((p, i) => (
					<li class="sort-row sort-row--static">
						<span class="rank">{i + 1}</span>
						{thumb(p.imageUrl) ? <img class="thumb" src={thumb(p.imageUrl)!} alt="" width="48" height="48" loading="lazy" /> : <span class="thumb thumb--empty"><i class="fa-solid fa-fish" aria-hidden="true"></i></span>}
						<span class="row-text">
							<strong>{p.name}</strong>
							<small>{i < HOME_SPOTLIGHT_LIMIT ? '首頁顯示中' : '超過 3 筆，首頁不顯示'}</small>
						</span>
						<span class="row-actions">
							<button type="button" class="text-btn" data-remove-spotlight={p._id}>取消主打</button>
						</span>
					</li>
				))}
			</ol>
		)}

		<div class="add-box">
			<label for="spotlightSearch">加入主打</label>
			<input id="spotlightSearch" type="search" placeholder="輸入商品名稱搜尋" autocomplete="off" data-search="spotlight" />
			<ul class="search-results" data-results="spotlight"></ul>
		</div>
	</section>

	<section id="featured-section" class="display-card" aria-labelledby="featured-heading">
		<header class="display-card__head">
			<div>
				<h2 id="featured-heading">熱銷推薦</h2>
				<p>顯示 {HOME_FEATURED_LIMIT} 筆。</p>
			</div>
			<span class="count-pill">{featured.length} 筆</span>
		</header>

		{featured.length === 0 ? (
			<p class="empty-line">目前沒有熱銷商品，用下方搜尋加入。</p>
		) : (
			<ol class="sort-list" data-sort-list>
				{featured.map((p, i) => (
					<li class="sort-row" data-id={p._id}>
						<button type="button" class="drag-handle" data-drag aria-label={`拖曳調整「${p.name}」順序`}><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
						<span class="rank" data-rank>{i + 1}</span>
						{thumb(p.imageUrl) ? <img class="thumb" src={thumb(p.imageUrl)!} alt="" width="48" height="48" loading="lazy" /> : <span class="thumb thumb--empty"><i class="fa-solid fa-fish" aria-hidden="true"></i></span>}
						<span class="row-text">
							<strong>{p.name}</strong>
							<small>{p.categoryLabel ?? '未分類'}{p.enabled === false ? '・已下架（首頁不顯示）' : ''}</small>
						</span>
						<span class="home-badge" data-home-badge>首頁</span>
						<span class="row-actions">
							<button type="button" class="icon-btn" data-move="-1" aria-label={`「${p.name}」往前`}><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
							<button type="button" class="icon-btn" data-move="1" aria-label={`「${p.name}」往後`}><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
							<button type="button" class="text-btn" data-remove-featured={p._id}>取消熱銷</button>
						</span>
					</li>
				))}
			</ol>
		)}

		<div class="card-actions">
			<button type="button" class="primary-btn" data-save-order disabled>儲存排序</button>
			<span class="dirty-hint" data-dirty-hint hidden>排序已變更，尚未儲存</span>
		</div>

		<div class="add-box">
			<label for="featuredSearch">加入熱銷</label>
			<input id="featuredSearch" type="search" placeholder="輸入商品名稱搜尋" autocomplete="off" data-search="featured" />
			<ul class="search-results" data-results="featured"></ul>
		</div>
	</section>


	<script type="application/json" id="displayCandidates" set:html={JSON.stringify(candidates)} />
</AdminLayout>

<script>
	import { askConfirm } from '../../../../scripts/confirmSheet';
	import { compressImage } from '../../../../scripts/compressImage';

	type Candidate = { id: string; name: string; categoryLabel: string | null };
	const HOME_LIMIT = 8;
	const list = document.querySelector<HTMLOListElement>('[data-sort-list]');
	const saveBtn = document.querySelector<HTMLButtonElement>('[data-save-order]');
	const dirtyHint = document.querySelector<HTMLElement>('[data-dirty-hint]');
	const statusBox = document.querySelector<HTMLElement>('[data-status]');
	let dirty = false;

	// 主圖輪播：換圖會先壓縮再上傳，編輯完按「儲存輪播圖」
	const heroEditor = document.querySelector<HTMLElement>('[data-hero-editor]');
	if (heroEditor) {
		const heroList = heroEditor.querySelector<HTMLOListElement>('[data-hero-list]')!;
		const heroMax = Number(heroEditor.dataset.max || 8);
		const heroCount = heroEditor.querySelector<HTMLElement>('[data-hero-count]');
		const addLabel = heroEditor.querySelector<HTMLElement>('[data-hero-add]')!;
		const heroTemplate = heroList.querySelector<HTMLLIElement>('.hero-row')?.cloneNode(true) as HTMLLIElement | undefined;
		const preview = (src: string) => (src.startsWith('https://cdn.sanity.io/') ? `${src}?w=640&auto=format` : src);
		const refreshHero = () => {
			const rows = Array.from(heroList.children) as HTMLElement[];
			let shown = 0;
			rows.forEach((row, i) => {
				const on = row.querySelector<HTMLInputElement>('[data-field="enabled"]')?.checked;
				if (on) shown += 1;
				row.classList.toggle('is-off', !on);
				const order = row.querySelector<HTMLElement>('[data-hero-order]');
				if (order) order.textContent = on ? `第 ${shown} 張` : '已隱藏';
				row.querySelectorAll<HTMLElement>('[data-count-of]').forEach((em) => {
					const input = em.closest('label')?.querySelector('input');
					if (input) em.textContent = `${Array.from(input.value).length}/${em.dataset.countOf}`;
				});
				(row.querySelector('[data-move="-1"]') as HTMLButtonElement).disabled = i === 0;
				(row.querySelector('[data-move="1"]') as HTMLButtonElement).disabled = i === rows.length - 1;
			});
			if (heroCount) heroCount.textContent = `${shown} 張顯示中`;
			addLabel.classList.toggle('is-disabled', rows.length >= heroMax);
		};
		const uploadImage = async (file: File) => {
			showStatus('壓縮並上傳圖片中…');
			const ready = await compressImage(file);
			const fd = new FormData();
			fd.append('files', ready, ready.name);
			const response = await fetch('/api/admin/sanity-upload', { method: 'POST', body: fd });
			const payload = await response.json().catch(() => null);
			if (!response.ok || !payload?.[0]?.url) throw new Error(payload?.error?.message || '圖片上傳失敗');
			showStatus('圖片已上傳，記得按「儲存輪播圖」。');
			return String(payload[0].url).split('?')[0];
		};
		const setImage = (row: HTMLElement, src: string) => {
			row.dataset.image = src;
			const img = row.querySelector<HTMLImageElement>('[data-hero-preview]');
			if (img) img.src = preview(src);
		};
		heroList.addEventListener('input', refreshHero);
		heroList.addEventListener('change', async (event) => {
			const input = event.target as HTMLInputElement;
			if (input.matches('[data-hero-file]') && input.files?.[0]) {
				const row = input.closest<HTMLElement>('.hero-row')!;
				row.classList.add('is-uploading');
				try { setImage(row, await uploadImage(input.files[0])); }
				catch (error) { showStatus(error instanceof Error ? error.message : '圖片上傳失敗', true); }
				finally { row.classList.remove('is-uploading'); input.value = ''; }
			}
			refreshHero();
		});
		heroList.addEventListener('click', async (event) => {
			const button = (event.target as HTMLElement).closest('button');
			const row = button?.closest<HTMLElement>('.hero-row');
			if (!button || !row) return;
			if (button.hasAttribute('data-remove')) {
				if (!(await askConfirm('刪除這張輪播圖？按「儲存輪播圖」後才會生效。', { okLabel: '刪除', danger: true }))) return;
				row.remove();
			} else if (button.dataset.move === '-1' && row.previousElementSibling) {
				heroList.insertBefore(row, row.previousElementSibling);
			} else if (button.dataset.move === '1' && row.nextElementSibling) {
				heroList.insertBefore(row.nextElementSibling, row);
			}
			refreshHero();
		});
		heroEditor.querySelector<HTMLInputElement>('[data-hero-new]')?.addEventListener('change', async (event) => {
			const input = event.target as HTMLInputElement;
			const file = input.files?.[0];
			input.value = '';
			if (!file || heroList.children.length >= heroMax || !heroTemplate) return;
			const row = heroTemplate.cloneNode(true) as HTMLLIElement;
			row.dataset.slideId = `slide-${Date.now()}`;
			row.querySelectorAll<HTMLInputElement>('input[data-field]').forEach((field) => { if (field.type === 'checkbox') field.checked = true; else field.value = ''; });
			row.classList.add('is-uploading');
			heroList.appendChild(row);
			refreshHero();
			try { setImage(row, await uploadImage(file)); row.querySelector<HTMLInputElement>('[data-field="title"]')?.focus(); }
			catch (error) { row.remove(); showStatus(error instanceof Error ? error.message : '圖片上傳失敗', true); }
			finally { row.classList.remove('is-uploading'); refreshHero(); }
		});
		heroEditor.querySelector<HTMLButtonElement>('[data-hero-save]')?.addEventListener('click', async (event) => {
			const button = event.currentTarget as HTMLButtonElement;
			const slides = (Array.from(heroList.children) as HTMLElement[]).map((row) => ({
				id: row.dataset.slideId,
				image: row.dataset.image,
				title: row.querySelector<HTMLInputElement>('[data-field="title"]')?.value ?? '',
				subtitle: row.querySelector<HTMLInputElement>('[data-field="subtitle"]')?.value ?? '',
				href: row.querySelector<HTMLInputElement>('[data-field="href"]')?.value ?? '',
				enabled: row.querySelector<HTMLInputElement>('[data-field="enabled"]')?.checked ?? true,
			}));
			if (slides.some((slide) => slide.enabled && !slide.title.trim())) { showStatus('顯示中的輪播圖都要填標題。', true); return; }
			button.disabled = true;
			try {
				const response = await fetch('/api/admin/hero-slides', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slides }) });
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload.error || '儲存失敗');
				showStatus(`已儲存主圖輪播（${payload.value.filter((s: { enabled: boolean }) => s.enabled).length} 張顯示中），約 15 秒內首頁生效。`);
			} catch (error) {
				showStatus(error instanceof Error ? error.message : '儲存失敗，請再試一次。', true);
			} finally {
				button.disabled = false;
			}
		});
		refreshHero();
	}

	// 頂部公告條：編輯後按「儲存公告條」才寫入
	const announceEditor = document.querySelector<HTMLElement>('[data-announce-editor]');
	if (announceEditor) {
		const listEl = announceEditor.querySelector<HTMLOListElement>('[data-announce-list]')!;
		const max = Number(announceEditor.dataset.max || 6);
		const addBtn = announceEditor.querySelector<HTMLButtonElement>('[data-announce-add]')!;
		const saveAnnounce = announceEditor.querySelector<HTMLButtonElement>('[data-announce-save]')!;
		const template = listEl.querySelector<HTMLLIElement>('.announce-row')?.cloneNode(true) as HTMLLIElement | undefined;
		const refresh = () => {
			const rows = Array.from(listEl.children) as HTMLElement[];
			rows.forEach((row, i) => {
				const text = row.querySelector<HTMLInputElement>('[data-field="text"]');
				const count = row.querySelector<HTMLElement>('[data-count]');
				if (text && count) { const n = Array.from(text.value).length; count.textContent = `${n} 字`; count.classList.toggle('is-long', n > 22); }
				(row.querySelector('[data-move="-1"]') as HTMLButtonElement).disabled = i === 0;
				(row.querySelector('[data-move="1"]') as HTMLButtonElement).disabled = i === rows.length - 1;
			});
			addBtn.disabled = rows.length >= max;
		};
		listEl.addEventListener('input', refresh);
		listEl.addEventListener('click', async (event) => {
			const button = (event.target as HTMLElement).closest('button');
			const row = button?.closest<HTMLElement>('.announce-row');
			if (!button || !row) return;
			if (button.hasAttribute('data-remove')) {
				const label = row.querySelector<HTMLInputElement>('[data-field="text"]')?.value || '這則公告';
				if (!(await askConfirm(`刪除「${label}」？按「儲存公告條」後才會生效。`, { okLabel: '刪除', danger: true }))) return;
				row.remove();
			} else if (button.dataset.move === '-1' && row.previousElementSibling) {
				listEl.insertBefore(row, row.previousElementSibling);
			} else if (button.dataset.move === '1' && row.nextElementSibling) {
				listEl.insertBefore(row.nextElementSibling, row);
			}
			refresh();
		});
		addBtn.addEventListener('click', () => {
			if (listEl.children.length >= max) return;
			const row = (template?.cloneNode(true) as HTMLLIElement | undefined) ?? document.createElement('li');
			row.querySelectorAll('input').forEach((input) => { input.value = ''; });
			listEl.appendChild(row);
			refresh();
			row.querySelector<HTMLInputElement>('[data-field="text"]')?.focus();
		});
		saveAnnounce.addEventListener('click', async () => {
			const items = (Array.from(listEl.children) as HTMLElement[]).map((row) => ({
				badge: row.querySelector<HTMLInputElement>('[data-field="badge"]')?.value ?? '',
				text: row.querySelector<HTMLInputElement>('[data-field="text"]')?.value ?? '',
				href: row.querySelector<HTMLInputElement>('[data-field="href"]')?.value ?? '',
			}));
			saveAnnounce.disabled = true;
			try {
				const response = await fetch('/api/admin/announcement', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						enabled: announceEditor.querySelector<HTMLInputElement>('[data-announce-enabled]')?.checked,
						homeOnly: announceEditor.querySelector<HTMLInputElement>('[data-announce-home]')?.checked,
						items,
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload.error || '儲存失敗');
				showStatus(`已儲存公告條（${payload.value.items.length} 則），約 15 秒內前台生效。`);
			} catch (error) {
				showStatus(error instanceof Error ? error.message : '儲存失敗，請再試一次。', true);
			} finally {
				saveAnnounce.disabled = false;
			}
		});
		refresh();
	}

	// 促銷分頁開關：切換即儲存，失敗就切回原狀
	const promoCount = document.querySelector<HTMLElement>('[data-promo-count]');
	const promoToggles = Array.from(document.querySelectorAll<HTMLInputElement>('[data-promo-toggle]'));
	for (const toggle of promoToggles) {
		toggle.addEventListener('change', async () => {
			const enabled = toggle.checked;
			const label = toggle.dataset.label ?? '分頁';
			const state = toggle.closest('.toggle-row')?.querySelector<HTMLElement>('[data-promo-state]');
			toggle.disabled = true;
			if (state) state.textContent = '儲存中…';
			try {
				const response = await fetch('/api/admin/sanity-dashboard', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ path: `/api/promotions/${encodeURIComponent(toggle.dataset.promoToggle ?? '')}`, method: 'PUT', body: { data: { enabled } } }),
				});
				if (!response.ok) {
					const body = await response.json().catch(() => null) as { error?: { message?: string } } | null;
					throw new Error(body?.error?.message ?? `儲存失敗（${response.status}）`);
				}
				showStatus(enabled ? `已開啟「${label}」` : `已隱藏「${label}」`);
			} catch (error) {
				toggle.checked = !enabled;
				showStatus(error instanceof Error ? error.message : '儲存失敗，請稍後再試', true);
			} finally {
				toggle.disabled = false;
				if (state) state.textContent = toggle.checked ? '前台顯示中' : '已隱藏';
				if (promoCount) promoCount.textContent = `${promoToggles.filter((item) => item.checked).length} 個開啟`;
			}
		});
	}

	const showStatus = (text: string, isError = false) => {
		if (!statusBox) return;
		statusBox.textContent = text;
		statusBox.classList.toggle('is-error', isError);
		statusBox.hidden = false;
	};

	const updateProduct = async (id: string, data: Record<string, unknown>) => {
		const response = await fetch('/api/admin/sanity-dashboard', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ path: `/api/products/${encodeURIComponent(id)}`, method: 'PUT', body: { data } }),
		});
		if (!response.ok) {
			const body = await response.json().catch(() => null) as { error?: { message?: string } } | null;
			throw new Error(body?.error?.message ?? `儲存失敗（${response.status}）`);
		}
	};

	const renumber = () => {
		if (!list) return;
		list.querySelectorAll<HTMLElement>('.sort-row').forEach((row, index) => {
			const rank = row.querySelector('[data-rank]');
			if (rank) rank.textContent = String(index + 1);
			row.classList.toggle('is-off-home', index >= HOME_LIMIT);
			const up = row.querySelector<HTMLButtonElement>('[data-move="-1"]');
			const down = row.querySelector<HTMLButtonElement>('[data-move="1"]');
			if (up) up.disabled = index === 0;
			if (down) down.disabled = index === list.children.length - 1;
		});
	};

	const markDirty = () => {
		dirty = true;
		if (saveBtn) saveBtn.disabled = false;
		if (dirtyHint) dirtyHint.hidden = false;
		renumber();
	};

	if (list) {
		renumber();
		list.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
			if (!button) return;
			const row = button.closest<HTMLElement>('.sort-row');
			if (!row) return;
			if (button.dataset.move === '-1' && row.previousElementSibling) row.previousElementSibling.before(row);
			if (button.dataset.move === '1' && row.nextElementSibling) row.nextElementSibling.after(row);
			markDirty();
			button.focus();
		});

		// 拖曳排序（滑鼠與手指皆可）：按住握把上下移動
		let dragging: HTMLElement | null = null;
		list.addEventListener('pointerdown', (event) => {
			const handle = (event.target as HTMLElement).closest<HTMLElement>('[data-drag]');
			if (!handle) return;
			dragging = handle.closest<HTMLElement>('.sort-row');
			if (!dragging) return;
			event.preventDefault();
			handle.setPointerCapture(event.pointerId);
			dragging.classList.add('is-dragging');
		});
		list.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			const over = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>('.sort-row');
			if (!over || over === dragging || over.parentElement !== list) return;
			const rect = over.getBoundingClientRect();
			if (event.clientY < rect.top + rect.height / 2) over.before(dragging);
			else over.after(dragging);
			renumber();
		});
		const endDrag = () => {
			if (!dragging) return;
			dragging.classList.remove('is-dragging');
			dragging = null;
			markDirty();
		};
		list.addEventListener('pointerup', endDrag);
		list.addEventListener('pointercancel', endDrag);
	}

	saveBtn?.addEventListener('click', async () => {
		if (!list) return;
		const ids = [...list.querySelectorAll<HTMLElement>('.sort-row')].map((row) => row.dataset.id ?? '').filter(Boolean);
		saveBtn.disabled = true;
		saveBtn.textContent = '儲存中…';
		try {
			for (const [index, id] of ids.entries()) await updateProduct(id, { featuredSortOrder: index + 1 });
			dirty = false;
			if (dirtyHint) dirtyHint.hidden = true;
			showStatus(`已儲存熱銷排序（${ids.length} 筆），首頁會照新順序顯示。`);
		} catch (error) {
			saveBtn.disabled = false;
			showStatus(error instanceof Error ? error.message : '儲存失敗，請再試一次。', true);
		} finally {
			saveBtn.textContent = '儲存排序';
		}
	});

	document.addEventListener('click', async (event) => {
		const target = event.target as HTMLElement;
		const featuredBtn = target.closest<HTMLButtonElement>('[data-remove-featured]');
		const spotlightBtn = target.closest<HTMLButtonElement>('[data-remove-spotlight]');
		const addBtn = target.closest<HTMLButtonElement>('[data-add-featured]');
		const addSpotBtn = target.closest<HTMLButtonElement>('[data-add-spotlight]');
		const button = featuredBtn ?? spotlightBtn ?? addBtn ?? addSpotBtn;
		if (!button) return;
		const name = button.closest('.sort-row, .search-row')?.querySelector('strong')?.textContent ?? '這個商品';
		if (featuredBtn && !(await askConfirm(`確定把「${name}」從熱銷推薦移除？`, { okLabel: '移除', danger: true }))) return;
		if (spotlightBtn && !(await askConfirm(`確定取消「${name}」的主打？`, { okLabel: '取消主打', danger: true }))) return;
		if (dirty && !(await askConfirm('排序還沒儲存，繼續會放棄目前的排序變更。要繼續嗎？', { okLabel: '放棄排序', danger: true }))) return;
		button.disabled = true;
		try {
			if (featuredBtn) await updateProduct(featuredBtn.dataset.removeFeatured ?? '', { featured: false });
			if (spotlightBtn) await updateProduct(spotlightBtn.dataset.removeSpotlight ?? '', { heroSpotlight: false });
			if (addBtn) {
				const count = list ? list.children.length : 0;
				await updateProduct(addBtn.dataset.addFeatured ?? '', { featured: true, featuredSortOrder: count + 1 });
			}
			if (addSpotBtn) await updateProduct(addSpotBtn.dataset.addSpotlight ?? '', { heroSpotlight: true });
			window.location.reload();
		} catch (error) {
			button.disabled = false;
			showStatus(error instanceof Error ? error.message : '更新失敗，請再試一次。', true);
		}
	});

	// 搜尋加入（主打／熱銷共用）
	const candidates: Record<string, Candidate[]> = JSON.parse(document.getElementById('displayCandidates')?.textContent ?? '{}');
	const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
	document.querySelectorAll<HTMLInputElement>('[data-search]').forEach((search) => {
		const kind = search.dataset.search ?? 'featured';
		const results = document.querySelector<HTMLUListElement>(`[data-results="${kind}"]`);
		const label = kind === 'spotlight' ? '加入主打' : '加入熱銷';
		search.addEventListener('input', () => {
			if (!results) return;
			const keyword = search.value.trim().toLowerCase();
			if (!keyword) { results.innerHTML = ''; return; }
			const matches = (candidates[kind] ?? []).filter((c) => c.name.toLowerCase().includes(keyword)).slice(0, 8);
			results.innerHTML = matches.length
				? matches.map((c) => `<li class="search-row"><span class="row-text"><strong>${escapeHtml(c.name)}</strong><small>${escapeHtml(c.categoryLabel ?? '未分類')}</small></span><button type="button" class="text-btn text-btn--add" data-add-${kind}="${escapeHtml(c.id)}">${label}</button></li>`).join('')
				: '<li class="search-empty">找不到符合的上架商品</li>';
		});
	});

	window.addEventListener('beforeunload', (event) => {
		if (dirty) event.preventDefault();
	});
</script>

<style>
	.display-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 10px 20px; margin-bottom: 16px; }
