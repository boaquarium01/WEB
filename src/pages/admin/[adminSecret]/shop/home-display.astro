	.display-head p { margin: 4px 0 0; color: var(--commerce-muted); font-size: 13px; }
	.preview-link { display: inline-flex; align-items: center; gap: 6px; color: var(--commerce-primary); font-size: 13px; font-weight: 700; text-decoration: none; }
	.display-notice { margin: 0 0 14px; padding: 10px 14px; border: 1px solid #c8e8d3; border-radius: 12px; background: #eef8f2; color: #1d6a43; font-size: 13px; font-weight: 650; }
	.display-notice.is-error { border-color: #f1cfcb; background: #fff1ef; color: #a23c35; }
	/* 頁內導覽：快速跳到各區塊 */
	.display-nav { position: sticky; top: 0; z-index: 20; display: flex; gap: 6px; margin: 0 0 14px; padding: 8px 0; overflow-x: auto; background: var(--commerce-bg, #f4f6f5); scrollbar-width: none; }
	.display-nav::-webkit-scrollbar { display: none; }
	.display-nav a { display: inline-flex; flex: none; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px; border: 1px solid var(--commerce-line); border-radius: 999px; background: #fff; color: #4f6569; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; }
	.display-nav a:hover { border-color: var(--commerce-primary); color: var(--commerce-primary-dark); }
	.display-nav i { color: var(--commerce-primary); font-size: 12px; }
	.display-card { scroll-margin-top: 64px; }

	/* 主圖輪播編輯 */
	.hero-list { display: grid; gap: 12px; margin: 0; padding: 4px 18px 0; list-style: none; }
	.hero-row { display: grid; grid-template-columns: 240px minmax(0, 1fr) auto; gap: 14px; align-items: start; padding: 12px; border: 1px solid #e6ecea; border-radius: 14px; background: #fafcfb; transition: opacity .2s ease; }
	.hero-row.is-off .hero-row__media img { filter: grayscale(.85); opacity: .55; }
	.hero-row__media { position: relative; overflow: hidden; aspect-ratio: 16 / 9; border-radius: 10px; background: #dfe8e6; }
	.hero-row__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.hero-row.is-uploading .hero-row__media::after { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(255, 255, 255, .7); color: var(--commerce-primary-dark); font-size: 13px; font-weight: 800; content: '上傳中…'; }
	.hero-row__badge { position: absolute; top: 8px; left: 8px; padding: 2px 9px; border-radius: 999px; background: rgba(15, 77, 74, .85); color: #fff; font-size: 11px; font-weight: 800; }
	.hero-row__upload { position: absolute; right: 8px; bottom: 8px; display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 999px; background: rgba(255, 255, 255, .92); color: var(--commerce-primary-dark); font-size: 12px; font-weight: 800; cursor: pointer; box-shadow: 0 2px 8px rgba(0, 0, 0, .15); }
	.hero-row__fields { display: grid; gap: 8px; min-width: 0; }
	.hero-row__side { display: grid; justify-items: end; gap: 10px; }
	label.announce-add { display: inline-flex; cursor: pointer; }
	label.announce-add.is-disabled { opacity: .45; pointer-events: none; }
	@media (max-width: 860px) {
		.hero-list { padding: 4px 12px 0; }
		.hero-row { grid-template-columns: 1fr; }
		.hero-row__side { grid-auto-flow: column; justify-content: space-between; align-items: center; }
	}

	/* 頂部公告條編輯 */
	.announce-list { display: grid; gap: 10px; margin: 0; padding: 4px 18px 0; list-style: none; counter-reset: announce; }
	.announce-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; padding: 12px; border: 1px solid #e6ecea; border-radius: 12px; background: #fafcfb; counter-increment: announce; }
	.announce-row__fields { display: grid; grid-template-columns: 120px minmax(0, 1fr) 200px; gap: 8px; }
	.announce-field { display: grid; gap: 4px; min-width: 0; color: #607579; font-size: 12px; font-weight: 700; }
	.announce-field em { font-style: normal; font-weight: 600; color: #93a5a6; }
	.announce-field em.is-long { color: #b4443a; }
	.announce-field input { width: 100%; box-sizing: border-box; min-height: 40px; padding: 0 10px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; font: inherit; font-size: 14px; }
	.announce-field--badge input { font-weight: 800; color: #9a4a10; }
	.announce-row__tools { display: flex; gap: 6px; }
	.announce-row__tools button { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; color: #4f6569; cursor: pointer; }
	.announce-row__tools button:disabled { opacity: .35; cursor: default; }
	.announce-row__tools .is-danger { color: #b4443a; }
	.announce-actions { display: flex; justify-content: space-between; gap: 10px; padding: 14px 18px 18px; }
	.announce-add, .announce-save { display: inline-flex; align-items: center; gap: 7px; min-height: 42px; padding: 0 16px; border-radius: 10px; font: inherit; font-weight: 750; cursor: pointer; }
	.announce-add { border: 1px dashed #b9d6cf; background: #fff; color: var(--commerce-primary-dark); }
	.announce-add:disabled { opacity: .45; cursor: default; }
	.announce-save { border: 0; background: var(--commerce-primary); color: #fff; }
	.announce-save:disabled { opacity: .6; cursor: wait; }
	@media (max-width: 760px) {
		.announce-list { padding: 4px 12px 0; }
		.announce-row { grid-template-columns: 1fr; }
		.announce-row__fields { grid-template-columns: 1fr; }
		.announce-row__tools { justify-content: flex-end; }
		.announce-actions { padding: 12px; }
		.announce-add, .announce-save { flex: 1; justify-content: center; }
	}
	.display-card { margin-bottom: 16px; border: 1px solid var(--commerce-line); border-radius: 15px; background: #fff; box-shadow: var(--commerce-shadow); overflow: hidden; }
	.display-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 15px 18px; border-bottom: 1px solid #edf1ef; }
	.display-card__head h2 { margin: 0; font-size: 18px; }
	.display-card__head p { margin: 4px 0 0; color: var(--commerce-muted); font-size: 12.5px; line-height: 1.5; }
	.count-pill { flex: none; padding: 3px 10px; border-radius: 999px; background: var(--commerce-primary-soft); color: var(--commerce-primary-dark); font-size: 12px; font-weight: 750; }
	.toggle-list { margin: 0; padding: 0; list-style: none; }
	.toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 10px 18px; border-bottom: 1px solid #edf1ef; }
	.toggle-row:last-child { border-bottom: 0; }
	.switch { position: relative; flex: none; display: inline-flex; width: 48px; height: 28px; cursor: pointer; }
	.switch input { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
	.switch__track { width: 100%; height: 100%; border-radius: 999px; background: #cfd8d6; transition: background-color 0.18s ease; }
	.switch__track::after { content: ''; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(20, 40, 40, 0.25); transition: transform 0.18s ease; }
	.switch input:checked + .switch__track { background: var(--commerce-primary); }
	.switch input:checked + .switch__track::after { transform: translateX(20px); }
	.switch input:focus-visible + .switch__track { outline: 3px solid rgba(21, 106, 102, 0.35); outline-offset: 2px; }
	.switch input:disabled { cursor: not-allowed; }
	.switch input:disabled + .switch__track { opacity: 0.5; }
	@media (prefers-reduced-motion: reduce) { .switch__track, .switch__track::after { transition: none; } }
	.empty-line { margin: 0; padding: 18px; color: var(--commerce-muted); font-size: 13px; }
	.sort-list { margin: 0; padding: 0; list-style: none; }
	.sort-row { display: grid; grid-template-columns: 36px 26px 48px minmax(0, 1fr) auto auto; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #f1f4f3; background: #fff; }
