    async function loadProductCommerce() {
      const sequence = ++state.commerceLoadSequence;
      if (state.model !== 'product' || isProductSortMode()) {
        productCommercePanel.hidden = true;
        productCommercePanel.replaceChildren();
        return;
      }

      productCommercePanel.hidden = false;
      const sanityProductId = String(state.selectedId ?? '').trim();
      const slug = String(state.selected?.slug ?? '').trim();
      if (!sanityProductId) {
        commerceStateMessage('請先儲存商品內容，再設定價格與庫存');
        return;
      }

      commerceStateMessage('正在讀取價格與庫存…');
      try {
        const params = new URLSearchParams({ sanityProductId });
        if (slug) params.set('slug', slug);
        const payload = await commerceApi(`/api/admin/product-commerce?${params.toString()}`);
        if (sequence !== state.commerceLoadSequence || state.model !== 'product') return;
        const fetchedRows = Array.isArray(payload?.rows) ? payload.rows : [];
        const rows = selectProductEditorSkus(fetchedRows, Boolean(state.selected?.specificationsEnabled), (state.selected?.variants ?? []).map((variant) => String(variant._key ?? '')));
        if (!rows.length) {
          commerceStateMessage('這項官網商品尚未建立電商價格與庫存資料。', { allowSync: true });
          return;
        }
        renderProductCommerceRows(rows, payload?.settings ?? { minimumPurchaseQuantity: 1, priceTiers: [] });
      } catch (e) {
        if (sequence !== state.commerceLoadSequence) return;
        commerceStateMessage(`無法讀取價格與庫存：${e instanceof Error ? e.message : String(e)}`, { error: true });
      }
    }

    const UPLOAD_MAX_MB = 20;
    const ALLOWED_IMAGE_EXT = ['jpg', 'jpeg', 'png', 'webp', 'gif'];
    const ALLOWED_IMAGE_MIME = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    const MIME_TO_EXT = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif' };

    function uploadErrText(payload, status) {
      const base = payload?.error?.message ?? payload?.message ?? '';
      const details = payload?.error?.details ?? payload?.details;
      if (!details) return String(base || `HTTP ${status}`);
      const detailText = typeof details === 'string' ? details : JSON.stringify(details);
      return String(base ? `${base} (${detailText})` : detailText || `HTTP ${status}`);
    }

    function fileExt(name = '') {
      const idx = name.lastIndexOf('.');
      if (idx < 0) return '';
      return name.slice(idx + 1).toLowerCase();
    }

    function normalizeRelationValue(raw) {
      const v = String(raw ?? '').trim();
      if (!v) return null;
      // 相容 Strapi v4/v5：純數字用數字 id，其餘視為 documentId。
      if (/^\d+$/.test(v)) return Number(v);
      return v;
    }

    function safeUploadName(file) {
      const mime = String(file.type || '').toLowerCase();
      const ext = fileExt(file.name) || MIME_TO_EXT[mime] || 'jpg';
      const rawBase = String(file.name || 'upload').replace(/\.[^.]+$/, '');
      const safeBase = rawBase
        .normalize('NFKD')
        .replace(/[^\w.-]+/g, '_')
        .replace(/^_+|_+$/g, '')
        .slice(0, 60) || `upload_${Date.now()}`;
      return `${safeBase}.${ext}`;
    }

    function validateUploadFiles(files) {
      const maxBytes = UPLOAD_MAX_MB * 1024 * 1024;
      const failed = [];
      const passed = [];
      files.forEach((f) => {
        const ext = fileExt(f.name);
        const mime = String(f.type || '').toLowerCase();
        if (!ALLOWED_IMAGE_EXT.includes(ext) && !ALLOWED_IMAGE_MIME.includes(mime)) {
          failed.push(`${f.name}（不支援格式，僅限 ${ALLOWED_IMAGE_EXT.join('/')}）`);
          return;
        }
        if (f.size > maxBytes) {
          failed.push(`${f.name}（超過 ${UPLOAD_MAX_MB}MB）`);
          return;
        }
        passed.push(f);
      });
      return { passed, failed };
    }

    function normalizeUploadIds(payload) {
      if (!Array.isArray(payload)) return [];
      const ids = [];
      payload.forEach((x) => {
        const raw = x?.id;
        if (raw == null || raw === '') return;
        if (typeof raw === 'number' && Number.isFinite(raw)) ids.push(raw);
        else ids.push(String(raw));
      });
      return ids;
    }

    async function uploadBatch(files) {
      const fd = new FormData();
      files.forEach((f) => fd.append('files', f, safeUploadName(f)));
      const url = adminBackend === 'sanity' ? '/api/admin/sanity-upload' : '/api/admin/strapi-proxy?path=%2Fapi%2Fupload';
      const res = await fetch(url, { method: 'POST', body: fd, headers: authHeaders() });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(uploadErrText(payload, res.status));
      return normalizeUploadIds(payload);
    }

    async function uploadOne(file) {
      const fd = new FormData();
      fd.append('files', file, safeUploadName(file));
      const url = adminBackend === 'sanity' ? '/api/admin/sanity-upload' : '/api/admin/strapi-proxy?path=%2Fapi%2Fupload';
      const res = await fetch(url, { method: 'POST', body: fd, headers: authHeaders() });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(uploadErrText(payload, res.status));
      const raw = payload?.[0]?.id;
      if (raw == null || raw === '') throw new Error('回傳缺少媒體 ID');
      return typeof raw === 'number' && Number.isFinite(raw) ? raw : String(raw);
    }

    async function upload(files) {
      if (!Array.isArray(files) || files.length === 0) return [];
      const { passed, failed: invalidFiles } = validateUploadFiles(files);
      if (invalidFiles.length) {
        setStatus(`已略過不可上傳檔案：${invalidFiles.join('、')}`);
      }
      if (!passed.length) {
        throw new Error(`上傳失敗：${invalidFiles.join('、')}`);
      }
      try {
        return await uploadBatch(passed);
      } catch (batchError) {
        const okIds = [];
        const failed = [];
        for (const file of passed) {
          try {
            const id = await uploadOne(file);
            okIds.push(id);
          } catch (singleError) {
            const reason = singleError instanceof Error ? singleError.message : String(singleError);
            failed.push(`${file.name}（${reason}）`);
          }
        }
        if (!okIds.length) {
          throw new Error(`上傳失敗：${failed.join('、') || (batchError instanceof Error ? batchError.message : String(batchError))}`);
        }
        if (failed.length || invalidFiles.length) {
          const allFailed = [...invalidFiles, ...failed];
          setStatus(`部分圖片上傳失敗：${allFailed.join('、')}`);
        }
        return okIds;
      }
    }

    const tabIcons = {
      promotion: 'fa-tags',
      product: 'fa-box-open'
    };

    function leaveCurrentProductEditor() {
      if (!confirmDiscardIfDirty()) return false;
      ++productSelectionSequence;
      state.dirty = false;
      state.pendingUploads = {};
      if (state.model === 'product') {
        ++state.commerceLoadSequence;
        fill({}, { redrawList: false, loadCommerce: false });
        productCommercePanel.replaceChildren();
        productCommercePanel.hidden = true;
      }
      return true;
    }

    function drawTabs() {
      modelTabs.innerHTML = '';
      ['promotion', 'product'].forEach((k) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `tab ${state.model === k ? 'is-active' : ''}`;
        const ic = document.createElement('i');
        ic.className = `fa-solid ${tabIcons[k] ?? 'fa-layer-group'}`;
        ic.setAttribute('aria-hidden', 'true');
        const lab = document.createElement('span');
        lab.textContent = defs[k].label;
        b.append(ic, lab);
        // 「分類管理」固定走排序模式，避免從不同入口看到不同內容
        b.onclick = () => {
          const returnToProducts = k === 'product' && state.model === 'product' && !isProductSortMode();
          if (!leaveCurrentProductEditor()) return;
          if (returnToProducts) {
            setMobilePanel('list'); drawList(); setStatus('商品清單'); return;
          }
          return switchModel(k, { mobilePanel: 'list' });
        };
        modelTabs.appendChild(b);
      });
      const stockTab = document.createElement('a');
      stockTab.className = 'tab';
      stockTab.href = shopProductsHref || '#';
      stockTab.innerHTML = '<i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><span>庫存</span>';
      stockTab.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        if (!leaveCurrentProductEditor()) event.preventDefault();
      });
      modelTabs.appendChild(stockTab);

      const sortTab = document.createElement('button');
      sortTab.type = 'button';
      sortTab.className = `tab ${isProductSortMode() || isCategorySortMode() ? 'is-active' : ''}`;
      sortTab.innerHTML = '<i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i><span>排序</span>';
      sortTab.onclick = () => {
        if (!leaveCurrentProductEditor()) return;
        return switchModel('product', { productSortMode: true, mobilePanel: 'list' })
          .then(() => {
            if (categoryFilter.options.length > 1 && !categoryFilter.value) categoryFilter.value = String(categoryFilter.options[1].value ?? '');
            drawList();
            setStatus('選分類→拖曳或置頂／置底→頂部「儲存」');
            queueMicrotask(() => categoryFilter.focus());
          })
          .catch((e) => setStatus(`無法開啟：${e instanceof Error ? e.message : String(e)}`));
      };
      modelTabs.appendChild(sortTab);
    }

    function drawList({ append = false } = {}) {
      productListObserver?.disconnect();
      productListMore.remove();
      const getProductThumbSrc = (row) => {
        let media = row?.image ?? row?.images ?? null;
        if (Array.isArray(media)) media = media[0] ?? null;
        const raw =
          media?.url ??
          media?.attributes?.url ??
          media?.data?.attributes?.url ??
          media?.data?.url ??
          '';
        const s = String(raw ?? '');
        if (!s) return '';
        return s.startsWith('http') ? s : `${base}${s}`;
      };

      if (isCategorySortMode()) {
        // 分類管理模式：只在載入時排序一次；之後以 state.entries 的順序為準（避免上下移後又被 orderRank 排回去）
        const items = [...state.entries];
        listCount.textContent = `共 ${items.length} 個分類（可拖曳排序）`;
        entryList.innerHTML = '';
        entryList.classList.add('entry-list--cat-sort');
        entryList.classList.remove('entry-list--product-sort');

        const reorderCategories = (fromIdx, toIdx) => {
          if (fromIdx === toIdx) return;
          if (fromIdx < 0 || toIdx < 0 || fromIdx >= items.length || toIdx >= items.length) return;
          const next = [...state.entries];
          const [moved] = next.splice(fromIdx, 1);
          next.splice(toIdx, 0, moved);
          state.entries = next;
          markDirty();
          drawList();
          setStatus('已調整分類順序，請按儲存');
        };

        const dragState = { active: false, fromIdx: -1, overIdx: -1, pointerId: null };
        const clearDragUi = () => {
          entryList.querySelectorAll('.cat-manage-row.is-dragging, .cat-manage-row.is-drag-over').forEach((el) => {
            el.classList.remove('is-dragging', 'is-drag-over');
          });
        };

        items.forEach((row, idx) => {
          const wrap = document.createElement('div');
          wrap.className = 'cat-manage-row';
          wrap.dataset.sortIndex = String(idx);
          const rank = idx + 1;
          const name = String(row.name ?? `分類 #${idx + 1}`);
          const slugText = String(row.slug ?? row?.attributes?.slug ?? '').trim();
          wrap.setAttribute('role', 'listitem');
          wrap.setAttribute('aria-label', `${name}，排序第 ${rank} 位`);

          const dragHandle = document.createElement('button');
          dragHandle.type = 'button';
          dragHandle.className = 'cat-manage-row__drag';
          dragHandle.setAttribute('aria-label', '拖曳調整順序');
          dragHandle.setAttribute('title', '拖曳排序');
          dragHandle.innerHTML = '<i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>';

          const main = document.createElement('div');
          main.className = 'cat-manage-row__main';
          const nameEl = document.createElement('span');
          nameEl.className = 'cat-manage-row__name';
          nameEl.textContent = name;
          const metaEl = document.createElement('span');
          metaEl.className = 'cat-manage-row__meta';
          metaEl.textContent = `排序：${rank}${slugText ? `　｜　slug：${slugText}` : ''}`;
          main.append(nameEl, metaEl);

          const ops = document.createElement('span');
          ops.className = 'cat-manage-row__ops';

          const mkBtn = (attrs) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = attrs.className;
            if (attrs.dir) b.dataset.dir = attrs.dir;
            if (attrs.act) b.dataset.act = attrs.act;
            b.setAttribute('aria-label', attrs.label);
            b.setAttribute('title', attrs.label);
            b.innerHTML = `<i class="fa-solid ${attrs.icon}" aria-hidden="true"></i>`;
            if (attrs.disabled) b.disabled = true;
            return b;
          };

          ops.append(
            mkBtn({ className: 'cat-manage-row__btn', dir: 'top', label: '置頂', icon: 'fa-angles-up', disabled: idx === 0 }),
            mkBtn({ className: 'cat-manage-row__btn', dir: 'up', label: '上移', icon: 'fa-arrow-up', disabled: idx === 0 }),
            mkBtn({ className: 'cat-manage-row__btn', dir: 'down', label: '下移', icon: 'fa-arrow-down', disabled: idx === items.length - 1 }),
            mkBtn({ className: 'cat-manage-row__btn', dir: 'bottom', label: '置底', icon: 'fa-angles-down', disabled: idx === items.length - 1 }),
            mkBtn({ className: 'cat-manage-row__btn cat-manage-row__btn--edit', act: 'edit', label: '編輯', icon: 'fa-pen' }),
            mkBtn({ className: 'cat-manage-row__btn cat-manage-row__btn--del', act: 'del', label: '刪除', icon: 'fa-trash' })
          );

          wrap.append(dragHandle, main, ops);

          dragHandle.addEventListener('pointerdown', (e) => {
            if (e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            dragState.active = true;
            dragState.fromIdx = idx;
            dragState.overIdx = idx;
            dragState.pointerId = e.pointerId;
            wrap.classList.add('is-dragging');
            try {
              dragHandle.setPointerCapture(e.pointerId);
            } catch {}
          });
          dragHandle.addEventListener('pointermove', (e) => {
            if (!dragState.active || dragState.pointerId !== e.pointerId) return;
            const under = document.elementFromPoint(e.clientX, e.clientY);
            const target = under instanceof Element ? under.closest('.cat-manage-row') : null;
            entryList.querySelectorAll('.cat-manage-row.is-drag-over').forEach((n) => n.classList.remove('is-drag-over'));
            if (target instanceof HTMLElement) {
              const kids = Array.from(entryList.querySelectorAll('.cat-manage-row'));
              const overIdx = kids.indexOf(target);
              if (overIdx >= 0) {
                dragState.overIdx = overIdx;
                if (overIdx !== dragState.fromIdx) target.classList.add('is-drag-over');
              }
            }
          });
          const endDrag = (e) => {
            if (!dragState.active || (e && dragState.pointerId !== e.pointerId)) return;
            const from = dragState.fromIdx;
            const to = dragState.overIdx;
            dragState.active = false;
            dragState.pointerId = null;
            clearDragUi();
            if (from >= 0 && to >= 0 && from !== to) reorderCategories(from, to);
          };
          dragHandle.addEventListener('pointerup', endDrag);
          dragHandle.addEventListener('pointercancel', () => {
            dragState.active = false;
            dragState.pointerId = null;
            clearDragUi();
          });

          ops.querySelectorAll('.cat-manage-row__btn').forEach((btn) => {
            btn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              const t = ev.currentTarget;
              if (!(t instanceof HTMLButtonElement)) return;
              const act = t.dataset.act ?? '';
              if (act === 'edit') {
                openCategoryModal('edit', row);
                return;
              }
              if (act === 'del') {
                void deleteCategory(row).catch((e) => setStatus(`刪除失敗：${e instanceof Error ? e.message : String(e)}`));
                return;
              }
              const dir = t.dataset.dir;
              let to = idx;
              if (dir === 'up') to = idx - 1;
              else if (dir === 'down') to = idx + 1;
              else if (dir === 'top') to = 0;
              else if (dir === 'bottom') to = items.length - 1;
              else return;
              reorderCategories(idx, to);
            });
          });

          entryList.appendChild(wrap);
        });
        return;
      }

      entryList.classList.remove('entry-list--cat-sort');
      if (isProductSortMode()) {
        const titleKey = defs.product.title;
        const selectedCategory = String(categoryFilter.value ?? '').trim();
        const allItems = [...state.entries];
        const categoryName = (row) =>
          String(row?.category?.name ?? row?.category?.data?.attributes?.name ?? row?.category?.data?.name ?? '').trim();
        // 順序必須與 state.entries 一致（僅篩選該分類），不可再依 sortOrder 排序；
        // 否則使用者調整順序後會立刻被 sort 回舊順序，看起來像按鈕無反應。
        const items = selectedCategory ? allItems.filter((x) => productCategoryId(x) === selectedCategory) : [];
        if (!selectedCategory) {
          listCount.textContent = '請先選擇分類';
          entryList.innerHTML = '';
          entryList.classList.add('entry-list--product-sort');
          return;
        }
        listCount.textContent = `共 ${items.length} 個商品（可拖曳排序）`;
        entryList.innerHTML = '';
        entryList.classList.add('entry-list--product-sort');

        const applyCategoryOrder = (movedItems) => {
          let mi = 0;
          const next = state.entries.map((r) => (productCategoryId(r) === selectedCategory ? movedItems[mi++] : r));
          if (mi !== movedItems.length) {
            setStatus('排序合併異常：請刷新頁面');
            return false;
          }
          state.entries = next;
          return true;
        };

        const reorderInCategory = (fromIdx, toIdx) => {
          if (fromIdx === toIdx) return;
          if (fromIdx < 0 || toIdx < 0 || fromIdx >= items.length || toIdx >= items.length) return;
          const movedItems = [...items];
          const [moved] = movedItems.splice(fromIdx, 1);
          movedItems.splice(toIdx, 0, moved);
          if (!applyCategoryOrder(movedItems)) return;
          markDirty();
          drawList();
          setStatus('順序已改，請儲存');
        };

        const dragState = { active: false, fromIdx: -1, overIdx: -1, pointerId: null };
        const clearDragUi = () => {
          entryList.querySelectorAll('.item--product-sort.is-dragging, .item--product-sort.is-drag-over').forEach((el) => {
            el.classList.remove('is-dragging', 'is-drag-over');
          });
        };

        items.forEach((row, idx) => {
          const rank = idx + 1;
          const enabled = Boolean(row.enabled);
          const featured = Boolean(row.featured);
          const heroSpotlight = Boolean(row.heroSpotlight);
          const thumbSrc = getProductThumbSrc(row);
          const cat = categoryName(row) || '未分類';
          const title = String(row[titleKey] ?? '').trim() || `商品 #${idx + 1}`;

          const wrap = document.createElement('div');
          wrap.className = `item item--product item--product-sort ${enabled ? 'item--enabled' : 'item--disabled'}`;
          wrap.dataset.sortIndex = String(idx);
          wrap.setAttribute('role', 'listitem');
          wrap.setAttribute('aria-label', `${title}，排序第 ${rank} 位`);

          const dragHandle = document.createElement('button');
          dragHandle.type = 'button';
          dragHandle.className = 'item__dragHandle';
          dragHandle.setAttribute('aria-label', '拖曳調整順序');
          dragHandle.setAttribute('title', '拖曳排序');
          dragHandle.innerHTML = '<i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>';

          const thumbWrap = document.createElement('span');
          thumbWrap.className = 'item__thumbWrap';
          if (thumbSrc) {
            const img = document.createElement('img');
            img.className = 'item__thumb';
            img.src = thumbSrc;
            img.alt = '首圖';
            img.loading = 'lazy';
            img.draggable = false;
            thumbWrap.appendChild(img);
          } else {
            const ph = document.createElement('span');
            ph.className = 'item__thumb item__thumb--empty';
            ph.setAttribute('aria-hidden', 'true');
            thumbWrap.appendChild(ph);
          }

          const main = document.createElement('span');
          main.className = 'item__main';

          const row1 = document.createElement('span');
          row1.className = 'item__row1';
          const titleEl = document.createElement('span');
          titleEl.className = 'item__title';
          titleEl.textContent = title;
          const rankEl = document.createElement('span');
          rankEl.className = 'item__sortRank';
          rankEl.textContent = `排序：${rank}`;
          row1.append(titleEl, rankEl);

          const meta = document.createElement('span');
          meta.className = 'item__meta item__meta--withTags';
          const catEl = document.createElement('span');
          catEl.className = 'item__metaCategory';
          catEl.textContent = cat;
          const tagWrap = document.createElement('span');
          tagWrap.className = 'item__metaTags';
          tagWrap.setAttribute('aria-label', '商品標籤');
          if (heroSpotlight) {
            const spot = document.createElement('span');
            spot.className = 'badge badge--spotlight';
            spot.textContent = '主打';
            tagWrap.appendChild(spot);
          }
          if (featured) {
            const hot = document.createElement('span');
            hot.className = 'badge badge--hot';
            hot.textContent = '熱銷';
            tagWrap.appendChild(hot);
          }
          meta.append(catEl, tagWrap);

          main.append(row1, meta);

          const rail = document.createElement('div');
          rail.className = 'item__sortRail';
          const btnRow = document.createElement('div');
          btnRow.className = 'item__sortBtnRow';

          const mkSortBtn = (dir, label, icon, disabled) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'item__sortBtn';
            b.dataset.dir = dir;
            b.setAttribute('aria-label', label);
            b.setAttribute('title', label);
            b.innerHTML = `<i class="fa-solid ${icon}" aria-hidden="true"></i>`;
            if (disabled) b.disabled = true;
            return b;
          };

          const btnTop = mkSortBtn('top', '置頂', 'fa-angles-up', idx === 0);
          const btnUp = mkSortBtn('up', '上移', 'fa-arrow-up', idx === 0);
          const btnDown = mkSortBtn('down', '下移', 'fa-arrow-down', idx === items.length - 1);
          const btnBottom = mkSortBtn('bottom', '置底', 'fa-angles-down', idx === items.length - 1);

          const btnEdit = document.createElement('button');
          btnEdit.type = 'button';
          btnEdit.className = 'item__sortBtn item__sortBtn--edit';
          btnEdit.dataset.act = 'edit';
          btnEdit.setAttribute('aria-label', '編輯');
          btnEdit.setAttribute('title', '編輯');
          btnEdit.innerHTML = '<i class="fa-solid fa-pen" aria-hidden="true"></i>';

          const btnDel = document.createElement('button');
          btnDel.type = 'button';
          btnDel.className = 'item__sortBtn item__sortBtn--del';
          btnDel.dataset.act = 'del';
          btnDel.setAttribute('aria-label', '刪除');
          btnDel.setAttribute('title', '刪除');
          btnDel.innerHTML = '<i class="fa-solid fa-trash" aria-hidden="true"></i>';

          btnRow.append(btnTop, btnUp, btnDown, btnBottom, btnEdit, btnDel);
          rail.appendChild(btnRow);

          wrap.append(dragHandle, thumbWrap, main, rail);

          dragHandle.addEventListener('pointerdown', (e) => {
            if (e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            dragState.active = true;
            dragState.fromIdx = idx;
            dragState.overIdx = idx;
            dragState.pointerId = e.pointerId;
            wrap.classList.add('is-dragging');
            try {
              dragHandle.setPointerCapture(e.pointerId);
            } catch {}
          });
          dragHandle.addEventListener('pointermove', (e) => {
            if (!dragState.active || dragState.pointerId !== e.pointerId) return;
            const under = document.elementFromPoint(e.clientX, e.clientY);
            const target = under instanceof Element ? under.closest('.item--product-sort') : null;
            entryList.querySelectorAll('.item--product-sort.is-drag-over').forEach((n) => n.classList.remove('is-drag-over'));
            if (target instanceof HTMLElement) {
              const kids = Array.from(entryList.querySelectorAll('.item--product-sort'));
              const overIdx = kids.indexOf(target);
              if (overIdx >= 0) {
                dragState.overIdx = overIdx;
                if (overIdx !== dragState.fromIdx) target.classList.add('is-drag-over');
              }
            }
          });
          const endDrag = (e) => {
            if (!dragState.active || (e && dragState.pointerId !== e.pointerId)) return;
            const from = dragState.fromIdx;
            const to = dragState.overIdx;
            dragState.active = false;
            dragState.pointerId = null;
            clearDragUi();
            if (from >= 0 && to >= 0 && from !== to) reorderInCategory(from, to);
          };
          dragHandle.addEventListener('pointerup', endDrag);
          dragHandle.addEventListener('pointercancel', () => {
            dragState.active = false;
            dragState.pointerId = null;
            clearDragUi();
          });

          btnRow.querySelectorAll('button').forEach((btn) => {
            btn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              const t = ev.currentTarget;
              if (!(t instanceof HTMLButtonElement)) return;
              const act = t.dataset.act ?? '';
              if (act === 'edit') {
                const keepCat = String(categoryFilter.value ?? '').trim();
                void switchModel('product').then(() => {
                  categoryFilter.value = keepCat;
                  drawList();
                  select(row);
                  if (isMobileNarrow()) setMobilePanel('editor');
                }).catch((e) => setStatus(`無法開啟商品卡：${e instanceof Error ? e.message : String(e)}`));
                return;
              }
              if (act === 'del') {
                const name = String(row.name ?? '').trim() || '此商品';
                const yes = window.confirm(`確定刪除「${name}」？\n\n刪除後無法復原。`);
                if (!yes) return;
                const id = kOf(row);
                if (!id) return;
                setStatus('刪除商品中…');
                void api(`${defs.product.api}/${id}`, { method: 'DELETE' })
                  .then(async () => {
                    await load();
                    categoryFilter.value = selectedCategory;
                    drawList();
                    setStatus('已刪除商品');
                  })
                  .catch((e) => setStatus(`刪除失敗：${e instanceof Error ? e.message : String(e)}`));
                return;
              }
              const dir = t.dataset.dir;
              let to = idx;
              if (dir === 'up') to = idx - 1;
              else if (dir === 'down') to = idx + 1;
              else if (dir === 'top') to = 0;
              else if (dir === 'bottom') to = items.length - 1;
              else return;
              reorderInCategory(idx, to);
            });
          });

          entryList.appendChild(wrap);
        });
        return;
      }

      entryList.classList.remove('entry-list--product-sort');

      const q = String(searchInput.value ?? '').trim().toLowerCase();
      const titleKey = defs[state.model].title;
      let items = [...state.entries];
      let categoryName = () => '';
      let categoryId = () => '';
      if (state.model === 'product') {
        const selectedCategory = String(categoryFilter.value ?? '').trim();
        categoryName = (row) =>
          String(row?.category?.name ?? row?.category?.data?.attributes?.name ?? row?.category?.data?.name ?? '').trim();
        categoryId = (row) => productCategoryId(row);

        if (selectedCategory) items = items.filter((x) => categoryId(x) === selectedCategory);
        const statusFilter = String(productStatusFilter.value ?? 'all');
        if (statusFilter === 'enabled') items = items.filter((x) => Boolean(x.enabled));
        if (statusFilter === 'disabled') items = items.filter((x) => !Boolean(x.enabled));
        if (statusFilter === 'sellable') items = items.filter((x) => state.commerceSummary.get(kOf(x))?.canSell === true);
        if (statusFilter === 'unsellable') items = items.filter((x) => state.commerceSummary.has(kOf(x)) && state.commerceSummary.get(kOf(x))?.canSell === false);
        items.sort((a, b) => {
          // 全部分類：先依分類下拉同順序（orderRank），再依分類內 sortOrder
          const catOrder = new Map(
            (state.categoryOptions ?? []).map((x, i) => [String(x.documentId ?? x.id ?? '').trim(), i])
          );
          const ida = categoryId(a);
          const idb = categoryId(b);
          const oa = catOrder.has(ida) ? catOrder.get(ida) : 999999;
          const ob = catOrder.has(idb) ? catOrder.get(idb) : 999999;
          if (oa !== ob) return oa - ob;

          // fallback：若分類不在下拉（例如資料缺漏），再用名稱比對
          const ca = categoryName(a);
          const cb = categoryName(b);
          if (ca !== cb) return ca.localeCompare(cb, 'zh-Hant');

          const sa = Number.isFinite(Number(a.sortOrder)) ? Number(a.sortOrder) : 999999;
          const sb = Number.isFinite(Number(b.sortOrder)) ? Number(b.sortOrder) : 999999;
          if (sa !== sb) return sa - sb;
          return String(a[titleKey] ?? '').localeCompare(String(b[titleKey] ?? ''), 'zh-Hant');
        });

        const sortMode = String(productListSort.value ?? 'default');
        if (sortMode === 'name-asc') {
          items.sort((a, b) => String(a[titleKey] ?? '').localeCompare(String(b[titleKey] ?? ''), 'zh-Hant'));
        } else if (sortMode.startsWith('price-') || sortMode.startsWith('stock-')) {
          const field = sortMode.startsWith('price-') ? 'price' : 'stock';
          const direction = sortMode.endsWith('-desc') ? -1 : 1;
          items.sort((a, b) => {
            const av = state.commerceSummary.get(kOf(a))?.[field];
            const bv = state.commerceSummary.get(kOf(b))?.[field];
            if (av == null && bv == null) return String(a[titleKey] ?? '').localeCompare(String(b[titleKey] ?? ''), 'zh-Hant');
            if (av == null) return 1;
            if (bv == null) return -1;
            if (av !== bv) return (av - bv) * direction;
            return String(a[titleKey] ?? '').localeCompare(String(b[titleKey] ?? ''), 'zh-Hant');
          });
        }
      }
      items = items.filter((x) => String(x[titleKey] ?? '').toLowerCase().includes(q));
      let appendBatch = false, totalProducts = items.length;
      if (state.model === 'product') {
        const key = JSON.stringify([state.model, q, categoryFilter.value, productStatusFilter.value, productListSort.value, items.map(kOf)]);
        const sameList = productListKey === key;
        const previousShown = sameList ? productListShown : 0;
        if (!sameList) { productListKey = key; productListShown = PRODUCT_LIST_BATCH_SIZE; }
        appendBatch = append && sameList;
        if (appendBatch) productListShown = Math.min(totalProducts, productListShown + PRODUCT_LIST_BATCH_SIZE);
        items = items.slice(appendBatch ? previousShown : 0, productListShown);
      } else { productListKey = ''; productListShown = PRODUCT_LIST_BATCH_SIZE; }
      listCount.textContent = '';
      if (!appendBatch) entryList.innerHTML = '';
      items.forEach((row) => {
        const b = document.createElement('button');
        b.type = 'button';
        const isActive = kOf(row) === state.selectedId;
        if (state.model === 'product') {
          const enabled = Boolean(row.enabled);
          const featured = Boolean(row.featured);
          const heroSpotlight = Boolean(row.heroSpotlight);
          const thumbSrc = getProductThumbSrc(row);
          const cat = categoryName(row) || '未分類';
          const title = String(row[titleKey] ?? '').trim() || `項目 #${row.id}`;
          const commerce = state.commerceSummary.get(kOf(row));

          b.className = `item item--product item--catalog ${isActive ? 'is-active' : ''} ${enabled ? 'item--enabled' : 'item--disabled'}`;

          const thumbWrap = document.createElement('span');
          thumbWrap.className = 'item__thumbWrap';
          if (thumbSrc) {
            const img = document.createElement('img');
            img.className = 'item__thumb';
            img.src = thumbSrc;
            img.alt = '首圖';
            img.loading = 'lazy';
            thumbWrap.appendChild(img);
          } else {
            const ph = document.createElement('span');
            ph.className = 'item__thumb item__thumb--empty';
            ph.setAttribute('aria-hidden', 'true');
            thumbWrap.appendChild(ph);
          }

          const main = document.createElement('span');
          main.className = 'item__main';

          const row1 = document.createElement('span');
          row1.className = 'item__row1';

          const titleEl = document.createElement('span');
          titleEl.className = 'item__title';
          titleEl.textContent = title;
          titleEl.title = title;
          row1.appendChild(titleEl);

          const meta = document.createElement('span');
          meta.className = 'item__meta item__meta--withTags';

          const catEl = document.createElement('span');
          catEl.className = 'item__metaCategory';
          catEl.textContent = cat;

          const tagWrap = document.createElement('span');
          tagWrap.className = 'item__metaTags';
          tagWrap.setAttribute('aria-label', '商品標籤');
          const statusBadge = document.createElement('span');
          statusBadge.className = `badge badge--status ${enabled ? 'is-enabled' : 'is-disabled'}`;
          statusBadge.textContent = enabled ? '上架' : '未上架';
          tagWrap.appendChild(statusBadge);
          const saleSummary = state.commerceSummary.get(kOf(row));
          const saleBadge = document.createElement('span');
          saleBadge.className = `badge badge--sale-status ${saleSummary ? (saleSummary.canSell ? 'is-selling' : 'is-stopped') : 'is-unknown'}`;
          saleBadge.textContent = saleSummary ? (saleSummary.canSell ? '販售' : '禁售') : '未同步';
          tagWrap.appendChild(saleBadge);
          if (heroSpotlight) {
            const spot = document.createElement('span');
            spot.className = 'badge badge--spotlight';
            spot.textContent = '主打';
            tagWrap.appendChild(spot);
          }
          if (featured) {
            const hot = document.createElement('span');
            hot.className = 'badge badge--hot';
            hot.textContent = '熱銷';
            tagWrap.appendChild(hot);
          }

          meta.append(catEl, tagWrap);

          const commerceMeta = document.createElement('span');
          commerceMeta.className = 'item__commerce';
          const priceMeta = document.createElement('span');
          priceMeta.className = 'item__price';
          priceMeta.textContent = commerce?.priceText ?? '尚未定價';
          priceMeta.title = priceMeta.textContent;
          const stockMeta = document.createElement('span');
          stockMeta.className = 'item__stock';
          stockMeta.textContent = commerce?.stockText ?? '庫存未同步';
          stockMeta.title = stockMeta.textContent;
          stockMeta.classList.toggle('is-empty', Boolean(commerce && commerce.stock === 0));
          commerceMeta.append(priceMeta, stockMeta);

          main.append(row1, meta, commerceMeta);
          b.append(thumbWrap, main);
        } else {
          b.className = `item ${isActive ? 'is-active' : ''}`;
          b.textContent = String(row[titleKey] ?? `項目 #${row.id}`);
        }
        b.onclick = () => select(row);
        entryList.appendChild(b);
      });
      if (state.model === 'product' && productListShown < totalProducts) {
        productListMore.textContent = '已顯示 ' + Math.min(productListShown, totalProducts) + ' / ' + totalProducts + ' · 載入更多';
        entryList.appendChild(productListMore);
        if ('IntersectionObserver' in window) {
          productListObserver = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting) || state.saving) return;
            productListObserver.disconnect();
            requestAnimationFrame(() => {
              if (productListMore.isConnected && state.model === 'product' && !isProductSortMode()) drawList({ append: true });
            });
          }, { rootMargin: '0px 0px 80px 0px' });
          productListObserver.observe(productListMore);
        }
      }
    }
    async function select(row) {
      if (state.saving) return;
      if (state.model === 'product' && state.dirty) {
        if (kOf(row) === state.selectedId) return;
        if (!confirmDiscardIfDirty()) return;
      }
      if (isCategorySortMode() || isProductSortMode()) return;
      const sequence = ++productSelectionSequence;
      if (state.model === 'product' && row.__listOnly) {
        setStatus('讀取商品內容…');
        try {
          const payload = await api(defs.product.api + '/' + encodeURIComponent(kOf(row)));
          if (sequence !== productSelectionSequence || state.model !== 'product' || state.saving) return;
          const detail = normOne(payload);
          if (!detail || !kOf(detail)) throw new Error('找不到商品內容');
          row = { ...row, ...detail, __listOnly: false };
          state.entries = state.entries.map((entry) => kOf(entry) === kOf(row) ? row : entry);
        } catch (error) { if (sequence === productSelectionSequence) setStatus('無法讀取商品：' + (error instanceof Error ? error.message : String(error))); return; }
      }
      fill(row);
      state.dirty = false;
      setStatus(`已載入 ${defs[state.model].label}`);
      if (isMobileNarrow()) setMobilePanel('editor');
    }

    function fieldEl(field, cfg) {
      const wrap = document.createElement('section');
      const allowMultiUpload = cfg.type === 'media' && (cfg.multiple || (state.model === 'product' && field === 'image'));
      wrap.className = 'card';
      wrap.dataset.field = field;
      wrap.dataset.type = cfg.type;
      wrap.dataset.multiple = String(Boolean(allowMultiUpload));
      if (cfg.type === 'media' || field === 'content' || field === 'body') wrap.classList.add('span2');
      wrap.innerHTML = `<label>${labelOf(state.model, field)}</label>`;

      if (cfg.type === 'boolean') {
        wrap.classList.add('card--bool');
        wrap.insertAdjacentHTML('beforeend', `<label class="switch"><input type="checkbox"><span></span></label>`);
      } else if (cfg.type === 'text' || cfg.type === 'blocks') {
        const rows = cfg.type === 'blocks' ? 8 : field === 'excerpt' ? 2 : 4;
        wrap.insertAdjacentHTML('beforeend', `<textarea rows="${rows}"></textarea>`);
      } else if (cfg.type === 'relation') {
        wrap.insertAdjacentHTML('beforeend', `<select></select>`);
      } else if (cfg.type === 'media') {
        wrap.insertAdjacentHTML(
          'beforeend',
          `<div class="wall"><div class="grid"></div><div class="pending-grid"></div><div class="uploader"><input class="file-input" type="file" accept="image/*" ${allowMultiUpload ? 'multiple' : ''}><span class="pick-info">未選擇檔案</span></div><div class="pick-files" aria-live="polite"></div></div>`
        );
      } else {
        wrap.insertAdjacentHTML('beforeend', `<input type="${cfg.type === 'datetime' ? 'datetime-local' : 'text'}">`);
      }
      if (state.model === 'product' && field === 'seoKeywords') {
        wrap.insertAdjacentHTML('beforeend', `<p class="hint">提示：關鍵字請用 , 、 。 分隔</p>`);
      }
      wrap.insertAdjacentHTML('beforeend', `<p class="err"></p>`);
      return wrap;
    }

    /** 商品分頁必備：篩選下拉與表單分類選項（排序模式會略過 drawForm，須單獨載入） */
    async function ensureProductCategoryFilter() {
      const prev = String(categoryFilter.value ?? '').trim();
      const cat = await api('/api/categories?fields[0]=name&fields[1]=orderRank&pagination[pageSize]=200');
      state.categoryOptions = sortCategoriesByOrderRank(Array.isArray(cat?.data) ? cat.data : []);
      categoryFilter.style.display = 'block';
      editCategoriesBtn.style.display = isProductSortMode() ? 'inline-flex' : 'none';
      productListSort.style.display = isProductSortMode() ? 'none' : 'block';
      productStatusFilter.style.display = isProductSortMode() ? 'none' : 'block';
      categoryFilter.innerHTML = '<option value="">分類</option>';
      state.categoryOptions.forEach((x) => {
        const o = document.createElement('option');
        o.value = String(x.documentId ?? x.id ?? '');
        o.textContent = String(x.attributes?.name ?? x.name ?? x.id);
        categoryFilter.appendChild(o);
      });
      if (prev && Array.from(categoryFilter.options).some((opt) => opt.value === prev)) {
        categoryFilter.value = prev;
      }
    }

    async function drawForm() {
      saveBtn.querySelector('.action-btn__label').textContent = '儲存';
      formRoot.innerHTML = '';
      const attrs = schemas[state.model]?.attributes ?? {};
      const advancedKeys = [];
      let fieldKeys = Object.keys(attrs);
      // 商品表單：短述在分類之前
      if (state.model === 'product') {
        const ci = fieldKeys.indexOf('category');
        const ei = fieldKeys.indexOf('excerpt');
        if (ci >= 0 && ei >= 0 && ci < ei) {
          fieldKeys = [...fieldKeys];
          fieldKeys[ci] = 'excerpt';
          fieldKeys[ei] = 'category';
        }
      }
      fieldKeys.forEach((f) => {
        if (state.model === 'product' && f === 'slug') return;
        if (state.model === 'product' && f === 'gallery') return;
        // Strapi 只保留 orderRank，避免出現第二個舊排序欄位
        if (state.model === 'category' && f === 'legacySortOrder') return;
        if (state.model === 'promotion' && f === 'title' && state.simpleMode) {
          advancedKeys.push(f);
          return;
        }
        const cfg = attrs[f];
        if (state.simpleMode && advancedField(f)) {
          advancedKeys.push(f);
          return;
        }
        if (state.simpleMode && !essentialField(f) && !cfg.required && cfg.type !== 'media' && cfg.type !== 'boolean') {
          advancedKeys.push(f);
          return;
        }
        formRoot.appendChild(fieldEl(f, cfg));
      });

      if (advancedKeys.length > 0) {
        const details = document.createElement('details');
        details.className = 'advanced';
        details.innerHTML = `<summary>進階設定（slug / SEO / 排序）</summary><div class="advanced-grid"></div>`;
        const grid = details.querySelector('.advanced-grid');
        if (grid) {
          let orderedAdvancedKeys = [...advancedKeys];
          if (state.model === 'product') {
            const preferredOrder = [
              'seoKeywords',
              'featuredSortOrder',
              'sortOrder',
              'seoTitle',
              'seoDescription',
              'heroSpotlightActivatedAt'
            ];
            const rank = new Map(preferredOrder.map((k, i) => [k, i]));
            orderedAdvancedKeys.sort((a, b) => {
              const ra = rank.has(a) ? rank.get(a) : Number.MAX_SAFE_INTEGER;
              const rb = rank.has(b) ? rank.get(b) : Number.MAX_SAFE_INTEGER;
              if (ra !== rb) return ra - rb;
              return String(a).localeCompare(String(b), 'zh-Hant');
            });
          }
          orderedAdvancedKeys.forEach((f) => grid.appendChild(fieldEl(f, attrs[f])));
        }
        formRoot.appendChild(details);
      }

      if (state.model === 'product') {
        const slugCard = document.createElement('section');
        slugCard.className = 'card span2 slug-card';
        slugCard.innerHTML =
          '<label>商品 slug (自動生成)</label><input id="productSlugReadonly" type="text" readonly /><button id="productRemoveBtn" type="button" class="product-remove-btn" disabled>移除此品項</button>';
        formRoot.appendChild(slugCard);
        const removeBtn = slugCard.querySelector('#productRemoveBtn');
        if (removeBtn instanceof HTMLButtonElement) {
          removeBtn.onclick = () => openProductRemoveModal();
        }
      }
      if (state.model === 'product') {
        if (!state.categoryOptions.length) {
          await ensureProductCategoryFilter();
        }
      } else {
        categoryFilter.style.display = 'none';
        editCategoriesBtn.style.display = 'none';
        categoryFilter.value = '';
        productListSort.style.display = 'none';
        productListSort.value = 'default';
        productStatusFilter.style.display = 'none';
        productStatusFilter.value = 'all';
      }
      fill(state.selected);
      formRoot.oninput = (e) => {
        const t = e.target;
        if (t instanceof HTMLInputElement && t.readOnly) return;
        markDirty();
        if (t instanceof Element) {
          const card = t.closest('.card');
          const key = String(defs[state.model]?.title ?? '').trim();
          if (key && card instanceof HTMLElement && card.dataset.field === key) updateSectionLabels();
        }
      };
      formRoot.onchange = () => markDirty();
    }

    async function applyPendingUploads(card, { interactive = true } = {}) {
      const grid = card.querySelector('.grid');
      const info = card.querySelector('.pick-info');
      const fileList = card.querySelector('.pick-files');
      const field = card.dataset.field ?? '';
      if (!(grid instanceof HTMLElement) || !(info instanceof HTMLElement)) return;
      const files = Array.isArray(state.pendingUploads[field]) ? [...state.pendingUploads[field]] : [];
      if (!files.length) return;

      const max = state.model === 'promotion' && field === 'promoImages' ? 25 : Infinity;
      if (Number.isFinite(max) && grid.children.length + files.length > max) {
        const overflow = grid.children.length + files.length - max;
        if (interactive) {
          const yes = window.confirm(`促銷圖片上限 25 張。\n將以新圖片取代最後 ${overflow} 張舊圖，是否繼續？`);
          if (!yes) return;
        }
        for (let i = 0; i < overflow; i += 1) {
          const last = grid.lastElementChild;
          if (last) last.remove();
        }
      }
      const ids = await upload(files);
      const fragment = document.createDocumentFragment();
      ids.forEach((id) => {
        const c = document.createElement('article');
        c.className = 'thumb pending';
        c.dataset.id = String(id);
        const label = String(id).length > 24 ? `${String(id).slice(0, 12)}…` : String(id);
        c.innerHTML = `<div class="ph">ID ${label}</div><div class="ops"><button type="button" class="op-btn op-left" data-a="l" aria-label="左移"><i class="fa-solid fa-arrow-left"></i></button><button type="button" class="op-btn op-right" data-a="r" aria-label="右移"><i class="fa-solid fa-arrow-right"></i></button><button type="button" class="op-btn op-del" data-a="d" aria-label="移除"><i class="fa-solid fa-trash"></i></button></div>`;
        fragment.appendChild(c);
      });
      grid.insertBefore(fragment, grid.firstChild);
      state.pendingUploads[field] = [];
      info.textContent = '未選擇檔案';
      const pendingGrid = card.querySelector('.pending-grid');
      if (pendingGrid instanceof HTMLElement) pendingGrid.innerHTML = '';
      if (fileList instanceof HTMLElement) fileList.innerHTML = '';
      const input = card.querySelector('.file-input');
      if (input instanceof HTMLInputElement) input.value = '';
      markDirty();
    }

    function mediaBind(card) {
      const grid = card.querySelector('.grid');
      const pendingGrid = card.querySelector('.pending-grid');
      const input = card.querySelector('.file-input');
      const info = card.querySelector('.pick-info');
      const fileList = card.querySelector('.pick-files');
      const field = card.dataset.field ?? '';
      if (!(grid instanceof HTMLElement) || !(pendingGrid instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(info instanceof HTMLElement) || !(fileList instanceof HTMLElement)) return;

      if (!Array.isArray(state.pendingUploads[field])) state.pendingUploads[field] = [];
      const renderPending = () => {
        const files = Array.isArray(state.pendingUploads[field]) ? state.pendingUploads[field] : [];
        pendingGrid.innerHTML = '';
        fileList.innerHTML = '';
        files.forEach((file, idx) => {
          const src = URL.createObjectURL(file);
          const item = document.createElement('article');
          item.className = 'thumb thumb--pending';
          item.innerHTML = `<span class="pending-tag">新圖片</span><img src="${src}" alt="${file.name}"><div class="ops"><button type="button" data-rm="${idx}">移除圖片</button></div>`;
          const rm = item.querySelector('button[data-rm]');
          if (rm) {
            rm.onclick = () => {
              state.pendingUploads[field].splice(idx, 1);
              renderPending();
              info.textContent = state.pendingUploads[field].length > 0 ? `已選 ${state.pendingUploads[field].length} 張` : '未選擇檔案';
              if (state.pendingUploads[field].length === 0) input.value = '';
              markDirty();
            };
          }
          pendingGrid.appendChild(item);

          const nameRow = document.createElement('div');
          nameRow.className = 'pick-file-row';
          nameRow.textContent = `${idx + 1}. ${file.name}`;
          fileList.appendChild(nameRow);
        });
      };

      input.onchange = () => {
        const files = Array.from(input.files ?? []);
        if (!files.length) return;
        state.pendingUploads[field].push(...files);
        info.textContent = `已選 ${state.pendingUploads[field].length} 張`;
        renderPending();
        markDirty();
      };

      grid.querySelectorAll('.thumb').forEach((el, i) => {
        const l = el.querySelector('[data-a="l"]');
        const r = el.querySelector('[data-a="r"]');
        const d = el.querySelector('[data-a="d"]');
        const img = el.querySelector('img');
        const existingBadge = el.querySelector('.order-badge');
        if (!existingBadge) {
          const badge = document.createElement('span');
          badge.className = 'order-badge';
          badge.textContent = state.model === 'product' && card.dataset.field === 'image' && i === 0 ? '主圖' : String(i + 1);
          el.prepend(badge);
        } else {
          existingBadge.textContent = state.model === 'product' && card.dataset.field === 'image' && i === 0 ? '主圖' : String(i + 1);
        }
        if (img instanceof HTMLImageElement) {
          img.style.cursor = 'zoom-in';
          img.onclick = () => openPreview(img.src);
        }
        if (l) l.onclick = () => {
          if (i > 0) {
            grid.insertBefore(el, grid.children[i - 1]);
            markDirty();
          }
          mediaBind(card);
        };
        if (r) r.onclick = () => {
          if (grid.children[i + 1]) {
            grid.insertBefore(grid.children[i + 1], el);
            markDirty();
          }
          mediaBind(card);
        };
        if (d) d.onclick = () => {
          if (window.confirm('確定移除此圖片？')) {
            el.remove();
            markDirty();
            mediaBind(card);
          }
        };
      });
    }

    function fillMedia(card, value) {
      const grid = card.querySelector('.grid');
      if (!(grid instanceof HTMLElement)) return;
      const arr = Array.isArray(value) ? value : Array.isArray(value?.data) ? value.data : value?.data ? [value.data] : value ? [value] : [];
      grid.innerHTML = '';
      arr.forEach((m) => {
        const raw = m?.url ?? m?.attributes?.url ?? '';
        const src = raw.startsWith('http') ? raw : `${base}${raw}`;
        const c = document.createElement('article');
        c.className = 'thumb';
        c.dataset.id = String(m?.id ?? '');
        c.innerHTML = `<img src="${src}" alt=""><div class="ops"><button type="button" class="op-btn op-left" data-a="l" aria-label="左移"><i class="fa-solid fa-arrow-left"></i></button><button type="button" class="op-btn op-right" data-a="r" aria-label="右移"><i class="fa-solid fa-arrow-right"></i></button><button type="button" class="op-btn op-del" data-a="d" aria-label="移除"><i class="fa-solid fa-trash"></i></button></div>`;
        grid.appendChild(c);
      });
      mediaBind(card);
    }

    function fill(row, { redrawList = true, loadCommerce = true } = {}) {
      ++productSelectionSequence;
      if (kOf(row ?? {}) !== state.selectedId) { productSyncPending = false; productCommerceRows = []; productCommerceSettings = null; }
      productSpecificationDraft = null; productSalesDraft = null; productSkuDrafts.clear(); productSkuPreviewCache.clear();
      state.selected = row ?? {};
      state.selectedId = kOf(state.selected);
      if (state.model === 'product') {
        const slugInput = document.getElementById('productSlugReadonly');
        if (slugInput instanceof HTMLInputElement) {
          const value = String(state.selected.slug ?? '').trim();
          slugInput.value = value;
        }
        const removeBtn = document.getElementById('productRemoveBtn');
        if (removeBtn instanceof HTMLButtonElement) {
          removeBtn.disabled = !String(state.selectedId ?? '').trim();
        }
      }
      formRoot.querySelectorAll('.card').forEach((card) => {
        const field = card.dataset.field;
        const type = card.dataset.type;
        if (!field) return;
        const v = state.selected[field];
        if (type === 'boolean') {
          const c = card.querySelector('input[type="checkbox"]');
          if (c) c.checked = Boolean(v);
        } else if (type === 'relation') {
          const s = card.querySelector('select');
          if (!(s instanceof HTMLSelectElement)) return;
          s.innerHTML = '<option value="">請選擇分類</option>';
          state.categoryOptions.forEach((x) => {
            const o = document.createElement('option');
            o.value = String(x.documentId ?? x.id ?? '');
            o.textContent = String(x.attributes?.name ?? x.name ?? x.id);
            s.appendChild(o);
          });
          s.value = String(v?.data?.documentId ?? v?.documentId ?? v?.data?.id ?? v?.id ?? '');
        } else if (type === 'media') {
          if (state.model === 'product' && field === 'image') {
            const merged = [];
            const head = Array.isArray(state.selected.image) ? state.selected.image : state.selected.image ? [state.selected.image] : [];
            const tail = Array.isArray(state.selected.gallery) ? state.selected.gallery : state.selected.gallery ? [state.selected.gallery] : [];
            merged.push(...head, ...tail);
            fillMedia(card, merged);
          } else {
            fillMedia(card, v);
          }
        } else {
          const i = card.querySelector('input,textarea');
          if (!i) return;
          if (type === 'datetime') i.value = v ? String(v).slice(0, 16) : '';
          else if (type === 'json') i.value = v ? JSON.stringify(v) : '';
          if (state.model === 'product' && field === 'seoKeywords' && type === 'json') {
            const list = Array.isArray(v) ? v : [];
            i.value = list.map((x) => String(x ?? '').trim()).filter(Boolean).join('、');
          }
          else if (type === 'blocks') {
            if (Array.isArray(v)) {
              const fb = v[0];
              const isPortable = Boolean(fb && typeof fb === 'object' && fb._type === 'block');
              i.value = isPortable ? portableBlocksToPlainText(v) : strapiBlocksToPlainText(v);
            } else i.value = v == null ? '' : String(v);
          } else i.value = v == null ? '' : String(v);
        }
      });
      if (redrawList) drawList();
      updateSectionLabels();
      syncPublicSiteButtons();
      if (state.model === "product") productBaseSnapshot = structuredClone(collect({ validate: false }).out);
      if (loadCommerce) productCommerceReady = loadProductCommerce();
    }

    function collect({ validate = true } = {}) {
      const attrs = schemas[state.model].attributes;
      const out = {};
      let ok = true;
      formRoot.querySelectorAll('.card').forEach((card) => {
        const f = card.dataset.field;
        const t = card.dataset.type;
        if (!f) return;
        const err = card.querySelector('.err');
        if (validate && err) err.textContent = '';

        if (t === 'boolean') {
          const c = card.querySelector('input[type="checkbox"]');
          out[f] = Boolean(c?.checked);
        } else if (t === 'relation') {
          const s = card.querySelector('select');
          out[f] = normalizeRelationValue(s?.value);
        } else if (t === 'media') {
          const rawIds = Array.from(card.querySelectorAll('.thumb'))
            .map((x) => String(x.dataset.id ?? '').trim())
            .filter(Boolean)
            .map((s) => (/^\d+$/.test(s) ? Number(s) : s));
          if (state.model === 'product' && f === 'image') {
            out.image = rawIds[0] ?? null;
            out.gallery = rawIds.slice(1);
          } else {
            out[f] = attrs[f].multiple ? rawIds : rawIds[0] ?? null;
          }
        } else {
          const i = card.querySelector('input,textarea');
          const raw = i?.value ?? '';
          if (t === 'integer') out[f] = raw.trim() ? Number(raw) : null;
          else if (t === 'json') {
            if (state.model === 'product' && f === 'seoKeywords') {
              const parts = String(raw)
                .split(/[,\uFF0C\u3001\u3002.]+/g)
                .map((x) => x.trim())
                .filter(Boolean);
              // Sanity 為 array；不可送 null（Studio 會報 Invalid property value）
              out[f] = parts;
            } else {
              out[f] = raw.trim() ? JSON.parse(raw) : null;
            }
          }
          else if (t === 'blocks') out[f] = plainTextToStrapiBlocks(raw);
          else out[f] = raw;
        }

        if (validate && attrs[f]?.required && (out[f] === '' || out[f] == null)) {
          if (err) err.textContent = '此欄位必填';
          ok = false;
        }
      });
      if (state.model === 'product') {
        const slugInput = document.getElementById('productSlugReadonly');
        const slugValue =
          slugInput instanceof HTMLInputElement ? slugInput.value.trim() : String(state.selected.slug ?? '').trim();
        out.slug = slugValue;
        // Product SEO is simplified: title/description auto-derived from name/excerpt.
        out.seoTitle = String(out.name ?? '').trim();
        out.seoDescription = String(out.excerpt ?? '').trim();
      }
      return { ok, out };
    }

    /**
     * @param {string} [selectIdAfter] 載入後自動選取（維持編輯畫面，避免儲存後表單被清空／手機跳出編輯）
     */
    async function load(selectIdAfter) {
      setStatus('載入中...');
      root.dataset.listLoading = '1';
      listCount.textContent = '載入中...';
      entryList.innerHTML = '';
      try {
        productListKey = ''; productListShown = PRODUCT_LIST_BATCH_SIZE;
        const listOnly = state.model === 'product' && adminBackend === 'sanity' && !isProductSortMode();
        const j = await api(`${defs[state.model].api}?${listOnly ? 'view=list-index' : 'populate=*'}`);
        state.entries = norm(j);
        if (state.model === 'product' && state.entries.length) {
          state.entries = applySortOrderWithinEachCategory(state.entries);
          await loadCommerceSummary();
        } else {
          state.commerceSummary = new Map();
        }
        if (isCategorySortMode()) {
          // 只在載入時依 orderRank 排序一次，後續調整以陣列順序為準
          state.entries = [...state.entries].sort((a, b) => {
            const ra = Number.isFinite(Number(a.orderRank)) ? Number(a.orderRank) : 999999;
            const rb = Number.isFinite(Number(b.orderRank)) ? Number(b.orderRank) : 999999;
            if (ra !== rb) return ra - rb;
            return String(a.name ?? '').localeCompare(String(b.name ?? ''), 'zh-Hant');
          });
        }
        state.selected = {};
        state.selectedId = '';
        fill({}, { redrawList: false });
        drawList();
        state.dirty = false;
        setLoadedStatus();
        const sid = String(selectIdAfter ?? '').trim();
        if (sid) {
          const row = state.entries.find((e) => kOf(e) === sid);
          if (row) select(row);
        }
        syncPublicSiteButtons();
      } finally {
        delete root.dataset.listLoading;
      }
    }

    async function switchModel(model, options = {}) {
      const {
        selectPromotionSlug,
        selectEntrySlug,
        mobilePanel,
        selectFirstEntry = false,
        // 「分類管理」預設開排序模式：只調整順序、不顯示右側表單
        categorySortMode = model === 'category',
        productSortMode = false
      } = options;
      try {
        state.model = model;
        state.categorySortMode = model === 'category' ? Boolean(categorySortMode) : false;
        state.productSortMode = model === 'product' ? Boolean(productSortMode) : false;
        root.dataset.categorySortMode = state.categorySortMode ? '1' : '0';
        root.dataset.productSortMode = state.productSortMode ? '1' : '0';
        root.dataset.model = model;
        if (model === 'product') {
          await ensureProductCategoryFilter();
        }
        if (isMobileNarrow()) {
          if (mobilePanel !== undefined) setMobilePanel(mobilePanel);
          else if (state.categorySortMode || state.productSortMode) setMobilePanel('list');
          else setMobilePanel('list');
        }
        drawTabs();
        if (state.categorySortMode || state.productSortMode) {
          formRoot.innerHTML = '';
          state.selected = {};
          state.selectedId = '';
        } else {
          await drawForm();
        }
        await load();
        if (selectPromotionSlug) {
          const slug = String(selectPromotionSlug).trim();
          const row = state.entries.find((e) => String(e.slug ?? '').trim() === slug);
          if (row) select(row);
          else setStatus(`找不到促銷頁（slug）：${slug}`);
        } else if (selectEntrySlug) {
          const slug = String(selectEntrySlug).trim();
          const row = state.entries.find((e) => String(e.slug ?? '').trim() === slug);
          if (row) select(row);
          else setStatus(`找不到商品（slug）：${slug}`);
        } else if (
          selectFirstEntry &&
          !state.categorySortMode &&
          !state.productSortMode &&
          (model === 'promotion' || model === 'product')
        ) {
          const firstRow = state.entries[0];
          if (firstRow) select(firstRow);
        }
        updateSectionLabels();
      } catch (e) {
        setStatus(`分頁切換失敗：${e instanceof Error ? e.message : String(e)}`);
      }
    }

    async function refreshCurrentView() {
      if (!confirmDiscardIfDirty()) return;
      const selectedIdBefore = String(state.selectedId ?? '').trim();
      const keepCategory = String(categoryFilter.value ?? '').trim();
      state.dirty = false;

      // Product view needs category options up-to-date before list redraw.
      if (state.model === 'product') {
        await ensureProductCategoryFilter();
      }

      await load(selectedIdBefore || undefined);

      if (isProductSortMode()) {
        if (keepCategory && Array.from(categoryFilter.options).some((o) => o.value === keepCategory)) {
          categoryFilter.value = keepCategory;
        }
        drawList();
      }

      setStatus('已重整：最新資料');
    }

    async function saveCategoryOrder() {
      // 逐筆更新（避免大量 Promise.all 併發造成偶發失敗，也方便定位哪筆出錯）
      for (let idx = 0; idx < state.entries.length; idx += 1) {
        const row = state.entries[idx];
        const id = kOf(row);
        if (!id) continue;
        // Strapi schema: orderRank 是 string
        const nextRank = String(idx + 1);
        const current = String(row.orderRank ?? '').trim();
        if (current === nextRank) continue;
        setStatus(`儲存中…（${idx + 1}/${state.entries.length}）`);
        await api(`${defs.category.api}/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: { orderRank: nextRank } })
        });
      }
      state.dirty = false;
      await load();
      setStatus('分類順序已儲存');
    }

    async function saveProductCategoryOrder() {
      const selectedCategory = String(categoryFilter.value ?? '').trim();
      if (!selectedCategory) {
        setStatus('請先選擇分類');
        return;
      }
      const items = state.entries.filter((x) => productCategoryId(x) === selectedCategory);
      const updates = [];
      for (let idx = 0; idx < items.length; idx += 1) {
        const row = items[idx];
        const id = kOf(row);
        if (!id) continue;
        const nextSort = idx + 1;
        const current = Number(row.sortOrder);
        if (Number.isFinite(current) && current === nextSort) continue;
        updates.push({ id, sortOrder: nextSort });
      }
      if (!updates.length) {
        state.dirty = false;
        setStatus('順序與後端一致，無需儲存');
        return;
      }
      setStatus(`儲存中…（${updates.length} 筆）`);
      if (adminBackend === 'sanity') {
        await api('/api/products/batch-sort-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: { items: updates } })
        });
      } else {
        const chunkSize = 6;
        for (let i = 0; i < updates.length; i += chunkSize) {
          const chunk = updates.slice(i, i + chunkSize);
          setStatus(`儲存中…（${Math.min(i + chunk.length, updates.length)}/${updates.length}）`);
          await Promise.all(
            chunk.map((u) =>
              api(`${defs.product.api}/${u.id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ data: { sortOrder: u.sortOrder } })
              })
            )
          );
        }
      }
      state.dirty = false;
      const keepCat = selectedCategory;
      await load();
      if (keepCat && Array.from(categoryFilter.options).some((o) => o.value === keepCat)) {
        categoryFilter.value = keepCat;
      }
      drawList();
      setStatus('商品排序已儲存');
    }

    const catModalState = { mode: 'create', id: '', originalSlug: '', manualSlug: false };

    function openCategoryModal(mode, row = null) {
      catModalState.mode = mode;
      catModalState.manualSlug = false;
      catModalState.id = row ? kOf(row) : '';
      const currentName = row ? String(row.name ?? '') : '';
      const currentSlug = row ? String(row.slug ?? row?.attributes?.slug ?? '') : '';
      catModalState.originalSlug = currentSlug;
      catModalTitle.textContent = mode === 'edit' ? '編輯分類' : '新增分類';
      catModalName.value = currentName;
      catModalSlug.value = currentSlug;
      catModalDelete.hidden = mode !== 'edit';
      if (catModalHint instanceof HTMLElement) catModalHint.textContent = 'slug 建議小寫英數與連字號（-），需唯一。';
      catManageModal.hidden = false;
      catManageModal.setAttribute('aria-hidden', 'false');
      try { applyBodyScrollLock(); } catch {}
      queueMicrotask(() => catModalName.focus());
    }

    function closeCategoryModal() {
      catManageModal.hidden = true;
      catManageModal.setAttribute('aria-hidden', 'true');
      try { releaseBodyScrollLock(); } catch {}
    }

    const productRemoveState = { id: '', name: '' };

    function closeProductRemoveModal() {
      productRemoveModal.hidden = true;
      productRemoveModal.setAttribute('aria-hidden', 'true');
      productRemoveState.id = '';
      productRemoveState.name = '';
      productRemoveConfirm.disabled = false;
      productRemoveCancel.disabled = false;
      try { releaseBodyScrollLock(); } catch {}
    }

    function openProductRemoveModal() {
      const id = String(state.selectedId ?? '').trim();
      if (!id) {
        setStatus('尚未儲存的新品項無需移除');
        return;
      }
      productRemoveState.id = id;
      productRemoveState.name = String(state.selected?.name ?? '').trim() || '此商品';
      productRemoveTitle.textContent = '移除此品項';
      productRemoveMsg.textContent = `確定要移除「${productRemoveState.name}」？\n移除後無法復原。`;
      productRemoveModal.hidden = false;
      productRemoveModal.setAttribute('aria-hidden', 'false');
      try { applyBodyScrollLock(); } catch {}
      queueMicrotask(() => productRemoveConfirm.focus());
    }

    async function confirmProductRemove() {
      const id = String(productRemoveState.id ?? '').trim();
      if (!id) return;
      productRemoveConfirm.disabled = true;
      productRemoveCancel.disabled = true;
      setStatus('移除商品中…');
      try {
        await api(`${defs.product.api}/${id}`, { method: 'DELETE' });
        const keepCat = String(categoryFilter.value ?? '').trim();
        closeProductRemoveModal();
        state.selected = {};
        state.selectedId = '';
        state.dirty = false;
        await load();
        categoryFilter.value = keepCat;
        drawList();
        fill({});
        setStatus('已移除此品項');
        if (isMobileNarrow()) setMobilePanel('list');
      } catch (e) {
        productRemoveConfirm.disabled = false;
        productRemoveCancel.disabled = false;
        setStatus(`移除失敗：${e instanceof Error ? e.message : String(e)}`);
      }
    }

    async function deleteCategory(row) {
      const id = kOf(row);
      if (!id) return;
      const name = String(row.name ?? '').trim() || '此分類';
      const yes = window.confirm(`確定要刪除「${name}」？\n\n刪除後無法復原。`);
      if (!yes) return;
      setStatus('刪除分類中…');
      await api(`${defs.category.api}/${id}`, { method: 'DELETE' });
      await load();
      setStatus('已刪除分類');
    }

    async function saveCategoryModal() {
      const name = String(catModalName.value ?? '').trim();
      let slug = String(catModalSlug.value ?? '').trim();
      if (!name) throw new Error('請輸入分類名稱');
      if (!slug) slug = slugify(name) || `cat-${slug5()}`;
      const payload = { name, slug };
      if (catModalState.mode === 'create') {
        const nextRank = String(state.entries.length + 1);
        setStatus('新增分類中…');
        await api(defs.category.api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: { ...payload, orderRank: nextRank } })
        });
        await load();
        setStatus('已新增分類');
      } else {
        if (!catModalState.id) throw new Error('缺少分類 ID');
        setStatus('更新分類中…');
        await api(`${defs.category.api}/${catModalState.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: payload })
        });
        await load();
        setStatus('已更新分類');
      }
      closeCategoryModal();
    }

    async function saveAllProductChanges() {
      if (state.saving) return;
      state.saving = true;
      productCommercePanel.dataset.savePhase = 'checking'; setStatus('檢查變更…');
      saveBtn.disabled = true; saveBtn.setAttribute('aria-busy', 'true'); saveBtn.setAttribute('data-saving', '1');
      [formRoot, productCommercePanel, entryList, modelTabs].forEach((element) => { element.inert = true; });
      [newBtn, refreshBtn, simpleModeToggle].forEach((button) => { button.disabled = true; });
      let hasCommittedContent = false;
      try {
        await productCommerceReady;
        if (specificationUploads) throw new Error('圖片仍在上傳，完成後再儲存');
        const basic = collect(); if (!basic.ok) throw new Error('請先修正商品必填欄位');
        const specDraft = productSpecificationDraft;
        const specValue = specDraft?.read();
        const specPatch = specDraft ? changedFields(specValue, specDraft.baseline) : {};
        if (Object.keys(specPatch).length) specDraft.validate();
        const salesDraft = productSalesDraft;
        const salesValue = salesDraft?.read();
        const settingsPatch = salesDraft ? changedFields(salesValue, salesDraft.baseline) : {};
        if (Object.keys(settingsPatch).length) salesDraft.validate();
        const skuChanges = [];
        for (const [id, draft] of productSkuDrafts) {
          const value = draft.read(), patch = changedFields(value, draft.baseline);
          if (!Object.keys(patch).length) continue;
          // Deleted combinations retain historical records, without writing abandoned edits to them.
          if (specPatch.specifications !== undefined || specPatch.specificationsEnabled !== undefined) {
            const keys = specValue.specificationsEnabled ? new Set(generateSpecificationCombinations(normalizeSpecifications(specValue.specifications)).map((combo) => combo._key)) : null;
            if (keys ? !keys.has(draft.row.variantKey) : Boolean(draft.row.variantKey)) continue;
          }
          draft.validate(); skuChanges.push({ productSkuId: id, patch, draft, value });
        }
        const codes = Array.from(productSkuDrafts.values()).map((draft) => draft.read().sku);
        if (skuChanges.some((entry) => entry.patch.sku !== undefined) && new Set(codes).size !== codes.length) throw new Error('商品選項貨號不可重複');
        const hasPendingImages = Object.values(state.pendingUploads).some((files) => Array.isArray(files) && files.length);
        const creating = !state.selectedId;
        const initialBasicPatch = creating ? basic.out : changedFields(basic.out, productBaseSnapshot);
        if (!creating && !Object.keys(initialBasicPatch).length && !Object.keys(specPatch).length && !skuChanges.length && !Object.keys(settingsPatch).length && !hasPendingImages && !productSyncPending) {
          productCommercePanel.dataset.savePhase = 'unchanged'; state.dirty = false; setStatus('沒有變更，無需儲存'); return;
        }
        setStatus('正在儲存變更…');
        for (const card of formRoot.querySelectorAll('.card[data-type="media"]')) await applyPendingUploads(card, { interactive: false });
        const collected = collect(); if (!collected.ok) throw new Error('請先修正商品欄位');
        const basePatch = creating ? collected.out : changedFields(collected.out, productBaseSnapshot);
        const contentPatch = { ...basePatch, ...specPatch };
        // Image-only specification edits need no SQL catalog synchronization.
        const specIdentity = (value) => JSON.stringify({ enabled: value?.specificationsEnabled, groups: (value?.specifications ?? []).map((group) => ({ id: group._key, name: group.name, options: group.options.map((option) => ({ id: option._key, name: option.name })) })) });
        const needsSync = creating || ['name', 'slug', 'enabled', 'category'].some((key) => key in basePatch) || (specDraft && specIdentity(specValue) !== specIdentity(specDraft.baseline));
        if (Object.keys(contentPatch).length || creating) {
          const endpoint = creating ? defs.product.api : defs.product.api + '/' + encodeURIComponent(state.selectedId);
          const result = await api(endpoint, { method: creating ? 'POST' : 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: contentPatch }) });
          const saved = normOne(result); if (!saved || !kOf(saved)) throw new Error('商品已寫入，但回傳資料不完整，請重新載入確認');
          hasCommittedContent = true;
          state.selectedId = kOf(saved); state.selected = { ...state.selected, ...saved };
          if (creating) state.entries.unshift(saved); else state.entries = state.entries.map((entry) => kOf(entry) === state.selectedId ? { ...entry, ...saved } : entry);
          productBaseSnapshot = { ...productBaseSnapshot, ...basePatch };
          if (specDraft) specDraft.baseline = structuredClone(specValue);
          productSyncPending = productSyncPending || Boolean(needsSync);
        }
        let persistedRows = productCommerceRows, persistedSettings = productCommerceSettings;
        if (productSyncPending) {
          setStatus('正在同步此商品的變更…');
          const synced = await commerceApi('/api/admin/product-commerce', { method: 'POST', body: JSON.stringify({ action: 'sync', sanityProductId: state.selectedId, includeCommerce: true }) });
          if (synced.result?.errors?.length || !Array.isArray(synced.rows)) throw new Error(synced.result?.errors?.[0]?.message || '商品規格同步失敗，請重試');
          persistedRows = synced.rows; persistedSettings = synced.settings; productSyncPending = false;
        }
        if (skuChanges.length || Object.keys(settingsPatch).length) {
          setStatus('正在儲存價格、庫存及購買設定…');
          const persisted = await commerceApi('/api/admin/product-commerce', { method: 'POST', body: JSON.stringify({ action: 'save-changes', sanityProductId: state.selectedId, changes: skuChanges.map((entry) => {
            const target = persistedRows.find((row) => (row.variantKey || null) === (entry.draft.row.variantKey || null));
            if (!target) throw new Error('找不到新規格，變更已保留，請重試儲存');
            const patch = { ...entry.patch };
            if (entry.draft.row.isPreview && patch.sku === entry.draft.baseline.sku) delete patch.sku;
            return { productSkuId: target.productSkuId, ...patch };
          }), ...(Object.keys(settingsPatch).length ? { settings: settingsPatch } : {}) }) });
          skuChanges.forEach((entry) => { entry.draft.baseline = structuredClone(entry.value); });
          if (salesDraft) salesDraft.baseline = structuredClone(salesValue);
          persistedRows = persisted.rows; persistedSettings = persisted.settings;
        }
        const productId = state.selectedId;
        fill(state.selected, { redrawList: false, loadCommerce: false });
        if (Array.isArray(persistedRows) && persistedRows.length) {
          const summary = buildCommerceSummary(persistedRows).get(productId);
          if (summary) state.commerceSummary.set(productId, summary);
          const rows = selectProductEditorSkus(persistedRows, Boolean(state.selected.specificationsEnabled), (state.selected.variants ?? []).map((variant) => String(variant._key ?? '')));
          renderProductCommerceRows(rows, persistedSettings);
        } else productCommerceReady = loadProductCommerce();
        productCommercePanel.dataset.savePhase = 'saved'; state.dirty = false; drawList(); setStatus('全部變更已儲存');
      } catch (error) {
        state.dirty = true;
        productCommercePanel.dataset.savePhase = 'error';
        setStatus((hasCommittedContent ? '商品內容已儲存；其餘變更保留待重試：' : '儲存失敗：') + (error instanceof Error ? error.message : String(error)));
      } finally {
        state.saving = false; saveBtn.disabled = false; saveBtn.removeAttribute('aria-busy'); saveBtn.removeAttribute('data-saving');
        [formRoot, productCommercePanel, entryList, modelTabs].forEach((element) => { element.inert = false; });
        [newBtn, refreshBtn, simpleModeToggle].forEach((button) => { button.disabled = false; });
      }
    }

    async function save() {
      if (state.model === 'product' && !isProductSortMode()) return saveAllProductChanges();
      if (state.saving) return;
      state.saving = true;
      saveBtn.setAttribute('data-saving', '1');
      saveBtn.setAttribute('aria-busy', 'true');
      saveBtn.setAttribute('disabled', 'true');
      if (isCategorySortMode()) {
        try {
          await saveCategoryOrder();
        } finally {
          state.saving = false;
          saveBtn.removeAttribute('data-saving');
          saveBtn.removeAttribute('aria-busy');
          saveBtn.removeAttribute('disabled');
        }
        return;
      }
      if (isProductSortMode()) {
        try {
          await saveProductCategoryOrder();
        } finally {
          state.saving = false;
          saveBtn.removeAttribute('data-saving');
          saveBtn.removeAttribute('aria-busy');
          saveBtn.removeAttribute('disabled');
        }
        return;
      }
      const { ok, out } = collect();
      if (!ok) {
        setStatus('請先修正欄位');
        state.saving = false;
        saveBtn.removeAttribute('data-saving');
        saveBtn.removeAttribute('aria-busy');
        saveBtn.removeAttribute('disabled');
        return;
      }
      try {
        const mediaCards = Array.from(formRoot.querySelectorAll('.card')).filter((x) => x.dataset.type === 'media');
        for (const card of mediaCards) {
          await applyPendingUploads(card, { interactive: false });
        }
        const { ok: ok2, out: out2 } = collect();
        if (!ok2) {
          setStatus('請先修正欄位');
          return;
        }
        const hasId = Boolean(state.selectedId);
        const endpoint = hasId ? `${defs[state.model].api}/${state.selectedId}` : defs[state.model].api;
        const idBeforeSave = state.selectedId;
        const resJson = await api(endpoint, { method: hasId ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: out2 }) });
        let reselectId = idBeforeSave;
        if (!hasId) {
          const created = normOne(resJson);
          if (created) reselectId = kOf(created);
        }
        state.dirty = false;
        setStatus(hasId ? '更新成功' : '新增成功');
        await load(reselectId || undefined);
      } finally {
        state.saving = false;
        saveBtn.removeAttribute('data-saving');
        saveBtn.removeAttribute('aria-busy');
        saveBtn.removeAttribute('disabled');
      }
    }

    const searchToggle = document.getElementById('searchToggle');
    const searchFilters = searchInput.closest('.listpane__filters');
    const setSearchExpanded = (expanded) => {
      searchFilters.classList.toggle('is-search-open', expanded);
      searchToggle.setAttribute('aria-expanded', String(expanded));
      searchToggle.setAttribute('aria-label', expanded ? '收合搜尋' : searchInput.value ? '展開搜尋，已套用搜尋條件' : '展開搜尋');
      searchToggle.innerHTML = expanded ? '<i class="fa-solid fa-xmark" aria-hidden="true"></i>' : '<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>';
      if (expanded) searchInput.focus(); else searchToggle.focus();
    };
    searchToggle.addEventListener('click', () => setSearchExpanded(searchToggle.getAttribute('aria-expanded') !== 'true'));
    searchInput.addEventListener('keydown', (event) => { if (event.key === 'Escape' && searchFilters.classList.contains('is-search-open')) { event.preventDefault(); setSearchExpanded(false); } });
    searchInput.addEventListener('input', () => { searchToggle.classList.toggle('has-query', Boolean(searchInput.value.trim())); });
    searchInput.addEventListener('input', () => {
      if (isProductSortMode()) return;
      drawList();
    });
    categoryFilter.addEventListener('change', drawList);
    editCategoriesBtn.addEventListener('click', () => {
      if (!confirmDiscardIfDirty()) return;
      void switchModel('category', { categorySortMode: true, mobilePanel: 'list' });
    });
    productListSort.addEventListener('change', drawList);
    productStatusFilter.addEventListener('change', drawList);
    const simpleModeLabel = simpleModeToggle.querySelector('.action-btn__label');
    simpleModeToggle.onclick = () => {
      if (state.model === 'product' && state.dirty) { setStatus('請先儲存變更，再切換編輯模式'); return; }
      state.simpleMode = !state.simpleMode;
      simpleModeToggle.classList.toggle('is-on', state.simpleMode);
      simpleModeToggle.classList.toggle('is-off', !state.simpleMode);
      simpleModeToggle.setAttribute('aria-pressed', state.simpleMode ? 'true' : 'false');
      const t = state.simpleMode ? '簡易' : '完整';
      if (simpleModeLabel) simpleModeLabel.textContent = t;
      void drawForm()
        .then(() => syncPublicSiteButtons())
        .catch((e) => setStatus(`表單更新失敗：${e.message}`));
    };
    refreshBtn.onclick = () => void refreshCurrentView().catch((e) => setStatus(`載入失敗：${e.message}`));
    newBtn.onclick = () => {
      if (!confirmDiscardIfDirty()) return;
      if (isCategorySortMode()) {
        openCategoryModal('create');
        return;
      }
      if (isProductSortMode()) {
        setStatus('此頁僅調整排序，不提供新增');
        return;
      }
      const attrs = schemas[state.model].attributes;
      const x = {};
      Object.keys(attrs).forEach((k) => {
        if (attrs[k].type === 'boolean') x[k] = Boolean(attrs[k].default);
        else if (attrs[k].type === 'media') x[k] = attrs[k].multiple ? [] : null;
        else x[k] = attrs[k].default ?? '';
      });
      if (state.model === 'product') x.slug = slug5();
      if (state.model === 'product') x.enabled = true;
      fill(x);
      state.dirty = true;
      setStatus('新增模式（待儲存）');
      if (isMobileNarrow()) setMobilePanel('editor');
    };

    // 分類 modal events
    catModalBackdrop.addEventListener('click', closeCategoryModal);
    catModalClose.addEventListener('click', closeCategoryModal);
    catModalCancel.addEventListener('click', closeCategoryModal);
    catModalSave.addEventListener('click', () => {
      void saveCategoryModal().catch((e) => setStatus(`儲存失敗：${e instanceof Error ? e.message : String(e)}`));
    });
    catModalDelete.addEventListener('click', () => {
      if (catModalState.mode !== 'edit') return;
      const row = state.entries.find((r) => kOf(r) === catModalState.id) ?? { name: catModalName.value, documentId: catModalState.id, id: catModalState.id };
      void deleteCategory(row).then(() => closeCategoryModal()).catch((e) => setStatus(`刪除失敗：${e instanceof Error ? e.message : String(e)}`));
    });

    // 商品移除確認
    productRemoveBackdrop.addEventListener('click', closeProductRemoveModal);
    productRemoveClose.addEventListener('click', closeProductRemoveModal);
    productRemoveCancel.addEventListener('click', closeProductRemoveModal);
    productRemoveConfirm.addEventListener('click', () => {
      void confirmProductRemove();
    });
    catModalName.addEventListener('input', () => {
      if (catModalState.manualSlug) return;
      const next = slugify(catModalName.value);
      if (next) catModalSlug.value = next;
    });
    catModalSlug.addEventListener('input', () => {
      catModalState.manualSlug = true;
    });
    window.addEventListener('resize', () => {
      if (!isMobileNarrow()) setMobilePanel('editor');
      else {
        const p = root.dataset.mobilePanel;
        if (p !== 'list' && p !== 'editor') setMobilePanel('list');
      }
    });
    saveBtn.onclick = () => save().catch((e) => setStatus(`儲存失敗：${e instanceof Error ? e.message : String(e)}`));

    if (openFrontendBtn) {
      openFrontendBtn.addEventListener('click', () => {
        openPublicFrontendPreview();
      });
    }
    if (showQrBtn) {
      showQrBtn.addEventListener('click', () => {
        const url = buildPublicFrontendUrl();
        if (!url) {
          setStatus('無法產生 QR：請先選取有 slug 的項目');
          return;
        }
        openQrModal(url);
      });
    }
    if (qrModalBackdrop) qrModalBackdrop.addEventListener('click', closeQrModal);
    if (qrModalClose) qrModalClose.addEventListener('click', closeQrModal);
    if (qrModalSaveImg) qrModalSaveImg.addEventListener('click', () => void saveQrPhoto());
    if (qrModalCopyImg) qrModalCopyImg.addEventListener('click', () => void copyQrPhoto());
    if (qrModalShare) qrModalShare.addEventListener('click', () => void shareQrContent());

    // 若後端沒有設 STRAPI_API_TOKEN，通常會得到 401/403；提供一次性輸入 token 的 fallback。
    window.addEventListener('keydown', (e) => {
      if (!(e instanceof KeyboardEvent)) return;
      if (e.key !== 'T' || !e.altKey) return;
      const current = readToken();
      const next = window.prompt('輸入 Strapi API Token（僅保存在此瀏覽器）\n\n清空可輸入空字串。', current);
      if (next == null) return;
      writeToken(String(next).trim());
      setStatus(readToken() ? '已設定 Token（Alt+T 可修改）' : '已清除 Token（改用部署環境變數）');
    });

    state.simpleMode = true;
    simpleModeToggle.classList.add('is-on');
    if (simpleModeLabel) simpleModeLabel.textContent = '簡易';
    drawTabs();
    const narrow = isMobileNarrow();
    if (narrow) setMobilePanel('list');
    else setMobilePanel('editor');
    const initialParams = new URLSearchParams(window.location.search);
    const requestedModel = initialParams.get('model');
    const initialModel = requestedModel === 'product' || requestedModel === 'category' || requestedModel === 'promotion'
      ? requestedModel
      : 'product';
    const initialProductSlug = initialParams.get('product') ?? '';
    const initialOptions = {
      ...(narrow ? { mobilePanel: 'list' } : {}),
      ...(initialModel === 'product' && initialProductSlug ? { selectEntrySlug: initialProductSlug } : {})
    };
    switchModel(initialModel, initialOptions)
      .catch((e) => setStatus(`初始化失敗：${e.message}`));
    imgPreviewBackdrop.addEventListener('click', closePreview);
    imgPreviewClose.addEventListener('click', closePreview);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (qrModal instanceof HTMLElement && !qrModal.hidden) {
        closeQrModal();
        return;
      }
      if (!(imgPreviewModal instanceof HTMLElement) || imgPreviewModal.hidden) return;
      closePreview();
    });
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      const status = document.getElementById('statusText');
      const titleStatus = document.getElementById('titleStatus');
      const titleStatusDesktop = document.getElementById('titleStatusDesktop');
      if (status) status.textContent = `後台初始化失敗：${message}`;
      if (titleStatus) titleStatus.textContent = '初始化失敗';
      if (titleStatusDesktop) titleStatusDesktop.textContent = `初始化失敗：${message}`;
      console.error('[admin-dashboard:init]', error);
    }
  </script>
</AdminLayout>

<style is:global>
  .line-float { display: none !important; }
  .mobile-sanity-bar,
  .mobile-hub {
    display: none;
  }
  .desktop-sanity-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: linear-gradient(180deg, #ffffff 0%, #fafbff 100%);
    border: 1px solid #e8ecf4;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(91, 108, 180, 0.05);
  }
  .adminx[data-dirty='true'] .desktop-sanity-bar {
    border-color: rgba(248, 113, 113, 0.42);
    box-shadow:
      0 2px 10px rgba(91, 108, 180, 0.05),
      inset 0 -3px 0 #f87171;
  }
  .desktop-sanity-bar__logo {
    color: #7b8fd4;
    font-size: 1.1rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .desktop-sanity-bar__title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #2a3148;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }
  .desktop-sanity-bar .title-status--desktop {
    margin-left: auto;
    display: inline-flex;
    max-width: min(42%, 420px);
  }
  /* 勿在 main 上使用 overflow-x: hidden，否則子層 position:sticky 可能無法貼視窗頂 */
  .adminx {
    width: min(1500px, 100% - 16px);
    margin: 8px auto 18px;
    display: grid;
    gap: 10px;
    max-width: 100%;
    box-sizing: border-box;
  }
  .topbar {
    --tb-accent: #6b83d6;
    --tb-accent-soft: #8fa3e8;
    --tb-accent-deep: #5a6fbc;
    --tb-ink: #2a3148;
    --tb-border: #e8ecf4;
    --tb-surface: #fafbff;
    position: relative;
    top: auto;
    z-index: 50;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 18px;
    padding: 14px 16px 18px;
    overflow-x: hidden;
    overflow-y: visible;
    background: linear-gradient(165deg, #ffffff 0%, #fafbff 45%, #f3f5fc 100%);
    border: 1px solid var(--tb-border);
    border-radius: 14px;
