    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cat-manage-row__meta {
    font-size: 0.78rem;
    color: #64748b;
  }
  .cat-manage-row__ops {
    display: grid;
    grid-template-columns: repeat(6, 34px);
    gap: 6px;
    justify-content: end;
  }
  .cat-manage-row__btn {
    width: 34px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #c5d4f0;
    background: linear-gradient(180deg, #e8eeff 0%, #dce4fb 100%);
    color: #1f2a44;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
  }
  .cat-manage-row__btn[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .cat-manage-row__btn--del {
