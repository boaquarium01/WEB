  .product-commerce-state button { display: inline-flex; justify-content: center; align-items: center; gap: 7px; min-height: 46px; padding: 0 13px; border: 0; border-radius: 9px; background: #0f766e; color: #fff; font: inherit; font-size: .84rem; font-weight: 800; cursor: pointer; }
