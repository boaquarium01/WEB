  .product-commerce-sku > label small { color: #829294; font-size: .7rem; font-weight: 550; }
  .product-commerce-sku input[type='number'] { width: 100%; min-width: 0; height: 46px; box-sizing: border-box; padding: 0 12px; border: 1px solid #cadbd7; border-radius: 9px; background: #fff; color: #183d3b; font: inherit; font-size: 1rem; }
  .product-commerce-sale-options { display: inline-flex; align-items: center; justify-content: stretch; gap: 5px; width: 100%; min-width: 0; box-sizing: border-box; margin: 0; padding: 4px; border: 1px solid #cadbd7; border-radius: 9px; background: #f3f8f7; }
  .product-commerce-sale-options label { position: relative; display: inline-flex; flex: 1 1 0; align-items: center; justify-content: center; min-height: 36px; padding: 0 8px; border-radius: 6px; color: #617779; font-size: .8rem; font-weight: 800; white-space: nowrap; cursor: pointer; }
