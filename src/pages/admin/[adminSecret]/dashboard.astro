    background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%);
  }

  .status { margin: 0 0 8px; font-weight: 700; color: #334155; }
  .form-grid { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* 精簡後台：移除欄位區塊外框，改用簡潔分隔 */
  .card {
    border: 0;
    border-radius: 0;
    padding: 5px 0;
    background: transparent;
    display: grid;
    gap: 6px;
    box-shadow: none;
  }
  .form-grid > .card {
    border-bottom: 1px solid rgba(219, 228, 234, 0.55);
    padding-bottom: 6px;
    margin-bottom: 2px;
  }
  .form-grid > .card:last-child {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .form-grid > .card:first-child {
    padding-top: 0;
  }
  .card.span2 { grid-column: 1 / -1; }

  /* 分類欄位：標籤 + 下拉合併同一列（減少高度） */
  .card[data-field="category"] {
    grid-template-columns: 84px 1fr;
    align-items: center;
    column-gap: 8px;
    row-gap: 0;
    padding-block: 5px;
  }
  .card[data-field="category"] > label {
    margin: 0;
    white-space: nowrap;
  }
  .card[data-field="category"] > select {
    margin: 0;
  }
  .card label { font-weight: 700; color: #334155; }
  .card input, .card textarea, .card select {
    width: 100%;
    min-height: 40px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
    font: inherit;
    box-sizing: border-box;
  }
  .card textarea { min-height: 110px; }
  /* 摘要等短欄（excerpt）：與單行 input 同高，不套用大文字框 min-height */
  .card textarea[rows='2'] {
    min-height: 40px;
    height: 40px;
    resize: none;
    line-height: normal;
    overflow: hidden;
  }
  /* 全文／區塊編輯（span2）：較預設約 +10% */
  .card.span2 textarea {
    min-height: calc(110px * 1.1);
  }
  .slug-card input[readonly] { background: #f1f5f9; color: #334155; font-weight: 700; letter-spacing: .08em; }
  .product-commerce-panel {
