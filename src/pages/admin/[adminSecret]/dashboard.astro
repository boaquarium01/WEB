  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .action-btn,
    .mode-btn,
    .tab > i,
    .action-btn > i,
    .title-status {
      transition: none !important;
      animation: none !important;
    }
    .tab:hover,
    .tab.is-active,
    .actions .action-btn--solid:hover,
    .mode-btn:hover {
      transform: none;
    }
    #saveBtn.is-dirty {
      animation: none;
      box-shadow:
        0 0 0 2px rgba(248, 113, 113, 0.35),
        0 2px 10px rgba(239, 68, 68, 0.12);
    }
    #saveBtn.is-dirty > i::after {
      animation: none;
    }
  }

