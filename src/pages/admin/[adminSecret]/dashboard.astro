    /** 勿用 overflow-x:auto／hidden，否則按鈕 box-shadow、hover 上移會被裁成「切邊」 */
    .actions > .action-btn,
    .actions > .mode-btn {
      position: relative;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      flex: 0 0 auto;
      width: 100%;
      min-width: 0;
      min-height: 50px;
      height: 100%;
      align-self: stretch;
      padding: 2px 3px 3px;
      font-size: 0.74rem;
      border-radius: 12px;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      border-color: rgba(199, 210, 236, 0.88);
      box-shadow:
        0 2px 10px rgba(91, 108, 180, 0.07),
        0 1px 2px rgba(15, 23, 42, 0.04),
        inset 0 1px 0 rgba(255, 255, 255, 0.88);
      transition:
        transform 0.18s ease,
        box-shadow 0.22s ease,
        border-color 0.2s ease,
        filter 0.2s ease,
        background 0.22s ease;
    }
    .actions > .action-btn--solid {
      background: linear-gradient(165deg, #f0f3ff 0%, #e2e9fb 55%, #d9e2f8 100%);
    }
    .actions > .mode-btn.is-on {
      border-color: rgba(199, 210, 236, 0.92);
      background: linear-gradient(165deg, #f0f3ff 0%, #e2e9fb 55%, #d9e2f8 100%);
      box-shadow:
        0 2px 10px rgba(91, 108, 180, 0.08),
        0 1px 2px rgba(15, 23, 42, 0.04),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .actions > .mode-btn.is-off {
      border-color: rgba(218, 224, 238, 0.75);
      background: linear-gradient(165deg, #ffffff 0%, #f7f9fc 50%, #f0f3f9 100%);
      box-shadow:
        0 1px 5px rgba(15, 23, 42, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
      color: #4a5568;
    }
    .actions > .action-btn > i,
    .actions > .mode-btn > i {
      flex: 1 1 0;
      min-height: 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .actions > #saveBtn {
      min-width: 0;
      min-height: 50px;
      height: 100%;
      padding: 4px 6px 5px;
      font-size: 0.88rem;
      font-weight: 800;
      border-radius: 12px;
      border-color: rgba(199, 210, 236, 0.95);
      background: linear-gradient(165deg, #f3f6ff 0%, #e6edfc 50%, #dce6fa 100%);
      box-shadow:
        0 2px 12px rgba(91, 108, 180, 0.1),
        0 1px 2px rgba(15, 23, 42, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.92);
    }
    .actions > #saveBtn.is-dirty {
      color: #7a1f1f;
      border-color: rgba(239, 68, 68, 0.55);
      background: linear-gradient(165deg, #fff5f5 0%, #ffe4e4 48%, #fecdd3 100%);
      box-shadow:
        0 0 0 1px rgba(248, 113, 113, 0.22),
        0 2px 14px rgba(239, 68, 68, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.75);
      animation: admin-save-dirty-pulse 1.65s ease-in-out infinite;
    }
    .actions .action-btn--solid:hover,
    .actions .mode-btn:hover {
      transform: none;
      filter: brightness(1.02);
      border-color: rgba(176, 192, 230, 0.95);
      box-shadow:
        0 4px 16px rgba(91, 108, 180, 0.11),
        0 1px 3px rgba(15, 23, 42, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
    }
    .actions > .mode-btn.is-off:hover {
      border-color: rgba(200, 208, 228, 0.9);
      background: linear-gradient(165deg, #ffffff 0%, #fafbfd 100%);
    }
    .actions > #saveBtn.is-dirty:hover {
      border-color: rgba(220, 38, 38, 0.5);
      filter: brightness(1.03);
      box-shadow:
        0 0 0 1px rgba(248, 113, 113, 0.28),
        0 4px 18px rgba(239, 68, 68, 0.16),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    .actions .action-btn--solid:active,
    .actions .mode-btn:active {
      transform: scale(0.985);
      box-shadow:
        0 1px 6px rgba(91, 108, 180, 0.07),
        inset 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .actions > #saveBtn > i {
      font-size: 1.18rem;
    }
    .actions > .action-btn:not(#saveBtn) > i,
    .actions > .mode-btn > i {
      font-size: 1.12rem;
    }
    .actions > .action-btn .action-btn__label,
    .actions > .mode-btn .action-btn__label {
      display: block;
      flex: 0 0 auto;
      position: static;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 1px 1px 0;
      clip: auto;
      clip-path: none;
      font-size: 0.64rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: 0.04em;
      color: #4b5a73;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .actions > #saveBtn .action-btn__label {
      font-size: 0.66rem;
      color: var(--tb-ink, #2a3148);
      letter-spacing: 0.05em;
    }
