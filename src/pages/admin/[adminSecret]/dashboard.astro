  @keyframes admin-save-dirty-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(248, 113, 113, 0.28),
        0 2px 12px rgba(239, 68, 68, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.65);
    }
    50% {
      box-shadow:
        0 0 0 4px rgba(248, 113, 113, 0.12),
        0 4px 18px rgba(239, 68, 68, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.75);
    }
  }
  @keyframes admin-dirty-save-dot {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.85;
    }
  }
  #saveBtn.is-dirty {
    color: #7a1f1f;
    border-color: #f87171;
    background: linear-gradient(180deg, #fff5f5 0%, #ffe4e4 45%, #fecaca 100%);
    font-weight: 800;
    animation: admin-save-dirty-pulse 1.65s ease-in-out infinite;
  }
  #saveBtn.is-dirty > i {
    position: relative;
  }
  #saveBtn.is-dirty > i::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dc2626;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.95);
    pointer-events: none;
    animation: admin-dirty-save-dot 1.1s ease-in-out infinite;
  }
  @keyframes admin-saving-bar {
    0% {
      transform: translateX(-110%);
    }
    100% {
      transform: translateX(110%);
    }
  }
  @keyframes admin-saving-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  #saveBtn[data-saving='1'] {
    position: relative;
    filter: saturate(1.05);
    /* reserve space so progress bar never overlaps label */
    padding-bottom: 16px;
  }
  #saveBtn .save-progress {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 2px;
    height: 2px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(148, 163, 184, 0.35);
    box-shadow: inset 0 1px 1px rgba(15, 23, 42, 0.06);
    pointer-events: none;
    opacity: 0;
    transform: translateZ(0);
  }
  #saveBtn[data-saving='1'] .save-progress {
    opacity: 1;
  }
  #saveBtn .save-progress::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(59, 130, 246, 0) 0%,
      rgba(59, 130, 246, 0.95) 45%,
      rgba(59, 130, 246, 0) 100%
    );
    transform: translateX(-110%);
    animation: admin-saving-bar 1.05s ease-in-out infinite;
  }
  #saveBtn[data-saving='1'] > i {
    animation: admin-saving-spin 0.95s linear infinite;
    transform-origin: 50% 50%;
    position: relative;
    z-index: 1;
  }
  #saveBtn[data-saving='1'] > .action-btn__label {
    position: relative;
    z-index: 1;
  }
  /* 儲存中避免紅點跟著旋轉造成干擾 */
  #saveBtn[data-saving='1'] > i::after {
    display: none;
  }
  .adminx[data-dirty='true'] .title-status {
    color: #7f1d1d;
    border-color: #f87171;
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
