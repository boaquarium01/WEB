---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readStrapiAdminBaseUrl } from '../../../lib/strapi/env';
import { readAdminBackend } from '../../../lib/admin/adminBackend';
import { getAdminBasePath } from '../../../lib/admin/path';
import promotionSchema from '../../../data/admin-schemas/promotion/schema.json';
import productSchema from '../../../data/admin-schemas/product/schema.json';
import categorySchema from '../../../data/admin-schemas/category/schema.json';

type Schema = {
  config?: { metadatas?: Record<string, { edit?: { label?: string } }> };
  attributes: Record<string, { type: string; required?: boolean; multiple?: boolean; default?: unknown }>;
};

const schemas = {
  promotion: promotionSchema as Schema,
  product: productSchema as Schema,
  category: categorySchema as Schema
};

const defs = {
  promotion: { label: '促銷', api: '/api/promotions', title: 'title' },
  product: { label: '商品', api: '/api/products', title: 'name' },
  category: { label: '分類', api: '/api/categories', title: 'name' }
};

const base = readStrapiAdminBaseUrl() || 'http://localhost:1337';
const adminBackend = readAdminBackend();
/** 官網前台 origin（供「官網預覽／QR」）；可用 PUBLIC_SITE_URL 覆寫；未設則由瀏覽器用目前網站 origin */
const publicSiteBase = String(import.meta.env.PUBLIC_SITE_URL ?? '').replace(/\/+$/, '');
const adminBasePath = getAdminBasePath();
const shopAdminHref = `${adminBasePath}/shop`;
const shopProductsHref = `${shopAdminHref}/products`;
---

<AdminLayout title="商品管理｜水博館水族官方網站後台" description="官網內容、圖片、價格與庫存整合管理">
  <div
    class="adminx"
    data-schemas={JSON.stringify(schemas)}
    data-defs={JSON.stringify(defs)}
    data-base={base}
    data-admin-backend={adminBackend}
    data-public-site-base={publicSiteBase}
    data-shop-products-href={shopProductsHref}
  >
    <section class="workspace">
      <aside class="listpane">
        <div class="listpane__filters">
          <select id="categoryFilter" class="search search--category" style="display:none;">
            <option value="">分類</option>
          </select>
          <button id="editCategoriesBtn" type="button" class="category-edit-entry" style="display:none;">
            <i class="fa-solid fa-folder-tree" aria-hidden="true"></i><span>編輯分類</span>
          </button>
          <select id="productListSort" class="search search--sort" aria-label="商品排序" style="display:none;">
            <option value="default">排序</option>
            <option value="name-asc">名稱↑</option>
            <option value="price-asc">價格↑</option>
            <option value="price-desc">價格↓</option>
            <option value="stock-asc">庫存↑</option>
            <option value="stock-desc">庫存↓</option>
          </select>
          <select id="productStatusFilter" class="search search--status" aria-label="商品狀態篩選" style="display:none;">
            <option value="all">狀態</option>
            <option value="enabled">上架</option>
            <option value="disabled">未上架</option>
            <option value="sellable">販售</option>
            <option value="unsellable">禁售</option>
          </select>
          <button id="searchToggle" class="search-toggle" type="button" aria-label="展開搜尋" aria-expanded="false" aria-controls="productSearchField"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
          <div id="productSearchField" class="search-wrap">
            <span class="search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input id="searchInput" type="search" aria-label="搜尋目前清單" class="search search--with-icon" placeholder="搜尋目前清單..." />
          </div>
        </div>
        <div id="listCount" class="count">載入中...</div>
        <div id="entryList" class="entry-list"></div>
      </aside>

      <header class="topbar">
        <span id="sectionLabelMobile" hidden></span>
        <span id="titleStatus" hidden>準備中</span>
        <span id="titleStatusDesktop" hidden>準備中</span>
        <div class="center-nav">
          <div class="center-nav__meta">
            <span id="sectionLabelDesktop" class="section-label section-label--desktop" aria-live="polite">商品</span>
          </div>
          <div id="modelTabs" class="tabs"></div>
        </div>
        <div class="actions">
          <button id="simpleModeToggle" class="mode-btn is-on action-btn" type="button" aria-pressed="true" aria-label="切換簡易或完整編輯模式">
            <i class="fa-solid fa-sliders" aria-hidden="true"></i>
            <span class="action-btn__label">簡易</span>
          </button>
          <button id="refreshBtn" type="button" class="action-btn action-btn--solid" aria-label="重整清單">
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
            <span class="action-btn__label">重整</span>
          </button>
          <button id="newBtn" type="button" class="action-btn action-btn--solid" aria-label="新增一筆">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span class="action-btn__label">新增</span>
          </button>
          <button id="openFrontendBtn" type="button" class="action-btn action-btn--solid action-btn--frontend" hidden aria-label="在瀏覽器中開啟官網對應頁面（預覽）">
            <i class="fa-solid fa-globe" aria-hidden="true"></i>
            <span class="action-btn__label">預覽</span>
          </button>
          <button id="showQrBtn" type="button" class="action-btn action-btn--solid action-btn--qrcode" hidden aria-label="顯示前台網址 QR Code">
            <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
            <span class="action-btn__label">QR</span>
          </button>
          <button id="saveBtn" type="button" class="action-btn action-btn--solid" aria-label="儲存變更">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
            <span class="action-btn__label">儲存</span>
          </button>
        </div>
      </header>

      <section class="formpane">
        <div class="formpane__section-head">
          <span id="sectionLabelForm" class="formpane__section-title" aria-live="polite"></span>
        </div>
        <p id="statusText" class="status" style="display:none;">準備中...</p>
        <section id="productCommercePanel" class="product-commerce-panel" hidden aria-live="polite"></section>
        <form id="formRoot" class="form-grid"></form>
      </section>
    </section>

    <!-- 分類管理：新增/編輯/刪除（避免 prompt 在手機被阻擋） -->
    <div id="catManageModal" class="cat-modal" hidden role="dialog" aria-modal="true" aria-label="分類管理">
      <button id="catModalBackdrop" class="cat-modal__backdrop" type="button" aria-label="關閉"></button>
      <section class="cat-modal__panel" role="document">
        <header class="cat-modal__head">
          <h3 id="catModalTitle" class="cat-modal__title">分類管理</h3>
          <button id="catModalClose" class="cat-modal__close" type="button" aria-label="關閉">✕</button>
        </header>
        <div class="cat-modal__body">
          <label class="cat-modal__label">
            <span>分類名稱</span>
            <input id="catModalName" type="text" autocomplete="off" />
          </label>
          <label class="cat-modal__label">
            <span>slug（英文網址名稱）</span>
            <input id="catModalSlug" type="text" autocomplete="off" placeholder="例如 fish / equipment" />
          </label>
          <p class="cat-modal__hint">slug 建議小寫英數與連字號（-），需唯一。</p>
        </div>
        <footer class="cat-modal__foot">
          <button id="catModalDelete" type="button" class="cat-modal__btn cat-modal__btn--danger" hidden>刪除</button>
          <div class="cat-modal__spacer"></div>
          <button id="catModalCancel" type="button" class="cat-modal__btn">取消</button>
          <button id="catModalSave" type="button" class="cat-modal__btn cat-modal__btn--primary">儲存</button>
        </footer>
      </section>
    </div>

    <!-- 商品移除確認（避免 prompt 在手機被阻擋） -->
    <div id="productRemoveModal" class="cat-modal" hidden role="dialog" aria-modal="true" aria-label="移除此品項">
      <button id="productRemoveBackdrop" class="cat-modal__backdrop" type="button" aria-label="關閉"></button>
      <section class="cat-modal__panel" role="document">
        <header class="cat-modal__head">
          <h3 id="productRemoveTitle" class="cat-modal__title">移除此品項</h3>
          <button id="productRemoveClose" class="cat-modal__close" type="button" aria-label="關閉">✕</button>
        </header>
        <div class="cat-modal__body">
          <p id="productRemoveMsg" class="cat-modal__hint" style="margin:0;font-size:.95rem;line-height:1.5;color:#334155;white-space:pre-line;"></p>
        </div>
        <footer class="cat-modal__foot">
          <div class="cat-modal__spacer"></div>
          <button id="productRemoveCancel" type="button" class="cat-modal__btn">取消</button>
          <button id="productRemoveConfirm" type="button" class="cat-modal__btn cat-modal__btn--danger">確認移除</button>
        </footer>
      </section>
    </div>
  </div>

  <!-- 置於 main 外：全螢幕 fixed 不受 .adminx overflow／寬度影響（RWD 預覽） -->
    <div id="qrModal" class="qr-modal" hidden role="dialog" aria-modal="true" aria-label="前台網址 QR Code">
      <button type="button" id="qrModalBackdrop" class="qr-modal__backdrop" aria-label="關閉"></button>
      <div class="qr-modal__panel">
        <header class="qr-modal__head">
          <span class="qr-modal__title">前台網址</span>
          <button type="button" id="qrModalClose" class="qr-modal__close" aria-label="關閉">✕</button>
        </header>
        <div class="qr-modal__body">
          <p id="qrModalUrl" class="qr-modal__url"></p>
          <div class="qr-modal__imgWrap">
            <img id="qrModalImg" class="qr-modal__img" width="240" height="240" alt="" />
          </div>
          <div class="qr-modal__actions">
            <button type="button" id="qrModalSaveImg" class="qr-modal__btn qr-modal__btn--primary">儲存照片</button>
            <button type="button" id="qrModalCopyImg" class="qr-modal__btn qr-modal__btn--secondary">複製照片</button>
            <button type="button" id="qrModalShare" class="qr-modal__btn qr-modal__btn--secondary">分享</button>
          </div>
        </div>
      </div>
    </div>
    <div id="imgPreviewModal" class="img-modal" hidden>
    <button id="imgPreviewBackdrop" class="img-modal__backdrop" type="button" aria-label="關閉預覽"></button>
    <button id="imgPreviewClose" class="img-modal__close" type="button" aria-label="關閉">✕</button>
    <img id="imgPreviewEl" class="img-modal__img" alt="圖片預覽" />
  </div>

  <script>
    import { applyBodyScrollLock, releaseBodyScrollLock } from '../../../scripts/scrollLock';
    import { plainTextToStrapiBlocks, strapiBlocksToPlainText } from '../../../lib/strapi/blocks';
    import { normalizeSpecifications, generateSpecificationCombinations } from '../../../lib/sanity/specifications';
    import { validateQuantityPriceTiers } from '../../../lib/services/quantity-pricing';
    import { selectProductEditorSkus } from '../../../lib/services/product-sku-identity';

    try {
    const portableBlocksToPlainText = (blocks) => {
      if (!Array.isArray(blocks)) return '';
      return blocks
        .filter((block) => block && typeof block === 'object' && block._type === 'block' && Array.isArray(block.children))
        .map((block) => block.children.map((child) => child && typeof child === 'object' && 'text' in child ? String(child.text ?? '') : '').join('').trim())
        .filter(Boolean)
        .join('\n');
    };
    const root = document.querySelector('.adminx');
    if (!(root instanceof HTMLElement)) throw new Error('missing root');
    const schemas = JSON.parse(root.dataset.schemas ?? '{}');
    const defs = JSON.parse(root.dataset.defs ?? '{}');
    const base = (root.dataset.base ?? 'http://localhost:1337').replace(/\/+$/, '');
    const adminBackend = root.dataset.adminBackend === 'strapi' ? 'strapi' : 'sanity';

    const openFrontendBtn = document.getElementById('openFrontendBtn');
    const showQrBtn = document.getElementById('showQrBtn');
    const qrModal = document.getElementById('qrModal');
    const qrModalBackdrop = document.getElementById('qrModalBackdrop');
    const qrModalClose = document.getElementById('qrModalClose');
    const qrModalUrl = document.getElementById('qrModalUrl');
    const qrModalImg = document.getElementById('qrModalImg');
    const qrModalSaveImg = document.getElementById('qrModalSaveImg');
    const qrModalCopyImg = document.getElementById('qrModalCopyImg');
    const qrModalShare = document.getElementById('qrModalShare');

    const modelTabs = document.getElementById('modelTabs');
    const refreshBtn = document.getElementById('refreshBtn');
    const newBtn = document.getElementById('newBtn');
    const saveBtn = document.getElementById('saveBtn');
    const simpleModeToggle = document.getElementById('simpleModeToggle');
    const searchInput = document.getElementById('searchInput');
    const entryList = document.getElementById('entryList');
    const categoryFilter = document.getElementById('categoryFilter');
    const editCategoriesBtn = document.getElementById('editCategoriesBtn');
    const productListSort = document.getElementById('productListSort');
    const productStatusFilter = document.getElementById('productStatusFilter');
    const listCount = document.getElementById('listCount');
    const formRoot = document.getElementById('formRoot');
    const productCommercePanel = document.getElementById('productCommercePanel');
    const shopProductsHref = root.dataset.shopProductsHref ?? '';
    const statusText = document.getElementById('statusText');
    const titleStatus = document.getElementById('titleStatus');
    const titleStatusDesktop = document.getElementById('titleStatusDesktop');
    const sectionLabelMobile = document.getElementById('sectionLabelMobile');
    const sectionLabelForm = document.getElementById('sectionLabelForm');
    const sectionLabelDesktop = document.getElementById('sectionLabelDesktop');
    const imgPreviewModal = document.getElementById('imgPreviewModal');
    const imgPreviewBackdrop = document.getElementById('imgPreviewBackdrop');
    const imgPreviewClose = document.getElementById('imgPreviewClose');
    const imgPreviewEl = document.getElementById('imgPreviewEl');
    const catManageModal = document.getElementById('catManageModal');
    const catModalBackdrop = document.getElementById('catModalBackdrop');
    const catModalClose = document.getElementById('catModalClose');
    const catModalTitle = document.getElementById('catModalTitle');
    const catModalName = document.getElementById('catModalName');
    const catModalSlug = document.getElementById('catModalSlug');
    const catModalHint = document.querySelector('.cat-modal__hint');
    const catModalCancel = document.getElementById('catModalCancel');
    const catModalSave = document.getElementById('catModalSave');
    const catModalDelete = document.getElementById('catModalDelete');
    const productRemoveModal = document.getElementById('productRemoveModal');
    const productRemoveBackdrop = document.getElementById('productRemoveBackdrop');
    const productRemoveClose = document.getElementById('productRemoveClose');
    const productRemoveTitle = document.getElementById('productRemoveTitle');
    const productRemoveMsg = document.getElementById('productRemoveMsg');
    const productRemoveCancel = document.getElementById('productRemoveCancel');
    const productRemoveConfirm = document.getElementById('productRemoveConfirm');
    if (!modelTabs || !refreshBtn || !newBtn || !saveBtn || !simpleModeToggle || !searchInput || !entryList || !categoryFilter || !editCategoriesBtn || !productListSort || !productStatusFilter || !listCount || !formRoot || !productCommercePanel || !statusText || !titleStatus || !titleStatusDesktop || !sectionLabelMobile || !sectionLabelForm || !sectionLabelDesktop || !imgPreviewModal || !imgPreviewBackdrop || !imgPreviewClose || !imgPreviewEl) {
      throw new Error('missing ui');
    }
    if (!productRemoveModal || !productRemoveBackdrop || !productRemoveClose || !productRemoveTitle || !productRemoveMsg || !productRemoveCancel || !productRemoveConfirm) {
      throw new Error('missing product remove modal');
    }

    // Save progress bar (avoid pseudo-element layering issues).
    if (saveBtn instanceof HTMLElement && !saveBtn.querySelector('.save-progress')) {
      const p = document.createElement('span');
      p.className = 'save-progress';
      p.setAttribute('aria-hidden', 'true');
      saveBtn.appendChild(p);
    }
    if (!catManageModal || !catModalBackdrop || !catModalClose || !catModalTitle || !catModalName || !catModalSlug || !catModalCancel || !catModalSave || !catModalDelete) {
      throw new Error('missing category modal ui');
    }

    const state = { model: 'product', entries: [], selectedId: '', selected: {}, categoryOptions: [], simpleMode: true, pendingUploads: {}, dirty: false, saving: false, categorySortMode: false, productSortMode: false, commerceLoadSequence: 0, commerceSummarySequence: 0, commerceSummary: new Map() };
    let productBaseSnapshot = {}, productSpecificationDraft = null, productSalesDraft = null;
    const productSkuDrafts = new Map();
    const productSkuPreviewCache = new Map();
    let productCommerceRows = [], productCommerceSettings = null, productCommerceReady = Promise.resolve();
    let productSyncPending = false, specificationUploads = 0;
    let productSelectionSequence = 0;
    const PRODUCT_LIST_BATCH_SIZE = 25;
    let productListShown = PRODUCT_LIST_BATCH_SIZE, productListKey = '';
    let productListObserver = null;
    const productListMore = document.createElement('button');
    productListMore.type = 'button'; productListMore.className = 'product-list-more';
    productListMore.addEventListener('click', () => drawList({ append: true }));
    const changedFields = (current, original) => Object.fromEntries(Object.entries(current).filter(([key, value]) => JSON.stringify(value) !== JSON.stringify(original?.[key])));
    productCommercePanel.addEventListener('input', () => markDirty());
    productCommercePanel.addEventListener('change', () => markDirty());
    productCommercePanel.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('button')) markDirty(); });

    const isCategorySortMode = () => state.model === 'category' && state.categorySortMode;
    const isProductSortMode = () => state.model === 'product' && state.productSortMode;

    function getPublicSiteOrigin() {
      const raw = root.dataset.publicSiteBase ?? '';
      const configured = String(raw).trim().replace(/\/+$/, '');
      if (configured && /^https?:\/\//i.test(configured)) return configured;
      // 外網同站部署（Vercel／自訂網域）未設 PUBLIC_SITE_URL 時，用目前網站 origin
      try {
        const origin = String(window.location?.origin ?? '').replace(/\/+$/, '');
        if (origin && /^https?:\/\//i.test(origin)) return origin;
      } catch {}
      return 'https://boaquarium.vercel.app';
    }
    /** 對應官網前台路徑：促銷 /promo/:slug、商品 /product/:slug、分類 /products/1?category=:slug */
    function buildPublicFrontendUrl() {
      if (isCategorySortMode() || isProductSortMode()) return '';
      const m = state.model;
      const slugOf = (row) => {
        const raw = row?.slug ?? row?.attributes?.slug ?? '';
        if (raw && typeof raw === 'object') return String(raw.current ?? '').trim();
        return String(raw ?? '').trim();
      };
      if (m === 'promotion') {
        const s = slugOf(state.selected);
        if (!s) return '';
        return `${getPublicSiteOrigin()}/promo/${encodeURIComponent(s)}`;
      }
      if (m === 'product') {
        const s = slugOf(state.selected);
        if (!s) return '';
        return `${getPublicSiteOrigin()}/product/${encodeURIComponent(s)}`;
      }
      if (m === 'category' && !isCategorySortMode()) {
        const s = slugOf(state.selected);
        if (!s) return '';
        return `${getPublicSiteOrigin()}/products/1?category=${encodeURIComponent(s)}`;
      }
      return '';
    }
    function syncPublicSiteButtons() {
      const url = buildPublicFrontendUrl();
      const has = Boolean(url);
      if (openFrontendBtn instanceof HTMLButtonElement) {
        openFrontendBtn.hidden = !has;
        openFrontendBtn.disabled = !has;
        if (has) openFrontendBtn.title = `預覽：${url}`;
        else openFrontendBtn.removeAttribute('title');
      }
      if (showQrBtn instanceof HTMLButtonElement) {
        showQrBtn.hidden = !has;
        showQrBtn.disabled = !has;
        showQrBtn.dataset.frontendUrl = url;
      }
    }
    /** 外網勿用 window.open(..., features)：會被當成彈出視窗擋下而「沒反應」 */
    function openPublicFrontendPreview() {
      const url = buildPublicFrontendUrl();
      if (!url) {
        setStatus('無法預覽：請先選取有 slug 的項目');
        return;
      }
      try {
        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setStatus(`已開啟預覽`);
      } catch (e) {
        const opened = window.open(url, '_blank');
        if (!opened) {
          setStatus(`無法開啟預覽（可能被瀏覽器阻擋）。網址：${url}`);
          return;
        }
        setStatus('已開啟預覽');
      }
    }
    function openQrModal(url) {
      if (!(qrModal instanceof HTMLElement) || !qrModalUrl || !(qrModalImg instanceof HTMLImageElement)) return;
      qrModalUrl.textContent = url;
      qrModalImg.alt = `QR：${url}`;
      qrModalImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=10&data=${encodeURIComponent(url)}`;
      qrModal.hidden = false;
      qrModal.setAttribute('aria-hidden', 'false');
      try {
        applyBodyScrollLock();
      } catch {}
    }
    function closeQrModal() {
      if (!(qrModal instanceof HTMLElement)) return;
      qrModal.hidden = true;
      qrModal.setAttribute('aria-hidden', 'true');
      if (qrModalImg instanceof HTMLImageElement) {
        qrModalImg.removeAttribute('src');
        qrModalImg.alt = '';
      }
      if (qrModalCopyImg instanceof HTMLButtonElement) {
        if (copyQrSuccessTimer) {
          window.clearTimeout(copyQrSuccessTimer);
          copyQrSuccessTimer = 0;
        }
        qrModalCopyImg.classList.remove('is-success');
        qrModalCopyImg.textContent = '複製照片';
        qrModalCopyImg.setAttribute('aria-label', '複製照片');
      }
      try {
        releaseBodyScrollLock();
      } catch {}
    }

    async function getQrImageBlob() {
      if (!(qrModalImg instanceof HTMLImageElement) || !qrModalImg.src) return null;
      try {
        const res = await fetch(qrModalImg.src, { mode: 'cors' });
        if (!res.ok) return null;
        return await res.blob();
      } catch {
        return null;
      }
    }

    function suggestQrFilename() {
      const publicUrl = qrModalUrl?.textContent?.trim() ?? '';
      if (!publicUrl) return `boaquarium-qrcode-${Date.now()}.png`;
      try {
        const u = new URL(publicUrl);
        const parts = u.pathname.split('/').filter(Boolean);
        const last = parts[parts.length - 1] || 'qrcode';
        const safe = String(last).replace(/[^a-zA-Z0-9\u4e00-\u9fff-_]/g, '_').slice(0, 48);
        return `boaquarium-qrcode-${safe || 'link'}.png`;
      } catch {
        return `boaquarium-qrcode-${Date.now()}.png`;
      }
    }

    async function saveQrPhoto() {
      const fn = suggestQrFilename();
      const blob = await getQrImageBlob();
      if (blob && blob.size > 0) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fn;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        setStatus('已下載 QR 圖');
        return;
      }
      const src = qrModalImg instanceof HTMLImageElement ? qrModalImg.src : '';
      if (!src) {
        setStatus('無 QR 圖可下載');
        return;
      }
      const a = document.createElement('a');
      a.href = src;
      a.download = fn;
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setStatus('已觸發下載（若未儲存請在新分頁長按圖片另存）');
    }

    let copyQrSuccessTimer = 0;
    function markCopyQrPhotoSuccess() {
      if (!(qrModalCopyImg instanceof HTMLButtonElement)) return;
      qrModalCopyImg.classList.add('is-success');
      qrModalCopyImg.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i><span>已複製</span>';
      qrModalCopyImg.setAttribute('aria-label', '已複製照片');
      if (copyQrSuccessTimer) window.clearTimeout(copyQrSuccessTimer);
      copyQrSuccessTimer = window.setTimeout(() => {
