    async function copyQrPhoto() {
      const blob = await getQrImageBlob();
      if (!blob || blob.size <= 0) {
        setStatus('無 QR 圖可複製');
        return;
      }
      const mime = blob.type && blob.type.startsWith('image/') ? blob.type : 'image/png';
      const pngBlob =
        mime === 'image/png'
          ? blob
          : await (async () => {
              try {
                const bmp = await createImageBitmap(blob);
                const canvas = document.createElement('canvas');
                canvas.width = bmp.width;
                canvas.height = bmp.height;
                const ctx = canvas.getContext('2d');
                if (!ctx) return blob;
                ctx.drawImage(bmp, 0, 0);
                bmp.close?.();
                const out = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
                return out || blob;
              } catch {
                return blob;
              }
            })();
      try {
        if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') {
          throw new Error('clipboard-image-unsupported');
        }
        await navigator.clipboard.write([
          new ClipboardItem({
            [pngBlob.type || 'image/png']: pngBlob
          })
        ]);
        markCopyQrPhotoSuccess();
        setStatus('已複製 QR 照片到剪貼簿');
      } catch {
        try {
          const url = qrModalUrl?.textContent?.trim() ?? '';
          if (url) {
            await navigator.clipboard.writeText(url);
            setStatus('此瀏覽器不支援複製圖片，已改為複製網址');
            return;
          }
        } catch {}
        setStatus('無法複製照片（請改用儲存照片或手動截圖）');
      }
    }

    function isAbortError(err) {
      return (
        (err instanceof DOMException && err.name === 'AbortError') ||
        (err != null && typeof err === 'object' && 'name' in err && err.name === 'AbortError')
      );
    }

    async function shareQrContent() {
      const url = qrModalUrl?.textContent?.trim() ?? '';
      if (!url) {
        setStatus('沒有可分享的網址');
        return;
      }
      const title = '水博館｜前台連結';
      // Avoid duplicate links in some apps: keep URL only in `url`.
      const sharePayload = { title, text: '水博館前台連結', url };
      if (!navigator.share) {
        try {
          await navigator.clipboard.writeText(url);
          setStatus('已複製網址到剪貼簿');
        } catch {
          setStatus('無法複製，請手動複製上方網址');
        }
        return;
      }
      const blob = await getQrImageBlob();
      if (blob && blob.size > 0) {
        const fn = suggestQrFilename();
        const mime = blob.type && blob.type.startsWith('image/') ? blob.type : 'image/png';
        const file = new File([blob], fn, { type: mime });
        if (navigator.canShare?.({ files: [file] })) {
          try {
            await navigator.share({ ...sharePayload, files: [file] });
            return;
          } catch (e) {
            if (isAbortError(e)) return;
          }
        }
      }
      try {
        await navigator.share(sharePayload);
      } catch (e) {
        if (isAbortError(e)) return;
        try {
          await navigator.clipboard.writeText(url);
          setStatus('已複製網址到剪貼簿（分享不可用）');
        } catch {
          setStatus('分享失敗，請複製上方網址');
        }
      }
    }

