    async function api(path, init = {}) {
      const mergedHeaders = { ...(init.headers ?? {}), ...authHeaders() };
      if (adminBackend === 'sanity') {
        const method = String(init.method ?? 'GET').toUpperCase();
        let bodyField = null;
        if (method !== 'GET' && init.body != null) {
          bodyField = typeof init.body === 'string' ? init.body : JSON.stringify(init.body);
        }
        const res = await fetch('/api/admin/sanity-dashboard', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...mergedHeaders },
          body: JSON.stringify({ path, method, body: bodyField })
        });
        if (!res.ok) {
          const errJson = await res.json().catch(() => null);
          const msg = errJson?.error?.message ? `：${errJson.error.message}` : '';
          throw new Error(`HTTP ${res.status} ${path}${msg}`);
        }
        return res.json();
      }
      const proxy = `/api/admin/strapi-proxy?path=${encodeURIComponent(path)}`;
      const res = await fetch(proxy, { ...init, headers: mergedHeaders });
      if (!res.ok) {
        const errJson = await res.json().catch(() => null);
        const msg = errJson?.error?.message ? `：${errJson.error.message}` : '';
        throw new Error(`HTTP ${res.status} ${path}${msg}`);
      }
      return res.json();
    }

    async function commerceApi(path, init = {}) {
      const res = await fetch(path, {
        ...init,
        headers: {
          ...(init.body ? { 'Content-Type': 'application/json' } : {}),
          ...(init.headers ?? {})
        }
      });
      const payload = await res.json().catch(() => null);
      if (!res.ok) {
        throw new Error(payload?.error?.message ?? `HTTP ${res.status}`);
      }
      return payload;
    }

    function buildCommerceSummary(rows) {
      const grouped = new Map();
      const rowsByProduct = new Map();
      (Array.isArray(rows) ? rows : []).forEach((row) => {
        const id = String(row.sanityProductId ?? '');
        const group = rowsByProduct.get(id) ?? []; group.push(row); rowsByProduct.set(id, group);
      });
      const editableRows = state.entries.flatMap((product) => selectProductEditorSkus(
        rowsByProduct.get(kOf(product)) ?? [], Boolean(product.specificationsEnabled),
        (product.variants ?? []).map((variant) => String(variant._key ?? '')),
      ));
      editableRows.forEach((row) => {
        const id = String(row?.sanityProductId ?? '').trim();
        if (!id) return;
        const current = grouped.get(id) ?? { prices: [], stock: 0, unlimited: false, hasSellableSku: false };
        const price = Number(row?.sellingPrice);
        const onHand = Number(row?.onHand);
        if (Number.isFinite(price)) current.prices.push(price);
        if (onHand < 0) current.unlimited = true;
        else if (Number.isFinite(onHand)) current.stock += Math.max(0, onHand);
        if (row.saleEnabled !== false && (onHand < 0 || onHand > 0)) current.hasSellableSku = true;
        grouped.set(id, current);
      });
      const summary = new Map();
      grouped.forEach((value, id) => {
        const prices = value.prices.sort((a, b) => a - b);
        const minPrice = prices.length ? prices[0] : null;
        const maxPrice = prices.length ? prices[prices.length - 1] : null;
        const priceText = minPrice == null
          ? '尚未定價'
          : minPrice === maxPrice
            ? `NT$ ${minPrice.toLocaleString('zh-TW')}`
            : `NT$ ${minPrice.toLocaleString('zh-TW')}–${maxPrice.toLocaleString('zh-TW')}`;
        summary.set(id, {
          price: minPrice,
          stock: value.unlimited ? Number.POSITIVE_INFINITY : value.stock,
          canSell: value.hasSellableSku,
          priceText,
          stockText: value.unlimited ? '庫存 不限量' : `庫存 ${value.stock.toLocaleString('zh-TW')}`
        });
      });
      return summary;
    }

