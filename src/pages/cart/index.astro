:1px solid #edf0ec;border-radius:0;background:transparent}.product-visual{display:grid;place-items:center;width:76px;height:76px;border-radius:16px;background:linear-gradient(145deg,#eff7f3,#dcece5);color:#438577;font-size:1.5rem}.product-info{min-width:0}.name{display:block;color:#24312d;font-size:.98rem;font-weight:750}.sku{margin:.35rem 0 0;color:#828d87;font-size:.8rem}.avail{margin:.25rem 0 0;color:#56836f;font-size:.76rem}.line .price{margin:.35rem 0 0;color:#65716c;font-size:.83rem}.actions{display:flex;align-items:center;gap:.5rem}.qty{display:flex;align-items:center;gap:.3rem;padding:.22rem;border:1px solid #e1e6e1;border-radius:11px}.qty input{width:44px;padding:.35rem .2rem;border:0;background:transparent;text-align:center;font:inherit;font-weight:700;color:var(--aq-ink)}.qty-update{width:30px;height:30px;border:0;border-radius:8px;background:#eef5f1;color:var(--aq-primary-dark);cursor:pointer}.danger{display:inline-flex;align-items:center;gap:.35rem;padding:.45rem .55rem;border:0!important;background:transparent!important;color:#a56a65!important;font-size:.78rem;cursor:pointer}.line-total{white-space:nowrap;font-size:.92rem;font-weight:800;color:#34423c}.continue{display:inline-flex;align-items:center;gap:.5rem;margin-top:1rem;color:var(--aq-primary-dark);font-size:.85rem;font-weight:700}.summary{position:sticky;top:100px;padding:1.35rem}.summary-title{margin:0 0 1.1rem;font-size:1.05rem;font-weight:800}.summary-row,.summary-total{display:flex;justify-content:space-between;gap:1rem;font-size:.85rem}.summary-row{margin:.8rem 0;color:#58645f}.summary-row.muted{padding-bottom:1rem;border-bottom:1px solid #edf0ec;color:#909994}.summary-total{align-items:center;padding-top:.25rem;font-weight:700}.summary-total strong{font-size:1.22rem;color:var(--aq-ink)}.checkout-btn{display:flex;align-items:center;justify-content:space-between;margin-top:1.2rem;padding:.9rem 1rem;border-radius:13px;background:var(--aq-primary);color:white!important;font-weight:750;text-decoration:none;box-shadow:0 8px 18px rgba(21,106,102,.18);transition:transform .15s,background .15s}.checkout-btn:hover{transform:translateY(-1px);background:var(--aq-primary-dark)}.secure{display:flex;align-items:center;justify-content:center;gap:.45rem;margin:.85rem 0 0;color:#8b9690;font-size:.72rem}.secure i{color:#5b9a78}.payment-note{display:flex;align-items:center;gap:.7rem;margin-top:1.2rem;padding:.8rem;border-radius:12px;background:#f7f9f6;color:#77827c;font-size:.73rem;line-height:1.45}.payment-note i{color:var(--aq-primary);font-size:1rem}.empty{padding:4rem 1.5rem;border:1px solid #e8ebe6;border-radius:22px;box-shadow:0 10px 30px rgba(35,49,42,.045)}.empty-icon{display:grid;place-items:center;width:66px;height:66px;margin:0 auto 1.2rem;border-radius:22px;background:#edf5f1;color:var(--aq-primary);font-size:1.45rem}.empty h2{margin:0 0 .4rem;font-size:1.25rem}.empty p{margin:0 0 1.3rem;color:var(--aq-muted)}.empty .btn-primary{gap:.6rem;border-radius:12px;padding:.8rem 1.1rem}
