---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatTwd } from '../../lib/services/catalog';
import { getCatalogProductBySlug } from '../../lib/services/catalog';
import {
	changeCartItemSku,
	getCartView,
	removeCartItem,
	updateCartItemQuantity,
} from '../../lib/services/cart';
import { listShippingMethods } from '../../lib/services/shipping';

export const prerender = false;

const user = Astro.locals.user!;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	const cartItemId = String(form.get('cartItemId') ?? '');

	try {
		if (action === 'update') {
			const quantity = Number(form.get('quantity'));
			await updateCartItemQuantity(user.id, cartItemId, quantity);
		} else if (action === 'remove') {
			await removeCartItem(user.id, cartItemId);
		} else if (action === 'change_sku') {
			await changeCartItemSku(user.id, cartItemId, String(form.get('productSkuId') ?? ''));
		}
	} catch (e) {
		error = e instanceof Error ? e.message : '操作失敗';
	}
}

const cart = await getCartView(user.id);

/** 可變更規格的商品：有命名規格、且至少兩個可購買的 SKU；給購物車「變更規格」面板使用 */
type SpecSheetData = {
	name: string;
	minimum: number;
	specifications: { id: string; name: string; options: { id: string; name: string; imageUrl: string | null }[] }[];
	skus: { id: string; name: string; price: number; available: number; optionIds: string[]; imageUrl: string | null; buyable: boolean }[];
};
const specData: Record<string, SpecSheetData> = {};
await Promise.all([...new Set(cart.items.map((item) => item.slug))].map(async (slug) => {
	try {
		const product = await getCatalogProductBySlug(slug);
		if (!product || !product.specifications.length) return;
		const skus = product.skus.filter((sku) => sku.optionIds?.length).map((sku) => ({
			id: sku.id,
			name: sku.name,
			price: sku.sellingPrice,
			available: sku.available,
			optionIds: sku.optionIds ?? [],
			imageUrl: sku.imageUrl ?? null,
			buyable: sku.isActive && sku.sellingPrice > 0 && (sku.available < 0 || sku.available >= product.minimumPurchaseQuantity),
		}));
		if (skus.filter((sku) => sku.buyable).length < 2) return;
		specData[slug] = {
			name: product.name,
			minimum: product.minimumPurchaseQuantity,
			specifications: product.specifications.map((spec) => ({ id: spec.id, name: spec.name, options: spec.options.map((option) => ({ id: option.id, name: option.name, imageUrl: option.imageUrl ?? null })) })),
			skus,
		};
	} catch {
		// 讀不到商品資料時，這列就不提供變更規格
	}
}));
/** 購物車只做運費預估：以第一個啟用的配送方式為準，實際以結帳選擇為準 */
let shippingHint: { name: string; fee: number; threshold: number | null } | null = null;
try {
	const method = (await listShippingMethods(true))[0];
	if (method) shippingHint = { name: method.name, fee: method.fee, threshold: method.freeShippingThreshold };
} catch {
	shippingHint = null;
}
/** 商品列的單價／小計不顯示「NT」，只用 $ 開頭 */
const itemPrice = (amount: number) => `$${new Intl.NumberFormat('zh-TW').format(amount)}`;
const shipText = (subtotal: number) => {
	if (!shippingHint) return '';
	if (shippingHint.threshold === null) return `運費 ${formatTwd(shippingHint.fee)}（${shippingHint.name}）`;
	if (subtotal >= shippingHint.threshold) return `已達免運門檻，${shippingHint.name}免運費`;
	return `再買 ${formatTwd(shippingHint.threshold - subtotal)} 即可免運（${shippingHint.name}滿 ${formatTwd(shippingHint.threshold)}）`;
};
const shipProgress = (subtotal: number) =>
	shippingHint?.threshold ? Math.min(100, Math.round((subtotal / shippingHint.threshold) * 100)) : 0;
---

<SiteLayout title="購物車｜桃園中壢水博館水族" description="購物車" wide productBack={{ href: '/products/1', label: '上一頁' }}>
	<div class="cart-page" data-cart-id={cart.cartId} data-preserve-selection={Astro.request.method === 'POST' ? 'true' : 'false'}>
	<header class="head">
		<div class="title-row"><div><h1>購物車</h1><p class="subhead">確認商品與數量，準備完成訂單。</p></div></div>
		<div class="steps" aria-label="結帳流程"><span class="step active"><b>1</b>購物車</span><i></i><span class="step"><b>2</b>配送與付款</span><i></i><span class="step"><b>3</b>完成訂單</span></div>
	</header>

	{error && <p class="banner error">{error}</p>}

	{
		cart.items.length === 0 ? (
			<div class="empty">
				<span class="empty-icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
				<h2>購物車目前是空的</h2>
				<p>發現喜歡的商品，加入購物車後就會出現在這裡。</p>
				<a class="btn-primary" href="/products/1">開始逛逛<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</div>
		) : (
			<>
				<div class="cart-layout"><section class="cart-items-panel"><div class="cart-columns"><div class="mark-column"><label class="select-all"><input type="checkbox" data-select-all checked aria-label="全選商品" /></label></div><span class="column-product">商品</span><span class="column-unit-price">單價</span><span class="column-quantity">數量</span><span class="column-total">總計</span><button class="edit-toggle" type="button" data-edit-toggle>編輯</button></div><ul class="lines">
					{cart.items.map((item) => (
						<li class="line" data-cart-line data-item-id={item.cartItemId} data-product-id={item.productId} data-unit-price={item.unitPrice} data-base-unit-price={item.baseUnitPrice} data-minimum-purchase={item.minimumPurchaseQuantity} data-price-tiers={JSON.stringify(item.priceTiers)} data-stock-limit={item.available >= 0 ? item.available : ''} data-line-total={item.lineTotal} data-quantity={item.quantity}>
							<label class="line-select"><input type="checkbox" data-item-select value={item.cartItemId} checked aria-label={`選擇${item.productName}`} /></label>
							<div class="product-summary"><div class="product-visual" aria-hidden="true">{item.imageUrl ? <img src={item.imageUrl} alt="" loading="lazy" /> : <i class="fa-solid fa-fish-fins"></i>}</div><div class="product-info">
								<a href={`/product/${item.slug}`} class="name" title={item.productName}>
									{item.productName}
								</a>
								{specData[item.slug]
									? <button type="button" class="sku sku-select" data-change-spec={item.slug} data-sku-id={item.productSkuId} aria-haspopup="dialog" aria-label={`變更${item.productName}規格，目前：${item.skuName ?? ''}`}><span>{item.skuName && item.skuName !== item.productName ? item.skuName : '選擇規格'}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
									: (item.skuName && item.skuName !== item.productName) || item.minimumPurchaseQuantity > 1
										? <p class="sku">{[item.skuName && item.skuName !== item.productName ? item.skuName : '', item.minimumPurchaseQuantity > 1 ? `最低 ${item.minimumPurchaseQuantity} 件` : ''].filter(Boolean).join(' · ')}</p>
										: null}
							</div></div>
							<span class="unit-price" data-label="單價">{itemPrice(item.unitPrice)}</span>
							<div class="actions">
								<div class="qty-stock"><form method="post" class="qty">
									<input type="hidden" name="_action" value="update" />
									<input type="hidden" name="cartItemId" value={item.cartItemId} />
									<button type="button" data-quantity-step="-1" class="qty-step" aria-label={`減少${item.productName}數量`}>−</button>
									<input type="number" name="quantity" min="1" step="1" inputmode="numeric" {...(item.available >= 0 ? { max: Math.max(item.available, item.quantity) } : {})} value={item.quantity} aria-label={`${item.productName} 數量`} />
									<button type="button" data-quantity-step="1" data-max-quantity={item.available >= 0 ? item.available : ''} class="qty-step" aria-label={`增加${item.productName}數量`}>＋</button>
								</form>{item.available >= 0 && <p class="stock-limit" data-stock-warning hidden={item.quantity < item.available}>已達最大上限</p>}</div>
								<div class="edit-actions"><form method="post">
									<input type="hidden" name="_action" value="remove" />
									<input type="hidden" name="cartItemId" value={item.cartItemId} />
									<button type="submit" class="danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i>移除</button>
								</form></div>
							</div>
							<strong class="line-total" data-label="總計">{itemPrice(item.lineTotal)}</strong>
						</li>
					))}
				</ul></section>

				<aside class="summary" data-cart-summary><p class="summary-title">訂單摘要</p><div class="summary-total"><span>商品小計</span><strong data-summary-total>{formatTwd(cart.subtotal)}</strong></div>{shippingHint && <div class:list={['ship-hint', { 'is-free': shippingHint.threshold !== null && cart.subtotal >= shippingHint.threshold }]} data-ship-hint data-fee={shippingHint.fee} data-threshold={shippingHint.threshold ?? ''} data-method={shippingHint.name}><p data-ship-text><i class="fa-solid fa-truck" aria-hidden="true"></i><span>{shipText(cart.subtotal)}</span></p>{shippingHint.threshold !== null && <span class="ship-bar" aria-hidden="true"><i data-ship-progress style={`width:${shipProgress(cart.subtotal)}%`}></i></span>}</div>}<p class="selection-warning" data-selection-warning hidden>請先勾選要結帳的商品</p><a class="checkout-btn" data-checkout-link href={`/checkout?${cart.items.map((item) => `item=${encodeURIComponent(item.cartItemId)}`).join('&')}`}><span data-checkout-label>去買單（{cart.items.length}）</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><p class="secure"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>庫存與價格將於結帳時再次確認</p><div class="payment-note"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><span>下單後可於訂單頁查看付款與配送資訊</span></div></aside></div>
			</>
		)
	}
	{Object.keys(specData).length > 0 && (
		<dialog class="spec-sheet" data-spec-sheet aria-labelledby="spec-sheet-title">
			<form method="post" class="spec-sheet__form" data-spec-form>
				<input type="hidden" name="_action" value="change_sku" />
				<input type="hidden" name="cartItemId" data-spec-item />
				<input type="hidden" name="productSkuId" data-spec-sku />
				<header class="spec-sheet__head">
					<img class="spec-sheet__img" data-spec-img alt="" hidden />
					<div class="spec-sheet__summary">
						<h2 id="spec-sheet-title" data-spec-name></h2>
						<p class="spec-sheet__price" data-spec-price></p>
						<p class="spec-sheet__stock" data-spec-stock></p>
					</div>
					<button type="button" class="spec-sheet__close" data-spec-close aria-label="關閉"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
				</header>
				<div class="spec-sheet__body" data-spec-groups></div>
				<div class="spec-sheet__foot"><button type="submit" class="spec-sheet__confirm" data-spec-confirm>確認變更</button></div>
			</form>
		</dialog>
		<script type="application/json" id="cart-spec-data" set:html={JSON.stringify(specData).replace(/</g, '\\u003c')} />
	)}
	</div>
</SiteLayout>

<script>
	const cartRoot = document.querySelector<HTMLElement>('[data-cart-id]');
	const cartSummary = document.querySelector<HTMLElement>('[data-cart-summary]');
	if (cartRoot && cartSummary) {
		const storageKey = `cart-selection-${cartRoot.dataset.cartId}`;
		const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-cart-line]'));
		const checks = lines.map((line) => line.querySelector<HTMLInputElement>('[data-item-select]')).filter((check): check is HTMLInputElement => Boolean(check));
		const selectAll = document.querySelector<HTMLInputElement>('[data-select-all]');
		const checkout = document.querySelector<HTMLAnchorElement>('[data-checkout-link]');
		const warning = document.querySelector<HTMLElement>('[data-selection-warning]');
		const totalOutput = cartSummary.querySelector<HTMLElement>('[data-summary-total]');
		const editToggle = document.querySelector<HTMLButtonElement>('[data-edit-toggle]');
		editToggle?.addEventListener('click', () => {
			const editing = cartRoot.classList.toggle('is-editing');
			editToggle.textContent = editing ? '完成' : '編輯';
			editToggle.setAttribute('aria-pressed', String(editing));
		});
		const formatMoney = (amount: number) => `NT$ ${new Intl.NumberFormat('zh-TW').format(amount)}`;
		const formatItemPrice = (amount: number) => `$${new Intl.NumberFormat('zh-TW').format(amount)}`;
		const tierPrice = (base: number, quantity: number, tiers: Array<{minQuantity: number; maxQuantity: number | null; unitPrice: number}>) => tiers.filter((tier) => quantity >= tier.minQuantity && (tier.maxQuantity == null || quantity <= tier.maxQuantity)).sort((a, b) => b.minQuantity - a.minQuantity)[0]?.unitPrice ?? base;
		let savedIds: string[] | null = null;
		try {
			const raw = window.sessionStorage.getItem(storageKey);
			if (raw !== null) {
				const parsed: unknown = JSON.parse(raw);
				if (Array.isArray(parsed)) savedIds = parsed.filter((id): id is string => typeof id === 'string');
			}
		} catch { /* Private browsing may disable storage; selection still works for this page. */ }
		if (cartRoot.dataset.preserveSelection === 'true' && savedIds !== null) checks.forEach((check) => { check.checked = savedIds.includes(check.value); });

		const updateSelection = () => {
			const selected = checks.filter((check) => check.checked);
			const selectedSet = new Set(selected.map((check) => check.value));
			const selectedLines = lines.filter((line) => selectedSet.has(line.dataset.itemId ?? ''));
			const quantities = new Map<string, number>();
			for (const line of selectedLines) {
				const id = line.dataset.productId ?? '';
				quantities.set(id, (quantities.get(id) ?? 0) + Number(line.dataset.quantity ?? 0));
			}
			let minimumError = '';
			const subtotal = selectedLines.reduce((sum, line) => {
				const id = line.dataset.productId ?? '';
				const quantity = quantities.get(id) ?? 0;
				const minimum = Number(line.dataset.minimumPurchase ?? 1);
				if (quantity < minimum) minimumError = `「${line.querySelector('.name')?.textContent?.trim() ?? '商品'}」最低購買數量為 ${minimum} 件`;
				let tiers: Array<{minQuantity: number; maxQuantity: number | null; unitPrice: number}> = [];
				try { tiers = JSON.parse(line.dataset.priceTiers ?? '[]'); } catch { /* Ignore malformed display metadata; server remains authoritative. */ }
				const unit = tierPrice(Number(line.dataset.baseUnitPrice ?? line.dataset.unitPrice ?? 0), quantity, tiers);
				const total = unit * Number(line.dataset.quantity ?? 0);
				line.dataset.lineTotal = String(total);
				const unitNode = line.querySelector<HTMLElement>('.unit-price');
				if (unitNode) unitNode.textContent = formatItemPrice(unit);
				const totalNode = line.querySelector<HTMLElement>('.line-total');
				if (totalNode) totalNode.textContent = formatItemPrice(total);
				return sum + total;
			}, 0);
			if (selectAll) {
				selectAll.checked = selected.length === checks.length;
				selectAll.indeterminate = selected.length > 0 && selected.length < checks.length;
			}
			if (totalOutput) totalOutput.textContent = formatMoney(subtotal);
			const shipHint = cartSummary.querySelector<HTMLElement>('[data-ship-hint]');
			if (shipHint) {
				const fee = Number(shipHint.dataset.fee ?? 0);
				const threshold = shipHint.dataset.threshold ? Number(shipHint.dataset.threshold) : null;
				const method = shipHint.dataset.method ?? '宅配';
				const text = shipHint.querySelector<HTMLElement>('[data-ship-text] span');
				const bar = shipHint.querySelector<HTMLElement>('[data-ship-progress]');
				const free = threshold !== null && subtotal >= threshold;
				shipHint.classList.toggle('is-free', free);
				if (text) {
					text.textContent = threshold === null
						? `運費 ${formatMoney(fee)}（${method}）`
						: free
							? `已達免運門檻，${method}免運費`
							: `再買 ${formatMoney(threshold - subtotal)} 即可免運（${method}滿 ${formatMoney(threshold)}）`;
				}
				if (bar && threshold) bar.style.width = `${Math.min(100, Math.round((subtotal / threshold) * 100))}%`;
			}
			if (checkout) {
				const label = checkout.querySelector('[data-checkout-label]');
				if (label) label.textContent = `去買單（${selected.length}）`;
				checkout.setAttribute('aria-label', `去買單，已選 ${selected.length} 筆商品`);
				checkout.setAttribute('aria-disabled', String(selected.length === 0));
				checkout.classList.toggle('is-disabled', selected.length === 0);
				if (selected.length > 0) {
					const params = new URLSearchParams();
					selected.forEach((check) => params.append('item', check.value));
					checkout.href = `/checkout?${params.toString()}`;
				} else checkout.href = '#';
			}
			if (warning) { warning.textContent = minimumError || '請先勾選要結帳的商品'; warning.hidden = selected.length > 0 && !minimumError; }
			if (checkout) {
				checkout.setAttribute('aria-disabled', String(selected.length === 0 || Boolean(minimumError)));
				checkout.classList.toggle('is-disabled', selected.length === 0 || Boolean(minimumError));
			}
			try { window.sessionStorage.setItem(storageKey, JSON.stringify(selected.map((check) => check.value))); } catch { /* Ignore unavailable session storage. */ }
		};
		const persistQuantity = (form: HTMLFormElement) => {
			const priorTimer = Number(form.dataset.submitTimer ?? 0);
			window.clearTimeout(priorTimer);
			form.dataset.submitTimer = String(window.setTimeout(() => form.requestSubmit(), 350));
		};
		lines.forEach((line) => {
			const input = line.querySelector<HTMLInputElement>('.qty input[name="quantity"]');
			const total = line.querySelector<HTMLElement>('.line-total');
			const stockWarning = line.querySelector<HTMLElement>('[data-stock-warning]');
			if (!input || !total) return;
			const refreshLine = () => {
				const quantity = Math.max(1, Number(input.value) || 1);
				const lineTotal = Number(line.dataset.unitPrice ?? 0) * quantity;
				const stockLimit = line.dataset.stockLimit ?? '';
				if (stockWarning && stockLimit !== '') stockWarning.hidden = quantity < Number(stockLimit);
				line.dataset.quantity = String(quantity);
				line.dataset.lineTotal = String(lineTotal);
				total.textContent = formatItemPrice(lineTotal);
				updateSelection();
			};
			input.addEventListener('input', refreshLine);
			input.addEventListener('change', () => {
				refreshLine();
				if (input.checkValidity() && input.form) persistQuantity(input.form);
			});
			line.querySelectorAll<HTMLButtonElement>('[data-quantity-step]').forEach((button) => {
				button.addEventListener('click', () => {
					const next = Number(input.value) + Number(button.dataset.quantityStep);
					const maxText = button.dataset.maxQuantity ?? '';
					if (next < 1 || (maxText !== '' && next > Number(maxText))) return;
					input.value = String(next);
					refreshLine();
					if (input.form) persistQuantity(input.form);
				});
			});
		});
		checks.forEach((check) => check.addEventListener('change', updateSelection));
		selectAll?.addEventListener('change', () => {
			checks.forEach((check) => { check.checked = selectAll.checked; });
			updateSelection();
		});
		checkout?.addEventListener('click', (event) => {
			if (checks.every((check) => !check.checked) || checkout.getAttribute('aria-disabled') === 'true') {
				event.preventDefault();
				return;
			}
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			event.preventDefault();
			if (checkout.classList.contains('is-checkout-starting')) return;
			const destination = checkout.href;
			checkout.classList.add('is-checkout-starting');
			checkout.setAttribute('aria-busy', 'true');
			window.setTimeout(() => window.location.assign(destination), 240);
		});
		updateSelection();
	}

	// 點商品那一列的空白處、圖片或價格就進入商品頁；勾選框、數量、編輯按鈕等操作不受影響
	document.querySelectorAll<HTMLElement>('[data-cart-line]').forEach((line) => {
		const link = line.querySelector<HTMLAnchorElement>('a.name');
		if (!link) return;
		line.classList.add('is-linked');
		line.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('a, button, input, label, select, textarea, form, .edit-actions')) return;
			if (window.getSelection()?.toString()) return;
			if (event.metaKey || event.ctrlKey) window.open(link.href, '_blank');
			else window.location.href = link.href;
		});
	});

	// 變更規格：點規格框，由下往上滑出面板（與商品頁加入購物車相同的操作方式）
	type SpecSku = { id: string; name: string; price: number; available: number; optionIds: string[]; imageUrl: string | null; buyable: boolean };
	type SpecProduct = { name: string; minimum: number; specifications: { id: string; name: string; options: { id: string; name: string; imageUrl: string | null }[] }[]; skus: SpecSku[] };
	const specSheet = document.querySelector<HTMLDialogElement>('[data-spec-sheet]');
	const specJson = document.getElementById('cart-spec-data');
	if (specSheet && specJson) {
		const allSpecs = JSON.parse(specJson.textContent || '{}') as Record<string, SpecProduct>;
		const q = <T extends HTMLElement>(sel: string) => specSheet.querySelector<T>(sel)!;
		const groupsBox = q('[data-spec-groups]');
		const confirmBtn = q<HTMLButtonElement>('[data-spec-confirm]');
		const twd = (n: number) => `NT$ ${new Intl.NumberFormat('zh-TW').format(n)}`;
		let product: SpecProduct | null = null;
		let currentSkuId = '';
		let picked: string[] = [];

		const matchSku = () => product?.skus.find((sku) => sku.optionIds.length === picked.length && picked.every((id) => sku.optionIds.includes(id)));
		const render = () => {
			if (!product) return;
			const sku = matchSku();
			groupsBox.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((btn) => {
				const groupIndex = Number(btn.dataset.group);
				const trial = picked.map((id, i) => (i === groupIndex ? btn.dataset.option! : id));
				const possible = product!.skus.some((s) => s.buyable && trial.every((id) => s.optionIds.includes(id)));
				btn.setAttribute('aria-pressed', String(picked[groupIndex] === btn.dataset.option));
				btn.disabled = !possible;
			});
			q('[data-spec-price]').textContent = sku && sku.price > 0 ? twd(sku.price) : '請選擇規格';
			q('[data-spec-stock]').textContent = !sku ? '' : !sku.buyable ? '此規格目前無法購買' : sku.available < 0 ? '庫存充足' : `庫存 ${sku.available}`;
			const img = q<HTMLImageElement>('[data-spec-img]');
			const image = sku?.imageUrl || product.skus.find((s) => s.imageUrl)?.imageUrl || '';
			img.hidden = !image;
			if (image) img.src = image;
			q<HTMLInputElement>('[data-spec-sku]').value = sku?.id ?? '';
			confirmBtn.disabled = !sku || !sku.buyable;
			confirmBtn.textContent = sku && sku.id === currentSkuId ? '維持目前規格' : '確認變更';
		};

		document.querySelectorAll<HTMLButtonElement>('[data-change-spec]').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				product = allSpecs[trigger.dataset.changeSpec ?? ''] ?? null;
				if (!product) return;
				currentSkuId = trigger.dataset.skuId ?? '';
				const current = product.skus.find((sku) => sku.id === currentSkuId);
				picked = product.specifications.map((spec) => spec.options.find((o) => current?.optionIds.includes(o.id))?.id ?? '');
				q<HTMLInputElement>('[data-spec-item]').value = trigger.closest<HTMLElement>('[data-cart-line]')?.dataset.itemId ?? '';
				q('[data-spec-name]').textContent = product.name;
				groupsBox.replaceChildren(...product.specifications.map((spec, groupIndex) => {
					const fieldset = document.createElement('fieldset');
					fieldset.className = 'spec-sheet__group';
					const legend = document.createElement('legend');
					legend.textContent = spec.name;
					const options = document.createElement('div');
					options.className = 'spec-sheet__options';
					spec.options.forEach((option) => {
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'spec-sheet__option';
						btn.dataset.group = String(groupIndex);
						btn.dataset.option = option.id;
						if (option.imageUrl) {
							const thumb = document.createElement('img');
							thumb.src = option.imageUrl;
							thumb.alt = '';
							btn.append(thumb);
						}
						btn.append(option.name);
						btn.addEventListener('click', () => {
							picked[groupIndex] = option.id;
							// 換了這一組後若組合不存在，清掉後面組別的選擇，讓顧客重選
							if (!matchSku()?.buyable) picked = picked.map((id, i) => (i > groupIndex && !product!.skus.some((s) => s.buyable && picked.slice(0, i + 1).every((p) => s.optionIds.includes(p))) ? '' : id));
							render();
						});
						options.append(btn);
					});
					fieldset.append(legend, options);
					return fieldset;
				}));
				render();
				specSheet.showModal();
			});
		});

		q('[data-spec-close]').addEventListener('click', () => specSheet.close());
		specSheet.addEventListener('click', (event) => { if (event.target === specSheet) specSheet.close(); });
		q<HTMLFormElement>('[data-spec-form]').addEventListener('submit', (event) => {
			if (q<HTMLInputElement>('[data-spec-sku]').value === currentSkuId) {
				event.preventDefault();
				specSheet.close();
				return;
			}
			confirmBtn.disabled = true;
			confirmBtn.textContent = '變更中…';
		});
	}
</script>

