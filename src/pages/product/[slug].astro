		const cartButton = form.querySelector<HTMLButtonElement>('.btn-cart');
		const feedback = document.createElement('p'); feedback.className = 'purchase-feedback'; feedback.setAttribute('role', 'status'); feedback.hidden = true; form.appendChild(feedback);
		let completionTimer: ReturnType<typeof setTimeout> | undefined;
		let cartAnimation: Animation | null = null;
		const resetCartButton = () => {
			if (!cartButton) return;
			cartButton.innerHTML = '<i class="fa-solid fa-cart-plus" aria-hidden="true"></i>加入購物車';
			cartButton.classList.remove('is-complete');
			dockCart.innerHTML = '<i class="fa-solid fa-cart-plus" aria-hidden="true"></i>加入購物車';
		};
		const showCartAdded = (count?: number) => {
			closeSheet();
			dockCart.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>加入完成';
			if (cartButton) {
				cartButton.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>加入完成';
				cartButton.classList.add('is-complete');
			}
			feedback.hidden = true; feedback.textContent = '';
			const floatingCart = document.querySelector<HTMLElement>('.cart-float');
			if (floatingCart) {
				if (typeof count === 'number') {
					const badge = floatingCart.querySelector('.cart-float-count'); if (badge) badge.textContent = String(count);
					floatingCart.setAttribute('aria-label', '購物車，目前 ' + count + ' 件商品');
				}
				cartAnimation?.cancel(); cartAnimation = null;
				if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					const animation = floatingCart.animate([
						{ transform: 'scale(1)', boxShadow: '0 0 0 0 rgba(21,106,102,.3)' },
						{ transform: 'translateY(-6px) scale(1.1)', boxShadow: '0 0 0 9px rgba(21,106,102,.12)', offset: .4 },
						{ transform: 'scale(1)', boxShadow: '0 0 0 16px rgba(21,106,102,0)' }
					], { duration: 650, easing: 'ease-out', fill: 'none' });
					cartAnimation = animation;
					animation.finished.then(() => { animation.cancel(); if (cartAnimation === animation) cartAnimation = null; }, () => {});
				}
			}
			clearTimeout(completionTimer);
			completionTimer = setTimeout(() => { resetCartButton(); }, 2600);
		};
		form.addEventListener('keydown', (event) => {
			if (sheet.open && event.key === 'Enter' && event.target instanceof HTMLInputElement) {
				event.preventDefault();
				const confirm = form.querySelector<HTMLButtonElement>(sheet.dataset.intent === 'buy' ? '.btn-buy-now' : '.btn-cart');
				if (confirm && !confirm.disabled) form.requestSubmit(confirm);
			}
		});
		form.addEventListener('submit', async (event) => {
			if (purchasePending) { event.preventDefault(); return; }
			if (event.submitter instanceof HTMLButtonElement && event.submitter.value === 'buy-now') return;
			event.preventDefault();
			if (!form.reportValidity() || form.classList.contains('is-unavailable')) return;
			const body = new FormData(form);
			purchasePending = true; dockCart.disabled = dockBuy.disabled = true; clearTimeout(completionTimer); feedback.hidden = true;
			submitButtons.forEach((button) => { button.disabled = true; });
			if (cartButton) { cartButton.classList.remove('is-complete'); cartButton.setAttribute('aria-busy', 'true'); cartButton.textContent = '加入中…'; }
			try {
				const response = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
				const result = await response.json();
				if (result.redirect) { window.location.assign(result.redirect); return; }
				if (!response.ok) throw new Error(result.error || '加入購物車失敗');
				showCartAdded(result.itemCount);
			} catch (error) {
				resetCartButton(); feedback.hidden = false; feedback.textContent = error instanceof Error ? error.message : '無法確認加入結果，請先查看購物車';
			} finally {
				purchasePending = false; dockCart.disabled = dockBuy.disabled = false; cartButton?.removeAttribute('aria-busy');
				if (groups.length) updateVariantSelection(false);
				else submitButtons.forEach((button) => { button.disabled = form.classList.contains('is-unavailable'); });
			}
		});
		const currentUrl = new URL(window.location.href);
		if (currentUrl.searchParams.get('added') === '1') {
			showCartAdded(); currentUrl.searchParams.delete('added'); history.replaceState(history.state, '', currentUrl);
		}
		// Initialize from a complete purchasable combination, independently of restored form values.
		const initialOptions = variantData instanceof HTMLSelectElement && groups.length ? Array.from(variantData.options) : spec instanceof HTMLSelectElement ? Array.from(spec.options) : [];
		const initialChoice = initialOptions.find((option) => {
			const available = Number(option.dataset.available), amount = Number(option.dataset.price);
			if (option.disabled || !(amount > 0) || !(available < 0 || available >= minimumPurchase)) return false;
			if (!groups.length) return true;
			try { const ids = JSON.parse(option.dataset.optionIds ?? '[]'); return ids.length === groups.length && groups.every((group) => Array.from(group.querySelectorAll<HTMLElement>('[data-spec-option]')).some((choice) => ids.includes(choice.dataset.specOption))); } catch { return false; }
		});
		if (initialChoice) {
			if (spec instanceof HTMLSelectElement || spec instanceof HTMLInputElement) spec.value = initialChoice.value;
			if (groups.length) {
				const ids: string[] = JSON.parse(initialChoice.dataset.optionIds ?? '[]');
				groups.forEach((group) => group.querySelectorAll<HTMLElement>('[data-spec-option]').forEach((choice) => {
					const chosen = ids.includes(choice.dataset.specOption ?? ''); choice.setAttribute('aria-pressed', String(chosen));
					if (chosen) selectedIds.set((group as HTMLElement).dataset.specGroup ?? '', choice.dataset.specOption ?? '');
				}));
			}
			updateVariantSelection(false);
		} else { setUnavailable('暫無可購買規格'); updateOptionAvailability(); }
		updateQuantityBounds();
	}

	function setupProductLightbox() {
		setupGalleryLightbox({
			pageRootSelector: '[data-product-lightbox-group]',
			triggerSelector: '[data-product-lightbox-trigger]',
			indexOfTrigger: (trigger) => Number(trigger.dataset.index ?? 0),
			collectItems: () => Array.from(document.querySelectorAll('[data-product-lightbox-trigger]'))
				.map((element) => ({
					src: element.getAttribute('data-src') ?? '',
					alt: element.getAttribute('data-alt') ?? '',
				}))
				.filter((item) => item.src),
			lightboxId: 'productLightbox',
			backdropId: 'productLbBackdrop',
			closeBtnId: 'productLbClose',
			shellId: 'productLbShell',
			imgId: 'productLbImg',
			counterId: 'productLbCounter',
			prevBtnId: 'productLbPrev',
			nextBtnId: 'productLbNext',
			wheelDismiss: true,
			swipeDownDismiss: true,
		});
	}

	// Returning from the admin tab refreshes an already open product only when its data changed.
	let productRefreshInFlight = false, lastProductRefresh = 0;
	async function refreshProductIfChanged() {
		const detail = document.querySelector<HTMLElement>('[data-product-revision]');
		if (!detail || document.querySelector('.purchase-sheet[open]') || document.visibilityState !== 'visible' || productRefreshInFlight || Date.now() - lastProductRefresh < 1500 || document.querySelector('.btn-cart[aria-busy="true"]')) return;
		productRefreshInFlight = true; lastProductRefresh = Date.now();
		const pageUrl = window.location.href;
		try {
			const response = await fetch(pageUrl, { cache: 'no-store', headers: { Accept: 'text/html' } });
			if (!response.ok || response.redirected) return;
			const next = new DOMParser().parseFromString(await response.text(), 'text/html').querySelector<HTMLElement>('[data-product-revision]');
			if (next?.dataset.productRevision && next.dataset.productRevision !== detail.dataset.productRevision && detail.isConnected && window.location.href === pageUrl && document.visibilityState === 'visible' && !document.querySelector('.btn-cart[aria-busy="true"]') && !document.querySelector('.purchase-sheet[open]')) window.location.reload();
		} catch { /* Keep the current usable page when the freshness check is offline. */ }
		finally { productRefreshInFlight = false; }
	}
	window.addEventListener('focus', refreshProductIfChanged);
	document.addEventListener('visibilitychange', refreshProductIfChanged);
	window.addEventListener('pageshow', (event) => { if (event.persisted) void refreshProductIfChanged(); });

	setupProductLightbox();
	setupProductCarousels();
	setupProductPurchase();
	document.addEventListener('astro:page-load', setupProductLightbox);
	document.addEventListener('astro:page-load', setupProductCarousels);
	document.addEventListener('astro:page-load', setupProductPurchase);
</script>
