				const url = (event as CustomEvent<{ url: string }>).detail.url;
				const target = slides.findIndex((slide) => (slide as HTMLElement).dataset.src === url);
				if (target >= 0) { userInteracted = true; stop(); setIndex(target, 'auto'); }
