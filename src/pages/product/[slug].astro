---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { portableTextToHtml } from '../../lib/portable-text';
import {
	formatTwd,
	getCatalogProductBySlug,
} from '../../lib/services/catalog';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect('/products');
}

const product = await getCatalogProductBySlug(slug);
if (!product) {
	return Astro.redirect('/products');
}

const bodyHtml = portableTextToHtml(product.body);
const images = [
	...(product.imageUrl ? [product.imageUrl] : []),
	...product.galleryUrls,
];
const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const added = Astro.url.searchParams.get('added');
const defaultSkuId = product.defaultSkuId ?? product.skus[0]?.id ?? '';
---

<SiteLayout
	title={`${product.seoTitle ?? product.name}｜桃園中壢水博館水族`}
	description={product.seoDescription ?? product.excerpt ?? product.name}
	wide
	legacyFooter
	productBack={{
		href: product.categorySlug
			? `/products/1?category=${encodeURIComponent(product.categorySlug)}`
			: '/products',
		label: product.categoryLabel ?? '商品列表',
	}}
>
	<p class="crumb">
		<a href="/">首頁</a>
		<span>/</span>
		<a href="/products/1">本店商品</a>
		<span>/</span>
		{product.categorySlug && product.categoryLabel ? <><a href={`/products/1?category=${encodeURIComponent(product.categorySlug)}`}>{product.categoryLabel}</a><span>/</span></> : null}
		<span>{product.name}</span>
	</p>

	{error && <p class="banner error">{error}</p>}
	{added && <p class="banner ok">已加入購物車</p>}

	<article class="detail">
		<section class="media detail-media">
			{
				images.length > 0 ? (
					<div class="product-carousel" data-product-carousel data-product-lightbox-group aria-roledescription="輪播" aria-label={`${product.name} 商品圖片`}>
						<div class="carousel-main">
							<div class="carousel-viewport" tabindex="0" aria-label="滑動瀏覽商品圖片">
								<div class="carousel-track">
									{images.map((src, i) => (
										<button type="button" class="carousel-slide" data-product-lightbox-trigger data-index={String(i)} data-src={src} data-alt={`${product.name}（第 ${i + 1} 張）`} aria-label={`放大檢視第 ${i + 1} 張商品圖片`} aria-hidden={i === 0 ? 'false' : 'true'}>
											<span class="carousel-slide__stack">
												<img class="carousel-slide__blur" src={src} alt="" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} />
												<img class="carousel-slide__image" src={src} alt={i === 0 ? product.name : `${product.name}（第 ${i + 1} 張）`} loading={i === 0 ? 'eager' : 'lazy'} />
											</span>
										</button>
									))}
								</div>
							</div>
							{images.length > 1 && <>
								<button type="button" class="carousel-nav carousel-prev" aria-label="上一張圖片"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
								<button type="button" class="carousel-nav carousel-next" aria-label="下一張圖片"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
								<div class="carousel-dots" role="tablist" aria-label="選擇圖片">
									{images.map((_, i) => <button type="button" class:list={['carousel-dot', { 'is-active': i === 0 }]} aria-label={`第 ${i + 1} 張，共 ${images.length} 張`} aria-selected={i === 0 ? 'true' : 'false'} role="tab" />)}
								</div>
							</>}
						</div>
					</div>
				) : (
					<div class="placeholder">暫無圖片</div>
				)
			}
		</section>

		<section class="summary">
			{product.categoryLabel && (
				<span class="category-pill">{product.categoryLabel}</span>
			)}
			<h1>{product.name}</h1>
			<p class="price">{product.sellingPrice > 0 ? formatTwd(product.sellingPrice) : '價格洽詢'}</p>
			<p class:list={['stock', { out: !product.inStock }]}>
				{product.inStock ? (product.available < 0 ? '庫存充足' : `可售庫存 ${product.available}`) : '暫無庫存'}
			</p>
			{
				product.requiresManualConfirmation && (
					<p class="note">活體商品：出貨前可能需要人工確認。</p>
				)
			}
			{product.excerpt && <p class="excerpt">{product.excerpt}</p>}

			{
				user && defaultSkuId && product.sellingPrice > 0 ? (
					<form method="post" action="/api/cart/add" class="add-form">
						<input type="hidden" name="returnTo" value={`/product/${product.slug}`} />
						{product.skus.length > 1 ? (
							<label>
								規格
								<select name="productSkuId" required>
									{product.skus.map((sku) => (
										<option value={sku.id} selected={sku.id === defaultSkuId}>
										{sku.name} · {formatTwd(sku.sellingPrice)}（{sku.available < 0 ? '庫存充足' : `庫存 ${sku.available}`}）
										</option>
									))}
								</select>
							</label>
						) : (
							<input type="hidden" name="productSkuId" value={defaultSkuId} />
						)}
						<label>
							數量
							<input
								type="number"
								name="quantity"
								min="1"
								{...(product.available >= 0 ? { max: Math.max(product.available, 1) } : {})}
								value="1"
								required
							/>
						</label>
						<button
							class="btn-primary"
							type="submit"
							disabled={!product.inStock}
						>
							加入購物車
						</button>
					</form>
				) : !user ? (
					<p class="login-hint">
						<a href={`/account/login?next=${encodeURIComponent(`/product/${product.slug}`)}`}>
							登入
						</a>
						後即可加入購物車
					</p>
				) : <p class="note">商品價格尚待確認，請洽門市或 LINE 詢問。</p>
			}

			{
				bodyHtml ? (
					<section class="body">
						<h2>商品介紹</h2>
						<div class="prose" set:html={bodyHtml} />
					</section>
				) : (
					<p class="product-body-empty">尚未填寫商品介紹。</p>
				)
			}
			<p class="ref-note">網站價格／庫存供參考，實際以門市與訂單確認為準。</p>
			<div class="detail-back-actions">
				<a href="/" class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>首頁</a>
				<a href="/products/1" class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>全部</a>
				{product.categorySlug && product.categoryLabel && <a href={`/products/1?category=${encodeURIComponent(product.categorySlug)}`} class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>{product.categoryLabel}</a>}
			</div>
		</section>
	</article>

	<div id="productLightbox" class="product-lightbox" hidden role="dialog" aria-modal="true" aria-label="放大檢視商品圖片">
		<button type="button" id="productLbBackdrop" class="product-lightbox__backdrop" aria-label="關閉放大圖"></button>
		<button type="button" id="productLbClose" class="product-lightbox__close" aria-label="關閉">
			<i class="fa-solid fa-xmark" aria-hidden="true"></i>
		</button>
		<button type="button" id="productLbPrev" class="product-lightbox__nav product-lightbox__nav--prev" aria-label="上一張" hidden>
			<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
		</button>
		<button type="button" id="productLbNext" class="product-lightbox__nav product-lightbox__nav--next" aria-label="下一張" hidden>
			<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
		</button>
		<div id="productLbShell" class="product-lightbox__shell">
			<img id="productLbImg" class="product-lightbox__img" alt="" decoding="async" />
		</div>
		<p id="productLbCounter" class="product-lightbox__counter" aria-live="polite" hidden></p>
	</div>

</SiteLayout>

<style>
	.crumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		color: var(--aq-muted);
		font-size: 0.9rem;
		margin: 0 0 1rem;
	}

	.crumb a {
		text-decoration: none;
	}

	.banner {
		padding: 0.75rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 1rem;
	}

	.banner.ok {
		background: var(--aq-primary-soft);
		color: var(--aq-primary-dark);
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.detail {
		display: grid;
		gap: 28px;
		align-items: start;
	}

	@media (min-width: 900px) {
		.detail {
			grid-template-columns: 1fr 1fr;
		}
	}

	.product-carousel,.carousel-main{position:relative}.carousel-viewport{overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-behavior:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;touch-action:pan-x pinch-zoom}.carousel-viewport::-webkit-scrollbar{display:none}.carousel-track{display:flex}.carousel-slide{position:relative;flex:0 0 100%;aspect-ratio:4/3;overflow:hidden;padding:0;border:0;background:#e8e8e8;scroll-snap-align:start;scroll-snap-stop:always;cursor:zoom-in;-webkit-tap-highlight-color:transparent}.carousel-slide:focus-visible{outline:3px solid var(--aq-primary);outline-offset:-3px}.carousel-slide__stack{position:absolute;inset:0;overflow:hidden}.carousel-slide__blur{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;filter:blur(26px);transform:scale(1.14);opacity:.9;pointer-events:none}.carousel-slide__image{position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;max-width:none;max-height:none;margin:0;object-fit:contain;object-position:center;background:transparent}.carousel-nav{position:absolute;top:50%;z-index:3;display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:1px solid rgba(0,0,0,.08);border-radius:50%;color:#333;background:rgba(255,255,255,.9);box-shadow:0 1px 6px rgba(0,0,0,.08);transform:translateY(-50%);cursor:pointer;opacity:0;pointer-events:none;transition:opacity .2s ease}.carousel-main:hover .carousel-nav,.carousel-main:focus-within .carousel-nav,.carousel-main.carousel-show-nav .carousel-nav{opacity:1;pointer-events:auto}.carousel-prev{left:10px}.carousel-next{right:10px}.carousel-dots{position:absolute;left:0;right:0;bottom:12px;z-index:2;display:flex;justify-content:center;gap:8px}.carousel-dot{width:9px;height:9px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.75);box-shadow:0 0 0 1px rgba(0,0,0,.2);cursor:pointer}.carousel-dot.is-active{background:#111;box-shadow:0 0 0 2px rgba(255,255,255,.9);transform:scale(1.2)}@media(prefers-reduced-motion:reduce){.carousel-slide__blur{filter:none;transform:none;opacity:.45}.carousel-nav{transition:none}}

	.product-lightbox {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
		box-sizing: border-box;
	}

	.product-lightbox[hidden] { display: none !important; }

	.product-lightbox__backdrop {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(0, 0, 0, 0.82);
		cursor: pointer;
	}

	.product-lightbox__close,
	.product-lightbox__nav {
		position: absolute;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		color: #111;
		background: rgba(255, 255, 255, 0.96);
		cursor: pointer;
	}

	.product-lightbox__close {
		top: max(10px, env(safe-area-inset-top));
		right: max(10px, env(safe-area-inset-right));
		width: 46px;
		height: 46px;
		border-radius: 50%;
	}

	.product-lightbox__nav {
		top: 50%;
		width: 48px;
		height: 64px;
		border-radius: 12px;
		transform: translateY(-50%);
	}

	.product-lightbox__nav:not([hidden]) { display: inline-flex; }
	.product-lightbox__nav--prev { left: max(12px, env(safe-area-inset-left)); }
	.product-lightbox__nav--next { right: max(12px, env(safe-area-inset-right)); }

	.product-lightbox__shell {
		position: relative;
		z-index: 1;
		max-width: min(96vw, 1200px);
		max-height: min(88vh, 900px);
		touch-action: none;
	}

	.product-lightbox__img {
		display: block;
		max-width: 100%;
		max-height: min(88vh, 900px);
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 6px;
		box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45);
		user-select: none;
	}

	.product-lightbox__counter {
		position: absolute;
		left: 50%;
		bottom: max(8px, env(safe-area-inset-bottom));
		z-index: 3;
		margin: 0;
		padding: 8px 16px;
		border-radius: 999px;
		color: #fff;
		background: rgba(15, 23, 42, 0.72);
		transform: translateX(-50%);
		pointer-events: none;
	}

	.product-lightbox__counter[hidden] { display: none !important; }

	.placeholder {
		min-height: 16rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-lg);
		display: grid;
		place-items: center;
		color: var(--aq-muted);
		background: #fff;
	}

	.summary {
		min-width: 0;
	}

	.category-pill{display:inline-block;margin:0 0 12px;padding:4px 12px;border-radius:999px;background:#f0f0f0;color:#333;font-size:.8125rem;font-weight:600}

	h1 {
		margin: 0 0 12px;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
		line-height: 1.25;
	}

	.price {
		margin: 0;
		font-size: 1.45rem;
		font-weight: 750;
		color: var(--aq-primary-dark);
	}

	.stock {
		margin: 0.35rem 0 0;
		color: var(--aq-muted);
	}

	.stock.out {
		color: var(--aq-danger);
	}

	.note,
	.excerpt,
	.ref-note,
	.login-hint {
		color: var(--aq-muted);
		line-height: 1.6;
	}

	.add-form {
		display: grid;
		gap: 0.75rem;
		margin: 1.1rem 0;
	}

	label {
		display: grid;
		gap: 0.35rem;
		font-size: 0.92rem;
	}

	input,
	select {
		padding: 0.65rem 0.75rem;
		border-radius: var(--aq-radius-sm);
		border: 1px solid var(--aq-line);
		background: #fff;
		color: var(--aq-ink);
	}

	button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.back {
		text-decoration: none;
	}

	.detail-back-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:1.25rem}.detail-back-actions .btn-secondary{display:inline-flex;align-items:center;gap:.45em;padding:10px 20px;border:1px solid #ccc;border-radius:8px;background:#fff;color:#111;font-size:.9375rem;font-weight:600;text-decoration:none}.detail-back-actions .btn-secondary:hover{background:#f5f5f5}.detail-back-actions .fa-arrow-left{font-size:.75em;opacity:.7}

	.body {
		margin: 1.4rem 0 1rem;
	}

	.body h2 {
		margin: 0 0 1rem;
		font-size: 1.15rem;
	}

	.prose :global(p) {
		line-height: 1.85;
		color: #333;
		font-size: .9375rem;
		margin: 0 0 0.9rem;
	}

	.product-body-empty{margin:1rem 0;padding:16px 18px;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;color:#64748b;font-size:.9375rem;line-height:1.65}
	.detail-media{overflow:hidden;border:1px solid #eee;border-radius:12px;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,.08)}
</style>

<script>
	import { setupGalleryLightbox } from '../../scripts/galleryLightbox';

	function setupProductCarousels() {
		document.querySelectorAll('[data-product-carousel]').forEach((root) => {
			if (!(root instanceof HTMLElement) || root.dataset.carouselInit === '1') return;
			root.dataset.carouselInit = '1';
			const viewport = root.querySelector('.carousel-viewport');
			const main = root.querySelector('.carousel-main');
			const slides = Array.from(root.querySelectorAll('.carousel-slide'));
			const prev = root.querySelector('.carousel-prev');
			const next = root.querySelector('.carousel-next');
			const dots = Array.from(root.querySelectorAll('.carousel-dot'));
			if (!(viewport instanceof HTMLElement) || !(main instanceof HTMLElement) || slides.length < 2) return;
			let index = 0;
			let timer = 0;
			let hideNavTimer = 0;
			let ticking = false;
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const setIndex = (nextIndex, behavior = reducedMotion ? 'auto' : 'smooth') => {
				index = (nextIndex + slides.length) % slides.length;
				viewport.scrollTo({ left: index * viewport.clientWidth, behavior });
				slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
				dots.forEach((dot, i) => {
					dot.classList.toggle('is-active', i === index);
					dot.setAttribute('aria-selected', String(i === index));
				});
			};
			const stop = () => { if (timer) window.clearInterval(timer); timer = 0; };
			const start = () => {
				stop();
				if (reducedMotion || document.hidden) return;
				timer = window.setInterval(() => setIndex(index + 1, 'auto'), 5500);
			};
			prev?.addEventListener('click', () => { setIndex(index - 1); start(); });
			next?.addEventListener('click', () => { setIndex(index + 1); start(); });
			dots.forEach((dot, i) => dot.addEventListener('click', () => { setIndex(i); start(); }));
			viewport.addEventListener('pointerdown', stop, { passive: true });
			viewport.addEventListener('pointerup', start, { passive: true });
			viewport.addEventListener('pointercancel', start, { passive: true });
			main.addEventListener('pointerdown', (event) => {
				if (event.pointerType !== 'touch') return;
				main.classList.add('carousel-show-nav');
				window.clearTimeout(hideNavTimer);
				hideNavTimer = window.setTimeout(() => main.classList.remove('carousel-show-nav'), 4200);
			}, { passive: true });
			viewport.addEventListener('scroll', () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					ticking = false;
					const active = Math.round(viewport.scrollLeft / Math.max(1, viewport.clientWidth));
					if (active !== index) setIndex(active, 'auto');
				});
			}, { passive: true });
			main.addEventListener('mouseenter', stop);
			main.addEventListener('mouseleave', start);
			document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
			window.addEventListener('resize', () => setIndex(index, 'auto'));
			start();
		});
	}

	function setupProductLightbox() {
		setupGalleryLightbox({
			pageRootSelector: '[data-product-lightbox-group]',
			triggerSelector: '[data-product-lightbox-trigger]',
			indexOfTrigger: (trigger) => Number(trigger.dataset.index ?? 0),
			collectItems: () => Array.from(document.querySelectorAll('[data-product-lightbox-trigger]'))
				.map((element) => ({
					src: element.getAttribute('data-src') ?? '',
					alt: element.getAttribute('data-alt') ?? '',
				}))
				.filter((item) => item.src),
			lightboxId: 'productLightbox',
			backdropId: 'productLbBackdrop',
			closeBtnId: 'productLbClose',
			shellId: 'productLbShell',
			imgId: 'productLbImg',
			counterId: 'productLbCounter',
			prevBtnId: 'productLbPrev',
			nextBtnId: 'productLbNext',
			wheelDismiss: true,
			swipeDownDismiss: true,
		});
	}

	setupProductLightbox();
	setupProductCarousels();
	document.addEventListener('astro:page-load', setupProductLightbox);
	document.addEventListener('astro:page-load', setupProductCarousels);
</script>
