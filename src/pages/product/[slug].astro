			const dots = Array.from(root.querySelectorAll('.carousel-dot'));
			if (!(viewport instanceof HTMLElement) || !(main instanceof HTMLElement) || slides.length < 2) return;
			let index = 0;
			let timer = 0;
			let hideNavTimer = 0;
			let ticking = false;
			let scrollSettleTimer = 0;
			let userInteracted = false;
