				window.clearTimeout(scrollSettleTimer);
				viewport.scrollTo({ left: slideLeft(index), behavior });
				paintIndex(index);
			};
			const stop = () => { if (timer) window.clearInterval(timer); timer = 0; };
			const start = () => {
				stop();
				if (userInteracted || reducedMotion || document.hidden) return;
				timer = window.setInterval(() => setIndex(index + 1, 'auto'), 5500);
			};
