---
import { createHash } from 'node:crypto';
import { defaultPurchasableSku } from '../../lib/sanity/specification-media';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { portableTextToHtml } from '../../lib/portable-text';
import {
	formatTwd,
	getCatalogProductBySlug,
} from '../../lib/services/catalog';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect('/products');
}

const product = await getCatalogProductBySlug(slug);
if (!product) {
	return Astro.redirect('/products');
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
const productRevision = createHash('sha256').update(JSON.stringify(product)).digest('hex');
const bodyHtml = portableTextToHtml(product.body);
const error = Astro.url.searchParams.get('error');
const defaultSku = defaultPurchasableSku(product.skus, product.minimumPurchaseQuantity);
const defaultSkuId = defaultSku?.id ?? '';
const displayPrices = product.skus.filter((sku) => sku.isActive && sku.sellingPrice > 0).map((sku) => sku.sellingPrice);
const minimumPrice = displayPrices.length ? Math.min(...displayPrices) : 0;
const maximumPrice = displayPrices.length ? Math.max(...displayPrices) : 0;
const priceRange = minimumPrice > 0 ? (minimumPrice === maximumPrice ? formatTwd(minimumPrice) : `${formatTwd(minimumPrice)}–${new Intl.NumberFormat('zh-TW').format(maximumPrice)}`) : '價格洽詢';
const defaultCanPurchase = Boolean(defaultSku?.isActive && defaultSku.sellingPrice > 0 && (defaultSku.available < 0 || defaultSku.available >= product.minimumPurchaseQuantity));
const hasNamedVariants = product.specifications.length > 0 && product.skus.some((sku) => sku.optionIds?.length);
const specificationImages = [...new Set(product.specifications[0]?.options.map((option) => option.imageUrl).filter((url): url is string => Boolean(url)) ?? [])];
const images = [...new Set([
	...(product.imageUrl ? [product.imageUrl] : []),
	...product.galleryUrls.filter((url) => !specificationImages.includes(url)),
	...specificationImages,
	...(!product.imageUrl && !product.galleryUrls.length && !specificationImages.length && defaultSku?.imageUrl ? [defaultSku.imageUrl] : []),
])];
---

<SiteLayout
	title={`${product.seoTitle ?? product.name}｜桃園中壢水博館水族`}
	description={product.seoDescription ?? product.excerpt ?? product.name}
	wide
	legacyFooter
	productBack={{
		href: product.categorySlug
			? `/products/1?category=${encodeURIComponent(product.categorySlug)}`
			: '/products',
		label: product.categoryLabel ?? '商品列表',
	}}
>
	<p class="crumb">
		<a href="/">首頁</a>
		<span>/</span>
		<a href="/products/1">本店商品</a>
		<span>/</span>
		{product.categorySlug && product.categoryLabel ? <><a href={`/products/1?category=${encodeURIComponent(product.categorySlug)}`}>{product.categoryLabel}</a><span>/</span></> : null}
		<span>{product.name}</span>
	</p>

	{error && <p class="banner error">{error}</p>}

	<article class="detail" data-product-revision={productRevision}>
		<section class="media detail-media">
			{
				images.length > 0 ? (
					<div class="product-carousel" data-product-carousel data-product-lightbox-group data-base-image={product.imageUrl ?? defaultSku?.imageUrl ?? product.galleryUrls[0] ?? ''} aria-roledescription="輪播" aria-label={`${product.name} 商品圖片`}>
						<div class="carousel-main">
							<div class="carousel-viewport" tabindex="0" aria-label="滑動瀏覽商品圖片">
								<div class="carousel-track">
									{images.map((src, i) => (
										<button type="button" class="carousel-slide" data-product-lightbox-trigger data-index={String(i)} data-src={src} data-alt={`${product.name}（第 ${i + 1} 張）`} aria-label={`放大檢視第 ${i + 1} 張商品圖片`} aria-hidden={i === 0 ? 'false' : 'true'}>
											<span class="carousel-slide__stack">
												<img class="carousel-slide__blur" src={src} alt="" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} />
												<img class="carousel-slide__image" src={src} alt={i === 0 ? product.name : `${product.name}（第 ${i + 1} 張）`} loading={i === 0 ? 'eager' : 'lazy'} />
											</span>
										</button>
									))}
								</div>
							</div>
							{images.length > 1 && <>
								<button type="button" class="carousel-nav carousel-prev" aria-label="上一張圖片"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
								<button type="button" class="carousel-nav carousel-next" aria-label="下一張圖片"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
								<div class="carousel-dots" role="tablist" aria-label="選擇圖片">
									{images.map((_, i) => <button type="button" class:list={['carousel-dot', { 'is-active': i === 0 }]} aria-label={`第 ${i + 1} 張，共 ${images.length} 張`} aria-selected={i === 0 ? 'true' : 'false'} role="tab" />)}
								</div>
							</>}
						</div>
					</div>
				) : (
					<div class="placeholder">暫無圖片</div>
				)
			}
		</section>

		<section class="summary">
			<h1>{product.name}</h1>
			<p id="product-price" class="price">{priceRange}</p>
			{product.minimumPurchaseQuantity > 1 && <p class="minimum-purchase-hint">最低購買數量：{product.minimumPurchaseQuantity} 件</p>}
			{product.priceTiers.length > 0 && <p class="minimum-purchase-hint">多件優惠：{product.priceTiers.map((tier) => `${tier.minQuantity}${tier.maxQuantity ? `–${tier.maxQuantity}` : '+'} 件 NT$ ${tier.unitPrice}/件`).join('・')}</p>}
			{!product.inStock && <p class="stock out" role="status">暫無庫存</p>}
			{
				product.requiresManualConfirmation && (
					<p class="note">活體商品：出貨前可能需要人工確認。</p>
				)
			}

			{
				defaultSkuId && product.skus.some((sku) => sku.sellingPrice > 0) ? (
					<form method="post" action="/api/cart/add" data-minimum-purchase={product.minimumPurchaseQuantity} data-base-price={defaultSku?.sellingPrice ?? product.sellingPrice} data-price-tiers={JSON.stringify(product.priceTiers)} class:list={['add-form', { 'is-unavailable': !defaultCanPurchase }]}>
						<input type="hidden" name="returnTo" value={`/product/${product.slug}`} />
						<p class="selected-variant-price" data-selected-price aria-live="polite">{defaultSku && defaultSku.sellingPrice > 0 ? formatTwd(defaultSku.sellingPrice) : '價格洽詢'}</p>
						{hasNamedVariants && <>
							{product.specifications.map((specification) => <fieldset class="purchase-field spec-choice" data-spec-group={specification.id}>
								<legend>{specification.name}</legend>
								<div class="spec-choice__options">
									{specification.options.map((option) => <button type="button" class="spec-choice__option" data-spec-option={option.id} disabled={!product.skus.some((sku) => sku.isActive && sku.sellingPrice > 0 && (sku.available < 0 || sku.available >= product.minimumPurchaseQuantity) && sku.optionIds?.includes(option.id))} aria-pressed={String(defaultSku?.optionIds?.includes(option.id) ?? false)}>
										{option.imageUrl && <img src={option.imageUrl} alt="" loading="lazy" />}{option.name}
									</button>)}
								</div>
							</fieldset>)}
							<input type="hidden" name="productSkuId" data-product-spec value={defaultSkuId} />
							<select data-product-variants hidden aria-hidden="true">
								{product.skus.map((sku) => <option value={sku.id} disabled={!sku.isActive || (sku.available >= 0 && sku.available < product.minimumPurchaseQuantity) || sku.sellingPrice <= 0} data-available={sku.available} data-price={sku.sellingPrice} data-option-ids={JSON.stringify(sku.optionIds ?? [])} data-image={sku.imageUrl ?? ''}>{sku.name}</option>)}
							</select>
							<small class="variant-stock" data-variant-stock hidden={!defaultCanPurchase} role="status" aria-live="polite">{!defaultSku || defaultSku.available === 0 ? "暫無庫存" : defaultSku.available < 0 ? "庫存充足" : `庫存 ${defaultSku.available}`}</small>
						</>}
						<label class="purchase-field spec-field" hidden={hasNamedVariants}>
							<span>規格</span>
							<select name="productSkuId" required disabled={!defaultCanPurchase} data-product-spec>
								{product.skus.map((sku) => (
								<option value={sku.id} selected={sku.id === defaultSkuId} disabled={!sku.isActive || (sku.available >= 0 && sku.available < product.minimumPurchaseQuantity) || sku.sellingPrice <= 0} data-available={sku.available} data-price={sku.sellingPrice} data-option-ids={JSON.stringify(sku.optionIds ?? [])} data-image={sku.imageUrl ?? ''}>
										{sku.name}{sku.sellingPrice !== product.sellingPrice ? ` · ${formatTwd(sku.sellingPrice)}` : ''}{sku.available === 0 ? '（暫無庫存）' : ''}
									</option>
								))}
							</select>
						</label>
						<div class="purchase-field quantity-field">
							<label for="product-quantity">數量</label>
							<span class="quantity-control">
								<button class="quantity-step" type="button" data-quantity-step="-1" aria-label="減少數量" disabled={!defaultCanPurchase}>−</button>
							<input
								type="number"
								name="quantity"
								id="product-quantity"
								min={product.minimumPurchaseQuantity}
								{...(defaultSku && defaultSku.available >= 0 ? { max: Math.max(defaultSku.available, 1) } : {})}
							value={String(product.minimumPurchaseQuantity)}
								disabled={!defaultCanPurchase}
								data-product-quantity
								required
							/>
								<button class="quantity-step" type="button" data-quantity-step="1" aria-label="增加數量" disabled={!defaultCanPurchase}>＋</button>
							</span>
						</div>
						<div class="purchase-actions">
							<button class="btn-cart" type="submit" disabled={!defaultCanPurchase}><i class="fa-solid fa-cart-plus" aria-hidden="true"></i>加入購物車</button>
							<button class="btn-buy-now" type="submit" name="intent" value="buy-now" disabled={!defaultCanPurchase}>直接購買</button>
						</div>
					</form>
				) : <p class="note">商品價格尚待確認，請洽門市或 LINE 詢問。</p>
			}

			{
				bodyHtml ? (
					<section class="body">
						<div class="prose" set:html={bodyHtml} />
					</section>
				) : (
					<p class="product-body-empty">尚未填寫商品介紹。</p>
				)
			}
			<p class="ref-note">網站僅供參考，實際以門市與訂單確認為準。</p>
			<div class="detail-back-actions">
				<a href="/" class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>首頁</a>
				<a href="/products/1" class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>全部</a>
				{product.categorySlug && product.categoryLabel && <a href={`/products/1?category=${encodeURIComponent(product.categorySlug)}`} class="btn-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>{product.categoryLabel}</a>}
			</div>
		</section>
	</article>

	<div id="productLightbox" class="product-lightbox" hidden role="dialog" aria-modal="true" aria-label="放大檢視商品圖片">
		<button type="button" id="productLbBackdrop" class="product-lightbox__backdrop" aria-label="關閉放大圖"></button>
		<button type="button" id="productLbClose" class="product-lightbox__close" aria-label="關閉">
			<i class="fa-solid fa-xmark" aria-hidden="true"></i>
		</button>
		<button type="button" id="productLbPrev" class="product-lightbox__nav product-lightbox__nav--prev" aria-label="上一張" hidden>
			<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
		</button>
		<button type="button" id="productLbNext" class="product-lightbox__nav product-lightbox__nav--next" aria-label="下一張" hidden>
			<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
		</button>
		<div id="productLbShell" class="product-lightbox__shell">
			<img id="productLbImg" class="product-lightbox__img" alt="" decoding="async" />
		</div>
		<p id="productLbCounter" class="product-lightbox__counter" aria-live="polite" hidden></p>
	</div>

</SiteLayout>

<style>
	.crumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		color: var(--aq-muted);
		font-size: 0.9rem;
		margin: 0 0 1rem;
	}

	.crumb a {
		text-decoration: none;
	}

	.banner {
		padding: 0.75rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 1rem;
	}

	.banner.ok {
		background: var(--aq-primary-soft);
		color: var(--aq-primary-dark);
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.detail {
		display: grid;
		gap: 28px;
		align-items: start;
	}

	@media (min-width: 900px) {
		.detail {
			grid-template-columns: 1fr 1fr;
		}
	}

	.product-carousel,.carousel-main{position:relative}.carousel-viewport{overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-behavior:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;touch-action:pan-x pinch-zoom}.carousel-viewport::-webkit-scrollbar{display:none}.carousel-track{display:flex;gap:2px}.carousel-slide{position:relative;flex:0 0 100%;min-width:0;box-sizing:border-box;isolation:isolate;contain:paint;clip-path:inset(0);aspect-ratio:4/3;overflow:hidden;padding:0;border:0;background:#e8e8e8;scroll-snap-align:start;scroll-snap-stop:always;cursor:zoom-in;-webkit-tap-highlight-color:transparent}.carousel-slide:focus-visible{outline:3px solid var(--aq-primary);outline-offset:-3px}.carousel-slide__stack{position:absolute;inset:0;overflow:hidden}.carousel-slide__blur{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;filter:blur(26px);transform:scale(1.14);opacity:.9;pointer-events:none}.carousel-slide__image{position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;max-width:none;max-height:none;margin:0;object-fit:contain;object-position:center;background:transparent}.carousel-nav{position:absolute;top:50%;z-index:3;display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:1px solid rgba(0,0,0,.08);border-radius:50%;color:#333;background:rgba(255,255,255,.9);box-shadow:0 1px 6px rgba(0,0,0,.08);transform:translateY(-50%);cursor:pointer;opacity:0;pointer-events:none;transition:opacity .2s ease}.carousel-main:hover .carousel-nav,.carousel-main:focus-within .carousel-nav,.carousel-main.carousel-show-nav .carousel-nav{opacity:1;pointer-events:auto}.carousel-prev{left:10px}.carousel-next{right:10px}.carousel-dots{position:absolute;left:0;right:0;bottom:12px;z-index:2;display:flex;justify-content:center;gap:8px}.carousel-dot{width:9px;height:9px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.75);box-shadow:0 0 0 1px rgba(0,0,0,.2);cursor:pointer}.carousel-dot.is-active{background:#111;box-shadow:0 0 0 2px rgba(255,255,255,.9);transform:scale(1.2)}@media(prefers-reduced-motion:reduce){.carousel-slide__blur{filter:none;transform:none;opacity:.45}.carousel-nav{transition:none}}

	.product-lightbox {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
		box-sizing: border-box;
	}

	.product-lightbox[hidden] { display: none !important; }

	.product-lightbox__backdrop {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(0, 0, 0, 0.82);
		cursor: pointer;
	}

	.product-lightbox__close,
	.product-lightbox__nav {
		position: absolute;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		color: #111;
		background: rgba(255, 255, 255, 0.96);
		cursor: pointer;
	}

	.product-lightbox__close {
		top: max(10px, env(safe-area-inset-top));
		right: max(10px, env(safe-area-inset-right));
		width: 46px;
		height: 46px;
		border-radius: 50%;
	}

	.product-lightbox__nav {
		top: 50%;
		width: 48px;
		height: 64px;
		border-radius: 12px;
		transform: translateY(-50%);
	}

	.product-lightbox__nav:not([hidden]) { display: inline-flex; }
	.product-lightbox__nav--prev { left: max(12px, env(safe-area-inset-left)); }
	.product-lightbox__nav--next { right: max(12px, env(safe-area-inset-right)); }

	.product-lightbox__shell {
		position: relative;
		z-index: 1;
		max-width: min(96vw, 1200px);
		max-height: min(88vh, 900px);
		touch-action: none;
	}

	.product-lightbox__img {
		display: block;
		max-width: 100%;
		max-height: min(88vh, 900px);
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 6px;
		box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45);
		user-select: none;
	}

	.product-lightbox__counter {
		position: absolute;
		left: 50%;
		bottom: max(8px, env(safe-area-inset-bottom));
		z-index: 3;
		margin: 0;
		padding: 8px 16px;
		border-radius: 999px;
		color: #fff;
		background: rgba(15, 23, 42, 0.72);
		transform: translateX(-50%);
		pointer-events: none;
	}

	.product-lightbox__counter[hidden] { display: none !important; }

	.placeholder {
		min-height: 16rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-lg);
		display: grid;
		place-items: center;
		color: var(--aq-muted);
		background: #fff;
	}

	.summary {
		min-width: 0;
	}


	h1 {
		margin: 0 0 12px;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
		line-height: 1.25;
	}

	.price {
		margin: 0;
		font-size: 1.45rem;
		font-weight: 750;
		color: var(--aq-primary-dark);
	}

	.stock {
		margin: 0.35rem 0 0;
		width: fit-content;
		padding: 0.35rem 0.65rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--aq-danger) 9%, white);
		color: var(--aq-danger);
		font-size: 0.875rem;
		font-weight: 650;
	}
	.minimum-purchase-hint { margin: -.35rem 0 .6rem; color: var(--aq-muted); font-size: .84rem; line-height: 1.5; }

	.stock.out {
		color: var(--aq-danger);
	}

	.note,
	.ref-note,
	.login-hint {
		color: var(--aq-muted);
		line-height: 1.6;
	}

	.add-form {
		display: grid;
		gap: 0.9rem;
		margin: 1.1rem 0;
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--aq-primary) 14%, var(--aq-line));
		border-radius: var(--aq-radius-lg);
		background: color-mix(in srgb, var(--aq-primary-soft) 42%, white);
		transition: opacity .2s ease, background .2s ease;
	}

	.add-form.is-unavailable .quantity-field,.add-form.is-unavailable .purchase-actions { opacity:.48; }
	.purchase-field { display:grid; gap: .45rem; color: var(--aq-ink); font-weight: 650; }
	.variant-stock { color: var(--aq-muted); font-size: .78rem; font-weight: 500; }
	.spec-field[hidden] { display: none !important; }
	.spec-choice { min-width: 0; margin: 0; padding: 0; border: 0; }
	.spec-choice legend { margin-bottom: .45rem; }
	.spec-choice__options { display: flex; flex-wrap: wrap; gap: .5rem; }
	.spec-choice__option { display: inline-flex; align-items: center; gap: .45rem; min-height: 42px; padding: .35rem .65rem; border: 1px solid var(--aq-line); border-radius: 10px; background: #fff; color: var(--aq-ink); font: inherit; cursor: pointer; }
	.spec-choice__option[aria-pressed="true"] { border-color: var(--aq-primary); background: var(--aq-primary-soft); color: var(--aq-primary-dark); box-shadow: 0 0 0 1px var(--aq-primary); }
	.spec-choice__option img { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; }
	.purchase-field input, .purchase-field select { width: 100%; min-height: 48px; font-size: 1rem; }
	.quantity-control{display:grid;grid-template-columns:48px minmax(0,1fr) 48px;align-items:stretch;min-height:48px;overflow:hidden;border:1px solid var(--aq-line);border-radius:12px;background:#fff}.quantity-control input{min-width:0;width:100%;min-height:46px;padding:.5rem;border:0;border-right:1px solid var(--aq-line);border-left:1px solid var(--aq-line);border-radius:0;background:transparent;text-align:center;font-variant-numeric:tabular-nums}.quantity-step{display:grid;place-items:center;border:0;background:#f5f8f6;color:var(--aq-primary-dark);font-size:1.25rem;font-weight:650;cursor:pointer;touch-action:manipulation}.quantity-step:hover:not(:disabled){background:var(--aq-primary-soft)}.purchase-actions{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.purchase-actions button{display:flex;align-items:center;justify-content:center;gap:.45rem;min-width:0;min-height:48px;padding:.65rem .75rem;border-radius:12px;font-size:.95rem;font-weight:750;cursor:pointer;transition:background .15s,border-color .15s,transform .15s}.purchase-actions button:active:not(:disabled){transform:scale(.98)}.btn-cart{border:1px solid var(--aq-primary);background:white;color:var(--aq-primary-dark)}.btn-cart:hover:not(:disabled){background:var(--aq-primary-soft)}.btn-buy-now{border:1px solid var(--aq-primary);background:var(--aq-primary);color:white}.btn-buy-now:hover:not(:disabled){border-color:var(--aq-primary-dark);background:var(--aq-primary-dark)}.purchase-actions button:disabled,.quantity-step:disabled{cursor:not-allowed}
	.add-form.is-unavailable .purchase-actions button:disabled { opacity: 1; }

	label {
		display: grid;
		gap: 0.35rem;
		font-size: 0.92rem;
	}

	input,
	select {
		padding: 0.65rem 0.75rem;
		border-radius: var(--aq-radius-sm);
		border: 1px solid var(--aq-line);
		background: #fff;
