---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CommerceTermsContent from '../../components/CommerceTermsContent.astro';
import { listAddressesForUser } from '../../lib/services/address';
import { placeOrderFromCart } from '../../lib/services/checkout';
import { getCartView } from '../../lib/services/cart';
import { formatTwd } from '../../lib/services/catalog';
import { getShippingFee, listShippingMethods } from '../../lib/services/shipping';
import { getOrderForUser } from '../../lib/services/order';
import { getBankTransferInfo } from '../../lib/services/payment';
import { sendAuthEmail } from '../../lib/email/adapter';
import { isSyntheticProviderEmail } from '../../lib/auth/policies.js';

export const prerender = false;

const user = Astro.locals.user!;

const htmlEscapes: Record<string, string> = {
	'&': '&amp;',
	'<': '&lt;',
	'>': '&gt;',
	'"': '&quot;',
	"'": '&#39;',
};
const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => htmlEscapes[character]);
let error: string | null = null;
let submittedShippingMethodId = '';
let selectedCartItemIds: string[] | undefined;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	submittedShippingMethodId = String(form.get('shippingMethodId') ?? '');
	if (form.has('cartItemIds')) selectedCartItemIds = form.getAll('cartItemIds').map(String).filter(Boolean);
	try {
		const result = await placeOrderFromCart(user.id, {
			addressId: String(form.get('addressId') ?? ''),
			shippingMethodId: submittedShippingMethodId,
			note: String(form.get('note') ?? ''),
			...(selectedCartItemIds ? { cartItemIds: selectedCartItemIds } : {}),
		});
		if (user.emailVerified && !isSyntheticProviderEmail(user.email)) {
			try {
				const order = await getOrderForUser(user.id, result.orderNumber);
				if (!order) throw new Error('Created order could not be loaded for its confirmation email');
				const bank = getBankTransferInfo();
				const orderUrl = new URL(
					`/account/orders/${encodeURIComponent(order.orderNumber)}`,
					Astro.url.origin,
				).toString();
				const itemLines = order.items.map((item) => {
					const specification = item.skuName && item.skuName !== item.productName ? `（${item.skuName}）` : '';
					return `• ${item.productName}${specification} × ${item.quantity}｜單價 ${formatTwd(item.unitPrice)}｜小計 ${formatTwd(item.subtotal)}`;
				});
				const htmlItemLines = order.items.map((item) => {
					const specification = item.skuName && item.skuName !== item.productName ? `（${item.skuName}）` : '';
					return `<li>${escapeHtml(item.productName)}${escapeHtml(specification)} × ${item.quantity}｜單價 ${formatTwd(item.unitPrice)}｜小計 ${formatTwd(item.subtotal)}</li>`;
				}).join('');
				const address = order.shippingAddress;
				const reportUrlLink = `<a href="${escapeHtml(orderUrl)}">前往訂單頁回報轉帳末五碼</a>`;
				const sent = await sendAuthEmail({
					to: user.email,
					subject: `${address.recipientName}您好，水博館水族訂單已建立｜${order.orderNumber}`,
					text: [
						`${address.recipientName}您好，水博館水族訂單已建立`,
						'',
						`訂單編號：${order.orderNumber}`,
						'目前狀態：待付款',
						`應付總額：${formatTwd(order.total)}`,
						`建立時間：${order.createdAt.toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' })}`,
						'',
						'【銀行轉帳提醒】',
						`銀行：${bank.bankName}`,
						`戶名：${bank.accountName}`,
						`帳號：${bank.accountNumber}`,
						`應付總額：${formatTwd(order.total)}`,
						`轉帳備註請填訂單編號「${order.orderNumber}」，方便我們核對。`,
						'',
						`完成轉帳後，請前往訂單頁回報轉出帳號末五碼：${orderUrl}`,
						'完成回報後請等候門市核帳，核帳後會更新訂單狀態，無須重複下單。',
						'',
						'【收件資訊】',
						address.recipientName,
						`${address.postalCode} ${address.city}${address.district}${address.addressLine}`,
						`電話：${address.phone}`,
						`配送方式：${address.shippingMethodName ?? '依訂單頁面顯示'}`,
						'',
						'【訂單明細】',
						...itemLines,
						'',
						`商品小計：${formatTwd(order.subtotal)}`,
						`運費：${formatTwd(order.shippingFee)}`,
						...(order.discount > 0 ? [`折扣：-${formatTwd(order.discount)}`] : []),
						`應付總額：${formatTwd(order.total)}`,
						'',
						'如對訂單或轉帳有疑問，請洽水博館水族 03-402-8721。',
					].join('\n'),
					html: [
						`<p>${escapeHtml(address.recipientName)}您好，水博館水族訂單已建立</p>`,
						`<p>訂單編號：<strong>${escapeHtml(order.orderNumber)}</strong><br>目前狀態：待付款<br>應付總額：<strong>${formatTwd(order.total)}</strong><br>建立時間：${escapeHtml(order.createdAt.toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' }))}</p>`,
						'<h3>銀行轉帳提醒</h3>',
						`<p>銀行：${escapeHtml(bank.bankName)}<br>戶名：${escapeHtml(bank.accountName)}<br>帳號：${escapeHtml(bank.accountNumber)}<br>應付總額：<strong>${formatTwd(order.total)}</strong><br>轉帳備註請填訂單編號「${escapeHtml(order.orderNumber)}」，方便我們核對。</p>`,
						`<p>完成轉帳後，請${reportUrlLink}，填寫轉出帳號末五碼。完成回報後請等候門市核帳，核帳後會更新訂單狀態，無須重複下單。</p>`,
						'<h3>收件資訊</h3>',
						`<p>${escapeHtml(address.recipientName)}<br>${escapeHtml(`${address.postalCode} ${address.city}${address.district}${address.addressLine}`)}<br>電話：${escapeHtml(address.phone)}<br>配送方式：${escapeHtml(address.shippingMethodName ?? '依訂單頁面顯示')}</p>`,
						'<h3>訂單明細</h3>',
						`<ul>${htmlItemLines}</ul>`,
						`<p>商品小計：${formatTwd(order.subtotal)}<br>運費：${formatTwd(order.shippingFee)}${order.discount > 0 ? `<br>折扣：-${formatTwd(order.discount)}` : ''}<br><strong>應付總額：${formatTwd(order.total)}</strong></p>`,
						'<p>如對訂單或轉帳有疑問，請洽水博館水族 03-402-8721。</p>',
					].join('\n'),
				});
				if (!sent) console.warn(`Order confirmation email is not configured for order ${order.orderNumber}`);
			} catch (emailError) {
				console.error(`Failed to send order confirmation email for order ${result.orderNumber}:`, emailError);
			}
		}
		return Astro.redirect(
			`/account/orders/${encodeURIComponent(result.orderNumber)}`,
		);
	} catch (e) {
		error = e instanceof Error ? e.message : '結帳失敗';
	}
	} else if (Astro.url.searchParams.has('item')) {
		selectedCartItemIds = Astro.url.searchParams.getAll('item').map((id) => id.trim()).filter(Boolean);
}

const [cartView, addresses, shippingMethods] = await Promise.all([
	getCartView(user.id),
	listAddressesForUser(user.id),
	listShippingMethods(true),
]);

const cartItems = selectedCartItemIds
	? cartView.items.filter((item) => selectedCartItemIds?.includes(item.cartItemId))
	: cartView.items;
if (selectedCartItemIds && cartItems.length !== new Set(selectedCartItemIds).size && !error) {
	return Astro.redirect('/cart?selection=changed');
}
const cart = {
	...cartView,
	items: cartItems,
	itemCount: cartItems.reduce((sum, item) => sum + item.quantity, 0),
	subtotal: cartItems.reduce((sum, item) => sum + item.lineTotal, 0),
};

if (cart.items.length === 0 && !error) {
	return Astro.redirect('/cart');
}

const selectedShippingMethod = shippingMethods.find((method) => method.id === submittedShippingMethodId) ?? shippingMethods[0] ?? null;
const shippingFee = selectedShippingMethod ? getShippingFee(selectedShippingMethod, cart.subtotal) : 0;
const discount = 0;
const total = cart.subtotal + shippingFee - discount;
const defaultAddressId =
	addresses.find((a) => a.isDefault)?.id ?? addresses[0]?.id ?? '';
---

<SiteLayout title="結帳｜桃園中壢水博館水族" description="結帳" wide legacyFooter productBack={{ href: '/cart', label: '購物車' }}>
	<header class="head">
		<p class="crumb">
			<a href="/">首頁</a> / <a href="/cart">購物車</a> / 結帳
		</p>
		<h1>結帳</h1>
	</header>

	{error && <p class="banner error">{error}</p>}

	{
		cart.items.length === 0 ? (
			<div class="empty">
				<p>購物車是空的。</p>
				<a class="btn-primary" href="/products">
					去選購商品
				</a>
			</div>
		) : (
			<form method="post" class="checkout">
				{cart.items.map((item) => <input type="hidden" name="cartItemIds" value={item.cartItemId} />)}
				<section class="panel">
					<h2>收件地址</h2>
					{addresses.length === 0 ? (
						<p class="hint">
							尚未新增收件地址。請先
							<a href="/account/addresses">新增地址</a>
							再結帳。
						</p>
					) : (
						<ul class="addrs">
							{addresses.map((a) => (
								<li>
									<label class="addr">
										<input
											type="radio"
											name="addressId"
											value={a.id}
											required
											checked={a.id === defaultAddressId}
										/>
										<span>
											<strong>{a.recipientName}</strong>
											{a.isDefault ? '（預設）' : ''}
											<br />
											{a.postalCode} {a.city}
											{a.district}
											{a.addressLine}
											<br />
											{a.phone}
										</span>
									</label>
								</li>
							))}
						</ul>
					)}
					<h2 class="shipping-heading">配送方式</h2>
					{shippingMethods.length === 0 ? <p class="hint">目前尚未提供配送方式，請聯絡商店。</p> : <ul class="shipping-options">{shippingMethods.map((method) => <li><label class="shipping-option" data-fee={method.fee} data-threshold={method.freeShippingThreshold ?? ''}><input type="radio" name="shippingMethodId" value={method.id} required checked={method.id === selectedShippingMethod?.id} /><span><strong>{method.name}</strong><small>運費 {formatTwd(method.fee)}{method.freeShippingThreshold !== null ? ` · 滿 ${formatTwd(method.freeShippingThreshold)} 免運` : ''}</small></span></label></li>)}</ul>}
					<h2 class="payment-heading">付款方式</h2>
					<div class="payment-method" aria-label="付款方式：銀行轉帳，目前僅提供此方式">
						<span class="payment-method-icon" aria-hidden="true"><i class="fa-solid fa-building-columns"></i></span>
						<span class="payment-method-name"><strong>銀行轉帳</strong><small>目前僅提供此付款方式</small></span>
						<i class="fa-solid fa-circle-check payment-method-check" aria-hidden="true"></i>
					</div>
				</section>

				<section class="panel">
					<h2>訂單備註</h2>
					<textarea
						name="note"
						rows="1"
						placeholder="選填：希望到貨時段、門市自取備註等"
					/>
				</section>

				<section class="panel">
					<h2>商品明細</h2>
					<ul class="lines">
						{cart.items.map((item) => (
							<li>
								<span>
									{item.productName}
									<small>
										{item.skuName} × {item.quantity}
									</small>
								</span>
								<strong>{formatTwd(item.lineTotal)}</strong>
							</li>
						))}
					</ul>
					<dl class="totals">
						<div>
							<dt>小計</dt>
							<dd>{formatTwd(cart.subtotal)}</dd>
						</div>
						<div>
							<dt>運費</dt>
							<dd id="checkout-shipping-fee" data-subtotal={cart.subtotal}>{formatTwd(shippingFee)}</dd>
						</div>
						{discount > 0 && (
							<div>
								<dt>折扣</dt>
								<dd>-{formatTwd(discount)}</dd>
							</div>
						)}
						<div class="grand">
							<dt>應付總額</dt>
							<dd>{formatTwd(total)}</dd>
						</div>
					</dl>
				</section>

				<div class="actions">
					<div class="checkout-consent">完成結帳即視為已同意 <button type="button" data-open-terms>條款與規則</button></div>
					<div class="checkout-fixed-total"><span>總金額（含運費）</span><strong data-checkout-fixed-total>{formatTwd(total)}</strong></div>
					<button
						type="submit"
						class="btn-primary"
						disabled={addresses.length === 0 || shippingMethods.length === 0}
					>
						結帳<i class="fa-solid fa-arrow-right checkout-confirm-arrow" aria-hidden="true"></i>
					</button>
				</div>
			</form>
			<div class="terms-backdrop" data-terms-dialog hidden>
				<section class="terms-sheet" role="dialog" aria-modal="true" aria-labelledby="terms-sheet-title" tabindex="-1">
					<header class="terms-sheet__header"><h2 id="terms-sheet-title">水博館水族電商條款與規則</h2><button class="terms-sheet__close" type="button" data-close-terms aria-label="關閉條款視窗">×</button></header>
					<div class="terms-sheet__body"><CommerceTermsContent /></div>
					<footer class="terms-sheet__footer"><button class="terms-sheet__agree" type="button" data-close-terms>同意</button></footer>
				</section>
			</div>
		)
	}
</SiteLayout>

<script>
	const shippingLabels = Array.from(document.querySelectorAll<HTMLLabelElement>('.shipping-option'));
	const termsDialog = document.querySelector<HTMLElement>('[data-terms-dialog]');
	const termsOpenButton = document.querySelector<HTMLButtonElement>('[data-open-terms]');
	const termsSheet = termsDialog?.querySelector<HTMLElement>('.terms-sheet');
	let termsReturnFocus: HTMLElement | null = null;
	const closeTerms = () => {
		if (!termsDialog || termsDialog.hidden) return;
		termsDialog.classList.remove('is-open');
		window.setTimeout(() => {
			if (!termsDialog.classList.contains('is-open')) termsDialog.hidden = true;
			termsReturnFocus?.focus();
		}, 220);
	};
	termsOpenButton?.addEventListener('click', () => {
		if (!termsDialog) return;
		termsReturnFocus = termsOpenButton;
		termsDialog.hidden = false;
		requestAnimationFrame(() => {
			termsDialog.classList.add('is-open');
			termsSheet?.focus();
		});
	});
	termsDialog?.addEventListener('click', (event) => {
		if (event.target === termsDialog || (event.target as Element).closest('[data-close-terms]')) closeTerms();
	});
	termsDialog?.addEventListener('keydown', (event) => {
		if (event.key !== 'Tab' || !termsSheet) return;
		const focusable = Array.from(termsSheet.querySelectorAll<HTMLElement>('a[href],button:not(:disabled),[tabindex]:not([tabindex="-1"])'));
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (!first || !last) return;
		if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
		else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeTerms();
	});
	const shippingFeeLabel = document.querySelector<HTMLElement>('#checkout-shipping-fee');
	const totalLabel = document.querySelector<HTMLElement>('.totals .grand dd');
	const fixedTotalLabel = document.querySelector<HTMLElement>('[data-checkout-fixed-total]');
	const formatTwd = (value: number) => `NT$ ${new Intl.NumberFormat('zh-TW').format(value)}`;
	const updateShippingTotal = () => {
		const selected = shippingLabels.find((label) => label.querySelector<HTMLInputElement>('input')?.checked);
		if (!selected || !shippingFeeLabel || !totalLabel) return;
		const fee = Number(selected.dataset.fee || 0);
		const threshold = selected.dataset.threshold ? Number(selected.dataset.threshold) : null;
		const subtotal = Number(shippingFeeLabel.dataset.subtotal || 0);
		const actualFee = threshold !== null && subtotal >= threshold ? 0 : fee;
		shippingFeeLabel.textContent = formatTwd(actualFee);
		const total = formatTwd(subtotal + actualFee);
		totalLabel.textContent = total;
		if (fixedTotalLabel) fixedTotalLabel.textContent = total;
	};
	shippingLabels.forEach((label) => label.querySelector('input')?.addEventListener('change', updateShippingTotal));
	const checkoutForm = document.querySelector<HTMLFormElement>('form.checkout');
	const confirmButton = checkoutForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
	let confirmReadyToSubmit = false;
	checkoutForm?.addEventListener('submit', (event) => {
		if (confirmReadyToSubmit || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !confirmButton) return;
		event.preventDefault();
		if (confirmButton.classList.contains('is-confirming')) return;
		confirmButton.classList.add('is-confirming');
		confirmButton.setAttribute('aria-busy', 'true');
		window.setTimeout(() => {
			confirmReadyToSubmit = true;
			checkoutForm.requestSubmit(confirmButton);
		}, 240);
	});
</script>

<style>
	.head {
		margin-bottom: 1rem;
	}

	.crumb {
		margin: 0 0 0.35rem;
		color: var(--aq-muted);
		font-size: 0.9rem;
	}

	.crumb a {
		text-decoration: none;
	}

	h1 {
		margin: 0;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.banner {
		padding: 0.7rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 1rem;
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.empty {
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
		padding: 2rem 1.25rem;
		text-align: center;
	}

	.checkout {
		display: grid;
		gap: 1rem;
	}

	.panel {
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
		padding: 1.1rem 1.2rem;
	}

	.addrs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.addr {
		display: flex;
		gap: 0.65rem;
		align-items: flex-start;
		cursor: pointer;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
	}

	.addr input {
		margin-top: 0.25rem;
	}

	textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
		font: inherit;
		resize: vertical;
	}

	.lines {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.lines li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}

	.lines small {
		display: block;
		color: var(--aq-muted);
		margin-top: 0.15rem;
	}

	.totals {
		margin: 1rem 0 0;
		padding-top: 0.85rem;
		border-top: 1px solid var(--aq-line);
		display: grid;
		gap: 0.4rem;
	}

	.totals > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.totals dt,
	.totals dd {
		margin: 0;
	}

	.totals .grand {
		font-size: 1.1rem;
		font-weight: 700;
		margin-top: 0.25rem;
	}

	.hint {
		margin: 0.85rem 0 0;
		color: var(--aq-muted);
		font-size: 0.9rem;
	}

	.hint a {
		color: var(--aq-primary);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		justify-content: flex-end;
	}

	button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
	.shipping-heading { margin-top: 1.4rem; }
	.shipping-options { display: grid; gap: .65rem; padding: 0; list-style: none; }
	.shipping-option { display: flex; align-items: center; gap: .75rem; padding: .9rem 1rem; border: 1px solid #e4e8e3; border-radius: 13px; cursor: pointer; }
	.shipping-option:has(input:checked) { border-color: var(--aq-primary); background: #f3f8f5; }
	.shipping-option input { accent-color: var(--aq-primary); }
	.shipping-option span { display: grid; gap: .25rem; }
	.shipping-option small { color: var(--aq-muted); }
	.payment-heading { margin-top: 1.4rem; }
	.payment-method { display:flex; align-items:center; gap:.8rem; padding:.9rem 1rem; border:1px solid var(--aq-primary); border-radius:13px; background:#f3f8f5; }
	.payment-method-icon { display:grid; place-items:center; width:38px; height:38px; flex:0 0 38px; border-radius:11px; background:#e2f0e9; color:var(--aq-primary-dark); }
	.payment-method-name { display:grid; gap:.2rem; }
	.payment-method-name strong { color:var(--aq-ink); font-size:.92rem; }
