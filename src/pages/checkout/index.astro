---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ShopTerms from '../../components/ShopTerms.astro';
import { listAddressesForUser } from '../../lib/services/address';
import { placeOrderFromCart } from '../../lib/services/checkout';
import { getCartView } from '../../lib/services/cart';
import { formatTwd } from '../../lib/services/catalog';
import { getShippingFee, listShippingMethods } from '../../lib/services/shipping';
import { getOrderForUser } from '../../lib/services/order';
import { getBankTransferInfo } from '../../lib/services/payment';
import { sendAuthEmail } from '../../lib/email/adapter';
import { orderCreatedEmail } from '../../lib/email/templates';
import { notifyShopEvent } from '../../lib/services/shop-notify';
import { isSyntheticProviderEmail } from '../../lib/auth/policies.js';

export const prerender = false;

const user = Astro.locals.user!;

let error: string | null = null;
let submittedShippingMethodId = '';
let selectedCartItemIds: string[] | undefined;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	submittedShippingMethodId = String(form.get('shippingMethodId') ?? '');
	if (form.has('cartItemIds')) selectedCartItemIds = form.getAll('cartItemIds').map(String).filter(Boolean);
	try {
		const result = await placeOrderFromCart(user.id, {
			addressId: String(form.get('addressId') ?? ''),
			shippingMethodId: submittedShippingMethodId,
			note: String(form.get('note') ?? ''),
			...(selectedCartItemIds ? { cartItemIds: selectedCartItemIds } : {}),
		});
		// 訂單已成立：確認信與店家通知改在背景寄出，顧客不用等寄信就能看到訂單
		const afterOrder = async () => {
			if (user.emailVerified && !isSyntheticProviderEmail(user.email)) {
				try {
					const order = await getOrderForUser(user.id, result.orderNumber);
					if (!order) throw new Error('Created order could not be loaded for its confirmation email');
					const bank = await getBankTransferInfo();
					const orderUrl = new URL(
						`/account/orders/${encodeURIComponent(order.orderNumber)}`,
						Astro.url.origin,
					).toString();
					const sent = await sendAuthEmail({ to: user.email, ...orderCreatedEmail(order, bank, orderUrl) });
					if (!sent) console.warn(`Order confirmation email is not configured for order ${order.orderNumber}`);
				} catch (emailError) {
					console.error(`Failed to send order confirmation email for order ${result.orderNumber}:`, emailError);
				}
			}
			await notifyShopEvent('SHOP_NEW_ORDER', user.id, result.orderNumber, Astro.url.origin).catch((notifyError) => console.error('[checkout] notify failed', notifyError));
		};
		const background = afterOrder();
		const cfContext = (Astro.locals as { cfContext?: { waitUntil(promise: Promise<unknown>): void } }).cfContext;
		if (cfContext?.waitUntil) cfContext.waitUntil(background);
		else void background;
		return Astro.redirect(
			`/account/orders/${encodeURIComponent(result.orderNumber)}`,
		);
	} catch (e) {
		error = e instanceof Error ? e.message : '結帳失敗';
	}
	} else if (Astro.url.searchParams.has('item')) {
		selectedCartItemIds = Astro.url.searchParams.getAll('item').map((id) => id.trim()).filter(Boolean);
}

const checkoutReturnTo = encodeURIComponent(Astro.url.pathname + Astro.url.search);
const addAddressHref = `/account/addresses?returnTo=${checkoutReturnTo}&new=1`;
const manageAddressHref = `/account/addresses?returnTo=${checkoutReturnTo}`;
const [cartView, addresses, shippingMethods] = await Promise.all([
	getCartView(user.id),
	listAddressesForUser(user.id),
	listShippingMethods(true),
]);

const cartItems = selectedCartItemIds
	? cartView.items.filter((item) => selectedCartItemIds?.includes(item.cartItemId))
	: cartView.items;
if (selectedCartItemIds && cartItems.length !== new Set(selectedCartItemIds).size && !error) {
	return Astro.redirect('/cart?selection=changed');
}
const cart = {
	...cartView,
	items: cartItems,
	itemCount: cartItems.reduce((sum, item) => sum + item.quantity, 0),
	subtotal: cartItems.reduce((sum, item) => sum + item.lineTotal, 0),
};

if (cart.items.length === 0 && !error) {
	return Astro.redirect('/cart');
}

const selectedShippingMethod = shippingMethods.find((method) => method.id === submittedShippingMethodId) ?? shippingMethods[0] ?? null;
const shippingFee = selectedShippingMethod ? getShippingFee(selectedShippingMethod, cart.subtotal) : 0;
const discount = 0;
const total = cart.subtotal + shippingFee - discount;
const defaultAddressId =
	addresses.find((a) => a.isDefault)?.id ?? addresses[0]?.id ?? '';
/** 結帳頁畫面上的金額不顯示「NT」，只用 $ 開頭（訂單通知信仍用 formatTwd） */
const dollars = (amount: number) => `$${new Intl.NumberFormat('zh-TW').format(amount)}`;
---

<SiteLayout title="結帳｜桃園中壢水博館水族" description="結帳" wide legacyFooter productBack={{ href: '/cart', label: '購物車' }}>
	<header class="head">
		<p class="crumb">
			<a href="/">首頁</a> / <a href="/cart">購物車</a> / 結帳
		</p>
		<h1>結帳</h1>
		<div class="steps" aria-label="結帳流程">
			<a class="step done" href="/cart"><b><i class="fa-solid fa-check" aria-hidden="true"></i></b>購物車</a><i></i>
			<span class="step active" aria-current="step"><b>2</b>配送與付款</span><i></i>
			<span class="step"><b>3</b>完成訂單</span>
		</div>
	</header>

	{error && <p class="banner error">{error}</p>}

	{
		cart.items.length === 0 ? (
			<div class="empty">
				<p>購物車是空的。</p>
				<a class="btn-primary" href="/products">
					去選購商品
				</a>
			</div>
		) : (
			<form method="post" class="checkout">
				{cart.items.map((item) => <input type="hidden" name="cartItemIds" value={item.cartItemId} />)}
				<section class="panel">
					<div class="addr-head">
						<h2>收件地址</h2>
						{addresses.length > 0 && (
							<div class="addr-tools">
								<a class="addr-tool" href={addAddressHref}><i class="fa-solid fa-plus" aria-hidden="true"></i>新增</a>
								<a class="addr-tool" href={manageAddressHref}><i class="fa-solid fa-pen" aria-hidden="true"></i>修改</a>
							</div>
						)}
					</div>
					{addresses.length === 0 ? (
						<div class="addr-empty">
							<p class="hint">還沒有收件地址，新增後會自動回到這裡繼續結帳。</p>
							<a class="addr-tool addr-tool--primary" href={addAddressHref}><i class="fa-solid fa-plus" aria-hidden="true"></i> 新增收件地址</a>
						</div>
					) : (
						<ul class="addrs">
							{addresses.map((a) => (
								<li>
									<label class="addr">
										<input
											type="radio"
											name="addressId"
											value={a.id}
											required
											checked={a.id === defaultAddressId}
										/>
										<span>
											<strong>{a.recipientName}</strong>
											{a.isDefault ? '（預設）' : ''}
											<br />
											{a.postalCode} {a.city}
											{a.district}
											{a.addressLine}
											<br />
											{a.phone}
										</span>
									</label>
								</li>
							))}
						</ul>
					)}

					<h2 class="shipping-heading">配送方式</h2>
					{shippingMethods.length === 0 ? <p class="hint">目前尚未提供配送方式，請聯絡商店。</p> : <ul class="shipping-options">{shippingMethods.map((method) => <li><label class="shipping-option" data-fee={method.fee} data-threshold={method.freeShippingThreshold ?? ''}><input type="radio" name="shippingMethodId" value={method.id} required checked={method.id === selectedShippingMethod?.id} /><span><strong>{method.name}</strong><small>運費 {dollars(method.fee)}{method.freeShippingThreshold !== null ? ` · 滿 ${dollars(method.freeShippingThreshold)} 免運` : ''}</small></span></label></li>)}</ul>}
					<h2 class="payment-heading">付款方式</h2>
					<div class="payment-method" aria-label="付款方式：銀行轉帳，目前僅提供此方式">
						<span class="payment-method-icon" aria-hidden="true"><i class="fa-solid fa-building-columns"></i></span>
						<span class="payment-method-name"><strong>銀行轉帳</strong><small>目前僅提供此付款方式</small></span>
						<i class="fa-solid fa-circle-check payment-method-check" aria-hidden="true"></i>
					</div>
				</section>

				<section class="panel">
					<h2>訂單備註</h2>
					<textarea
						name="note"
						rows="1"
						placeholder="選填：希望到貨時段、門市自取備註等"
					/>
				</section>

				<section class="panel">
					<h2>商品明細</h2>
					<ul class="lines">
						{cart.items.map((item) => (
							<li>
								<span>
									{item.productName}
									<small>
										{item.skuName} × {item.quantity}
									</small>
								</span>
								<strong class="line-amount">{dollars(item.lineTotal)}</strong>
							</li>
						))}
					</ul>
					<dl class="totals">
						<div>
							<dt>小計</dt>
							<dd>{dollars(cart.subtotal)}</dd>
						</div>
						<div>
							<dt>運費</dt>
							<dd id="checkout-shipping-fee" data-subtotal={cart.subtotal}>{dollars(shippingFee)}</dd>
						</div>
						{discount > 0 && (
							<div>
								<dt>折扣</dt>
								<dd>-{dollars(discount)}</dd>
							</div>
						)}
						<div class="grand">
							<dt>應付總額</dt>
							<dd>{dollars(total)}</dd>
						</div>
					</dl>
					{/* 結帳按鈕放在商品明細卡片底部：桌面跟著右欄固定，手機仍是畫面底部的結帳列 */}
					<div class="actions">
						<div class="checkout-consent">完成結帳即視為已同意 <button type="button" data-open-terms>購物須知與服務條款</button></div>
						<div class="checkout-fixed-total"><span>總金額（含運費）</span><strong data-checkout-fixed-total>{formatTwd(total)}</strong></div>
						<button
							type="submit"
							class="btn-primary"
							disabled={addresses.length === 0 || shippingMethods.length === 0}
						>
							結帳<i class="fa-solid fa-arrow-right checkout-confirm-arrow" aria-hidden="true"></i>
						</button>
					</div>
				</section>
			</form>
			<div class="terms-backdrop" data-terms-dialog hidden>
				<section class="terms-sheet" role="dialog" aria-modal="true" aria-labelledby="terms-sheet-title" tabindex="-1">
					<header class="terms-sheet__header"><h2 id="terms-sheet-title">購物須知與服務條款</h2><button class="terms-sheet__close" type="button" data-close-terms aria-label="關閉條款視窗">×</button></header>
					<div class="terms-sheet__body"><ShopTerms compact /></div>
					<footer class="terms-sheet__footer"><button class="terms-sheet__agree" type="button" data-close-terms>同意</button></footer>
				</section>
			</div>
		)
	}
</SiteLayout>

<script>
	const shippingLabels = Array.from(document.querySelectorAll<HTMLLabelElement>('.shipping-option'));
	const termsDialog = document.querySelector<HTMLElement>('[data-terms-dialog]');
	const termsOpenButton = document.querySelector<HTMLButtonElement>('[data-open-terms]');
	const termsSheet = termsDialog?.querySelector<HTMLElement>('.terms-sheet');
	let termsReturnFocus: HTMLElement | null = null;
	const closeTerms = () => {
		if (!termsDialog || termsDialog.hidden) return;
		termsDialog.classList.remove('is-open');
		window.setTimeout(() => {
			if (!termsDialog.classList.contains('is-open')) termsDialog.hidden = true;
			termsReturnFocus?.focus();
		}, 220);
	};
	termsOpenButton?.addEventListener('click', () => {
		if (!termsDialog) return;
		termsReturnFocus = termsOpenButton;
		termsDialog.hidden = false;
		requestAnimationFrame(() => {
			termsDialog.classList.add('is-open');
			termsSheet?.focus();
		});
	});
	termsDialog?.addEventListener('click', (event) => {
		if (event.target === termsDialog || (event.target as Element).closest('[data-close-terms]')) closeTerms();
	});
	termsDialog?.addEventListener('keydown', (event) => {
		if (event.key !== 'Tab' || !termsSheet) return;
		const focusable = Array.from(termsSheet.querySelectorAll<HTMLElement>('a[href],button:not(:disabled),[tabindex]:not([tabindex="-1"])'));
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (!first || !last) return;
		if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
		else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeTerms();
	});
	const shippingFeeLabel = document.querySelector<HTMLElement>('#checkout-shipping-fee');
	const totalLabel = document.querySelector<HTMLElement>('.totals .grand dd');
	const fixedTotalLabel = document.querySelector<HTMLElement>('[data-checkout-fixed-total]');
	const formatTwd = (value: number) => `$${new Intl.NumberFormat('zh-TW').format(value)}`;
	const updateShippingTotal = () => {
		const selected = shippingLabels.find((label) => label.querySelector<HTMLInputElement>('input')?.checked);
		if (!selected || !shippingFeeLabel || !totalLabel) return;
		const fee = Number(selected.dataset.fee || 0);
		const threshold = selected.dataset.threshold ? Number(selected.dataset.threshold) : null;
		const subtotal = Number(shippingFeeLabel.dataset.subtotal || 0);
		const actualFee = threshold !== null && subtotal >= threshold ? 0 : fee;
		shippingFeeLabel.textContent = formatTwd(actualFee);
		const total = formatTwd(subtotal + actualFee);
		totalLabel.textContent = total;
		// 手機底部「總金額（含運費）」保留 NT$
		if (fixedTotalLabel) fixedTotalLabel.textContent = `NT$ ${new Intl.NumberFormat('zh-TW').format(subtotal + actualFee)}`;
	};
	shippingLabels.forEach((label) => label.querySelector('input')?.addEventListener('change', updateShippingTotal));
	const checkoutForm = document.querySelector<HTMLFormElement>('form.checkout');
	const confirmButton = checkoutForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
	// 建立訂單需要幾秒：按鈕改成「建立訂單中…」並蓋上半透明提示，避免顧客以為沒反應而重複按
	const confirmLabel = confirmButton?.innerHTML ?? '';
	let submittingOverlay: HTMLElement | null = null;
	// 步驟進度：每步至少顯示一段時間，訂單建立完成後把剩下的步驟跑完才跳頁
	const STEP_MS = 650;
	let steps: Element[] = [];
	let stepIndex = 0;
	let stepTimer = 0;
	const advanceStep = () => {
		if (stepIndex >= steps.length - 1) return false;
		steps[stepIndex]?.classList.replace('is-active', 'is-done');
		stepIndex += 1;
		steps[stepIndex]?.classList.add('is-active');
		return true;
	};
	const finishSteps = () => new Promise<void>((resolve) => {
		window.clearInterval(stepTimer);
		const tick = () => {
			if (advanceStep()) { window.setTimeout(tick, 280); return; }
			steps[stepIndex]?.classList.replace('is-active', 'is-done');
			const title = submittingOverlay?.querySelector('[data-step-title]');
			if (title) title.textContent = '訂單建立完成';
			submittingOverlay?.querySelector('.checkout-progress')?.classList.add('is-complete');
			window.setTimeout(resolve, 450);
		};
		tick();
	});
	const showSubmitting = () => {
		if (!confirmButton) return;
		confirmButton.disabled = true;
		confirmButton.setAttribute('aria-busy', 'true');
		confirmButton.innerHTML = '<span class="checkout-spinner" aria-hidden="true"></span>建立訂單中…';
		submittingOverlay ??= Object.assign(document.createElement('div'), { className: 'checkout-submitting', role: 'status' });
		// 等待時顯示步驟進度與小魚動畫，而不是只有轉圈圈
		submittingOverlay.innerHTML = '<div class="checkout-submitting__card"><div class="checkout-fishbowl" aria-hidden="true"><i class="fa-solid fa-fish"></i><span></span><span></span><span></span></div><strong data-step-title>正在建立訂單</strong><ol class="checkout-steps"><li class="is-active">確認商品與庫存</li><li>保留您的商品</li><li>建立訂單編號</li><li>準備付款資訊</li></ol><div class="checkout-progress"><span></span></div><small>請不要關閉或重新整理頁面</small></div>';
		document.body.append(submittingOverlay);
		steps = Array.from(submittingOverlay.querySelectorAll('.checkout-steps li'));
		stepIndex = 0;
		// 最後一步留著轉圈，等伺服器回應
		stepTimer = window.setInterval(() => { if (stepIndex >= steps.length - 2 || !advanceStep()) window.clearInterval(stepTimer); }, STEP_MS);
	};
	// 在背景送出訂單；成功後跑完步驟再前往訂單頁，失敗時顯示伺服器回傳的錯誤頁
	const placeOrder = async () => {
		if (!checkoutForm || !confirmButton) return;
		showSubmitting();
		const minimumWait = new Promise((resolve) => window.setTimeout(resolve, STEP_MS * 2));
		try {
			const response = await fetch(checkoutForm.action || window.location.href, { method: 'POST', body: new FormData(checkoutForm), credentials: 'same-origin' });
			const finalUrl = new URL(response.url, window.location.href);
			if (response.redirected && finalUrl.pathname.startsWith('/account/orders/')) {
				await minimumWait;
				await finishSteps();
				window.location.assign(finalUrl.pathname + finalUrl.search);
				return;
			}
			const html = await response.text();
			document.open();
			document.write(html);
			document.close();
		} catch {
			// 連線中斷時不重送，避免重複下單；帶顧客到「我的訂單」確認是否已成立
			window.location.assign('/account/orders');
		}
	};
	// 從下一頁按「上一頁」回來時（瀏覽器快取），還原按鈕
	window.addEventListener('pageshow', (event) => {
		if (!event.persisted || !confirmButton) return;
		confirmButton.disabled = false;
		confirmButton.removeAttribute('aria-busy');
		confirmButton.classList.remove('is-confirming');
		confirmButton.innerHTML = confirmLabel;
		submittingOverlay?.remove();
	});
	checkoutForm?.addEventListener('submit', (event) => {
		if (event.defaultPrevented) return;
		event.preventDefault();
		if (!confirmButton || confirmButton.classList.contains('is-confirming') || confirmButton.disabled) return;
		if (!checkoutForm.reportValidity()) return;
		confirmButton.classList.add('is-confirming');
		confirmButton.setAttribute('aria-busy', 'true');
		const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 240;
		window.setTimeout(() => { void placeOrder(); }, delay);
	});
</script>

<style>
	.head {
		margin-bottom: 1rem;
	}

	.crumb {
		margin: 0 0 0.35rem;
		color: var(--aq-muted);
		font-size: 0.9rem;
	}

	.crumb a {
		text-decoration: none;
	}

	h1 {
		margin: 0;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.banner {
		padding: 0.7rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 1rem;
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.empty {
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
		padding: 2rem 1.25rem;
		text-align: center;
	}

	.checkout {
		display: grid;
		gap: 1rem;
	}

	.panel {
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
		padding: 1.1rem 1.2rem;
	}

	.addrs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.addr {
		display: flex;
		gap: 0.65rem;
		align-items: flex-start;
		cursor: pointer;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
	}

	.addr input {
		margin-top: 0.25rem;
	}

	textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
		font: inherit;
		resize: vertical;
	}

	.lines {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.lines li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		/* 金額與下一行的「規格 × 數量」對齊 */
		align-items: flex-end;
	}

	.lines .line-amount {
		flex: none;
		font-variant-numeric: tabular-nums;
	}

	.lines small {
		display: block;
		color: var(--aq-muted);
		margin-top: 0.15rem;
	}

	.totals {
		margin: 1rem 0 0;
		padding-top: 0.85rem;
		border-top: 1px solid var(--aq-line);
		display: grid;
		gap: 0.4rem;
	}

	.totals > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.totals dt,
	.totals dd {
		margin: 0;
	}

	.totals .grand {
		font-size: 1.1rem;
		font-weight: 700;
		margin-top: 0.25rem;
	}

	.hint {
		margin: 0.85rem 0 0;
		color: var(--aq-muted);
		font-size: 0.9rem;
	}

	.hint a {
		color: var(--aq-primary);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		justify-content: flex-end;
	}

	button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
