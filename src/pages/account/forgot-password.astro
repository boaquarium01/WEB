---
import AccountLayout from '../../layouts/AccountLayout.astro';
import EmailField from '../../components/EmailField.astro';
import { isAuthEmailConfigured } from '../../lib/email/adapter';

export const prerender = false;
const mailConfigured = isAuthEmailConfigured();
---

<AccountLayout title="忘記密碼｜水博館水族">
	<div class="auth-head">
		<h1>忘記密碼</h1>
		<p>輸入註冊時的 Email，我們會寄送重設連結（1 小時內有效）。</p>
	</div>
	{!mailConfigured && <p class="error">郵件服務尚未設定，目前無法寄送重設連結，請聯絡店家。</p>}
	<form id="forgot-form" class="form" novalidate>
		<EmailField id="forgot-email" />
		<p id="notice" class="status" role="status" aria-live="polite"></p>
		<button type="submit" disabled={!mailConfigured}>寄送重設連結</button>
	</form>
	<p class="meta">想起密碼了？<a href="/account/login">回到登入</a></p>
</AccountLayout>

<script>
	const form = document.getElementById('forgot-form') as HTMLFormElement | null;
	const notice = document.getElementById('notice') as HTMLElement;
	const button = form?.querySelector<HTMLButtonElement>('button[type=submit]') ?? null;
	const cooldownKey = 'password-reset-email-cooldown';
	let cooldownTimer: number | undefined;

	const setNotice = (message: string, isError = false) => {
		notice.textContent = message;
		notice.classList.toggle('is-error', isError);
	};
	const startCooldown = (until: number) => {
		if (!button) return;
		window.clearInterval(cooldownTimer);
		try { window.sessionStorage.setItem(cooldownKey, String(until)); } catch {}
		const update = () => {
			const secondsLeft = Math.max(0, Math.ceil((until - Date.now()) / 1000));
			if (secondsLeft > 0) {
				button.disabled = true;
				button.textContent = `請稍候 ${secondsLeft} 秒再寄`;
				return;
			}
			window.clearInterval(cooldownTimer);
			try { window.sessionStorage.removeItem(cooldownKey); } catch {}
			button.disabled = false;
			button.textContent = '再次寄送重設連結';
		};
		update();
		cooldownTimer = window.setInterval(update, 1000);
	};
	let savedCooldown = 0;
	try { savedCooldown = Number(window.sessionStorage.getItem(cooldownKey)); } catch {}
	if (savedCooldown > Date.now() && button && !button.disabled) startCooldown(savedCooldown);

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!button) return;
		const emailInput = document.getElementById('forgot-email') as HTMLInputElement;
		const email = emailInput.value.trim();
		if (!email || !emailInput.checkValidity()) {
			setNotice('請輸入正確的 Email，例如 name@gmail.com。', true);
			emailInput.focus();
			return;
		}
		button.disabled = true;
		button.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>寄送中…';
		setNotice('');
		try {
			const response = await fetch('/api/auth/request-password-reset', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, redirectTo: `${window.location.origin}/account/reset-password` }),
			});
			if (!response.ok) {
				if (response.status === 429) {
					startCooldown(Date.now() + 60_000);
					setNotice('寄送次數已達上限，請稍後再試。', true);
					return;
				}
				throw new Error('request failed');
			}
			startCooldown(Date.now() + 60_000);
			setNotice('若這個 Email 已註冊，重設連結已寄出。請到收件匣查看，沒看到請檢查垃圾郵件。');
		} catch {
			setNotice('目前無法寄送重設連結，請稍後再試。', true);
			button.disabled = false;
			button.textContent = '寄送重設連結';
		}
	});
</script>

<style>
	.back-link{display:inline-flex;align-items:center;gap:.45rem;margin-bottom:1rem;font-size:.88rem;font-weight:600;text-decoration:none}.back-link:hover{text-decoration:underline}.status{margin:0}.meta{margin:.25rem 0 0;text-align:center}
</style>
