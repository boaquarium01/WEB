---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { isAuthEmailConfigured } from '../../lib/email/adapter';

export const prerender = false;
const mailConfigured = isAuthEmailConfigured();
---

<AccountLayout title="重設密碼｜水博館水族">
	<h1>忘記密碼</h1>
	<p class="lead">輸入註冊 Email，我們會寄送一小時內有效的密碼重設連結。</p>
	{!mailConfigured && <p class="notice">郵件服務尚未設定，目前無法寄送重設連結，請聯絡網站管理員。</p>}
	<form id="forgot-form" class="form">
		<label>Email<input type="email" name="email" required autocomplete="email" /></label>
		<button type="submit" disabled={!mailConfigured}>寄送重設連結</button>
	</form>
	<p id="notice" class="notice" role="status" aria-live="polite"></p>
</AccountLayout>

<script>
	const form = document.getElementById('forgot-form');
	const notice = document.getElementById('notice');
	const cooldownKey = 'password-reset-email-cooldown';
	let cooldownTimer;
	const startCooldown = (until) => {
		const button = form?.querySelector('button');
		if (!button) return;
		window.clearInterval(cooldownTimer);
		window.sessionStorage.setItem(cooldownKey, String(until));
		const update = () => {
			const secondsLeft = Math.max(0, Math.ceil((until - Date.now()) / 1000));
			if (secondsLeft > 0) {
				button.disabled = true;
				button.textContent = `請稍候 ${secondsLeft} 秒`;
				return;
			}
			window.clearInterval(cooldownTimer);
			window.sessionStorage.removeItem(cooldownKey);
			button.disabled = false;
			button.textContent = '再次寄送重設連結';
		};
		update();
		cooldownTimer = window.setInterval(update, 1000);
	};
	const savedCooldown = Number(window.sessionStorage.getItem(cooldownKey));
	if (savedCooldown > Date.now() && !form?.querySelector('button')?.disabled) startCooldown(savedCooldown);
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const button = form.querySelector('button');
		button.disabled = true;
		notice.textContent = '正在寄送…';
		const data = new FormData(form);
		try {
			const response = await fetch('/api/auth/request-password-reset', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: data.get('email'), redirectTo: `${window.location.origin}/account/reset-password` }),
			});
			if (!response.ok) {
				if (response.status === 429) {
					startCooldown(Date.now() + 60_000);
					notice.textContent = '寄送次數已達限制，請稍後再試。';
					return;
				}
				throw new Error('request failed');
			}
			startCooldown(Date.now() + 60_000);
			notice.textContent = '若此 Email 已註冊，密碼重設連結已寄出。請查看收件匣與垃圾郵件。';
		} catch {
			notice.textContent = '目前無法寄送重設連結，請稍後再試。';
			button.disabled = false;
			button.textContent = '寄送重設連結';
		}
	});
</script>

<style>
	h1 { margin: 0 0 .5rem; font-size: 1.8rem; }
	.lead { color: var(--muted); }
	.form { display: grid; gap: 1rem; margin: 1.5rem 0; }
	label { display: grid; gap: .4rem; }
	input { padding: .7rem .8rem; border-radius: .5rem; border: 1px solid var(--line); background: rgba(8,20,28,.55); color: var(--ink); }
	button { padding: .75rem 1rem; border: 0; border-radius: .5rem; background: var(--accent); color: #062018; font-weight: 650; cursor: pointer; }
	button:disabled { opacity: .65; cursor: wait; }
	.notice { min-height: 1.5rem; }
</style>
