---
import AccountLayout from '../../layouts/AccountLayout.astro';
import PasswordRules from '../../components/PasswordRules.astro';
import { getServerEnv } from '../../lib/env';
import { getDb } from '../../lib/db/client';
import { account } from '../../lib/db/schema';
import { eq } from 'drizzle-orm';
export const prerender = false;
const user = Astro.locals.user!;
const oauthError = Astro.url.searchParams.get('error');
const accounts = await getDb().select({ id: account.id, providerId: account.providerId, createdAt: account.createdAt }).from(account).where(eq(account.userId, user.id));
const env = getServerEnv();
const providers = { google: Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET), line: Boolean(env.LINE_CHANNEL_ID && env.LINE_CHANNEL_SECRET) };
const hasCredential = accounts.some((item) => item.providerId === 'credential');
const linked = (id: string) => accounts.find((item) => item.providerId === id);
/** 已綁定與可綁定的方式放在同一份清單；只剩一種方式時不能解除 */
const loginMethods = [
	...(hasCredential ? [{ id: 'credential', accountId: linked('credential')?.id, icon: 'fa-solid fa-envelope', name: '手機／Email', detail: '使用密碼登入', action: 'none' }] : []),
	...[
		{ id: 'line', icon: 'fa-brands fa-line', name: 'LINE', enabled: providers.line },
		{ id: 'google', icon: 'fa-brands fa-google', name: 'Google', enabled: providers.google },
	].flatMap((item) => {
		const account = linked(item.id);
		if (!account && !item.enabled) return [];
		return [{ ...item, accountId: account?.id, detail: account ? '已綁定' : '尚未綁定', action: account ? (accounts.length > 1 ? 'unlink' : 'none') : 'link' }];
	}),
];
---
<AccountLayout title="登入與安全｜水博館水族">
	<div class="security-page">
		<h1>登入與安全</h1>
		{oauthError && <p class="error security-error">授權未完成或已取消。請確認該登入方式尚未綁定其他會員後再試。</p>}
		<p id="security-status" class="security-status" role="status" aria-live="polite"></p>

		<section aria-labelledby="login-methods-title">
			<h2 id="login-methods-title">登入方式</h2>
			<ul id="account-list" class="settings-list">
				{loginMethods.map((method) => (
					<li class="settings-row" data-account-id={method.accountId}>
						<span class:list={['provider-icon', `provider-icon--${method.id}`]}><i class={method.icon} aria-hidden="true"></i></span>
						<span class="settings-row__text">{method.name}<small>{method.detail}</small></span>
						{method.action === 'unlink' && <button type="button" class="btn-plain row-action row-action--quiet unlink" aria-label={`解除綁定 ${method.name}`}>解除</button>}
						{method.action === 'link' && <button type="button" class="btn-plain row-action link-social" data-provider={method.id} aria-label={`綁定 ${method.name}`}>綁定</button>}
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="password-title">
			<h2 id="password-title">密碼</h2>
			<details class="settings-list password-details">
				<summary class="settings-row"><span class="provider-icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></span><span class="settings-row__text">{hasCredential ? '修改密碼' : '設定密碼'}{!hasCredential && <small>設定後可用手機或 Email 登入</small>}</span><i class="fa-solid fa-chevron-down details-chevron" aria-hidden="true"></i></summary>
				<form id="password-form" class="form password-form" data-has-credential={String(hasCredential)}>
					{hasCredential && <label>目前密碼<span class="password-field"><input id="security-current-password" type="password" name="currentPassword" autocomplete="current-password" required /><button class="password-toggle" type="button" data-password-toggle="security-current-password" aria-label="顯示密碼" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button></span></label>}
					<label>新密碼<span class="password-field"><input id="security-new-password" type="password" name="newPassword" minlength="8" autocomplete="new-password" required placeholder="請設定密碼" aria-describedby="security-password-rules" /><button class="password-toggle" type="button" data-password-toggle="security-new-password" aria-label="顯示密碼" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button></span><PasswordRules id="security-password-rules" for="security-new-password" /></label>
					<p id="password-status" class="password-status" role="status" aria-live="polite"></p>
					<button type="submit">{hasCredential ? '更新密碼' : '設定密碼'}</button>
					{hasCredential && <a class="reset-link" href="/account/forgot-password">忘記目前密碼？</a>}
				</form>
			</details>
		</section>

		<section aria-labelledby="devices-title">
			<h2 id="devices-title">登入裝置</h2>
			<div class="settings-list">
				<button id="revoke-sessions" class="btn-plain settings-row settings-row--button" type="button"><span class="settings-row__text">登出其他裝置<small>手機遺失或在別人的裝置登入過時使用</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
				<form action="/api/account/logout" method="post"><button class="btn-plain settings-row settings-row--button settings-row--danger" type="submit"><span class="settings-row__text">登出此裝置</span></button></form>
			</div>
		</section>
	</div>
</AccountLayout>
<script>
	import { authClient } from '../../lib/auth/client';
	import { passwordPolicyMessage } from '../../lib/auth/policies.js';
	const hasCredential = document.getElementById('password-form')?.dataset.hasCredential === 'true';
	const status=document.getElementById('security-status');
	for(const button of document.querySelectorAll<HTMLButtonElement>('.link-social')) button.addEventListener('click', async()=>{button.disabled=true; status.textContent='正在前往授權…'; try{const result=await authClient.linkSocial({provider:button.dataset.provider as 'google'|'line',callbackURL:'/account/security'}); if(result.error) throw new Error();}catch{status.textContent='綁定失敗或授權已取消。';button.disabled=false;}});
	for(const button of document.querySelectorAll<HTMLButtonElement>('.unlink')) button.addEventListener('click', async()=>{if(button.dataset.armed!=='1'){button.dataset.armed='1';button.textContent='確定解除？';window.setTimeout(()=>{button.dataset.armed='';button.textContent='解除';},3000);return;}const item=button.closest<HTMLElement>('[data-account-id]'); if(!item)return; button.disabled=true; const response=await fetch('/api/account/security',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({accountId:item.dataset.accountId})}); if(response.ok){item.remove();status.textContent='已解除綁定。';}else{const result=await response.json().catch(()=>({}));status.textContent=result.error||'解除失敗，請保留至少一種登入方式。';button.disabled=false;}});
	for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]')) {
		toggle.addEventListener('click', () => {
			const input = document.getElementById(toggle.dataset.passwordToggle!) as HTMLInputElement;
			const showing = input.type === 'text';
			input.type = showing ? 'password' : 'text';
			toggle.setAttribute('aria-pressed', String(!showing));
			toggle.setAttribute('aria-label', showing ? '顯示密碼' : '隱藏密碼');
			toggle.innerHTML = showing ? '<i class="fa-regular fa-eye" aria-hidden="true"></i>' : '<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>';
		});
	}
	const passwordForm = document.getElementById('password-form') as HTMLFormElement | null;
	const passwordStatus = document.getElementById('password-status') as HTMLElement | null;
	const setPasswordStatus = (message: string, tone: '' | 'error' | 'ok' = '') => {
		if (!passwordStatus) return;
		passwordStatus.textContent = message;
		passwordStatus.dataset.tone = tone;
	};
	passwordForm?.addEventListener('input', () => {
		if (passwordStatus?.dataset.tone === 'error') setPasswordStatus('');
	});
	passwordForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(passwordForm);
		const newPassword = String(data.get('newPassword') ?? '');
		const problem = passwordPolicyMessage(newPassword);
		if (problem) {
			setPasswordStatus(`${problem}。`, 'error');
			document.getElementById('security-new-password')?.focus();
			return;
		}
		const button = passwordForm.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const label = button.textContent;
		button.disabled = true;
		setPasswordStatus('正在更新…');
		try {
			const result = hasCredential
				? await authClient.changePassword({ currentPassword: String(data.get('currentPassword')), newPassword, revokeOtherSessions: true })
				: await authClient.setPassword({ newPassword });
			if (result.error) {
				// 密碼規則訊息是中文直接顯示；Better Auth 的英文錯誤（如 Invalid password）改成中文
				const message = result.error.message ?? '';
				setPasswordStatus(/[一-鿿]/.test(message) ? message : '目前密碼不正確，請再確認一次。', 'error');
			} else {
				passwordForm.reset();
				passwordForm.querySelector('#security-new-password')?.dispatchEvent(new Event('input'));
				setPasswordStatus('密碼已更新。', 'ok');
			}
		} catch {
			setPasswordStatus('密碼更新失敗，請稍後再試。', 'error');
		} finally {
			button.disabled = false;
			button.textContent = label;
		}
	});
	document.getElementById('revoke-sessions')?.addEventListener('click',async()=>{const result=await authClient.revokeSessions();if(result.error){status.textContent='登出失敗，請稍後再試。';return;}status.textContent='已登出其他裝置。';});
</script>

<style>
	.security-page { display: grid; gap: 1.35rem; max-width: 640px; margin: 0 auto; }
	.security-page h1 { margin: 0; color: var(--aq-ink); font-size: clamp(1.3rem, 4vw, 1.6rem); }
	.security-page h2 { margin: 0 0 .5rem; color: var(--aq-muted); font-size: .84rem; font-weight: 700; }
	.security-status { position: sticky; top: 76px; z-index: 5; margin: 0; padding: .7rem .85rem; border-radius: 12px; background: #edf5f1; color: var(--aq-primary-dark); font-size: .88rem; }
	.security-status:empty { display: none; }
	.security-error { margin: 0; }
	.settings-list { margin: 0; padding: 0; overflow: hidden; border: 1px solid #e5eae6; border-radius: 14px; background: #fff; list-style: none; }
	.settings-list > * + *, .settings-list form + form { border-top: 1px solid #eef1ee; }
	.settings-row { display: flex; align-items: center; gap: .75rem; width: 100%; min-height: 60px; padding: .6rem .85rem; }
	.settings-row__text { display: grid; flex: 1; gap: .1rem; min-width: 0; color: var(--aq-ink); font-size: .95rem; font-weight: 650; text-align: left; }
	.settings-row__text small { color: var(--aq-muted); font-size: .76rem; font-weight: 500; }
	.settings-row--button { border: 0; background: none; font: inherit; color: #93a09a; cursor: pointer; }
	.settings-row--button:hover { background: #f7faf8; }
	.settings-row--danger .settings-row__text { color: #a63228; }
	.settings-row--danger { min-height: 52px; }
	.provider-icon { display: grid; flex: none; place-items: center; width: 36px; height: 36px; border-radius: 11px; background: #eaf5f1; color: var(--aq-primary-dark); font-size: .95rem; }
	.provider-icon--google { background: #f1f5fb; color: #4285f4; }
	.provider-icon--line { background: #e9f8ee; color: #06a84f; }
	.row-action { flex: none; min-height: 36px; padding: 0 .85rem; border: 1px solid var(--aq-primary); border-radius: 999px; background: #fff; color: var(--aq-primary-dark); font: inherit; font-size: .84rem; font-weight: 700; cursor: pointer; }
	.row-action--quiet { border-color: #e3e7e5; color: var(--aq-muted); font-weight: 600; }
	.row-action--quiet:hover { border-color: #e4aaa4; color: #a63228; }
	.row-action:disabled { opacity: .6; cursor: wait; }
	.password-details summary { cursor: pointer; list-style: none; }
	.password-details summary::-webkit-details-marker { display: none; }
	.details-chevron { color: #93a09a; font-size: .8rem; transition: transform .18s ease; }
	.password-details[open] .details-chevron { transform: rotate(180deg); }
	.password-form { gap: .85rem !important; margin: 0 !important; padding: .4rem .85rem 1rem; border-top: 1px solid #eef1ee; }
	.password-form label { gap: .45rem; }
	.password-form button[type=submit] { width: 100%; min-height: 46px; }
	.password-field { position: relative; display: block; }
	.password-field input { padding-right: 3rem !important; }
	.password-toggle { position: absolute; top: 50%; right: .4rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; min-height: 0 !important; padding: 0 !important; transform: translateY(-50%); border: 0 !important; background: transparent !important; color: #66756e !important; box-shadow: none !important; cursor: pointer; }
	.password-status { margin: 0; color: var(--aq-muted); font-size: .88rem; }
	.password-status:empty { display: none; }
	.password-status[data-tone=error] { padding: .65rem .85rem; border: 1px solid #f3ceca; border-radius: 10px; background: #fff4f2; color: #a63228; }
	.password-status[data-tone=ok] { padding: .65rem .85rem; border: 1px solid #cde7d8; border-radius: 10px; background: #eff9f2; color: #21633d; }
	.reset-link { justify-self: center; color: var(--aq-primary-dark); font-size: .86rem; font-weight: 650; text-decoration: none; }
</style>
