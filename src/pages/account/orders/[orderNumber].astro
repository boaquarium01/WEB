---
import AccountLayout from '../../../layouts/AccountLayout.astro';
import { formatTwd } from '../../../lib/services/catalog';
import { attachOrderItemImages, orderThumbUrl } from '../../../lib/services/order-item-images';
import PushOptIn from '../../../components/PushOptIn.astro';
import DigitField from '../../../components/DigitField.astro';
import type { ShippingAddressSnapshot } from '../../../lib/services/checkout';
import {
	canSubmitBankLastFive,
	getOrderForUser,
	orderStatusLabel,
} from '../../../lib/services/order';
import {
	getBankTransferInfo,
	submitBankTransferLastFive,
} from '../../../lib/services/payment';
import { getCustomerByUserId } from '../../../lib/services/customer';
import { notifyShopEvent } from '../../../lib/services/shop-notify';

export const prerender = false;

const user = Astro.locals.user!;
const customer = await getCustomerByUserId(user.id);
const orderNumber = String(Astro.params.orderNumber ?? '').trim();

let error: string | null = null;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'submit_last_five') {
			await submitBankTransferLastFive(user.id, {
				orderNumber,
				submissionId: String(form.get('submissionId') ?? ''),
				bankLastFive: String(form.get('bankLastFive') ?? ''),
				note: String(form.get('note') ?? ''),
			});
			await notifyShopEvent('SHOP_PAYMENT_REPORTED', user.id, orderNumber, Astro.url.origin);
			return Astro.redirect(`/account/orders/${encodeURIComponent(orderNumber)}?reported=1#order-top`);
		}
	} catch (e) {
		error = e instanceof Error ? e.message : '操作失敗';
	}
}

const order = orderNumber
	? await getOrderForUser(user.id, orderNumber)
	: null;

if (!order) {
	return Astro.redirect('/account/orders');
}

const addr = order.shippingAddress as ShippingAddressSnapshot;
const payment = order.payments[0];
const submissions = payment?.submissions ?? [];
const latestSubmission = submissions[0] ?? null;
const bank = await getBankTransferInfo();
const showSubmitForm = canSubmitBankLastFive(order.status);
const showCancellationContact = order.status === 'PENDING_PAYMENT' || order.status === 'PAYMENT_SUBMITTED';
const pageTitle =
	order.status === 'CANCELLED'
		? '訂單已取消'
		: order.status === 'PENDING_PAYMENT'
			? '訂單已建立'
			: '訂單詳情';
/** 付款期限：建立後 3 天 */
const PAYMENT_DAYS = 3;
const paymentDeadline = new Date(order.createdAt.getTime() + PAYMENT_DAYS * 24 * 60 * 60 * 1000);
const paymentDeadlineLabel = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', month: 'numeric', day: 'numeric', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(paymentDeadline);
const isAwaitingPayment = order.status === 'PENDING_PAYMENT';
const justReported = Astro.url.searchParams.get('reported') === '1' && order.status === 'PAYMENT_SUBMITTED';
const orderStages = ['建立', '付款', '備貨', '出貨', '完成'];
const activeStageByStatus: Record<string, number> = {
	PENDING_PAYMENT: 0,
	PAYMENT_SUBMITTED: 1,
	PAID: 2,
	PROCESSING: 2,
	SHIPPED: 3,
	COMPLETED: 4,
};
const activeStage = activeStageByStatus[order.status] ?? -1;
const statusDescriptions: Record<string, string> = {
	PENDING_PAYMENT: '訂單已建立，請完成轉帳付款，並回報轉出帳號末五碼，方便我們核對。',
	PAYMENT_SUBMITTED: '已收到您的付款資料，盡快核對中，將於出貨時通知您！',
	PAID: '款項已確認，接下來會為您安排備貨。',
	PROCESSING: '商品正在備貨中，備妥後會安排出貨。',
	SHIPPED: '訂單已出貨，請留意物流配送進度。',
	COMPLETED: '訂單已完成，感謝您的支持！',
	CANCELLED: '訂單已取消；若您已完成轉帳，請聯繫我們協助確認款項。',
};
const statusDescription = statusDescriptions[order.status] ?? '您可以在此查看訂單處理進度。';
/** 商品明細加上小圖（與後台訂單相同） */
const itemsWithImages = await attachOrderItemImages(order.items);
/** 商品明細的單價／小計／運費不顯示「NT」，只有總計用 formatTwd 顯示 NT$（與後台一致） */
const dollars = (amount: number) => `$${new Intl.NumberFormat('zh-TW').format(amount)}`;
---

<AccountLayout title={`訂單 ${order.orderNumber}｜水博館水族`} focus={isAwaitingPayment}>
	<span id="order-top" aria-hidden="true"></span>
	{isAwaitingPayment && (
		<section class="created-hero" aria-labelledby="created-hero-title">
			<span class="created-hero__icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
			<h1 id="created-hero-title">訂單已建立</h1>
			<p class="created-hero__no">訂單編號 <strong class="mono">{order.orderNumber}</strong></p>
			<p class="created-hero__amount"><span>應付金額</span><strong>{formatTwd(order.total)}</strong></p>
			<p class="created-hero__deadline"><i class="fa-regular fa-clock" aria-hidden="true" style="margin-right:.35rem"></i>請於 <strong>{paymentDeadlineLabel}</strong> 前完成轉帳，逾期訂單將會取消</p>
			{showSubmitForm && submissions.length === 0 && <a class="created-hero__report" href="#report-last-five" onclick="event.preventDefault();document.getElementById('report-last-five')?.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(()=>document.querySelector('#report-last-five input[name=bankLastFive]')?.focus({preventScroll:true}),450)">已完成轉帳？回報末五碼 <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>}
		</section>
	)}
	<header class="head">
		{!isAwaitingPayment && <h1>{pageTitle}</h1>}
		<div class:list={['order-status-note', order.status === 'CANCELLED' && 'is-cancelled']} role="status">
			<i class:list={['fa-solid', order.status === 'CANCELLED' ? 'fa-circle-exclamation' : 'fa-circle-info']} aria-hidden="true"></i>
			<div><strong>{orderStatusLabel(order.status)}</strong><p>{statusDescription}</p></div>
		</div>
		<div class="order-progress" aria-label="訂單進度">
			{orderStages.map((stage, index) => <div class:list={['progress-step', index < activeStage && 'complete', index === activeStage && 'current']}><span class="progress-dot">{index < activeStage ? <i class="fa-solid fa-check" aria-hidden="true"></i> : index + 1}</span><span>{stage}</span>{index < orderStages.length - 1 && <i class="progress-connector" aria-hidden="true"></i>}</div>)}
		</div>
		{order.status === 'CANCELLED' && <p class="cancelled-status">此訂單已取消</p>}
	</header>

	{['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'PAID', 'PROCESSING'].includes(order.status) && <PushOptIn variant="compact" />}

	{error && <p class="banner error">{error}</p>}

	{
		order.status !== 'CANCELLED' && (
			<details class="panel collapsible-panel" open={activeStage < 2}>
				<summary class="panel-title-row collapsible-panel__summary"><h2>銀行轉帳資訊</h2><i class="fa-solid fa-chevron-down collapsible-panel__chevron" aria-hidden="true"></i></summary>
				<div class="pay-amount">
					<span>應付金額</span>
					<strong class="mono">{formatTwd(order.total)}</strong>
					<button type="button" class="copy-pill btn-plain" data-copy-text={String(order.total)} aria-label="複製應付金額"><i class="fa-regular fa-copy" aria-hidden="true"></i><span data-copy-label>複製</span></button>
				</div>
				<dl class="bank-card">
					<div>
						<dt>銀行</dt>
						<dd>{bank.bankName}</dd>
					</div>
					<div>
						<dt>戶名</dt>
						<dd>{bank.accountName}</dd>
					</div>
					<div>
						<dt>帳號</dt>
						<dd>
							<span class="mono bank-card__account">{bank.accountNumber}</span>
							{/\d{5,}/.test(bank.accountNumber.replace(/\D/g, '')) && (
								<button type="button" class="copy-pill btn-plain" data-copy-text={bank.accountNumber.replace(/\D/g, '')} aria-label="複製銀行帳號"><i class="fa-regular fa-copy" aria-hidden="true"></i><span data-copy-label>複製</span></button>
							)}
						</dd>
					</div>
				</dl>
				<div class="transfer-reference">
					<p class="transfer-reference__message"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>轉帳備註請填寫訂單編號，方便對帳</p>
					<div class="transfer-reference__row">
						<strong class="mono">{order.orderNumber}</strong>
						<button type="button" class="copy-pill btn-plain" data-copy-text={order.orderNumber} aria-label="複製訂單編號"><i class="fa-regular fa-copy" aria-hidden="true"></i><span data-copy-label>複製編號</span></button>
					</div>
				</div>
			</details>
		)
	}

	{
		showSubmitForm && (
			<section id="report-last-five" class="panel transfer-report-panel" data-transfer-report hidden={submissions.length > 0}>
				<h2>回報轉帳末五碼</h2>
				<p class="hint">轉帳後，輸入<strong>您轉出帳號</strong>的末 5 碼</p>
				<form method="post" class="submit-form" action={`/account/orders/${encodeURIComponent(order.orderNumber)}`}>
					<input type="hidden" name="_action" value="submit_last_five" />
					<input type="hidden" name="submissionId" value={latestSubmission?.id ?? ''} />
					<DigitField name="bankLastFive" length={5} value={latestSubmission?.bankLastFive ?? customer?.bankAccountLastFive ?? ''} label="您轉出帳號的末五碼" />
					<details class="note-toggle" open={Boolean(latestSubmission?.note)}>
						<summary><i class="fa-solid fa-plus" aria-hidden="true"></i>加備註（選填）</summary>
						<input type="text" name="note" value={latestSubmission?.note ?? ''} placeholder="例如：已於今晚轉帳" aria-label="備註（選填）" />
					</details>
					<div class="form-actions">
						<button type="submit" class="btn-primary">{latestSubmission ? '儲存修改' : '送出末五碼'}</button>
						{latestSubmission && <button type="button" class="cancel-transfer-button" data-cancel-transfer>取消</button>}
					</div>
				</form>
			</section>
		)
	}

	{
		submissions.length > 0 && (
			<details class="panel collapsible-panel" open={activeStage < 2}>
				<summary class="panel-title-row collapsible-panel__summary">
					<div class="panel-title-content"><h2>我的帳號末五碼</h2>{latestSubmission && (latestSubmission.verifiedAt ? <span class="badge ok">已核對</span> : <span class="badge">待核對</span>)}</div>
					<i class="fa-solid fa-chevron-down collapsible-panel__chevron" aria-hidden="true"></i>
				</summary>
				<ul class="subs">
					{latestSubmission && (
						<li>
							<span class="mono">{latestSubmission.bankLastFive}</span>
							<span>{formatTwd(latestSubmission.amount)}</span>
							<span class="muted">
								{latestSubmission.submittedAt.toLocaleString('zh-TW', {
									timeZone: 'Asia/Taipei',
								})}
							</span>
							{showSubmitForm && !latestSubmission.verifiedAt && <button type="button" class="edit-transfer-button" data-edit-transfer>編輯</button>}
						</li>
					)}
				</ul>
			</details>
		)
	}

	<section class="panel">
		<h2>收件資訊</h2>
		<p>
			{addr.recipientName} · {addr.phone}
		</p>
		{addr.shippingMethodName && <p>配送方式：{addr.shippingMethodName}</p>}
		<p>
			{addr.postalCode} {addr.city}
			{addr.district}
			{addr.addressLine}
		</p>
		{order.note && <p class="note">備註：{order.note}</p>}
	</section>

	<section class="panel">
		<h2>商品明細</h2>
		<div class="order-items-header" aria-hidden="true"><span>商品</span><span>單價</span><span>數量</span><span>總計</span></div>
		<ul class="lines order-lines">
			{
				itemsWithImages.map((item) => (
					<li>
						<span class="order-product">
							<span class="order-thumb" aria-hidden="true">{item.imageUrl ? <img src={orderThumbUrl(item.imageUrl)} alt="" loading="lazy" decoding="async" /> : <i class="fa-solid fa-fish"></i>}</span>
							<span class="order-product__text"><span class="order-product__name">{item.productName}</span>
								{item.skuName && item.skuName !== item.productName && <small>規格：{item.skuName}</small>}
							</span>
						</span>
						<span class="order-unit-price">{dollars(item.unitPrice)}</span>
						<span class="order-quantity">{item.quantity}</span>
						<span class="order-calc">{dollars(item.unitPrice)} × <b>{item.quantity}</b></span>
						<strong class="order-line-total">{dollars(item.subtotal)}</strong>
					</li>
				))
			}
		</ul>
		<dl class="totals">
			<div>
				<dt>小計</dt>
				<dd>{dollars(order.subtotal)}</dd>
			</div>
			<div>
				<dt>運費</dt>
				<dd>{dollars(order.shippingFee)}</dd>
			</div>
			{
				order.discount > 0 && (
					<div>
						<dt>折扣{order.discountCode && <small class="discount-code">{order.discountCode}</small>}</dt>
						<dd>-{dollars(order.discount)}</dd>
					</div>
				)
			}
			<div class="grand">
				<dt>總計</dt>
				<dd>{formatTwd(order.total)}</dd>
			</div>
		</dl>
	</section>

	{
		showCancellationContact && (
			<section class="panel cancellation-contact">
				<div><h2>訂單有疑問嗎？</h2><p class="hint">請聯絡我們，由門市協助確認訂單狀態。</p></div>
				<a class="line-contact-button" href="https://lin.ee/nG8kcR2" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-line" aria-hidden="true"></i>聯絡我們</a>
			</section>
		)
	}

	<p class="created-at">建立於 {order.createdAt.toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' })}</p>
</AccountLayout>

<script>
	const copyOrderButton = document.querySelector<HTMLButtonElement>('[data-copy-order-number]');
	const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
	copyOrderButton?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(copyOrderButton.dataset.copyOrderNumber ?? '');
			if (copyFeedback) copyFeedback.textContent = '已複製';
		} catch {
			if (copyFeedback) copyFeedback.textContent = '無法複製，請手動選取編號';
		}
	});
	// B6：銀行帳號等「一鍵複製」按鈕
	document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((button) => {
		const label = button.querySelector<HTMLElement>('[data-copy-label]');
		const originalLabel = label?.textContent ?? '複製';
		let resetTimer = 0;
		button.addEventListener('click', async () => {
			window.clearTimeout(resetTimer);
			try {
				await navigator.clipboard.writeText(button.dataset.copyText ?? '');
				if (label) label.textContent = '已複製';
				button.classList.add('is-copied');
			} catch {
				if (label) label.textContent = '請手動複製';
			}
			resetTimer = window.setTimeout(() => {
				if (label) label.textContent = originalLabel;
				button.classList.remove('is-copied');
			}, 2000);
		});
	});
	const editTransferButton = document.querySelector<HTMLButtonElement>('[data-edit-transfer]');
	const transferReport = document.querySelector<HTMLElement>('[data-transfer-report]');
	const cancelTransferButton = document.querySelector<HTMLButtonElement>('[data-cancel-transfer]');
	const transferForm = document.querySelector<HTMLFormElement>('[data-transfer-report] .submit-form');
	editTransferButton?.addEventListener('click', () => {
		if (!transferReport) return;
		transferReport.hidden = false;
		transferReport.querySelector<HTMLInputElement>('input[name="bankLastFive"]')?.focus();
		transferReport.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});
	cancelTransferButton?.addEventListener('click', () => {
		if (!transferReport) return;
		transferReport.querySelector<HTMLFormElement>('.submit-form')?.reset();
		transferReport.hidden = true;
	});
	// 回報成功後：移除網址參數，避免重新整理又出現提示
	const reportedUrl = new URL(window.location.href);
	if (reportedUrl.searchParams.has('reported')) { reportedUrl.searchParams.delete('reported'); reportedUrl.hash = ''; history.replaceState(history.state, '', reportedUrl); window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior }); }
	// 從上一頁返回時（瀏覽器快取），把卡住的「送出中…」按鈕還原
	window.addEventListener('pageshow', (event) => {
		if (!event.persisted) return;
		const button = transferForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (button) { button.disabled = false; button.textContent = button.dataset.label ?? button.textContent; }
	});
	transferForm?.addEventListener('submit', () => {
		const submitButton = transferForm.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!submitButton) return;
		submitButton.dataset.label = submitButton.textContent ?? ''; submitButton.disabled = true;
		submitButton.textContent = '送出中…';
	});
</script>

<style>
	.head {
		margin-bottom: 1rem;
	}

	.crumb {
		margin: 0 0 0.35rem;
		color: var(--aq-muted);
		font-size: 0.9rem;
	}

	.crumb a {
		text-decoration: none;
		color: var(--aq-primary);
	}

	h1 {
		margin: 0;
		font-size: 1.6rem;
	}

	.lead {
		margin: 0.4rem 0 0;
		color: var(--aq-muted);
	}

	.muted-sm {
		font-size: 0.88rem;
	}

	h2 {
		margin: 0 0 0.65rem;
		font-size: 1.05rem;
	}

	.banner {
		padding: 0.7rem 1rem;
		border-radius: var(--aq-radius-sm);
		margin-bottom: 0.85rem;
	}

	.banner.error {
		background: rgba(180, 35, 24, 0.08);
		color: var(--aq-danger);
	}

	.panel {
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius);
		padding: 1.1rem 1.2rem;
		margin-bottom: 0.85rem;
	}

	.cancellation-contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		column-gap: 1rem;
		padding: 0.8rem 1rem;
	}
	.cancellation-contact h2{margin:0 0 .2rem;font-size:.95rem}
	.cancellation-contact .hint{margin:0;font-size:.8rem}
	.line-contact-button{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.5rem .8rem;border-radius:9px;background:#06c755;color:#fff!important;font-size:.84rem;font-weight:700;text-decoration:none}
	.line-contact-button:hover{background:#05b94e}

	.panel p {
		margin: 0.3rem 0;
	}

	.hint,
	.note,
	.muted {
		color: var(--aq-muted);
		font-size: 0.92rem;
	}

	.bank {
		margin: 0.75rem 0;
		display: grid;
		gap: 0.4rem;
	}

	.bank > div {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 0.5rem;
	}

	.bank dt,
	.bank dd {
		margin: 0;
	}

	.mono {
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
	}

	.submit-form {
		display: grid;
		gap: 0.75rem;
		margin-top: 0.75rem;
		max-width: 22rem;
	}
	/* 回報末五碼 */
	.transfer-report-panel .hint{margin:.25rem 0 0;font-size:.9rem}
	.transfer-report-panel .hint strong{color:var(--aq-primary-dark)}
	.transfer-report-panel .submit-form{max-width:none;gap:.85rem}
	.note-toggle summary{display:inline-flex;align-items:center;gap:.35rem;color:var(--aq-muted);font-size:.85rem;font-weight:650;cursor:pointer;list-style:none}
	.note-toggle summary::-webkit-details-marker{display:none}
	.note-toggle summary i{font-size:.7rem}
	.note-toggle[open] summary{margin-bottom:.45rem}
	.note-toggle[open] summary i{transform:rotate(45deg)}
	.transfer-report-panel .form-actions>button[type=submit]{min-height:52px;font-size:1.05rem}
	.form-actions{display:flex;gap:.6rem}
	.form-actions>button{flex:1}
	.cancel-transfer-button{border:1px solid var(--aq-line)!important;background:#fff!important;color:var(--aq-primary-dark)!important;box-shadow:none!important}
	.cancel-transfer-button:hover{border-color:#b9d8d0!important;background:#f4f9f7!important}

	.submit-form label {
		display: grid;
		gap: 0.35rem;
		font-size: 0.92rem;
	}

	.submit-form input {
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
		font: inherit;
	}

	.subs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	.subs li {
		display: grid;
		grid-template-columns: auto auto minmax(0,1fr) auto;
		gap: 0.65rem;
		align-items: center;
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--aq-line);
	}

	.badge {
		font-size: 0.78rem;
		padding: 0.15rem 0.45rem;
		border-radius: 999px;
		background: var(--aq-sand-2, #f3efe6);
		color: var(--aq-muted);
	}

	.badge.ok {
		background: var(--aq-primary-soft);
		color: var(--aq-primary-dark);
	}

	.lines {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.lines li {
