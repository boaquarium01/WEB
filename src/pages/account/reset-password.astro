---
import AccountLayout from '../../layouts/AccountLayout.astro';
import PasswordRules from '../../components/PasswordRules.astro';

export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
---

<AccountLayout title="設定新密碼｜水博館水族">
	<div class="auth-head">
		<h1>設定新密碼</h1>
		{token && <p>新密碼需包含英文大小寫、數字和特殊符號，至少 8 碼。</p>}
	</div>
	{token ? (
		<form id="reset-form" class="form" novalidate data-token={token}>
			<label>
				新密碼
				<div class="password-field">
					<input id="reset-password" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="請設定密碼" aria-describedby="reset-password-rules" />
					<button class="password-toggle" type="button" data-password-toggle="reset-password" aria-label="顯示密碼" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
				</div>
				<PasswordRules id="reset-password-rules" for="reset-password" />
			</label>
			<label>
				再次輸入新密碼
				<div class="password-field">
					<input id="reset-confirm-password" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="請再輸入一次新密碼" />
					<button class="password-toggle" type="button" data-password-toggle="reset-confirm-password" aria-label="顯示密碼" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
				</div>
			</label>
			<p id="notice" class="status" role="status" aria-live="polite"></p>
			<button type="submit">更新密碼</button>
		</form>
	) : <p class="error">重設連結無效或已失效，請重新申請。</p>}
	<p class="meta"><a href={token ? '/account/login' : '/account/forgot-password'}>{token ? '返回登入' : '重新申請重設連結'}</a></p>
</AccountLayout>

<script>
	import { passwordPolicyMessage } from '../../lib/auth/policies.js';

	const form = document.getElementById('reset-form') as HTMLFormElement | null;
	const notice = document.getElementById('notice') as HTMLElement | null;
	const setNotice = (message: string, isError = false) => {
		if (!notice) return;
		notice.textContent = message;
		notice.classList.toggle('is-error', isError);
	};

	for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]')) {
		toggle.addEventListener('click', () => {
			const input = document.getElementById(toggle.dataset.passwordToggle!) as HTMLInputElement;
			const showing = input.type === 'text';
			input.type = showing ? 'password' : 'text';
			toggle.setAttribute('aria-pressed', String(!showing));
			toggle.setAttribute('aria-label', showing ? '顯示密碼' : '隱藏密碼');
			toggle.innerHTML = showing ? '<i class="fa-regular fa-eye" aria-hidden="true"></i>' : '<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>';
		});
	}

	form?.addEventListener('input', () => {
		if (notice?.classList.contains('is-error')) setNotice('');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const password = String(data.get('password') ?? '');
		const problem = passwordPolicyMessage(password);
		if (problem) {
			setNotice(`${problem}。`, true);
			document.getElementById('reset-password')?.focus();
			return;
		}
		if (password !== String(data.get('confirmPassword') ?? '')) {
			setNotice('兩次輸入的密碼不一致。', true);
			document.getElementById('reset-confirm-password')?.focus();
			return;
		}
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		button.disabled = true;
		button.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>更新中…';
		try {
			const response = await fetch('/api/auth/reset-password', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ newPassword: password, token: form.dataset.token }),
			});
			const payload = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(payload.message || payload.error || '此重設連結無效或已失效。');
			form.replaceWith(Object.assign(document.createElement('p'), { className: 'ok-box', textContent: '密碼已更新，請使用新密碼登入。' }));
		} catch (error) {
			setNotice(error instanceof Error ? error.message : '更新失敗，請重新申請重設連結。', true);
			button.disabled = false;
			button.textContent = '更新密碼';
		}
	});
</script>

<style>
	.password-field{position:relative}.password-field input{padding-right:3rem!important}.password-toggle{position:absolute;top:50%;right:.4rem;display:grid;place-items:center;width:2.5rem;height:2.5rem;min-height:0!important;padding:0!important;transform:translateY(-50%);border:0!important;background:transparent!important;color:#66756e!important;box-shadow:none!important;cursor:pointer}.password-toggle:hover{color:var(--aq-primary-dark)!important;transform:translateY(-50%)!important}.status{margin:0}.meta{margin:.25rem 0 0;text-align:center}
	:global(.ok-box){margin:1rem 0;padding:.75rem .9rem;border:1px solid #cde7d8;border-radius:10px;background:#eff9f2;color:#21633d}
</style>
