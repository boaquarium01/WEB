---
import AccountLayout from '../../layouts/AccountLayout.astro';

export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
---

<AccountLayout title="設定新密碼｜水博館水族">
	<h1>設定新密碼</h1>
	{token ? (
		<>
			<p class="lead">請設定至少 8 個字元的新密碼。</p>
			<form id="reset-form" class="form">
				<label>新密碼<input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
				<label>再次輸入新密碼<input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" /></label>
				<button type="submit">更新密碼</button>
			</form>
			<p id="notice" class="notice" role="status" aria-live="polite"></p>
		</>
	) : <p class="error">重設連結無效或已失效，請重新申請。</p>}
	<p class="meta"><a href="/account/login">返回登入</a></p>
</AccountLayout>

<script define:vars={{ token }}>
	const form = document.getElementById('reset-form');
	const notice = document.getElementById('notice');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const password = String(data.get('password') ?? '');
		if (password !== String(data.get('confirmPassword') ?? '')) {
			notice.textContent = '兩次輸入的密碼不一致。';
			return;
		}
		const button = form.querySelector('button');
		button.disabled = true;
		try {
			const response = await fetch('/api/auth/reset-password', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ newPassword: password, token }),
			});
			const payload = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(payload.message || payload.error || '此重設連結無效或已失效。');
			notice.textContent = '密碼已更新，請使用新密碼登入。';
			form.remove();
		} catch (error) {
			notice.textContent = error instanceof Error ? error.message : '更新失敗，請重新申請重設連結。';
			button.disabled = false;
		}
	});
</script>

<style>
	h1 { margin: 0 0 .5rem; font-size: 1.8rem; }
	.lead, .meta { color: var(--muted); }
	.form { display: grid; gap: 1rem; margin: 1.5rem 0; }
	label { display: grid; gap: .4rem; }
	input { padding: .7rem .8rem; border-radius: .5rem; border: 1px solid var(--line); background: rgba(8,20,28,.55); color: var(--ink); }
	button { padding: .75rem 1rem; border: 0; border-radius: .5rem; background: var(--accent); color: #062018; font-weight: 650; cursor: pointer; }
	button:disabled { opacity: .65; cursor: wait; }
	.notice { min-height: 1.5rem; }
	.error { color: #ff8f8f; }
</style>
