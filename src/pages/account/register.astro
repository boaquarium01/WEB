---
import AccountLayout from '../../layouts/AccountLayout.astro';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<AccountLayout title="註冊｜水博館 V2">
	<h1>會員註冊</h1>
	<p class="lead">建立帳號後，我們會寄送 Email 驗證信。</p>

	{error && <p class="error">{error}</p>}

	<form id="register-form" class="form">
		<label>
			姓名
			<input type="text" name="name" required autocomplete="name" />
		</label>
		<label>
			Email
			<input type="email" name="email" required autocomplete="email" />
		</label>
		<label>
			密碼（至少 8 碼）
			<input
				type="password"
				name="password"
				required
				minlength="8"
				autocomplete="new-password"
			/>
		</label>
		<label>確認密碼<input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" /></label>
		<label class="terms"><input type="checkbox" name="acceptedTerms" required />我已閱讀並同意<a href="/terms" target="_blank" rel="noreferrer">服務條款</a>與<a href="/privacy" target="_blank" rel="noreferrer">隱私權政策</a></label>
		<button type="submit">註冊</button>
	</form>

	<p class="meta">
		已有帳號？<a href="/account/login">登入</a>
	</p>
</AccountLayout>

<script>
	const form = document.getElementById('register-form');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (data.get('password') !== data.get('confirmPassword')) {
			window.location.href = `/account/register?error=${encodeURIComponent('兩次輸入的密碼不一致')}`;
			return;
		}
		const res = await fetch('/api/account/register', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				name: data.get('name'),
				email: data.get('email'),
				password: data.get('password'),
				confirmPassword: data.get('confirmPassword'),
				acceptedTerms: data.get('acceptedTerms') === 'on',
			}),
		});

		if (!res.ok) {
			let message = '註冊失敗';
			try {
				const payload = await res.json();
				message = payload.error || message;
			} catch {
				/* ignore */
			}
			window.location.href = `/account/register?error=${encodeURIComponent(message)}`;
			return;
		}

		window.location.href = '/account/verify-email?sent=1';
	});
</script>

<style>
	h1 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
	}

	.lead,
	.meta {
		color: var(--muted);
	}

	.error {
		color: #ff8f8f;
		background: rgba(120, 20, 20, 0.25);
		border: 1px solid rgba(255, 140, 140, 0.35);
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
	}

	.form {
		display: grid;
		gap: 1rem;
		margin: 1.5rem 0;
	}

	label {
		display: grid;
		gap: 0.4rem;
		font-size: 0.95rem;
	}

	input {
		padding: 0.7rem 0.8rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line);
		background: rgba(8, 20, 28, 0.55);
		color: var(--ink);
	}
	.terms { display:flex; grid-template-columns:auto 1fr; align-items:center; gap:.45rem; font-weight:500; }
	.terms input { width:1rem; height:1rem; }

	button {
		padding: 0.75rem 1rem;
		border: 0;
		border-radius: 0.5rem;
		background: var(--accent);
		color: #062018;
		font-weight: 650;
		cursor: pointer;
	}
</style>
