---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { getServerEnv } from '../../lib/env';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
const authEnv = getServerEnv();
const googleEnabled = Boolean(authEnv.GOOGLE_CLIENT_ID && authEnv.GOOGLE_CLIENT_SECRET);
const lineEnabled = Boolean(authEnv.LINE_CHANNEL_ID && authEnv.LINE_CHANNEL_SECRET);
---

<AccountLayout title="註冊｜水博館 V2">
	<h1 class="visually-hidden">建立會員帳號</h1>

	{error && <p class="error">{error}</p>}

	<form id="register-form" class="form">
		<label>
			姓名
			<input type="text" name="name" required autocomplete="name" placeholder="請輸入姓名" />
		</label>
		<label>
			電子郵件
			<input type="email" name="email" required autocomplete="email" placeholder="請輸入 Email" />
		</label>
		<label>
			密碼（至少 8 碼）
			<input
				type="password"
				name="password"
				required
				minlength="8"
				autocomplete="new-password"
				placeholder="請設定至少 8 碼密碼"
			/>
		</label>
		<label>確認密碼<input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="請再次輸入密碼" /></label>
		<label class="terms"><input type="checkbox" name="acceptedTerms" required />我已閱讀並同意<a href="/terms" target="_blank" rel="noreferrer">服務條款</a>與<a href="/privacy" target="_blank" rel="noreferrer">隱私權政策</a></label>
		<button type="submit" id="register-submit">註冊</button>
	</form>
	<p id="register-status" class="status" role="status" aria-live="polite"></p>

	<div class="divider"><span>或使用其他方式註冊</span></div>
	<div class="social-login">
		{googleEnabled ? <button type="button" class="social" data-provider="google"><span class="google-mark" aria-hidden="true">G</span>使用 Google 註冊</button> : <p class="social-unavailable">Google 登入尚未設定</p>}
		{lineEnabled ? <button type="button" class="social line" data-provider="line"><i class="fa-solid fa-comment" aria-hidden="true"></i>使用 LINE 註冊</button> : <p class="social-unavailable">LINE 登入尚未設定</p>}
	</div>

	<p class="meta">
		已有帳號？<a href="/account/login">登入</a>
	</p>
</AccountLayout>

<script>
	const form = document.getElementById('register-form');
	const status = document.getElementById('register-status');
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-provider]')) {
		button.addEventListener('click', async () => {
			button.disabled = true;
			if (status) status.textContent = '正在前往授權…';
			try {
				const { authClient } = await import('../../lib/auth/client');
				const result = await authClient.signIn.social({ provider: button.dataset.provider!, callbackURL: '/account/complete-profile?next=%2Faccount' });
				if (result.error) throw new Error();
			} catch {
				if (status) status.textContent = '授權失敗或已取消，請再試一次。';
				button.disabled = false;
			}
		});
	}
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const submit = document.getElementById('register-submit') as HTMLButtonElement;
		if (data.get('password') !== data.get('confirmPassword')) {
			if (status) status.textContent = '兩次輸入的密碼不一致。';
			return;
		}
		submit.disabled = true;
		if (status) status.textContent = '正在建立帳號…';
		try {
			const res = await fetch('/api/account/register', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: data.get('name'),
					email: data.get('email'),
					password: data.get('password'),
					confirmPassword: data.get('confirmPassword'),
					acceptedTerms: data.get('acceptedTerms') === 'on',
				}),
			});

			if (!res.ok) {
				const payload = await res.json().catch(() => ({}));
				throw new Error(payload.error || '註冊失敗，請稍後再試。');
			}

			window.location.href = '/account/verify-email?sent=1';
		} catch (error) {
			if (status) status.textContent = error instanceof Error ? error.message : '註冊失敗，請稍後再試。';
			submit.disabled = false;
		}
	});
</script>

<style>
	.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.terms{display:flex!important;flex-wrap:wrap;grid-template-columns:none!important;align-items:center;gap:.4rem!important;font-weight:450!important;line-height:1.5}.terms input{width:1rem;height:1rem;flex:none}.status{min-height:1.25rem;color:#c8c8c8}.social-login{display:grid;gap:.55rem}.social{width:100%;display:flex;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1rem}.google-mark{font-family:Arial,sans-serif;font-size:1.1rem;font-weight:800;background:conic-gradient(from -45deg,#4285f4 0 25%,#34a853 0 50%,#fbbc05 0 75%,#ea4335 0);color:transparent;background-clip:text}.meta{margin:.65rem 0}
</style>
