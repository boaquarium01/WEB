---
import AccountLayout from '../../layouts/AccountLayout.astro';
import EmailField from '../../components/EmailField.astro';
import { safeLocalRedirect } from '../../lib/auth/policies.js';
import { getServerEnv } from '../../lib/env';

export const prerender = false;

const next = safeLocalRedirect(Astro.url.searchParams.get('next'), Astro.url.origin);
const rawError = Astro.url.searchParams.get('error');
const error = rawError ? (['access_denied', 'OAuthCallbackError', 'oauth_error'].includes(rawError) ? '授權已取消或失敗，請再試一次。' : rawError) : null;
const authEnv = getServerEnv();
const googleEnabled = Boolean(authEnv.GOOGLE_CLIENT_ID && authEnv.GOOGLE_CLIENT_SECRET);
const lineEnabled = Boolean(authEnv.LINE_CHANNEL_ID && authEnv.LINE_CHANNEL_SECRET);
const registerHref = next && next !== '/account' ? `/account/register?next=${encodeURIComponent(next)}` : '/account/register';
---

<AccountLayout title="會員登入｜水博館水族">
	<h1 class="visually-hidden">會員登入</h1>

	{error && <p class="error">{error}</p>}

	<form id="login-form" class="form" method="post" action="/api/account/login" novalidate>
		<input type="hidden" name="next" value={next} />
		<div class="login-field">
			<i class="fa-regular fa-user login-field__icon" aria-hidden="true"></i>
			<EmailField id="login-email" label="手機或電子郵件" placeholder="手機號碼 / Email" remember acceptsPhone />
		</div>
		<div class="login-field login-field--password">
			<i class="fa-solid fa-lock login-field__icon" aria-hidden="true"></i>
			<label class="visually-hidden" for="login-password">密碼</label>
			<div class="password-field">
				<input id="login-password" type="password" name="password" required minlength="8" autocomplete="current-password" enterkeyhint="go" placeholder="密碼" />
				<button class="password-toggle" type="button" id="toggle-password" aria-label="顯示密碼" aria-controls="login-password" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
				<a class="forgot-link" href="/account/forgot-password">忘記密碼</a>
			</div>
		</div>
		<p id="login-status" class="status" role="status" aria-live="polite"></p>
		<button type="submit" id="login-submit">登入</button>
	</form>

	{(lineEnabled || googleEnabled) && (
		<div class="divider"><span>或</span></div>
		<div class="social-login">
			{lineEnabled && <button type="button" class="social line" data-provider="line" aria-label="使用 LINE 登入"><i class="fa-brands fa-line" aria-hidden="true"></i>LINE</button>}
			{googleEnabled && <button type="button" class="social" data-provider="google" aria-label="使用 Google 登入"><span class="google-mark" aria-hidden="true">G</span>Google</button>}
		</div>
	)}

	<p class="login-terms">登入即表示您同意水博館水族的<a href="/shopping-guide" target="_blank" rel="noreferrer">服務條款</a>及<a href="/privacy" target="_blank" rel="noreferrer">隱私權政策</a></p>
	<p class="meta">還沒有帳號？<a href={registerHref}>註冊</a></p>
</AccountLayout>

<script>
	import { normalizeTaiwanMobile } from '../../lib/auth/policies.js';

	const form = document.getElementById('login-form') as HTMLFormElement | null;
	const status = document.getElementById('login-status') as HTMLElement;
	const submit = document.getElementById('login-submit') as HTMLButtonElement;
	const next = (document.querySelector<HTMLInputElement>('[name="next"]')?.value || '/account');

	const setStatus = (message: string, isError = false) => {
		status.textContent = message;
		status.classList.toggle('is-error', isError);
	};
	const setLoading = (loading: boolean) => {
		submit.disabled = loading;
		submit.innerHTML = loading ? '<span class="btn-spinner" aria-hidden="true"></span>登入中…' : '登入';
	};

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-provider]')) {
		button.addEventListener('click', async () => {
			button.disabled = true;
			// 不另外跳出文字列，改由按鈕本身顯示前往中的動畫
			button.classList.add('is-redirecting');
			button.setAttribute('aria-busy', 'true');
			try {
				const { authClient } = await import('../../lib/auth/client');
				const result = await authClient.signIn.social({ provider: button.dataset.provider!, callbackURL: `/account/complete-profile?next=${encodeURIComponent(next)}` });
				if (result.error) throw new Error();
			} catch {
				button.classList.remove('is-redirecting');
				button.removeAttribute('aria-busy');
				setStatus('授權失敗或已取消，請再試一次。', true);
				button.disabled = false;
			}
		});
	}

	const passwordInput = document.getElementById('login-password') as HTMLInputElement;
	const togglePassword = document.getElementById('toggle-password');
	togglePassword?.addEventListener('click', () => {
		const showing = passwordInput.type === 'text';
		passwordInput.type = showing ? 'password' : 'text';
		togglePassword.setAttribute('aria-label', showing ? '顯示密碼' : '隱藏密碼');
		togglePassword.innerHTML = showing ? '<i class="fa-regular fa-eye" aria-hidden="true"></i>' : '<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>';
		togglePassword.setAttribute('aria-pressed', String(!showing));
	});

	// 有記住的 Email 就直接把游標放在密碼欄
	const emailInput = document.getElementById('login-email') as HTMLInputElement;
	if (emailInput.value && window.matchMedia('(min-width: 768px)').matches) passwordInput.focus();

	form?.addEventListener('input', () => {
		if (status.classList.contains('is-error')) setStatus('');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const email = String(data.get('email') ?? '').trim();
		const password = String(data.get('password') ?? '');
		if (!(email.includes('@') ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) : normalizeTaiwanMobile(email))) {
			setStatus('請輸入正確的手機號碼或電子郵件。', true);
			emailInput.focus();
			return;
		}
		if (password.length < 8) {
			setStatus('密碼至少 8 碼，請再確認一次。', true);
			passwordInput.focus();
			return;
		}
		setLoading(true);
		setStatus('');
		try {
			const res = await fetch('/api/account/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password }),
			});
			if (!res.ok) {
				const payload = await res.json().catch(() => ({}));
				if (payload.code === 'EMAIL_NOT_VERIFIED') {
					try {
						sessionStorage.setItem('aq-verify-email', payload.email ?? email);
						sessionStorage.setItem('aq-verify-next', next);
					} catch {}
					window.location.href = '/account/verify-email?sent=1';
					return;
				}
				throw new Error(payload.error || '帳號或密碼不正確，請再確認一次。');
			}
			window.dispatchEvent(new CustomEvent('aq:login-success', { detail: email }));
			window.location.href = next;
		} catch (error) {
			setStatus(error instanceof Error ? error.message : '目前無法登入，請稍後再試。', true);
			setLoading(false);
		}
	});
</script>

<style>
	.visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	.login-field { position: relative; }
	.login-field__icon { position: absolute; top: 17px; left: 14px; z-index: 1; color: #7c8a84; font-size: 15px; pointer-events: none; }
	.login-field :global(input) { padding-left: 2.6rem !important; }
	.login-field :global(.email-field > label) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
	.password-field { position: relative; }
	.login-field--password input { padding-right: 7.4rem !important; }
	.password-toggle { position: absolute; top: 50%; right: 4.7rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; min-height: 0 !important; padding: 0 !important; transform: translateY(-50%); border: 0 !important; background: transparent !important; color: #66756e !important; box-shadow: none !important; cursor: pointer; }
	.password-toggle:hover { color: var(--aq-primary-dark) !important; transform: translateY(-50%) !important; }
	.forgot-link { position: absolute; top: 50%; right: .8rem; padding-left: .6rem; border-left: 1px solid #dfe5e1; font-size: .84rem; font-weight: 600; line-height: 1.2; text-decoration: none; transform: translateY(-50%); white-space: nowrap; }
	.forgot-link:hover, .meta a:hover, .login-terms a:hover { text-decoration: underline; }
	button:disabled { opacity: .65; cursor: wait; }
	.social-login { display: flex; gap: .6rem; }
	.social { flex: 1 1 0; min-width: 0; display: flex; align-items: center; justify-content: center; gap: .6rem; padding: .8rem 1rem; }
	.social i { font-size: 1.2rem; }
	.google-mark { font-family: Arial, sans-serif; font-size: 1.1rem; font-weight: 800; background: conic-gradient(from -45deg, #4285f4 0 25%, #34a853 0 50%, #fbbc05 0 75%, #ea4335 0); color: transparent; background-clip: text; }
	.status { margin: 0; }
	.login-terms { margin: 1rem 0 0; color: var(--aq-muted); font-size: .8rem; line-height: 1.7; text-align: center; }
	.login-terms a { display: inline-block; margin: 0 .2rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
	.meta { margin: .75rem 0 0; padding-top: .75rem; border-top: 1px solid #edf0ec; text-align: center; }
	.meta a { margin-left: .25rem; font-weight: 700; text-decoration: none; }
</style>
