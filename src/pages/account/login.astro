---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { safeLocalRedirect } from '../../lib/auth/policies.js';
import { getServerEnv } from '../../lib/env';

export const prerender = false;

const next = safeLocalRedirect(Astro.url.searchParams.get('next'), Astro.url.origin);
const rawError = Astro.url.searchParams.get('error');
const error = rawError ? (['access_denied', 'OAuthCallbackError', 'oauth_error'].includes(rawError) ? '授權已取消或失敗，請再試一次。' : rawError) : null;
const authEnv = getServerEnv();
const googleEnabled = Boolean(authEnv.GOOGLE_CLIENT_ID && authEnv.GOOGLE_CLIENT_SECRET);
const lineEnabled = Boolean(authEnv.LINE_CHANNEL_ID && authEnv.LINE_CHANNEL_SECRET);
---

<AccountLayout title="登入｜水博館 V2">
	<h1 class="visually-hidden">會員登入</h1>

	{error && <p class="error">{error}</p>}

	<form id="login-form" class="form" method="post" action="/api/account/login">
		<input type="hidden" name="next" value={next} />
		<label>
			電子郵件
			<input type="email" name="email" required autocomplete="email" placeholder="請輸入 Email" />
		</label>
		<label>
			密碼
			<input
				id="login-password"
				type="password"
				name="password"
				required
				minlength="8"
				autocomplete="current-password"
				placeholder="請輸入密碼"
			/>
			<div class="password-actions">
				<button class="password-toggle" type="button" id="toggle-password" aria-controls="login-password" aria-pressed="false">顯示密碼</button>
				<a class="forgot-link" href="/account/forgot-password">忘記密碼？</a>
			</div>
		</label>
		<button type="submit" id="login-submit">登入</button>
	</form>
	<p id="login-status" class="status" role="status" aria-live="polite"></p>

	<div class="divider"><span>或使用其他方式登入</span></div>
	<div class="social-login">
		{googleEnabled ? <button type="button" class="social" data-provider="google"><span class="google-mark" aria-hidden="true">G</span>使用 Google 登入</button> : <p class="social-unavailable">Google 登入尚未設定</p>}
		{lineEnabled ? <button type="button" class="social line" data-provider="line"><i class="fa-solid fa-comment" aria-hidden="true"></i>使用 LINE 登入</button> : <p class="social-unavailable">LINE 登入尚未設定</p>}
	</div>

	<p class="meta">
		還沒有帳號？<a href="/account/register">註冊</a>
	</p>
	<p class="meta"><a href="/account/verify-email">重新寄送驗證信</a></p>
</AccountLayout>

<script>
	const form = document.getElementById('login-form');
	const status = document.getElementById('login-status');
	const next = (document.querySelector<HTMLInputElement>('[name="next"]')?.value || '/account');
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-provider]')) {
		button.addEventListener('click', async () => {
			button.disabled = true;
			status.textContent = '正在前往授權…';
			try {
				const { authClient } = await import('../../lib/auth/client');
				const result = await authClient.signIn.social({ provider: button.dataset.provider!, callbackURL: `/account/complete-profile?next=${encodeURIComponent(next)}` });
				if (result.error) throw new Error('授權失敗或已取消，請再試一次。');
			} catch {
				status.textContent = '授權失敗或已取消，請再試一次。';
				button.disabled = false;
			}
		});
	}
	const passwordInput = document.getElementById('login-password') as HTMLInputElement;
	const togglePassword = document.getElementById('toggle-password');
	togglePassword?.addEventListener('click', () => {
		const showing = passwordInput.type === 'text';
		passwordInput.type = showing ? 'password' : 'text';
		togglePassword.textContent = showing ? '顯示密碼' : '隱藏密碼';
		togglePassword.setAttribute('aria-pressed', String(!showing));
	});
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submit = document.getElementById('login-submit') as HTMLButtonElement;
		submit.disabled = true;
		status.textContent = '正在登入…';
		const data = new FormData(form);
		try {
			const res = await fetch('/api/account/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: data.get('email'), password: data.get('password') }),
			});
			if (!res.ok) {
				const payload = await res.json().catch(() => ({}));
				throw new Error(payload.error || '登入失敗，請確認 Email 與密碼。');
			}
			window.location.href = next;
		} catch (error) {
			status.textContent = error instanceof Error ? error.message : '目前無法登入，請稍後再試。';
			submit.disabled = false;
		}
	});
</script>

<style>
	h1 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
	}

	.lead,
	.meta {
		color: var(--muted);
	}

	.error {
		color: #ff8f8f;
		background: rgba(120, 20, 20, 0.25);
		border: 1px solid rgba(255, 140, 140, 0.35);
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
	}

	.status{min-height:1.25rem;color:#c8c8c8}.password-actions{display:flex;align-items:center;justify-content:space-between;gap:.8rem}.password-toggle{padding:0!important;background:none!important;color:#a8d8c1!important;text-align:left;font-weight:500!important;box-shadow:none!important}.forgot-link{color:#69cda1;font-size:.85rem;text-decoration:none}.forgot-link:hover,.meta a:hover{text-decoration:underline}button:disabled{opacity:.65;cursor:wait}.social-login{display:grid;gap:.55rem}.social{width:100%;display:flex;align-items:center;justify-content:center;gap:.6rem;padding:.8rem 1rem}.google-mark{font-family:Arial,sans-serif;font-size:1.1rem;font-weight:800;background:conic-gradient(from -45deg,#4285f4 0 25%,#34a853 0 50%,#fbbc05 0 75%,#ea4335 0);color:transparent;background-clip:text}.meta{margin:.65rem 0}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
