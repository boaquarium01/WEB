---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { getCustomerByUserId } from '../../lib/services/customer';
import { safeLocalRedirect } from '../../lib/auth/policies.js';
export const prerender = false;
const user = Astro.locals.user!;
const customer = await getCustomerByUserId(user.id);
const needsTerms = !customer?.termsAcceptedAt;
const safeNext = safeLocalRedirect(Astro.url.searchParams.get('next'), Astro.url.origin);
if (customer?.onboardingCompleted) return Astro.redirect(safeNext);
---
<AccountLayout title="補充會員資料｜水博館水族">
	<h1>完成會員資料</h1>
	<p class="lead">為了訂單聯絡與配送，請補上可聯絡資料。</p>
	<form id="complete-form" class="form" data-next={safeNext}>
		<label>姓名<input name="displayName" required autocomplete="name" value={customer?.displayName || user.name} /></label>
		<label>手機<input name="phone" required autocomplete="tel" inputmode="tel" value={customer?.phone || ''} /></label>
		<label>聯絡 Email（選填）<input name="contactEmail" type="email" autocomplete="email" value={customer?.contactEmail || ''} /></label>
		{needsTerms && <label class="terms"><input type="checkbox" name="acceptedTerms" required />我已閱讀並同意<a href="/terms" target="_blank" rel="noreferrer">服務條款</a>與<a href="/privacy" target="_blank" rel="noreferrer">隱私權政策</a></label>}
		<button type="submit">儲存並繼續</button>
	</form>
	<p id="complete-status" class="status" role="status" aria-live="polite"></p>
</AccountLayout>
<script>
	const form = document.getElementById('complete-form');
	const status = document.getElementById('complete-status');
	const safeNext = form?.dataset.next || '/account';
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const response = await fetch('/api/account/profile', { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({displayName:data.get('displayName'),phone:data.get('phone'),contactEmail:data.get('contactEmail'),acceptedTerms:data.get('acceptedTerms')==='on',completeOnboarding:true}) });
		if (!response.ok) { const result=await response.json().catch(()=>({})); status.textContent=result.error || '儲存失敗，請再試一次。'; return; }
		window.location.assign(safeNext);
	});
</script>
<style>.terms{display:flex!important;align-items:center;gap:.45rem}.terms input{width:1rem;height:1rem}.status{min-height:1.4rem}</style>
