---
/** V1 compatibility route: category browsing uses the paginated catalog filter. */
import { getAllCategories } from '../../data/products';

export const prerender = false;

const slug = String(Astro.params.category ?? '').trim();
if (!slug) return Astro.redirect('/products/1', 301);

const categories = await getAllCategories();
if (!categories.some((category) => category.id === slug)) {
	return Astro.redirect('/products/1', 301);
}

return Astro.redirect(`/products/1?${new URLSearchParams({ category: slug })}`, 301);
---
