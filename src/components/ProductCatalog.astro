---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductGridStagger from './ProductGridStagger.astro';
import {
	formatTwd,
	listCatalogCategories,
	listCatalogProducts,
} from '../lib/services/catalog';

const { page } = Astro.props as { page: number };
const pageSize = 12;
const rawCategory = Astro.url.searchParams.get('category')?.trim() ?? '';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const sortChoices = [{ value:'recommended', label:'綜合推薦' }, { value:'newest', label:'最新' }, { value:'price-asc', label:'價格低到高' }, { value:'price-desc', label:'價格高到低' }];
const requestedSort = Astro.url.searchParams.get('sort') ?? 'recommended';
const sort = sortChoices.some((choice) => choice.value === requestedSort) ? requestedSort : 'recommended';
const sortLabel = sortChoices.find((choice) => choice.value === sort)!.label;
const [categories, allProducts] = await Promise.all([
	listCatalogCategories(),
	listCatalogProducts(),
]);
const activeCategory = categories.some((category) => category.slug === rawCategory)
	? rawCategory
	: '';
if (rawCategory && !activeCategory) {
	const params = new URLSearchParams();
	if (query) params.set('q', query);
	if (sort !== 'recommended') params.set('sort', sort);
	return Astro.redirect(`/products/${page}${params.size ? `?${params}` : ''}`);
}
const activeCategoryLabel = categories.find((category) => category.slug === activeCategory)?.label ?? '';
const filtered = allProducts.filter((product) => {
	if (activeCategory && product.categorySlug !== activeCategory) return false;
	if (!query) return true;
	return [product.name, product.excerpt ?? '', product.categoryLabel ?? '', product.searchText ?? '']
		.join(' ')
		.toLocaleLowerCase('zh-TW')
		.includes(query.toLocaleLowerCase('zh-TW'));
});
if (sort === 'newest') filtered.sort((a, b) => (Date.parse(b.createdAt ?? '') || 0) - (Date.parse(a.createdAt ?? '') || 0) || a.name.localeCompare(b.name, 'zh-TW'));
else if (sort === 'price-asc' || sort === 'price-desc') filtered.sort((a, b) => {
	// Unpriced products stay at the end in both directions.
	if (a.sellingPrice <= 0 || b.sellingPrice <= 0) return a.sellingPrice > 0 ? -1 : b.sellingPrice > 0 ? 1 : 0;
	return (sort === 'price-asc' ? 1 : -1) * (a.sellingPrice - b.sellingPrice);
});
const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
if (page > pageCount) {
	const params = new URLSearchParams();
	if (activeCategory) params.set('category', activeCategory);
	if (query) params.set('q', query);
	if (sort !== 'recommended') params.set('sort', sort);
	return Astro.redirect(`/products/${pageCount}${params.size ? `?${params}` : ''}`);
}
const params = new URLSearchParams();
if (activeCategory) params.set('category', activeCategory);
if (query) params.set('q', query);
if (sort !== 'recommended') params.set('sort', sort);
const qs = params.size ? `?${params}` : '';
const products = filtered.slice((page - 1) * pageSize, page * pageSize);
const title = activeCategoryLabel ? `${activeCategoryLabel}｜全部商品` : '全部商品';
const backParams = new URLSearchParams();
if (query) backParams.set('q', query);
if (sort !== 'recommended') backParams.set('sort', sort);
const backUrl = activeCategory ? `/products/1${backParams.size ? `?${backParams}` : ''}` : '/';
const cardItems = products.map((product) => ({
	slug: product.slug,
	name: product.name,
	excerpt: product.excerpt ?? '',
	categoryLabel: product.categoryLabel ?? undefined,
	imageUrl: product.imageUrl,
	priceLabel: product.priceMin && product.priceMax ? (product.priceMin === product.priceMax ? formatTwd(product.priceMin) : `${formatTwd(product.priceMin)}–${new Intl.NumberFormat('zh-TW').format(product.priceMax)}`) : '價格洽詢',
}));
const allCategoryParams = new URLSearchParams();
if (query) allCategoryParams.set('q', query);
if (sort !== 'recommended') allCategoryParams.set('sort', sort);
const allCategoryUrl = `/products/1${allCategoryParams.size ? `?${allCategoryParams}` : ''}`;
const categoryUrl = (slug: string) => {
	const categoryParams = new URLSearchParams({ category: slug });
	if (query) categoryParams.set('q', query);
	if (sort !== 'recommended') categoryParams.set('sort', sort);
	return `/products/1?${categoryParams.toString()}`;
};
Astro.response.headers.set(
	'Cache-Control',
	'public, max-age=0, s-maxage=30, stale-while-revalidate=120, must-revalidate',
);
---

<SiteLayout
	title={`${title}${page > 1 ? `（第 ${page} 頁）` : ''}｜桃園中壢水博館水族`}
	description={`桃園中壢水博館水族商品列表，每頁 ${pageSize} 項。`}
	wide
	legacyFooter
	productBack={{ href: backUrl, label: activeCategory ? '全部商品' : '首頁' }}
>
	<nav class="crumb" aria-label="麵包屑">
		<a href="/">首頁</a><span>/</span><a href="/products/1">全部商品</a>
		{activeCategoryLabel && <><span>/</span><span>{activeCategoryLabel}</span></>}
		{query && <><span>/</span><span>關鍵字「{query}」</span></>}
		{pageCount > 1 && <><span>/</span><span>第 {page} 頁</span></>}
	</nav>
	<form class="catalog-toolbar" method="get" action="/products/1" role="search" aria-label="商品篩選與搜尋">
		{activeCategory && <input type="hidden" name="category" value={activeCategory} />}
		<div class="catalog-search-row">
			<div class="catalog-input-wrap">
				<i class="fa-solid fa-magnifying-glass catalog-input-icon" aria-hidden="true"></i>
				<label class="visually-hidden" for="catalog-q">搜尋商品</label>
				<input id="catalog-q" class="catalog-input catalog-input--search" type="search" name="q" value={query} placeholder="搜尋商品" aria-label="搜尋商品" enterkeyhint="search" autocomplete="off" />
				<button type="submit" name="sort" value={sort} class="catalog-search-submit">搜尋</button>
			</div>
			<details class="catalog-sort">
				<summary class:list={[{ 'is-sorted': sort !== 'recommended' }]} aria-label={`排序：${sortLabel}`} title={`排序：${sortLabel}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16m-4-4 4 4 4-4M17 20V4m-4 4 4-4 4 4"/></svg></summary>
				<div class="catalog-sort-menu">{sortChoices.map((choice) => <button type="submit" name="sort" value={choice.value} aria-pressed={choice.value === sort}><span>{choice.label}</span>{choice.value === sort && <i class="fa-solid fa-check" aria-hidden="true"></i>}</button>)}</div>
			</details>
		</div>
	</form>
	<nav class="catalog-category-nav" aria-label="商品分類">
		<div class="catalog-category-track">
			<a class:list={['catalog-category-link', !activeCategory && 'is-active']} href={allCategoryUrl} aria-current={!activeCategory ? 'page' : undefined}>全部</a>
			{categories.map((category) => (
				<a class:list={['catalog-category-link', activeCategory === category.slug && 'is-active']} href={categoryUrl(category.slug)} aria-current={activeCategory === category.slug ? 'page' : undefined}>{category.label}</a>
			))}
		</div>
		<details class="catalog-category-more">
			<summary aria-label="展開全部商品分類" title="展開全部分類"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
			<div class="catalog-category-menu">
				<a class:list={['catalog-category-option', !activeCategory && 'is-active']} href={allCategoryUrl}>全部商品</a>
				{categories.map((category) => (
					<a class:list={['catalog-category-option', activeCategory === category.slug && 'is-active']} href={categoryUrl(category.slug)}>{category.label}</a>
				))}
			</div>
		</details>
	</nav>
	{products.length === 0 ? <p class="catalog-empty">沒有符合條件的商品，請調整搜尋條件。</p> : <ProductGridStagger items={cardItems} />}
	{pageCount > 1 && (
		<nav class="pagination" aria-label="商品列表分頁">
			{page > 1 ? <a class="page-btn" href={`/products/${page - 1}${qs}`} rel="prev">上一頁</a> : <span class="page-btn is-disabled" aria-disabled="true">上一頁</span>}
			<span class="page-position" aria-current="page">第 {page} / {pageCount} 頁</span>
			{page < pageCount ? <a class="page-btn" href={`/products/${page + 1}${qs}`} rel="next">下一頁</a> : <span class="page-btn is-disabled" aria-disabled="true">下一頁</span>}
		</nav>
	)}
</SiteLayout>

<style>
	.crumb{margin:0 0 1.25rem;color:#666;font-size:.875rem}.crumb a{color:#111;text-decoration:underline;text-underline-offset:3px}.crumb span{margin:0 6px;color:#bbb}
	.catalog-toolbar{width:100%;max-width:28rem;margin:0 auto .4rem}.catalog-search-row{display:flex;align-items:stretch;min-width:0}.catalog-input-wrap{position:relative;display:flex;align-items:center;flex:1 1 auto;min-width:0;height:46px;box-sizing:border-box;overflow:hidden;border:1px solid #d5dfd9;border-radius:12px;background:#fff;transition:border-color .15s ease,box-shadow .15s ease}.catalog-input-wrap:focus-within{border-color:var(--aq-primary);box-shadow:0 0 0 3px var(--aq-primary-soft)}.catalog-input-icon{position:absolute;left:15px;color:var(--aq-muted);font-size:.85rem;opacity:.75;pointer-events:none}.catalog-input--search{width:100%;min-width:0;min-height:44px;box-sizing:border-box;padding:8px 78px 8px 39px;border:0;background:transparent;color:var(--aq-ink);font-size:16px;line-height:1.4}.catalog-input--search:focus{outline:none}.catalog-search-submit{position:absolute;top:4px;right:4px;bottom:4px;min-width:62px;padding:0 13px;border:0;border-radius:8px;background:var(--aq-primary);color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s}.catalog-search-submit:hover{background:var(--aq-primary-dark)}.catalog-category-nav{position:relative;display:flex;align-items:center;min-height:44px;margin:0 auto 1rem;padding-right:38px;border-bottom:1px solid color-mix(in srgb,var(--aq-ink) 10%,transparent)}.catalog-category-track{display:flex;align-items:stretch;gap:clamp(1rem,2.2vw,1.75rem);width:100%;overflow:hidden;white-space:nowrap}.catalog-category-link{position:relative;display:inline-flex;align-items:center;flex:0 0 auto;min-height:44px;color:var(--aq-ink);font-size:.875rem;text-decoration:none;transition:color .15s}.catalog-category-link:hover,.catalog-category-link.is-active{color:var(--aq-primary-dark)}.catalog-category-link.is-active{font-weight:750}.catalog-category-link.is-active::after{position:absolute;right:0;bottom:-1px;left:0;height:3px;border-radius:3px 3px 0 0;background:var(--aq-primary);content:""}.catalog-category-more{position:absolute;top:4px;right:0;z-index:10}.catalog-category-more summary{display:grid;width:34px;height:34px;place-items:center;border:1px solid color-mix(in srgb,var(--aq-ink) 15%,transparent);border-radius:9px;background:var(--aq-sand);color:var(--aq-ink);list-style:none;cursor:pointer}.catalog-category-more summary::-webkit-details-marker{display:none}.catalog-category-more[open] summary i{transform:rotate(180deg)}.catalog-category-more summary i{font-size:.7rem;transition:transform .15s}.catalog-category-menu{position:absolute;top:calc(100% + 8px);right:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;width:min(20rem,calc(100vw - 2.5rem));padding:8px;border:1px solid color-mix(in srgb,var(--aq-ink) 10%,transparent);border-radius:14px;background:#fff;box-shadow:0 14px 38px rgba(26,34,33,.16)}.catalog-category-option{padding:10px 12px;border-radius:9px;color:var(--aq-ink);font-size:.875rem;text-decoration:none}.catalog-category-option:hover,.catalog-category-option.is-active{background:var(--aq-primary-soft);color:var(--aq-primary-dark)}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.catalog-empty{margin:2rem 0;text-align:center;color:#666;font-size:.9375rem}
	.pagination{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;margin-top:1rem;padding-top:1rem;border-top:1px solid #eee}.page-btn{padding:8px 14px;border:1px solid #ccc;border-radius:8px;background:#fff;color:#111;font-size:.875rem;font-weight:600;text-decoration:none;transition:transform .2s,box-shadow .2s,background .15s,border-color .15s}.page-btn:hover:not(.is-disabled){background:#f5f5f5}.page-btn.is-disabled{border-color:#e5e5e5;color:#bbb;cursor:not-allowed}.page-position{min-width:5.5rem;text-align:center;color:var(--aq-muted);font-size:.875rem;font-variant-numeric:tabular-nums}
	@media(hover:hover) and (pointer:fine){.page-btn:hover:not(.is-disabled){transform:translateY(-2px);box-shadow:0 4px 12px rgba(26,34,33,.08)}}
	@media(max-width:640px){.catalog-toolbar{max-width:100%;margin-bottom:.25rem}.catalog-category-nav{margin-bottom:.75rem;padding-right:42px;padding-left:3px}.catalog-category-track{gap:1rem}.catalog-category-link{font-size:.8125rem}.catalog-category-more{right:2px}.catalog-category-menu{grid-template-columns:repeat(2,minmax(0,1fr))}.pagination{margin-top:.75rem;padding-top:.75rem}}

	.catalog-search-row { gap:8px; }
	.catalog-sort { position:relative; flex:none; z-index:20; }
	.catalog-sort summary { display:grid; place-items:center; width:46px; height:46px; box-sizing:border-box; border:1px solid #d5dfd9; border-radius:12px; background:#fff; color:var(--aq-primary-dark); font-size:19px; cursor:pointer; list-style:none; }
	.catalog-input--search::placeholder { color:#91a09a; }
	.catalog-search-submit:focus-visible { outline:2px solid var(--aq-primary-dark); outline-offset:-3px; }
	.catalog-sort summary::-webkit-details-marker { display:none; }
	.catalog-sort[open] summary,.catalog-sort summary.is-sorted { background:var(--aq-primary-soft); border-color:var(--aq-primary); }
	.catalog-sort summary:focus-visible,.catalog-sort-menu button:focus-visible { outline:2px solid var(--aq-primary); outline-offset:2px; }
	.catalog-sort-menu { position:absolute; top:calc(100% + 8px); right:0; display:grid; gap:3px; width:180px; padding:6px; border:1px solid var(--aq-line); border-radius:12px; background:#fff; box-shadow:0 10px 28px #163d3026; }
	.catalog-sort-menu button { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; min-height:42px; padding:9px 11px; border:0; border-radius:8px; background:transparent; color:var(--aq-ink); font:inherit; font-size:14px; text-align:left; cursor:pointer; }
	.catalog-sort-menu button:hover,.catalog-sort-menu button[aria-pressed='true'] { background:var(--aq-primary-soft); color:var(--aq-primary-dark); }
	.catalog-sort-menu i { font-size:12px; }
	@media(max-width:360px) { .catalog-input--search { padding-right:68px; }.catalog-search-submit { min-width:58px; padding-inline:10px; } }
</style>
<script>
	document.addEventListener('click', (event) => { document.querySelectorAll<HTMLDetailsElement>('.catalog-sort[open]').forEach((sort) => { if (event.target instanceof Node && !sort.contains(event.target)) sort.open = false; }); });
	document.addEventListener('keydown', (event) => { if (event.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('.catalog-sort[open]').forEach((sort) => { sort.open = false; sort.querySelector('summary')?.focus(); }); });
</script>
