---
/** 全站共用確認彈窗的樣式與表單攔截；彈窗本身由 scripts/confirmSheet.ts 建立 */
---
<script>
	import { initConfirmForms } from '../scripts/confirmSheet';

	initConfirmForms();
</script>

<style is:global>
	/* 電腦置中、手機從底部升起 */
	.confirm-sheet { width: min(420px, calc(100vw - 32px)); margin: auto; padding: 0; border: 0; border-radius: 16px; background: #fff; color: var(--aq-ink); box-shadow: 0 20px 50px rgba(20, 40, 40, 0.25); }
	.confirm-sheet::backdrop { background: rgba(16, 30, 30, 0.45); }
	.confirm-sheet:focus { outline: none; }
	.confirm-sheet__body { padding: 22px 20px 18px; }
	.confirm-sheet__message { margin: 0 0 18px; font-size: 16px; font-weight: 650; line-height: 1.6; white-space: pre-line; overflow-wrap: anywhere; }
	.confirm-sheet__input { display: block; box-sizing: border-box; width: 100%; min-height: 46px; margin: 0 0 16px; padding: 0 12px; border: 1px solid #d9e0dd; border-radius: 10px; font: inherit; font-size: 16px; }
	.confirm-sheet__input[hidden] { display: none; }
	.confirm-sheet__actions { display: grid; grid-auto-columns: 1fr; grid-auto-flow: column; gap: 10px; }
	.confirm-sheet__actions button { min-height: 46px; padding: 0 12px; border-radius: 10px; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; }
	.confirm-sheet__actions button[hidden] { display: none; }
	.confirm-sheet__actions button:focus-visible { outline: 3px solid rgba(21, 106, 102, 0.35); outline-offset: 2px; }
	.confirm-sheet__cancel { border: 1px solid #d9e0dd; background: #fff; color: var(--aq-muted); }
	.confirm-sheet__ok { border: 1px solid var(--aq-primary); background: var(--aq-primary); color: #fff; }
	.confirm-sheet__ok.is-danger { border-color: var(--aq-danger); background: var(--aq-danger); }
	.confirm-sheet__actions button:disabled { opacity: 0.7; cursor: wait; }
	/* 危險操作：返回在右、確認在左 */
	.confirm-sheet.is-danger .confirm-sheet__ok { order: -1; }
	.confirm-sheet.is-danger .confirm-sheet__cancel { border-color: var(--aq-primary); background: var(--aq-primary); color: #fff; }
	.confirm-sheet.is-danger .confirm-sheet__ok:disabled { cursor: not-allowed; opacity: 0.45; }
	@media (max-width: 720px) {
		.confirm-sheet { width: 100%; max-width: none; margin: auto 0 0; border-radius: 18px 18px 0 0; }
		.confirm-sheet__body { padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px)); }
	}
</style>
