---
export type ProductCardItem = {
  slug: string;
  name: string;
  excerpt: string;
  categoryLabel?: string;
  /** 空字串或缺漏時為無圖卡（一格高）；載入失敗也會改成無圖卡 */
  imageUrl?: string | null;
  priceLabel?: string;
  stockLabel?: string;
  inStock?: boolean;
};

type Props = {
  items: ProductCardItem[];
  /** 為 true 時顯示商品簡介 */
  compact?: boolean;
};

const { items, compact = false } = Astro.props as Props;

/** 商品名依字數選字級：短名字放大，長名字縮小；超過兩行用「…」 */
const nameSize = (name: string) => {
  const length = [...name.trim()].length;
  return length <= 6 ? 'is-short' : length <= 12 ? 'is-medium' : 'is-long';
};
---

<div
  class="product-stagger-grid group mx-auto grid w-full grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 lg:gap-6"
  data-product-stagger
>
  {
    items.map((product, i) => {
      const imageSrc = String(product.imageUrl ?? '').trim();
      const hasImage = imageSrc.length > 0;

      return (
      <article
        data-stagger-card
        class:list={[hasImage ? 'has-image' : 'no-image', 'product-stagger-card group/card opacity-0 translate-y-4 transition-[opacity,transform,box-shadow] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)] [transition-delay:var(--stagger-delay)] group-[.is-visible]:opacity-100 group-[.is-visible]:translate-y-0']}
        style={`--stagger-delay: ${i * 70}ms`}
      >
        <a
          href={`/product/${product.slug}`}
          class="product-stagger-card__link flex h-full flex-col overflow-hidden rounded-[var(--aq-radius-lg)] border border-[color-mix(in_srgb,var(--aq-ink)_10%,transparent)] bg-[color-mix(in_srgb,white_94%,var(--aq-sand))] text-inherit no-underline shadow-[0_1px_2px_rgba(26,34,33,0.04),0_10px_28px_rgba(26,34,33,0.07)] outline-none ring-[color-mix(in_srgb,var(--aq-ink)_4%,transparent)] ring-1 transition-[transform,box-shadow,border-color] duration-200 ease-out [touch-action:manipulation] [-webkit-tap-highlight-color:transparent] hover:border-[color-mix(in_srgb,var(--aq-primary)_22%,transparent)] hover:shadow-[0_4px_14px_rgba(26,34,33,0.06),0_18px_40px_rgba(21,106,102,0.1)] active:scale-[0.98] active:shadow-[0_2px_8px_rgba(26,34,33,0.05)] focus-visible:ring-2 focus-visible:ring-[color-mix(in_srgb,var(--aq-primary)_65%,transparent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--aq-sand)]"
        >
          {hasImage ? (
            <div class="product-stagger-card__media relative min-h-0 flex-1 overflow-hidden bg-gradient-to-br from-[var(--aq-mist)] to-[color-mix(in_srgb,var(--aq-sand-2)_85%,var(--aq-muted))]">
              <img
                src={imageSrc}
                alt=""
                width={600}
                height={450}
                loading="lazy"
                decoding="async"
                class="product-stagger-card__img absolute inset-0 z-[1] h-full w-full object-cover object-center transition-[opacity,filter,transform] duration-500 ease-out group-hover/card:brightness-[1.03] motion-reduce:transition-none"
                onerror="const c=this.closest('.product-stagger-card'); if(c){c.classList.replace('has-image','no-image'); this.closest('.product-stagger-card__media')?.remove();}"
              />
              <div
                class="product-stagger-card__media-overlay pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-[color-mix(in_srgb,var(--aq-primary-dark)_35%,transparent)] via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/card:opacity-100 motion-reduce:transition-none"
                aria-hidden="true"
              />
            </div>
          ) : null}
          <div class="product-stagger-card__body flex flex-col px-3 pb-3 pt-2.5 sm:px-4 sm:pb-3.5 sm:pt-3">
            <h2 class:list={['product-stagger-card__name line-clamp-2 font-bold leading-snug tracking-tight text-[var(--aq-ink)]', nameSize(product.name)]}>
              {product.name}
            </h2>
            {compact && product.excerpt.trim() && product.excerpt.trim() !== product.name.trim() ? (
              <p class="line-clamp-2 text-[0.75rem] leading-relaxed text-[var(--aq-muted)] sm:text-[0.8125rem]">
                {product.excerpt}
              </p>
            ) : null}
            {(product.priceLabel || product.stockLabel) ? (
              <div class="mt-auto flex items-baseline justify-between gap-2 border-t border-[color-mix(in_srgb,var(--aq-ink)_8%,transparent)] pt-2.5">
                {product.priceLabel ? <span class="text-sm font-bold text-[var(--aq-primary-dark)]">{product.priceLabel}</span> : null}
                {product.stockLabel ? <span class:list={['text-xs', product.inStock === false ? 'text-[var(--aq-danger)]' : 'text-[var(--aq-muted)]']}>{product.stockLabel}</span> : null}
              </div>
            ) : null}
          </div>
        </a>
      </article>
      );
    })
  }
</div>

<script>
  function initProductStagger() {
    document.querySelectorAll('[data-product-stagger]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.staggerInit === '1') return;
      root.dataset.staggerInit = '1';

      const show = () => root.classList.add('is-visible');

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        show();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              show();
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '-32px 0px 0px 0px' }
      );
      io.observe(root);
    });
  }

  initProductStagger();
  document.addEventListener('astro:page-load', initProductStagger);

  function initProductCardImageBlur() {
    const reduced =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.product-stagger-card__img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      if (reduced) {
        img.classList.add('is-loaded');
        return;
      }
      const mark = () => img.classList.add('is-loaded');
      if (img.complete && img.naturalWidth > 0) mark();
      else {
        img.addEventListener('load', mark, { once: true });
        img.addEventListener('error', mark, { once: true });
      }
    });
  }

  initProductCardImageBlur();
  document.addEventListener('astro:page-load', initProductCardImageBlur);
</script>

<style is:global>
  .product-stagger-card {
    height: 100%;
  }

  /* 有圖卡佔兩格、無圖卡佔一格；dense 讓無圖卡補滿空位 */
  .product-stagger-grid {
    grid-auto-flow: dense;
    grid-auto-rows: 112px;
  }

  .product-stagger-card.has-image {
    grid-row: span 2;
  }

  /* 文字區固定高度，同一排的圖片才會等高、底部切齊 */
  .product-stagger-card__body {
    flex: none;
    height: 100px;
  }

  @media (min-width: 640px) {
    .product-stagger-card__body {
      height: 110px;
    }
  }

  .product-stagger-card.no-image .product-stagger-card__body {
    flex: 1;
    height: auto;
    min-height: 0;
  }

  .product-stagger-card__name {
    margin-bottom: 0.45rem;
    font-size: 0.875rem;
  }

  .product-stagger-card__name.is-short {
    font-size: 1.05rem;
  }

  .product-stagger-card__name.is-long {
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .product-stagger-grid {
      grid-auto-rows: 128px;
    }

    .product-stagger-card__name {
      font-size: 0.9375rem;
    }

    .product-stagger-card__name.is-short {
      font-size: 1.125rem;
    }

    .product-stagger-card__name.is-long {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 1024px) {
    .product-stagger-grid {
      grid-auto-rows: 130px;
    }
  }

  /**
   * Layout 全域 `img { max-width:100%; height:auto }` 會讓卡片主圖無法撐滿 4:3 區塊，
   * 底部會露出 `.product-stagger-card__media` 的漸層（看起來像留白）。
   */
  .product-stagger-card__media > .product-stagger-card__img {
    display: block;
    max-width: none;
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-stagger-card__link:hover {
      transform: translateY(-3px);
    }
  }

  /* 類 blur placeholder：載入前微模糊＋略放大，減少 CLS 感知的「硬跳出」 */
  @media (prefers-reduced-motion: no-preference) {
    .product-stagger-card__media > .product-stagger-card__img:not(.is-loaded) {
      opacity: 0.9;
      filter: blur(12px) saturate(0.92);
      transform: scale(1.06);
    }

    .product-stagger-card__media > .product-stagger-card__img.is-loaded {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-product-stagger] [data-stagger-card] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .product-stagger-card__img,
    .product-stagger-card__media-overlay {
      transition: none !important;
      transform: none !important;
    }

    .product-stagger-card__link:active {
      transform: none !important;
    }
  }

  /* 手機：略縮卡片最大寬度，避免雙欄在寬型手機上過扁過滿 */
  @media (max-width: 639.98px) {
    .product-stagger-grid {
      max-width: min(100%, 22.5rem);
      margin-left: auto;
      margin-right: auto;
      column-gap: 0.625rem;
      row-gap: 0.75rem;
    }
  }

  @media (min-width: 400px) and (max-width: 639.98px) {
    .product-stagger-grid {
      max-width: min(100%, 26rem);
    }
  }

  @media (min-width: 640px) {
    .product-stagger-grid {
      max-width: none;
    }
  }
</style>
