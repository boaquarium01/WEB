---
/**
 * 購物須知與服務條款（全站唯一版本）：購物須知頁與結帳時的條款視窗共用。
 * 前半是實際做法（運費、出貨、付款、活體、退換貨、保固），後半是法律條款。
 * 運費與免運門檻跟著後台「運費設定」走。
 */
import { listShippingMethods } from '../lib/services/shipping';

interface Props {
	/** 結帳視窗用：不顯示卡片外框，字小一點 */
	compact?: boolean;
}

const { compact = false } = Astro.props;

let shippingFee = 99;
let freeShipping: number | null = 1200;
try {
	const [method] = await listShippingMethods(true);
	if (method) {
		shippingFee = method.fee;
		freeShipping = method.freeShippingThreshold;
	}
} catch (error) {
	console.error('[shop-terms] shipping settings unavailable', error);
}
const freeText = freeShipping === null ? null : freeShipping.toLocaleString('zh-TW');
const LINE_URL = 'https://line.me/R/ti/p/@407hrczr?oat_content=url&ts=03301229';
const PHONE = '03-402-8721';
---

<div class:list={['shop-terms', { 'shop-terms--compact': compact }]}>
	<p class="shop-terms__intro">請於下單前閱讀以下內容。本須知與條款依台灣消費者保護及個人資料保護相關法令適用；法令賦予消費者的權利不因本條款而受限制。</p>

	<section id="shipping-fee" class="guide__section">
		<h2><i class="fa-solid fa-truck-fast" aria-hidden="true"></i>運費</h2>
		<ol>
			<li>台灣本島黑貓宅配，運費優惠價 <strong>NT$ {shippingFee}</strong>。</li>
			{freeText && <li>單筆訂單商品金額滿 <strong>NT$ {freeText}</strong> 免運費。</li>}
			<li>離島（澎湖、金門、馬祖、綠島、蘭嶼等）運費另計，下單後我們會以電話或 LINE 與您確認運費，確認後再付款。</li>
			<li>魚缸、冷水機、長燈具等大型或易碎商品需單獨包裝，若運費與網站計算不同，會先與您聯繫確認。</li>
		</ol>
	</section>

	<section id="delivery" class="guide__section">
		<h2><i class="fa-solid fa-box" aria-hidden="true"></i>出貨與配送</h2>
		<ol>
			<li><strong>僅提供付款後宅配出貨</strong>，不提供貨到付款。</li>
			<li>款項核對完成後預估 <strong>1–2 個工作天</strong>內出貨，「週日及國定假日」可能不出貨。</li>
			<li>以黑貓宅急便配送到府，或寄到黑貓營業所「到站自取」（請在訂單備註寫上營業所名稱與地址）。部分地區沒有到站自取服務，可先洽黑貓客服確認。</li>
			<li>宅配依路線配送，遇節慶、颱風或貨量大時可能延誤，敬請見諒。</li>
			<li>為保護活體，<strong>活體與水草不寄送超商</strong>，宅配包裹也請勿改送超商；改送造成的損傷恕不補償。</li>
			<li>商品不接受保留或延後寄出。</li>
		</ol>
	</section>

	<section id="payment" class="guide__section">
		<h2><i class="fa-solid fa-building-columns" aria-hidden="true"></i>付款方式</h2>
		<ol>
			<li>目前提供 <strong>ATM／網路銀行轉帳</strong>，下單完成後會寄出訂單確認信，內含轉帳帳號。</li>
			<li>請於 <strong>下單後 3 天內</strong>完成轉帳，逾期未付款的訂單會自動取消並釋放庫存。</li>
			<li>轉帳後請到「會員中心 → 我的訂單 → 點選訂單」<strong>回報轉出帳號末五碼</strong>，我們核對款項後會更新訂單狀態，並開始備貨。</li>
			<li>轉帳備註請填寫訂單編號，方便我們快速核對。</li>
		</ol>
	</section>

	<section id="live" class="guide__section">
		<h2><i class="fa-solid fa-fish" aria-hidden="true"></i>活體與水草送達保證</h2>
		<ol>
			<li>魚蝦皆於店內穩定後才出貨，包裝使用水族專用保護箱，視季節加放保溫或保冷材料。</li>
			<li>收件當天請盡快拆箱檢查。若有運送途中死亡，請於 <strong>收件後 60 分鐘內</strong>拍照或錄影，並<strong>包含未拆封的原始魚袋</strong>，傳至官方 LINE。</li>
			<li>確認屬運送造成的死亡，<strong>於您下次訂購時補償同款活體</strong>；若該品項已售完，則於下次消費時抵扣該活體金額。</li>
			<li>蝦、螺類不提供死亡補償。</li>
			<li>收件人無法收件、地址或電話錯誤、退件、改送他處，或到站自取未於當天領取所造成的損傷，恕不補償。</li>
			<li>本保證僅限台灣本島，離島配送不適用。</li>
			<li>活體魚蝦、水草的品種、尺寸、色澤與外觀可能因個體及生長狀態略有差異。</li>
		</ol>
	</section>

	<section id="receive" class="guide__section">
		<h2><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>收到商品請先檢查</h2>
		<ol>
			<li>收到商品請先核對品項、數量與外觀，若有短少、錯誤或運送損壞，請拍照並於 <strong>3 天內</strong>與我們聯繫。</li>
			<li>檢查時請保留完整外箱、包裝、配件、說明書與保固卡，退換貨時需一併寄回。</li>
		</ol>
	</section>

	<section id="returns" class="guide__section">
		<h2><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>取消訂單與退換貨</h2>
		<ol>
			<li>訂單尚未出貨前，如欲取消或變更，請儘速以 LINE 或電話告知，我們確認處理進度後協助辦理。</li>
			<li>器材類商品依消費者保護法享有<strong>到貨隔日起 7 天猶豫期</strong>，無須說明理由，請先以 LINE 或電話告知，並於期限內寄回。猶豫期並非試用期，商品須保持原狀與完整包裝。</li>
			<li>商品經使用、下水運轉或包裝毀損，致價值減損時，依法由消費者負擔回復原狀或減損費用。</li>
			<li><strong>活體、水草屬易於腐敗、保存期限較短之商品，不適用 7 天猶豫期</strong>，到貨問題依上方「活體與水草送達保證」處理。</li>
			<li>商品瑕疵、寄錯或運送損壞，退換貨運費由本店負擔；非瑕疵（例如不喜歡、聲音或亮度不如預期）的退換貨，來回運費由顧客負擔。</li>
			<li>換貨若有價差，多退少補；確認寄回商品完整後再寄出更換商品或辦理退款。</li>
		</ol>
	</section>

	<section id="warranty" class="guide__section">
		<h2><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>保固與維修</h2>
		<ol>
			<li>各品牌器材依原廠保固條件辦理，保固期間以商品說明或保固卡為準，送修時請附上保固卡或購買證明。</li>
			<li>到貨 7 天內發生非人為故障，經確認後換新品，來回運費由本店負擔。</li>
			<li>超過 7 天的故障，請將商品寄回並附上紙條註明：故障狀況、姓名、聯絡電話、收件地址；我們會交由原廠檢修，送修期間預估約 2–3 週，來回運費由顧客負擔。</li>
			<li>保固期內非人為損壞不收維修費（以原廠判定為準）；如需付費維修，會先報價並與您確認。</li>
		</ol>
	</section>

	<section id="order" class="guide__section">
		<h2><i class="fa-solid fa-file-signature" aria-hidden="true"></i>訂單成立與價格</h2>
		<ol>
			<li>本條款適用於您透過水博館水族官方網站選購商品及使用相關服務。商品名稱、規格、價格、庫存、配送方式與費用，以您送出訂單前結帳頁面所列為準。</li>
			<li>送出訂單後，訂單是否成立及後續處理，以網站通知或訂單狀態為準。送出前請核對商品、數量、收件資料、配送方式、運費及總金額。</li>
			<li>若遇商品售罄、資料錯誤或其他無法出貨的情形，我們會儘速聯絡您，協商更換、取消或退款；未經您同意，不會以其他商品取代。</li>
		</ol>
	</section>

	<section id="terms" class="guide__section">
		<h2><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>其他條款</h2>
		<ol>
			<li><strong>商品照護：</strong>活體及水族器材請依商品說明及適當方式安置與使用。因水質、溫度、混養、設備或照護條件而有特殊風險時，請先閱讀商品頁說明或向我們詢問；照護建議應配合實際缸況判斷。</li>
			<li><strong>個人資料：</strong>為處理訂單、付款、配送、售後服務及法令要求，我們會在必要範圍內蒐集及利用您的帳戶、聯絡、收件及交易資料，並依個人資料保護法及本站 <a href="/privacy">隱私權政策</a> 辦理。您可依法請求查詢、閱覽、複製、更正、停止利用或刪除個人資料；若拒絕提供完成交易所需資料，可能無法提供服務。請妥善保管帳戶與登入資訊。</li>
			<li><strong>智慧財產與網站使用：</strong>網站文字、圖片、商標及其他內容，除另有標示外，屬水博館水族或合法權利人所有，未經授權請勿重製、散布或作商業使用。使用網站時請勿從事違法、干擾系統或侵害他人權益的行為。</li>
			<li><strong>消費爭議：</strong>如有訂單、付款、配送或商品問題，請透過官方 LINE 或電話與我們聯繫，我們會以誠信方式協商；您亦得依法向所在地消費者服務中心或主管機關提出申訴。</li>
			<li><strong>條款修訂與準據法：</strong>本頁內容如有修訂，會公告於網站並自公告日起適用；對您權益有重大影響者，會以適當方式提示。個別交易適用中華民國法律，未盡事宜依相關法令及誠信原則處理。</li>
		</ol>
	</section>

	<p class="shop-terms__contact">網站經營名稱：水博館水族｜門市地址：320 桃園市中壢區環西路二段 69 號｜電話：<a href={`tel:${PHONE.replace(/-/g, '')}`}>{PHONE}</a>｜<a href={LINE_URL} target="_blank" rel="noreferrer">官方 LINE</a></p>
</div>

<style>
	.shop-terms { color: var(--aq-ink); line-height: 1.8; }
	.shop-terms a { color: var(--aq-primary-dark); font-weight: 650; }
	.shop-terms__intro { margin: 0 0 4px; color: var(--aq-muted); font-size: .9rem; }
	.guide__section { margin-top: 16px; padding: 20px 20px 8px; border: 1px solid var(--aq-line); border-radius: 16px; background: #fff; scroll-margin-top: 44px; /* 全站已預留 80px 頂欄，再加目錄高度 */ }
	.guide__section h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 1.2rem; font-weight: 800; }
	.guide__section h2 i { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 10px; background: var(--aq-primary-soft); color: var(--aq-primary); font-size: .95rem; }
	.guide__section ol { margin: 0; padding-left: 1.4em; list-style: decimal; }
	.guide__section li { margin-bottom: 10px; padding-left: 2px; }
	.guide__section li::marker { color: var(--aq-primary); font-weight: 800; }
	.guide__section strong { color: var(--aq-ink); }
	.shop-terms__contact { margin: 20px 0 0; padding-top: 14px; border-top: 1px solid var(--aq-line); color: var(--aq-muted); font-size: .82rem; line-height: 1.9; }
	@media (max-width: 600px) {
		.guide__section { padding: 16px 14px 4px; }
	}
	/* 結帳視窗：連續閱讀，不用卡片 */
	.shop-terms--compact { font-size: .9rem; line-height: 1.75; }
	.shop-terms--compact .guide__section { margin-top: 18px; padding: 0; border: 0; border-radius: 0; background: none; }
	.shop-terms--compact .guide__section h2 { font-size: 1rem; }
	.shop-terms--compact .guide__section h2 i { width: 26px; height: 26px; border-radius: 8px; font-size: .78rem; }
	.shop-terms--compact .guide__section li { margin-bottom: 6px; }
</style>
