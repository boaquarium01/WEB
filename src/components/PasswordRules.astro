---
/**
 * 密碼規則打勾清單：放在新密碼欄下方，邊打邊打勾。
 * 規則來源與伺服器檢查同一份（lib/auth/policies.js）。
 * for：對應的密碼輸入框 id（輸入框請加 aria-describedby={id}）
 */
import { PASSWORD_RULES } from '../lib/auth/policies.js';

interface Props {
	for: string;
	id: string;
}

const { for: inputId, id } = Astro.props;
---

<ul id={id} class="pw-rules" data-password-rules data-for={inputId} aria-label="密碼需符合">
	{PASSWORD_RULES.map((rule) => <li data-rule={rule.key}><i class="fa-solid fa-circle" aria-hidden="true"></i>{rule.label}</li>)}
</ul>

<script>
	import { PASSWORD_RULES } from '../lib/auth/policies.js';

	for (const list of document.querySelectorAll<HTMLElement>('[data-password-rules]')) {
		const input = document.getElementById(list.dataset.for ?? '') as HTMLInputElement | null;
		if (!input) continue;
		const items = list.querySelectorAll<HTMLElement>('[data-rule]');
		const update = () => {
			for (const item of items) {
				const rule = PASSWORD_RULES.find((r) => r.key === item.dataset.rule);
				const ok = rule ? rule.test(input.value) : false;
				item.dataset.state = ok ? 'ok' : input.value ? 'warn' : '';
				item.querySelector('i')!.className = ok ? 'fa-solid fa-circle-check' : 'fa-solid fa-circle';
			}
		};
		input.addEventListener('input', update);
		update();
	}
</script>

<style>
	.pw-rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .75rem;margin:.15rem 0 0;padding:0;list-style:none;color:var(--aq-muted);font-size:.8rem;font-weight:500}
	.pw-rules li{display:flex;align-items:center;gap:.4rem}
	.pw-rules li:last-child{grid-column:1/-1}
	.pw-rules i{font-size:.45rem;opacity:.6}
	.pw-rules li[data-state=ok]{color:#21633d}
	.pw-rules li[data-state=ok] i{font-size:.85rem;opacity:1}
	.pw-rules li[data-state=warn]{color:#a65a10}
</style>
