---
/**
 * Account pages use the same V1 shop shell (ecommerce on top of official site).
 */
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = '水博館水族會員中心' } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;
const entryAuthPage = currentPath === '/account/login' || currentPath === '/account/register';
const backHref = currentPath.startsWith('/account/orders/')
	? '/account/orders'
	: currentPath === '/account/orders'
		? '/'
		: currentPath.startsWith('/account/addresses')
		? '/account'
		: '/';
---

<SiteLayout title={title} description={description} wide legacyFooter productBack={{ href: backHref, label: '上一頁' }}>
	{user ? (
		<div class="account-hub">
			<aside class="account-sidebar">
				<a class="account-brand" href="/account/orders"><span class="brand-mark"><i class="fa-solid fa-fish-fins" aria-hidden="true"></i></span><span><strong>我的帳戶</strong><small>水博館水族會員專區</small></span></a>
				<nav aria-label="會員導覽">
					<a class:list={['account-nav-link', { active: currentPath.startsWith('/account/orders') }]} href="/account/orders"><i class="fa-solid fa-box" aria-hidden="true"></i>我的訂單</a>
					<a class:list={['account-nav-link', { active: currentPath.startsWith('/account/addresses') }]} href="/account/addresses"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>收件地址</a>
					<a class:list={['account-nav-link', { active: currentPath.startsWith('/account/profile') }]} href="/account/profile"><i class="fa-regular fa-user" aria-hidden="true"></i>個人資料</a>
					<a class:list={['account-nav-link', { active: currentPath.startsWith('/account/security') }]} href="/account/security"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>登入與安全</a>
				</nav>
				<div class="account-help"><i class="fa-regular fa-circle-question" aria-hidden="true"></i><span>需要協助？<a href="/#about">聯絡我們</a></span></div>
			</aside>
			<main class="account-content"><slot /></main>
		</div>
	) : (
		<main class:list={['account-auth', { 'account-auth--entry': entryAuthPage }]}><section class="auth-card">{!entryAuthPage && <a class="auth-brand" href="/" aria-label="水博館水族首頁"><span class="brand-mark"><i class="fa-solid fa-fish-fins" aria-hidden="true"></i></span><span>水博館水族</span></a>}<slot /></section></main>
	)}
</SiteLayout>

<style>
	.account-hub{display:grid;grid-template-columns:250px minmax(0,1fr);gap:1.25rem;align-items:start}.account-sidebar,.account-content,.auth-card{border:1px solid #e9e7e1;border-radius:22px;background:#fff;box-shadow:0 14px 38px rgba(33,45,41,.055)}.account-sidebar{position:sticky;top:88px;padding:1.15rem}.account-brand,.auth-brand{display:flex;align-items:center;gap:.75rem;color:var(--aq-ink);text-decoration:none}.account-brand{padding:.2rem .2rem 1.1rem;border-bottom:1px solid #efeee9}.account-brand strong,.account-brand small{display:block}.account-brand strong{font-size:1rem}.account-brand small{margin-top:.2rem;color:var(--aq-muted);font-size:.74rem}.brand-mark{display:grid;place-items:center;flex:none;width:42px;height:42px;border-radius:14px;background:#e9f4f0;color:var(--aq-primary-dark)}.account-sidebar nav{display:grid;gap:.35rem;margin:1rem 0}.account-nav-link{display:flex;align-items:center;gap:.75rem;padding:.75rem .8rem;border-radius:12px;color:#626d69;text-decoration:none;font-size:.92rem;font-weight:600;transition:background .15s,color .15s}.account-nav-link i{width:1.1rem;text-align:center;color:#8b9691}.account-nav-link:hover,.account-nav-link.active{background:#edf5f1;color:var(--aq-primary-dark)}.account-nav-link.active i{color:var(--aq-primary)}.account-help{display:flex;gap:.65rem;align-items:center;border-top:1px solid #efeee9;padding:.9rem .2rem 0;color:var(--aq-muted);font-size:.78rem}.account-help>a,.account-help a{color:var(--aq-primary-dark);font-weight:700}.account-content{min-width:0;padding:clamp(1.25rem,3vw,2rem)}.account-auth{min-height:62vh;display:grid;place-items:center;padding:1rem 0}.auth-card{width:min(100%,540px);padding:clamp(1.4rem,5vw,2.5rem)}.auth-brand{margin-bottom:1.75rem;font-weight:800;letter-spacing:.02em}.auth-brand .brand-mark{width:46px;height:46px}.auth-card :global(h1),.account-content :global(h1){margin:0 0 .45rem;color:var(--aq-ink);font-size:clamp(1.55rem,3vw,1.9rem);font-weight:800;letter-spacing:-.025em}.auth-card :global(h2),.account-content :global(h2){color:var(--aq-ink);font-size:1.12rem;font-weight:750}.auth-card :global(.lead),.account-content :global(.lead){margin:.25rem 0 1.35rem;color:var(--aq-muted);line-height:1.65}.account-content :global(.muted),.account-content :global(.meta){color:var(--aq-muted)}.auth-card :global(.form),.account-content :global(.form){display:grid;gap:1rem;margin:1.35rem 0}.auth-card :global(label),.account-content :global(label){display:grid;gap:.42rem;color:#3d4945;font-size:.9rem;font-weight:650}.auth-card :global(input:not([type=checkbox]):not([type=radio])),.account-content :global(input:not([type=checkbox]):not([type=radio])),.account-content :global(select),.account-content :global(textarea){width:100%;min-height:46px;padding:.7rem .85rem;border:1px solid #dedfd9;border-radius:12px;background:#fff;color:var(--aq-ink);font:inherit;box-shadow:0 1px 2px rgba(20,35,30,.025);transition:border-color .16s,box-shadow .16s}.auth-card :global(input:focus),.account-content :global(input:focus),.account-content :global(select:focus),.account-content :global(textarea:focus){outline:none;border-color:var(--aq-primary);box-shadow:0 0 0 4px rgba(21,106,102,.1)}.auth-card :global(button:not(.password-toggle)),.account-content :global(button:not(.password-toggle)){min-height:46px;padding:.7rem 1rem;border:0;border-radius:12px;background:var(--aq-primary);color:white;font:inherit;font-weight:750;cursor:pointer;box-shadow:0 5px 13px rgba(21,106,102,.16);transition:transform .15s,background .15s}.auth-card :global(button:hover:not(:disabled)),.account-content :global(button:hover:not(:disabled)){transform:translateY(-1px);background:var(--aq-primary-dark)}.auth-card :global(.meta){color:var(--aq-muted);font-size:.9rem}.auth-card :global(a),.account-content :global(a){color:var(--aq-primary-dark)}.auth-card :global(.error),.account-content :global(.error){padding:.75rem .9rem;border:1px solid #f3ceca;border-radius:12px;background:#fff4f2;color:#a63228}.account-content :global(.ok){padding:.75rem .9rem;border:1px solid #cde7d8;border-radius:12px;background:#eff9f2;color:#21633d}.auth-card :global(.status),.auth-card :global(.notice){min-height:1.25rem;color:var(--aq-muted)}.auth-card :global(.password-toggle){justify-self:start;padding:0;border:0;background:none;color:var(--aq-primary-dark);font-size:.82rem;box-shadow:none}.account-content :global(.links){display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.7rem;margin-top:1.5rem}.account-content :global(.links a){padding:1rem;border:1px solid #e9e7e1;border-radius:14px;background:#fbfcfa;color:var(--aq-primary-dark);font-weight:700;text-decoration:none}.account-content :global(.list){list-style:none;display:grid;gap:.75rem;margin:1rem 0;padding:0}.account-content :global(.card),.account-content :global(.panel){padding:1.05rem 1.15rem;border:1px solid #e9e7e1;border-radius:16px;background:#fff;box-shadow:0 4px 16px rgba(30,40,35,.035)}.account-content :global(.badge),.account-content :global(.status){display:inline-flex;padding:.25rem .65rem;border-radius:999px;background:#edf5f1;color:var(--aq-primary-dark);font-size:.78rem;font-weight:750}.account-content :global(.danger),.account-content :global(.btn-danger){border:1px solid #f0c8c4!important;background:#fff7f6!important;color:#a63228!important;box-shadow:none!important}.account-content :global(.empty){padding:2rem;border:1px dashed #d8dcd6;border-radius:16px;background:#fafbf9;color:var(--aq-muted);text-align:center}.account-content :global(.banner){padding:.8rem 1rem;border-radius:12px}.account-content :global(.crumb){color:var(--aq-muted);font-size:.86rem}.account-content :global(.actions){display:flex;justify-content:flex-end;flex-wrap:wrap;gap:.65rem}.account-content :global(.mono){font-variant-numeric:tabular-nums;letter-spacing:.02em}
	.account-auth--entry{min-height:calc(100vh - 150px);padding:clamp(1rem,4vw,2.5rem);background:#050505}.account-auth--entry .auth-card{width:min(100%,760px);padding:clamp(1rem,2vw,1.25rem);border:1px solid #2b2b2b;border-radius:8px;background:#050505;color:#f4f4f4;box-shadow:none}.account-auth--entry :global(h1){color:#f6f6f6;font-size:1.25rem}.account-auth--entry :global(.lead){color:#a9a9a9}.account-auth--entry :global(label){color:#d8d8d8;font-size:.9rem;font-weight:450}.account-auth--entry :global(input:not([type=checkbox]):not([type=radio])){min-height:52px;padding:.8rem .85rem;border:1px solid #303030;border-radius:7px;background:#030303;color:#f6f6f6;box-shadow:none}.account-auth--entry :global(input::placeholder){color:#aaa}.account-auth--entry :global(input:focus){border-color:#168458;box-shadow:0 0 0 3px #16845833}.account-auth--entry :global(.form){gap:.8rem;margin:.8rem 0}.account-auth--entry :global(.form>button[type=submit]){min-height:50px;border-radius:7px;background:#168458;color:#fff;box-shadow:none}.account-auth--entry :global(.social-login){display:grid;gap:.55rem}.account-auth--entry .auth-card :global(button.social){min-height:52px;display:flex;align-items:center;justify-content:center;gap:.6rem;padding:.7rem 1rem;border:1px solid #303030;border-radius:8px;background:#030303;color:#f4f4f4;box-shadow:none}.account-auth--entry .auth-card :global(button.social:hover:not(:disabled)){background:#141414;box-shadow:none}.account-auth--entry .auth-card :global(button.social.line){border-color:#06c755;background:#06c755;color:#fff}.account-auth--entry .auth-card :global(button.social.line:hover:not(:disabled)){background:#05b94e}.account-auth--entry :global(.social-unavailable){border-color:#303030;color:#aaa}.account-auth--entry :global(.divider){margin:.8rem 0;color:#c2c2c2}.account-auth--entry :global(.divider:before),.account-auth--entry :global(.divider:after){background:#303030}.account-auth--entry :global(.error){border-color:#703c3c;background:#261414;color:#ffbcbc}.account-auth--entry :global(.status){color:#c8c8c8}.account-auth--entry :global(.meta){margin:.65rem 0;color:#bdbdbd}.account-auth--entry :global(a){color:#69cda1}.account-auth--entry :global(.password-toggle){background:none;color:#a8d8c1}.account-auth--entry :global(.terms){color:#d8d8d8}.account-auth--entry :global(.terms a){color:#69cda1}
	@media(max-width:760px){.account-hub{grid-template-columns:1fr}.account-sidebar{position:static;padding:.9rem}.account-brand{padding-bottom:.85rem}.account-sidebar nav{display:flex;overflow-x:auto;gap:.4rem;margin:.75rem 0}.account-nav-link{flex:none;padding:.65rem .75rem;font-size:.82rem}.account-help{display:none}.account-content{padding:1.15rem}.account-sidebar nav::-webkit-scrollbar{display:none}}
</style>
