		.commerce-sidebar { position: relative; top: auto; z-index: auto; height: auto; display: grid; grid-template-columns: minmax(0,1fr) auto; grid-template-areas: "brand context" "nav nav"; align-items: center; gap: 8px 10px; padding: max(11px, env(safe-area-inset-top, 0px)) max(14px, env(safe-area-inset-right, 0px)) 4px max(14px, env(safe-area-inset-left, 0px)); border-right: 0; border-bottom: 1px solid var(--commerce-line); }
