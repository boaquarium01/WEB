---
/** Shared shell for the ecommerce administration workspace. */
import Layout from './Layout.astro';
import { getAdminBasePath } from '../lib/admin/path';

interface Props {
	title: string;
	description?: string;
}

const { title, description = '水博館水族電商管理後台' } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const base = getAdminBasePath();
const shop = `${base}/shop`;

const links = [
	{ href: shop, label: '營運總覽', icon: 'fa-chart-pie', match: (p: string) => p === shop || p === `${shop}/` },
	{ href: `${shop}/orders`, label: '訂單管理', icon: 'fa-receipt', match: (p: string) => p.includes('/shop/orders') },
	{ href: `${shop}/members`, label: '會員管理', icon: 'fa-users', match: (p: string) => p.includes('/shop/members') },
	{ href: `${shop}/products`, label: '商品管理', icon: 'fa-box-open', match: (p: string) => p.includes('/shop/products') || p.includes('/shop/inventory') },
	{ href: `${shop}/shipping`, label: '運費設定', icon: 'fa-truck-fast', match: (p: string) => p.includes('/shop/shipping') },
];
const today = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
---

<Layout title={title} description={description}>
	<div class="commerce-admin">
		<aside class="commerce-sidebar" aria-label="電商管理導覽">
			<a href={shop} class="commerce-brand">
				<span class="commerce-brand__mark"><i class="fa-solid fa-fish-fins" aria-hidden="true"></i></span>
				<span class="commerce-brand__text"><strong>水博館水族</strong><small>電商管理</small></span>
			</a>
			<div class="commerce-sidebar__context">
				<span class="commerce-sidebar__date"><i class="fa-regular fa-calendar" aria-hidden="true"></i>{today}</span>
				<span class="commerce-sidebar__user"><span class="commerce-user__avatar">{String(user?.name ?? user?.email ?? '管').slice(0, 1).toUpperCase()}</span><strong>{user?.name ?? user?.email ?? '管理員'}</strong></span>
			</div>
			<nav class="commerce-nav">
				{links.map((link) => (
					<a href={link.href} class:list={[{ active: link.match(path) }]} aria-current={link.match(path) ? 'page' : undefined}>
						<i class:list={['fa-solid', link.icon]} aria-hidden="true"></i>
						<span><strong>{link.label}</strong></span>
						<i class="fa-solid fa-chevron-right nav-chevron" aria-hidden="true"></i>
					</a>
				))}
			</nav>
			<div class="commerce-sidebar__bottom">
				<a href={`${base}/dashboard`}><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span>官網內容管理</span></a>
				<a href="/"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span>查看官網</span></a>
			</div>
		</aside>

		<div class="commerce-workspace">
			<main class="commerce-main">
				<div class="commerce-content"><slot /></div>
				<footer class="commerce-footer"><span>水博館水族 · 電商管理系統</span><span>安全管理工作區</span></footer>
			</main>
		</div>
	</div>
</Layout>

<style is:global>
	:root {
		--commerce-ink: #18323b;
		--commerce-muted: #72828a;
		--commerce-line: #e2e9e8;
		--commerce-paper: #ffffff;
		--commerce-canvas: #f3f7f6;
		--commerce-primary: #087e78;
		--commerce-primary-dark: #075d59;
		--commerce-primary-soft: #e8f5f2;
		--commerce-warn: #b96a16;
		--commerce-danger: #bd4d4d;
		--commerce-shadow: 0 12px 34px rgba(28, 67, 70, 0.055);
	}
	body:has(.commerce-admin) { margin: 0; background: var(--commerce-canvas); color: var(--commerce-ink); }
	body:has(.commerce-admin) .line-float,
	body:has(.commerce-admin) .cart-float { display: none !important; }
	.commerce-admin { min-height: 100vh; display: grid; grid-template-columns: 252px minmax(0, 1fr); }
	.commerce-sidebar { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 23px 15px 18px; background: #fff; border-right: 1px solid var(--commerce-line); }
	.commerce-brand { display: flex; align-items: center; gap: 12px; padding: 0 11px 27px; color: inherit; text-decoration: none; }
	.commerce-brand__mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 14px; background: linear-gradient(145deg, #0c938a, #066963); color: #fff; font-size: 19px; box-shadow: 0 7px 15px #087e782e; }
	.commerce-brand__text { display: grid; gap: 4px; }
	.commerce-brand__text strong { font-size: 15px; letter-spacing: .04em; }
	.commerce-brand__text small { color: #8a999c; font-size: 11px; font-weight: 700; letter-spacing: .04em; }
	.commerce-sidebar__context { display: grid; gap: 9px; margin: -8px 3px 19px; padding: 11px; border-radius: 12px; background: #f6f9f8; }
	.commerce-sidebar__date { display: flex; align-items: center; gap: 8px; color: #6f8387; font-size: 12px; }
	.commerce-sidebar__user { display: flex; align-items: center; gap: 9px; min-width: 0; color: #40575c; font-size: 13px; }
	.commerce-sidebar__user strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.commerce-nav { display: grid; gap: 5px; }
	.commerce-nav a { min-height: 56px; display: flex; align-items: center; gap: 12px; padding: 8px 12px; border: 1px solid transparent; border-radius: 12px; color: #73848a; text-decoration: none; transition: .18s ease; }
	.commerce-nav a:hover { background: #f7faf9; color: var(--commerce-primary); }
	.commerce-nav a.active { background: var(--commerce-primary-soft); border-color: #d5ebe6; color: var(--commerce-primary-dark); }
	.commerce-nav a > i:first-child { width: 20px; text-align: center; font-size: 15px; }
	.commerce-nav a span { flex: 1; display: grid; gap: 2px; }
	.commerce-nav a strong { font-size: 15px; font-weight: 680; }
	.commerce-nav a small { color: #9aa8a9; font-size: 10px; }
	.commerce-nav .nav-chevron { color: #a7b5b4; font-size: 10px; }
	.commerce-sidebar__bottom { margin-top: auto; padding-top: 15px; border-top: 1px solid #edf1ef; display: grid; gap: 3px; }
	.commerce-sidebar__bottom a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 9px; color: #718189; text-decoration: none; font-size: 12px; }
	.commerce-sidebar__bottom a:hover,.commerce-sidebar__bottom a.active { background: #f2f7f6; color: var(--commerce-primary-dark); }
	.commerce-sidebar__bottom i { width: 17px; text-align: center; }
	.commerce-workspace { min-width: 0; }
	.commerce-user__avatar { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: #e5f2ef; color: var(--commerce-primary-dark); font-weight: 750; }
	.commerce-main { min-height: 100vh; display: flex; flex-direction: column; padding: 30px 36px 18px; }
	.commerce-content { flex: 1; width: 100%; max-width: 1500px; margin: 0 auto; }
	.commerce-footer { width: 100%; max-width: 1500px; margin: 26px auto 0; padding-top: 14px; display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid #e3eae8; color: #9aa7a7; font-size: 10px; }
	.commerce-content h1 { margin: 0; color: var(--commerce-ink); font-size: clamp(32px, 3.5vw, 40px); line-height: 1.18; letter-spacing: -.035em; }
	.commerce-content h2 { color: var(--commerce-ink); font-size: 23px; }
	.commerce-content .lead { margin: 8px 0 0; color: var(--commerce-muted); font-size: 15px; line-height: 1.65; }
	.commerce-content .head { margin-bottom: 20px; }
	.commerce-content .table-wrap,.commerce-content .panel { overflow: hidden; background: var(--commerce-paper); border: 1px solid var(--commerce-line); border-radius: 16px; box-shadow: var(--commerce-shadow); }
	.commerce-content .panel { padding: 20px 22px; margin-bottom: 16px; }
	.commerce-content .table-wrap { overflow-x: auto; }
	.commerce-content table { width: 100%; border-collapse: collapse; font-size: 14px; }
	.commerce-content th { padding: 13px 15px; background: #f6f9f8; color: #687b7e; font-size: 12px; font-weight: 750; letter-spacing: .02em; }
	.commerce-content td { padding: 13px 15px; border-bottom: 1px solid #edf1ef; color: #41575e; line-height: 1.5; }
	.commerce-content tbody tr:last-child td { border-bottom: 0; }
	.commerce-content tbody tr:hover { background: #fbfdfc; }
	.commerce-content .empty { padding: 28px; border: 1px dashed #d6e2df; border-radius: 14px; background: #fff; color: var(--commerce-muted); text-align: center; }
	.commerce-content input,.commerce-content select,.commerce-content textarea { border: 1px solid #dce6e3; border-radius: 9px; background: #fff; color: var(--commerce-ink); font: inherit; }
	.commerce-content input:focus,.commerce-content select:focus,.commerce-content textarea:focus { outline: 3px solid #087e781b; border-color: var(--commerce-primary); }
	@media (max-width: 800px) {
		.commerce-admin { grid-template-columns: 1fr; }
		.commerce-sidebar { position: static; height: auto; padding: 11px 14px 9px; border-right: 0; border-bottom: 1px solid var(--commerce-line); }
		.commerce-brand { padding: 0 2px 10px; }
		.commerce-brand__mark { width: 34px; height: 34px; border-radius: 11px; font-size: 16px; }
		.commerce-sidebar__bottom { display: none; }
		.commerce-nav { display: flex; overflow-x: auto; gap: 6px; padding-bottom: 1px; }
		.commerce-nav a { flex: 0 0 auto; min-height: 38px; gap: 7px; padding: 6px 10px; border-color: #edf1ef; background: #fff; }
		.commerce-nav a span { display: block; }
		.commerce-nav a strong { font-size: 13px; }
		.commerce-nav a small,.commerce-nav .nav-chevron { display: none; }
		.commerce-nav a > i:first-child { font-size: 12px; }
		.commerce-sidebar__context { grid-template-columns: 1fr auto; align-items: center; gap: 8px; margin: 0 0 10px; padding: 7px 9px; }
		.commerce-sidebar__date { font-size: 11px; }
		.commerce-sidebar__user { font-size: 12px; }
		.commerce-user__avatar { width: 26px; height: 26px; }
		.commerce-main { min-height: calc(100vh - 150px); padding: 22px 15px 15px; }
	}
</style>
