</style>

<script>
	// 手機「更多」選單
	const moreSheet = document.getElementById('commerceMoreSheet') as HTMLDialogElement | null;
	document.getElementById('commerceMoreBtn')?.addEventListener('click', () => moreSheet?.showModal());
	// 底部導覽：按下立即回饋（縮放、輕震動），點連結時先切換選中狀態再換頁
	const tabbar = document.querySelector('.commerce-tabbar');
	if (tabbar) {
		const itemOf = (event: Event) => (event.target as Element | null)?.closest?.('a, button') as HTMLElement | null;
		const clear = () => tabbar.querySelectorAll('.is-pressed').forEach((el) => el.classList.remove('is-pressed'));
		tabbar.addEventListener('pointerdown', (event) => { itemOf(event)?.classList.add('is-pressed'); try { navigator.vibrate?.(8); } catch {} });
		['pointerup', 'pointercancel', 'pointerleave'].forEach((type) => tabbar.addEventListener(type, clear));
		tabbar.addEventListener('click', (event) => {
			const item = itemOf(event);
			if (!(item instanceof HTMLAnchorElement)) return;
			const mouse = event as MouseEvent;
			if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.button !== 0) return;
			tabbar.querySelectorAll('.active').forEach((el) => { el.classList.remove('active'); el.removeAttribute('aria-current'); });
			item.classList.add('active', 'is-going');
			item.setAttribute('aria-current', 'page');
		});
		// 按上一頁回來時（瀏覽器快取），還原成這一頁原本的選中項目
		const original = tabbar.querySelector('.active');
		window.addEventListener('pageshow', () => {
			tabbar.querySelectorAll('.is-going, .active').forEach((el) => { el.classList.remove('is-going', 'active'); el.removeAttribute('aria-current'); });
			if (original) { original.classList.add('active'); if (original instanceof HTMLAnchorElement) original.setAttribute('aria-current', 'page'); }
		});
	}
	moreSheet?.addEventListener('click', (event) => {
		if (event.target === moreSheet || (event.target as HTMLElement).closest('[data-close-more]')) moreSheet.close();
	});
	const adminShell = document.querySelector('.commerce-admin');
	const sidebarToggle = document.getElementById('commerceSidebarToggle');
	if (adminShell instanceof HTMLElement && sidebarToggle instanceof HTMLButtonElement) {
		const storageKey = 'bo-admin-sidebar-collapsed';
		const applySidebarState = (collapsed) => {
			adminShell.dataset.sidebarCollapsed = collapsed ? 'true' : 'false';
			sidebarToggle.setAttribute('aria-expanded', String(!collapsed));
			sidebarToggle.setAttribute('aria-label', collapsed ? '展開側邊欄' : '收折側邊欄');
			sidebarToggle.title = collapsed ? '展開側邊欄' : '收折側邊欄';
			const icon = sidebarToggle.querySelector('.collapse-button__icon');
			if (icon) {
				icon.classList.toggle('fa-angles-right', collapsed);
				icon.classList.toggle('fa-angles-left', !collapsed);
			}
			try { localStorage.setItem(storageKey, collapsed ? '1' : '0'); } catch {}
		};
		let collapsed = false;
		try { collapsed = localStorage.getItem(storageKey) === '1'; } catch {}
		applySidebarState(collapsed);
		sidebarToggle.addEventListener('click', () => {
			applySidebarState(adminShell.dataset.sidebarCollapsed !== 'true');
		});
	}
	const navScrollStart = document.getElementById('commerceNavScrollStart');
	const navScrollEnd = document.getElementById('commerceNavScrollEnd');
	const commerceNav = document.querySelector<HTMLElement>('.commerce-nav');
	if (commerceNav instanceof HTMLElement) {
		const updateNavScrollButtons = () => {
			const navWrap = commerceNav.closest('.commerce-nav-wrap');
			const hasLeftScroll = commerceNav.scrollLeft > 2;
			const hadLeftScroll = navWrap?.classList.contains('has-left-scroll') ?? false;
			navWrap?.classList.toggle('has-left-scroll', hasLeftScroll);
			if (hasLeftScroll && !hadLeftScroll) commerceNav.scrollLeft += 30;
			if (navScrollStart) navScrollStart.hidden = !hasLeftScroll;
			const hasRightScroll = commerceNav.scrollLeft + commerceNav.clientWidth < commerceNav.scrollWidth - 2;
			navWrap?.classList.toggle('has-right-scroll', hasRightScroll);
			if (navScrollEnd) navScrollEnd.hidden = !hasRightScroll;
		};
		const activeNavLink = commerceNav.querySelector<HTMLElement>('a[aria-current="page"]');
		requestAnimationFrame(() => {
			if (activeNavLink) {
				const navWrap = commerceNav.closest('.commerce-nav-wrap');
				if (activeNavLink !== commerceNav.firstElementChild) navWrap?.classList.add('has-left-scroll');
				const isLastNavLink = activeNavLink === commerceNav.lastElementChild;
				const navRect = commerceNav.getBoundingClientRect();
				const activeRect = activeNavLink.getBoundingClientRect();
				const currentLeft = commerceNav.scrollLeft;
				const targetLeft = isLastNavLink
					? commerceNav.scrollWidth - commerceNav.clientWidth
					: activeRect.left < navRect.left
						? currentLeft - (navRect.left - activeRect.left)
						: activeRect.right > navRect.right
							? currentLeft + (activeRect.right - navRect.right)
							: currentLeft;
				commerceNav.scrollTo({ left: targetLeft, behavior: 'auto' });
			}
			updateNavScrollButtons();
		});
		commerceNav.addEventListener('scroll', updateNavScrollButtons, { passive: true });
		window.addEventListener('resize', updateNavScrollButtons);
		navScrollStart?.addEventListener('click', () => commerceNav.scrollBy({ left: -Math.max(140, commerceNav.clientWidth * .8), behavior: 'smooth' }));
		navScrollEnd?.addEventListener('click', () => commerceNav.scrollBy({ left: Math.max(140, commerceNav.clientWidth * .8), behavior: 'smooth' }));
	}
</script>
