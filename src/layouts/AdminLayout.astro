		.commerce-nav-scroll-end { position: absolute; top: calc(50% - 3px); right: 0; z-index: 2; display: grid; width: 26px; height: 32px; place-items: center; padding: 0; transform: translateY(-50%); border: 1px solid #dce8e5; border-radius: 8px; background: #fff; color: var(--commerce-primary); box-shadow: -6px 0 12px rgba(255, 255, 255, 0.9); font-size: 11px; }
		.commerce-nav-scroll-end[hidden] { display: none; }
		.commerce-nav-scroll-end:active { background: var(--commerce-primary-soft); }
		.commerce-nav-wrap.has-right-scroll { padding-right: 30px; }
		.commerce-nav-scroll-start:active { background: var(--commerce-primary-soft); }
		.commerce-nav-scroll-start[hidden] { display: none; }
		.commerce-nav a { flex: 0 0 auto; min-height: 38px; gap: 7px; padding: 6px 10px; border-color: #edf1ef; background: #fff; }
		.commerce-nav a span { display: block; }
		.commerce-nav a strong { font-size: 13px; }
