		.commerce-sidebar__date { font-size: 11px; }
		.commerce-sidebar__date-full { display: none; }
		.commerce-sidebar__date-compact { display: inline; }
		.commerce-sidebar__date { max-width: none; max-height: none; gap: 5px; overflow: visible; }
		.commerce-sidebar__date > i { font-size: 10px; }
