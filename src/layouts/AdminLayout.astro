---
/** Shared shell for the official website administration workspace. */
import Layout from './Layout.astro';
import { getAdminBasePath } from '../lib/admin/path';
import { getAdminOrderStatusCounts } from '../lib/services/admin-orders';

interface Props {
	title: string;
	description?: string;
}

const { title, description = '水博館水族官方網站後台' } = Astro.props;
// 分頁標題統一為「頁名｜水博館水族官方網站後台」，各頁只需傳頁名
const pageTitle = `${title.split('｜')[0]}｜水博館水族官方網站後台`;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const base = getAdminBasePath();
const shop = `${base}/shop`;

const links = [
	{ href: shop, label: '營運總覽', icon: 'fa-chart-pie', match: (p: string) => p === shop || p === `${shop}/` },
	{ href: `${shop}/orders`, label: '訂單管理', icon: 'fa-receipt', match: (p: string) => p.includes('/shop/orders') },
	{ href: `${base}/dashboard?model=product`, label: '商品管理', icon: 'fa-box-open', match: (p: string) => p.includes('/dashboard') || p.includes('/shop/products') || p.includes('/shop/inventory') },
	{ href: `${shop}/members`, label: '會員管理', icon: 'fa-users', match: (p: string) => p.includes('/shop/members') },
	{ href: `${shop}/home-display`, label: '首頁陳列', icon: 'fa-house', match: (p: string) => p.includes('/shop/home-display') },
	{ href: `${shop}/operations`, label: '營運管理', icon: 'fa-chart-line', match: (p: string) => p.includes('/shop/operations') },
	{ href: `${shop}/discounts`, label: '折扣碼', icon: 'fa-ticket', match: (p: string) => p.includes('/shop/discounts') },
	{ href: `${shop}/shipping`, label: '運費設定', icon: 'fa-truck-fast', match: (p: string) => p.includes('/shop/shipping') },
	{ href: `${shop}/admins`, label: '管理員設定', icon: 'fa-user-shield', match: (p: string) => p.includes('/shop/admins') },
];
/** 需要店家處理的訂單：已回報付款待核對＋待出貨，顯示在「訂單管理」徽章 */
let pendingOrders = 0;
try {
	const counts = await getAdminOrderStatusCounts();
	pendingOrders = counts.PAYMENT_SUBMITTED + counts.AWAITING_SHIPMENT;
} catch {
	/* 讀不到就不顯示徽章 */
}
const badgeFor = (href: string) => (href === `${shop}/orders` && pendingOrders > 0 ? (pendingOrders > 99 ? '99+' : String(pendingOrders)) : '');
/** 手機底部分頁列：常用三項＋更多 */
const tabLinks = links.slice(0, 3);
const moreLinks = links.slice(3);
const moreActive = moreLinks.some((link) => link.match(path));
const today = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
const todayCompact = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', month: '2-digit', day: '2-digit', weekday: 'short' }).format(new Date());
---

<Layout title={pageTitle} description={description}>
	<div class="commerce-admin">
		<aside class="commerce-sidebar" aria-label="官方網站後台導覽">
			<button id="commerceSidebarToggle" class="commerce-sidebar-toggle" type="button" aria-expanded="true" aria-label="收折側邊欄" title="收折側邊欄">
				<i class="fa-solid fa-angles-left collapse-button__icon" aria-hidden="true"></i>
			</button>
			<a href={shop} class="commerce-brand" title="水博館水族官方網站後台">
				<span class="commerce-brand__mark"><i class="fa-solid fa-fish-fins" aria-hidden="true"></i></span>
				<span class="commerce-brand__text"><strong>水博館水族</strong><small>官方網站後台</small></span>
			</a>
			<div class="commerce-sidebar__context">
				<span class="commerce-sidebar__date"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span class="commerce-sidebar__date-full">{today}</span><span class="commerce-sidebar__date-compact">{todayCompact}</span></span>
				<span class="commerce-sidebar__user"><span class="commerce-user__avatar">{String(user?.name ?? user?.email ?? '管').slice(0, 1).toUpperCase()}</span><strong>{user?.name ?? user?.email ?? '管理員'}</strong></span>
			</div>
			<div class="commerce-nav-wrap">
				<button id="commerceNavScrollStart" class="commerce-nav-scroll-start" type="button" aria-label="導覽向左捲動" title="導覽向左捲動" hidden><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
				<nav class="commerce-nav" aria-label="管理功能">
					{links.map((link) => (
						<a href={link.href} title={link.label} class:list={[{ active: link.match(path) }]} aria-current={link.match(path) ? 'page' : undefined}>
							<i class:list={['fa-solid', link.icon]} aria-hidden="true"></i>
							<span><strong>{link.label}</strong></span>
							{badgeFor(link.href) && <span class="nav-badge" aria-label={`${badgeFor(link.href)} 筆待處理`}>{badgeFor(link.href)}</span>}
							<i class="fa-solid fa-chevron-right nav-chevron" aria-hidden="true"></i>
						</a>
					))}
				</nav>
				<button id="commerceNavScrollEnd" class="commerce-nav-scroll-end" type="button" aria-label="導覽向右捲動，還有更多功能" title="還有更多功能" hidden><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
			</div>
			<div class="commerce-sidebar__bottom">
				<a href="/" title="查看官網"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span>查看官網</span></a>
				<form method="post" action="/api/account/logout" data-confirm="確定要登出後台？">
					<input type="hidden" name="next" value={`${base}/login`} />
					<button type="submit" class="commerce-logout" title="登出"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>登出</span></button>
				</form>
			</div>
		</aside>

		<!-- 手機底部分頁列 -->
		<nav class="commerce-tabbar" aria-label="主要功能">
			{tabLinks.map((link) => (
				<a href={link.href} class:list={[{ active: link.match(path) }]} aria-current={link.match(path) ? 'page' : undefined}>
					<span class="commerce-tabbar__icon"><i class:list={['fa-solid', link.icon]} aria-hidden="true"></i>{badgeFor(link.href) && <span class="nav-badge">{badgeFor(link.href)}</span>}</span>
					<span>{link.label.replace('管理', '').replace('營運總覽', '總覽')}</span>
				</a>
			))}
			<button type="button" id="commerceMoreBtn" class:list={[{ active: moreActive }]} aria-haspopup="dialog" aria-controls="commerceMoreSheet">
				<span class="commerce-tabbar__icon"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></span>
				<span>更多</span>
			</button>
		</nav>
		<dialog id="commerceMoreSheet" class="commerce-more" aria-label="更多功能">
			<div class="commerce-more__body">
				<div class="commerce-more__head"><strong>更多功能</strong><button type="button" class="commerce-more__close" data-close-more aria-label="關閉"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
				<div class="commerce-more__grid">
					{moreLinks.map((link) => (
						<a href={link.href} class:list={[{ active: link.match(path) }]} aria-current={link.match(path) ? 'page' : undefined}><i class:list={['fa-solid', link.icon]} aria-hidden="true"></i><span>{link.label}</span></a>
					))}
					<a href="/"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span>查看官網</span></a>
				</div>
				<form method="post" action="/api/account/logout" data-confirm="確定要登出後台？">
					<input type="hidden" name="next" value={`${base}/login`} />
					<button type="submit" class="commerce-more__logout"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>登出</button>
				</form>
			</div>
		</dialog>

		<div class="commerce-workspace">
			<main class="commerce-main">
				<div class="commerce-content"><slot /></div>
				<footer class="commerce-footer"><span>水博館水族官方網站後台</span><span>Copyright ©mfeng</span></footer>
			</main>
		</div>
	</div>
</Layout>

<style is:global>
	:root {
		--commerce-ink: #1a2221;
		--commerce-muted: #5c6563;
		--commerce-line: #e3e7e5;
		--commerce-paper: #ffffff;
		--commerce-canvas: #eef1ef;
		--commerce-primary: #156a66;
		--commerce-primary-dark: #0f4d4a;
		--commerce-primary-soft: #e7f0ef;
		--commerce-warn: #b96a16;
		--commerce-danger: #bd4d4d;
		--commerce-shadow: 0 12px 34px rgba(28, 67, 70, 0.055);
	}
	body:has(.commerce-admin) { margin: 0; background: var(--commerce-canvas); color: var(--commerce-ink); }
	body:has(.commerce-admin) .line-float,
	body:has(.commerce-admin) .cart-float { display: none !important; }
	.commerce-admin { min-height: 100vh; min-height: 100dvh; display: grid; grid-template-columns: 252px minmax(0, 1fr); transition: grid-template-columns .2s ease; }
	.commerce-sidebar { position: relative; top: auto; height: 100vh; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; padding: 23px 15px 18px; overflow: hidden; background: #fff; border-right: 1px solid var(--commerce-line); transition: padding .2s ease; }
	.commerce-sidebar-toggle { position: absolute; top: 24px; right: 10px; z-index: 20; width: 46px; height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 0; border: 1px solid #b9ddd7; border-radius: 10px; background: var(--commerce-primary-soft); color: var(--commerce-primary-dark); box-shadow: 0 5px 14px rgba(8, 126, 120, .12); cursor: pointer; transition: background-color .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease, transform .16s ease; }
	.commerce-sidebar-toggle:hover { border-color: var(--commerce-primary); background: var(--commerce-primary); color: #fff; transform: translateY(-1px); box-shadow: 0 7px 17px rgba(8, 126, 120, .2); }
	.commerce-sidebar-toggle:focus-visible { outline: 3px solid #087e7833; outline-offset: 2px; }
	.collapse-button__icon { display: grid; width: 22px; height: 22px; place-items: center; font-size: 14px; line-height: 1; }
	.commerce-brand { display: flex; align-items: center; gap: 12px; padding: 0 58px 27px 11px; color: inherit; text-decoration: none; transition: padding .2s ease; }
	.commerce-brand__mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 14px; background: var(--commerce-primary); color: #fff; font-size: 19px; box-shadow: 0 7px 15px rgba(21, 106, 102, 0.18); }
	.commerce-brand__text { display: grid; gap: 4px; min-width: 0; max-width: 170px; overflow: hidden; white-space: nowrap; transition: opacity .12s ease, max-width .2s ease, visibility 0s linear; }
	.commerce-brand__text strong { font-size: 15px; letter-spacing: .04em; }
	.commerce-brand__text small { color: #8a999c; font-size: 11px; font-weight: 700; letter-spacing: .04em; }
	.commerce-sidebar__context { display: grid; gap: 9px; margin: -8px 3px 19px; padding: 11px; border-radius: 12px; background: #f6f9f8; transition: gap .2s ease, margin .2s ease, padding .2s ease; }
	.commerce-sidebar__date { display: flex; align-items: center; gap: 8px; max-width: 220px; max-height: 22px; overflow: hidden; color: #6f8387; font-size: 12px; white-space: nowrap; transition: opacity .12s ease, max-width .2s ease, max-height .2s ease, visibility 0s linear; }
	.commerce-sidebar__date-compact { display: none; }
	.commerce-sidebar__user { display: flex; align-items: center; gap: 9px; min-width: 0; color: #40575c; font-size: 13px; }
	.commerce-sidebar__user strong { min-width: 0; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity .12s ease, max-width .2s ease, visibility 0s linear; }
	.commerce-nav { display: grid; gap: 5px; }
	.commerce-nav-wrap { display: contents; }
	.commerce-nav-scroll-start, .commerce-nav-scroll-end { display: none; }
	.commerce-nav a { min-height: 56px; display: flex; align-items: center; gap: 12px; padding: 8px 12px; border: 1px solid transparent; border-radius: 12px; color: #73848a; text-decoration: none; transition: .18s ease; }
		.commerce-nav a:hover { background: #f7faf9; color: var(--commerce-primary); }
		.commerce-nav a.active { background: var(--commerce-primary-soft); border-color: #d5ebe6; color: var(--commerce-primary-dark); }
		.commerce-nav a.active > i:first-child { color: var(--commerce-primary); }
	.commerce-nav a > i:first-child { width: 20px; text-align: center; font-size: 15px; }
	.commerce-nav a span { flex: 1; min-width: 0; max-width: 170px; display: grid; gap: 2px; overflow: hidden; white-space: nowrap; transition: opacity .12s ease, max-width .2s ease, visibility 0s linear; }
	.commerce-nav a strong { font-size: 15px; font-weight: 680; }
	.commerce-nav a small { color: #9aa8a9; font-size: 10px; }
	.commerce-nav .nav-chevron { flex: none; overflow: hidden; color: #a7b5b4; font-size: 10px; transition: opacity .12s ease, width .2s ease; }
	.commerce-sidebar__bottom { margin-top: auto; padding-top: 15px; border-top: 1px solid #edf1ef; display: grid; gap: 3px; }
	.commerce-sidebar__bottom form { margin: 0; }
	.commerce-sidebar__bottom .commerce-logout { width: 100%; border: 0; background: transparent; font: inherit; cursor: pointer; text-align: left; }
	.commerce-sidebar__bottom a, .commerce-sidebar__bottom .commerce-logout { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 9px; color: #718189; text-decoration: none; font-size: 12px; }
	.commerce-sidebar__bottom .commerce-logout:hover { background: #fff3f1; color: #b4443a; }
	.commerce-sidebar__bottom a:hover,.commerce-sidebar__bottom a.active { background: #f2f7f6; color: var(--commerce-primary-dark); }
	.commerce-sidebar__bottom i { width: 17px; text-align: center; }
	.commerce-sidebar__bottom span { max-width: 170px; overflow: hidden; white-space: nowrap; transition: opacity .12s ease, max-width .2s ease, visibility 0s linear; }
	.commerce-workspace { min-width: 0; }
	.commerce-user__avatar { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: #e5f2ef; color: var(--commerce-primary-dark); font-weight: 750; }
	.commerce-main { min-height: 100vh; display: flex; flex-direction: column; padding: 22px 36px 18px; }
	.commerce-content { flex: 1; width: 100%; max-width: 1500px; margin: 0 auto; }
	.commerce-back-link { display: inline-flex; min-height: 38px; box-sizing: border-box; align-items: center; justify-content: center; gap: 8px; padding: 0 12px; border: 1px solid var(--commerce-line); border-radius: 9px; background: #fff; color: var(--commerce-primary-dark); font: inherit; font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; transition: border-color .15s ease,background-color .15s ease,color .15s ease; }
	.commerce-back-link:hover { border-color: #b9ddd7; background: var(--commerce-primary-soft); color: var(--commerce-primary-dark); }
	.commerce-back-link:focus-visible { outline: 3px solid #087e7833; outline-offset: 2px; }
	.commerce-back-link i { font-size: 12px; }
	.commerce-footer { width: 100%; max-width: 1500px; margin: 26px auto 0; padding-top: 14px; display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid #e3eae8; color: #9aa7a7; font-size: 10px; }
	.commerce-content h1 { margin: 0; color: var(--commerce-ink); font-size: clamp(32px, 3.5vw, 40px); line-height: 1.18; letter-spacing: -.035em; }
	.commerce-content h2 { color: var(--commerce-ink); font-size: 23px; }
	.commerce-content .lead { margin: 8px 0 0; color: var(--commerce-muted); font-size: 15px; line-height: 1.65; }
	.commerce-content .head { margin-bottom: 20px; }
	.commerce-content .table-wrap,.commerce-content .panel { overflow: hidden; background: var(--commerce-paper); border: 1px solid var(--commerce-line); border-radius: 16px; box-shadow: var(--commerce-shadow); }
	.commerce-content .panel { padding: 20px 22px; margin-bottom: 16px; }
	.commerce-content .table-wrap { overflow-x: auto; }
	.commerce-content table { width: 100%; border-collapse: collapse; font-size: 14px; }
	.commerce-content th { padding: 13px 15px; background: #f6f9f8; color: #687b7e; font-size: 12px; font-weight: 750; letter-spacing: .02em; }
	.commerce-content td { padding: 13px 15px; border-bottom: 1px solid #edf1ef; color: #41575e; line-height: 1.5; }
	.commerce-content tbody tr:last-child td { border-bottom: 0; }
	.commerce-content tbody tr:hover { background: #fbfdfc; }
	.commerce-content .empty { padding: 28px; border: 1px dashed #d6e2df; border-radius: 14px; background: #fff; color: var(--commerce-muted); text-align: center; }
	.commerce-content input,.commerce-content select,.commerce-content textarea { border: 1px solid #dce6e3; border-radius: 9px; background: #fff; color: var(--commerce-ink); font: inherit; }
	.commerce-content input:focus,.commerce-content select:focus,.commerce-content textarea:focus { outline: 3px solid #087e781b; border-color: var(--commerce-primary); }
	@media (min-width: 801px) {
		.commerce-admin[data-sidebar-collapsed='true'] { grid-template-columns: 76px minmax(0, 1fr); }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar { padding-inline: 8px; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-brand { align-self: stretch; justify-content: center; gap: 0; padding: 42px 0 20px; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar-toggle { top: 10px; right: auto; left: 50%; width: 42px; height: 42px; transform: translateX(-50%); }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar-toggle:hover { transform: translate(-50%, -1px); }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-brand__text,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__date,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__user strong,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-nav .nav-chevron,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__bottom span { visibility: hidden; max-width: 0; opacity: 0; transition-delay: 0s, 0s, .2s; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-nav .nav-chevron { width: 0; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-nav a span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__context { align-self: stretch; box-sizing: border-box; gap: 0; margin-inline: 0; padding: 8px; background: transparent; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__date { visibility: hidden; max-width: 0; max-height: 0; opacity: 0; transition-delay: 0s, 0s, 0s, .2s; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__user { display: grid; width: 100%; grid-template-columns: 30px; justify-content: center; padding: 0; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-user__avatar { width: 30px; height: 30px; margin: 0; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-nav a,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__bottom a, .commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__bottom .commerce-logout { position: relative; width: 100%; box-sizing: border-box; justify-content: center; gap: 0; padding-inline: 0; }
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-nav a > i:first-child,
		.commerce-admin[data-sidebar-collapsed='true'] .commerce-sidebar__bottom i { position: relative; left: 0; width: 22px; height: 22px; display: grid; flex: none; place-items: center; margin-inline: auto; text-align: center; }
	}
	.nav-badge { display: inline-grid; place-items: center; min-width: 20px; height: 20px; margin-left: auto; padding: 0 6px; box-sizing: border-box; border-radius: 999px; background: #d64535; color: #fff; font-size: 11px; font-weight: 800; line-height: 1; }
	.commerce-tabbar, .commerce-more { display: none; }

	@media (max-width: 800px) {
		.commerce-admin { display: block; }
		/* 手機改用底部分頁列，頂部只留品牌與使用者 */
		.commerce-nav-wrap { display: none !important; }
		.commerce-sidebar { grid-template-areas: "brand context" !important; padding-bottom: 10px !important; }
		.commerce-tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: repeat(4, 1fr); padding: 4px max(6px, env(safe-area-inset-right, 0px)) max(4px, env(safe-area-inset-bottom, 0px)) max(6px, env(safe-area-inset-left, 0px)); border-top: 1px solid var(--commerce-line); background: rgba(255, 255, 255, 0.97); box-shadow: 0 -6px 18px rgba(28, 67, 70, 0.06); backdrop-filter: blur(8px); }
		.commerce-tabbar a, .commerce-tabbar button { display: grid; justify-items: center; gap: 2px; min-height: 52px; padding: 6px 2px 4px; border: 0; background: none; color: #7a8b8f; font: inherit; font-size: 11px; font-weight: 700; text-decoration: none; cursor: pointer; }
		.commerce-tabbar .active { color: var(--commerce-primary-dark); }
		.commerce-tabbar .active .commerce-tabbar__icon { background: var(--commerce-primary-soft); }
		.commerce-tabbar__icon { position: relative; display: grid; place-items: center; width: 44px; height: 28px; border-radius: 999px; font-size: 16px; }
		.commerce-tabbar__icon .nav-badge { position: absolute; top: -4px; right: -2px; margin: 0; min-width: 18px; height: 18px; font-size: 10px; border: 2px solid #fff; }
		/* 質感＋點擊回饋：按下縮放、選中膠囊淡入、立即切換選中狀態 */
		.commerce-tabbar { border-top-color: rgba(15, 23, 42, 0.06); background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); box-shadow: 0 -8px 24px rgba(28, 67, 70, 0.07); }
		.commerce-tabbar a, .commerce-tabbar button { gap: 3px; font-size: 11px; font-weight: 600; letter-spacing: .02em; -webkit-tap-highlight-color: transparent; touch-action: manipulation; transition: color .18s ease; }
		.commerce-tabbar .active { font-weight: 700; }
		.commerce-tabbar__icon { width: 56px; height: 30px; transition: background-color .2s ease, transform .16s cubic-bezier(.2, .8, .2, 1); }
		.commerce-tabbar__icon > i { transition: transform .2s cubic-bezier(.2, .8, .2, 1); }
		.commerce-tabbar .active .commerce-tabbar__icon { background: var(--commerce-primary-soft); box-shadow: inset 0 0 0 1px rgba(15, 118, 110, 0.10); }
		.commerce-tabbar .active .commerce-tabbar__icon > i { transform: translateY(-0.5px) scale(1.06); }
		.commerce-tabbar a:active .commerce-tabbar__icon, .commerce-tabbar button:active .commerce-tabbar__icon,
