---
/**
 * Shop / account / cart shell: V1 Layout + V1-style header with ecommerce links.
 */
import Layout from './Layout.astro';
import { getAllCategories } from '../data/products';
import { getCartItemCount } from '../lib/services/cart';
import { getVisiblePromoTabs } from '../lib/promoTabs';

interface Props {
	title: string;
	description?: string;
	wide?: boolean;
	productBack?: { href: string; label: string };
	legacyFooter?: boolean;
}

const { title, description, wide = false, productBack, legacyFooter = false } = Astro.props;
const user = Astro.locals.user;
let cartCount = 0;
if (user) {
	try {
		cartCount = await getCartItemCount(user.id);
	} catch {
		cartCount = 0;
	}
}

const [categories, promoTabs] = await Promise.all([getAllCategories(), getVisiblePromoTabs()]);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`));
const promoLinks = promoTabs.map((tab) => ({ href: `/promo/${tab.slug}`, label: tab.shortLabel }));
const accountLink = user ? { href: '/account', label: '會員中心' } : { href: '/account/login', label: '登入' };
---

<Layout title={title} description={description}>
	<header
		id="siteHeader"
		class="site-header sticky top-0 z-[100] border-b border-[var(--aq-line)] bg-[color-mix(in_srgb,var(--aq-sand)_88%,white)] shadow-[0_6px_24px_rgba(26,34,33,0.05)] backdrop-blur-[14px]"
	>
		{productBack ? (
			<div class="header-inner product-header-inner">
				<a class="product-back" href={productBack.href} aria-label={`返回${productBack.href === '/' ? '首頁' : productBack.label}`} title={productBack.href === '/' ? '返回首頁' : productBack.href === '/cart' ? '返回購物車' : '返回上一頁'} onclick={productBack.href === '/' || productBack.href === '/cart' ? undefined : "if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) { event.preventDefault(); history.back(); }"}>
					<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
				</a>
				<a href="/" class="product-brand">水博館水族</a>
				<nav class="nav-desktop product-nav" aria-label="主要導覽">
					<a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>首頁</a>
					{promoLinks.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
					<details class="nav-cat">
						<summary class:list={{ 'is-current': currentPath.startsWith('/products') || currentPath.startsWith('/product/') }}>本店商品</summary>
						<ul>
							<li><a href="/products/1">全部商品</a></li>
							{categories.map((c) => <li><a href={`/products/1?category=${encodeURIComponent(c.id)}`}>{c.label}</a></li>)}
						</ul>
					</details>
					<a href="/cart" aria-current={isCurrent('/cart') ? 'page' : undefined}>購物車{cartCount > 0 ? `（${cartCount}）` : ''}</a>
					<a href={accountLink.href} aria-current={currentPath.startsWith('/account') ? 'page' : undefined}>{accountLink.label}</a>
				</nav>
				<details class="mobile-menu">
					<summary aria-label="開啟選單"><i class="fa-solid fa-bars" aria-hidden="true"></i></summary>
					<nav class="mobile-menu-panel" aria-label="主要導覽">
						<a href="/" aria-current={isCurrent('/') ? 'page' : undefined}><i class="fa-solid fa-house" aria-hidden="true"></i>首頁</a>
						<a href="/products/1"><i class="fa-solid fa-fish" aria-hidden="true"></i>全部商品</a>
						<div class="mobile-menu-cats">
							{categories.map((c) => <a href={`/products/1?category=${encodeURIComponent(c.id)}`}>{c.label}</a>)}
						</div>
						{promoLinks.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}><i class="fa-solid fa-tag" aria-hidden="true"></i>{l.label}</a>)}
						<hr />
						<a href="/cart" aria-current={isCurrent('/cart') ? 'page' : undefined}><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>購物車{cartCount > 0 ? `（${cartCount}）` : ''}</a>
						<a href={accountLink.href}><i class="fa-solid fa-user" aria-hidden="true"></i>{accountLink.label}</a>
					</nav>
				</details>
			</div>
		) : (
		<div class="header-inner">
			<a href="/" class="brand">水博館水族</a>
			<nav class="nav-desktop" aria-label="主要導覽">
				<a href="/">首頁</a>
				{promoLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				<details class="nav-cat">
					<summary>本店商品</summary>
					<ul>
						<li><a href="/products/1">全部商品</a></li>
						{
							categories.map((c) => (
								<li>
									<a href={`/products/1?category=${encodeURIComponent(c.id)}`}>
										{c.label}
									</a>
								</li>
							))
						}
					</ul>
				</details>
				<a href="/cart">購物車{cartCount > 0 ? `（${cartCount}）` : ''}</a>
				{
					user ? (
						<a href="/account">會員中心</a>
					) : (
						<a href="/account/login">登入</a>
					)
				}
			</nav>
			<nav class="nav-mobile">
					<a href="/products/1">商品</a>
				<a href="/cart">購物車{cartCount > 0 ? `（${cartCount}）` : ''}</a>
				{user ? <a href="/account">會員</a> : <a href="/account/login">登入</a>}
			</nav>
		</div>
		)}
	</header>

	<main class:list={['page-main', { wide }]}>
		<slot />
	</main>

	{/* 全站頁尾與首頁一致 */}
	<footer class="site-footer legacy-footer">
		<div class="legacy-footer-inner">
			<nav class="legacy-footer-links" aria-label="頁尾連結"><a href="/#about">聯絡資訊</a><a href="/shopping-guide">購物須知</a></nav>
			<p>© 2026 水博館水族</p>
		</div>
	</footer>
</Layout>

<script>
	function initHeaderMenus() {
		document.addEventListener('click', (event) => {
			document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open], .nav-cat[open]').forEach((menu) => {
				if (!menu.contains(event.target as Node)) menu.open = false;
			});
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open], .nav-cat[open]').forEach((menu) => {
				menu.open = false;
			});
		});
	}
	initHeaderMenus();
</script>

<style>
	.header-inner {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0.75rem 1.1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		font-weight: 750;
		font-size: 1.15rem;
		color: var(--aq-ink);
		text-decoration: none;
	}

	.product-header-inner {
		display: grid;
		grid-template-columns: 40px 1fr 40px;
		max-width: 75rem;
		min-height: 56px;
		padding: 0.75rem 1rem;
	}

	.product-back {
		width: 40px;
		height: 40px;
	}

	/* 內頁：手機用選單按鈕，桌面直接顯示主選單 */
	.product-nav {
		display: none;
	}

	.nav-desktop a[aria-current='page'],
	.nav-desktop summary.is-current {
		color: var(--aq-primary-dark);
		font-weight: 700;
	}

	.mobile-menu {
		position: relative;
		justify-self: end;
	}

	.mobile-menu > summary {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		color: #111;
		font-size: 1.1rem;
		list-style: none;
		cursor: pointer;
	}

	.mobile-menu > summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu[open] > summary {
		background: color-mix(in srgb, var(--aq-primary) 10%, white);
		color: var(--aq-primary-dark);
	}

	.mobile-menu-panel {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		z-index: 200;
		display: grid;
		gap: 2px;
		width: min(78vw, 260px);
		padding: 0.5rem;
		border: 1px solid var(--aq-line);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 18px 40px rgba(26, 34, 33, 0.16);
	}

	.mobile-menu-panel > a {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 44px;
		padding: 0 0.75rem;
		border-radius: 10px;
		color: var(--aq-ink);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
	}

	.mobile-menu-panel > a i {
		width: 1.1rem;
		color: var(--aq-primary);
		text-align: center;
	}

	.mobile-menu-panel > a:hover,
	.mobile-menu-panel > a[aria-current='page'] {
		background: color-mix(in srgb, var(--aq-primary) 8%, white);
		color: var(--aq-primary-dark);
	}

	.mobile-menu-cats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.15rem 0.75rem 0.45rem 2.5rem;
	}

	.mobile-menu-cats a {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		padding: 0 0.7rem;
		border: 1px solid var(--aq-line);
		border-radius: 999px;
		color: var(--aq-muted);
		font-size: 0.82rem;
		text-decoration: none;
	}

	.mobile-menu-panel hr {
		margin: 0.25rem 0.5rem;
		border: 0;
		border-top: 1px solid var(--aq-line);
	}

	@media (min-width: 900px) {
		.product-header-inner {
			grid-template-columns: 40px auto 1fr;
			column-gap: 0.75rem;
		}

		.product-header-inner .product-brand {
			justify-self: start;
		}

		.product-nav {
			display: flex;
			justify-self: end;
		}

		.mobile-menu {
			display: none;
		}
	}

	.product-back {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		color: #111;
		transition: transform 0.2s ease, background 0.15s ease, box-shadow 0.2s ease;
	}

	.product-back:hover {
		background: #f5f5f5;
		transform: translateY(-2px);
		box-shadow: 0 4px 10px rgba(26, 34, 33, 0.06);
	}

	.product-brand {
		justify-self: center;
		font-weight: 800;
		font-size: 1.0625rem;
		letter-spacing: 0.04em;
		color: #111;
		text-decoration: none;
	}

	.nav-desktop {
		display: none;
		align-items: center;
		gap: 0.85rem;
		flex-wrap: wrap;
	}

	.nav-desktop a,
	.nav-desktop summary {
		color: var(--aq-muted);
		font-size: 0.92rem;
		text-decoration: none;
		cursor: pointer;
		list-style: none;
	}

	.nav-desktop a:hover,
	.nav-desktop summary:hover {
		color: var(--aq-primary);
	}

	.nav-cat {
		position: relative;
	}

	.nav-cat ul {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		margin: 0.35rem 0 0;
		padding: 0.4rem 0;
		min-width: 10rem;
		list-style: none;
		background: #fff;
		border: 1px solid var(--aq-line);
		border-radius: var(--aq-radius-sm);
		box-shadow: 0 10px 28px rgba(26, 34, 33, 0.08);
		z-index: 20;
	}

	.nav-cat[open] ul {
		display: block;
	}

	.nav-cat li a {
		display: block;
		padding: 0.4rem 0.85rem;
	}

	.nav-mobile {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.nav-mobile a {
		color: var(--aq-muted);
		font-size: 0.88rem;
		text-decoration: none;
	}

	@media (min-width: 900px) {
		.nav-desktop {
			display: flex;
		}
		.nav-mobile {
			display: none;
		}
	}

	.page-main {
		flex: 1 0 auto;
		width: 100%;
		max-width: 42rem;
		margin: 0 auto;
		padding: 1.5rem 1.15rem 3rem;
	}

	.page-main.wide {
		max-width: 75rem;
	}

	.site-footer {
		flex: 0 0 auto;
		border-top: 1px solid var(--aq-line);
		padding: 1.4rem 1.15rem 2rem;
		text-align: center;
		color: var(--aq-muted);
		font-size: 0.85rem;
		background: #fff;
	}

	.site-footer.legacy-footer{padding:2rem 1rem;background:inherit}.legacy-footer-inner{display:flex;width:100%;max-width:64rem;margin:0 auto;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;text-align:center}.legacy-footer-inner a{color:var(--aq-primary-dark);font-size:.875rem;font-weight:650;text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:4px;transition:color .15s}.legacy-footer-inner a:hover{color:var(--aq-primary)}.legacy-footer-links{display:flex;gap:1.25rem;flex-wrap:wrap;justify-content:center}.legacy-footer-inner p{margin:0;font-size:.75rem;letter-spacing:.02em}

	.site-footer p {
		margin: 0.25rem 0;
	}

	.site-footer a {
		color: var(--aq-primary);
		text-decoration: none;
	}
</style>

<style is:global>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
	}

	body > main.page-main {
		flex: 1 0 auto;
	}

	body > footer.site-footer {
		flex: 0 0 auto;
	}
</style>
